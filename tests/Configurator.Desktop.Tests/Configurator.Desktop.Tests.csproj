<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Configurator.Desktop\Configurator.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.BuildServices" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="Avalonia.Headless" PrivateAssets="all" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Conformance\root-map.definition.json" LogicalName="Conformance.RootMap" />
    <EmbeddedResource Include="..\Conformance\root-variant.definition.json" LogicalName="Conformance.RootVariant" />
    <EmbeddedResource Include="..\Conformance\recursive-cases.json" LogicalName="Conformance.Cases" />
    <EmbeddedResource Include="..\Conformance\synthetic-library.definition.json" LogicalName="Conformance.Library" />
  </ItemGroup>
</Project>
