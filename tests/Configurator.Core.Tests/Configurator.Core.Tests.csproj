<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Configurator.Core\Configurator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../examples/islamu-event/definition.json" LogicalName="EventDefinition" />
    <EmbeddedResource Include="../../examples/islamu-event/answers/*" LogicalName="EventAnswers.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../examples/islamu-event/expected/*" LogicalName="EventExpected.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../examples/grafana-13.2.2/setup-definition.json" LogicalName="GrafanaDefinition" />
    <EmbeddedResource Include="../../examples/grafana-13.2.2/answers.json" LogicalName="GrafanaAnswers" />
    <EmbeddedResource Include="../../examples/grafana-13.2.2/expected.env" LogicalName="GrafanaExpected.Environment" />
    <EmbeddedResource Include="../../examples/grafana-13.2.2/expected.yaml" LogicalName="GrafanaExpected.Datasource" />
  </ItemGroup>
</Project>
