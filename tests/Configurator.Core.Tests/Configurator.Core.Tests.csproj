<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Configurator.Core\Configurator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../examples/islamu-event/setup-definition.json" LogicalName="EventDefinition" />
    <EmbeddedResource Include="../../examples/islamu-event/public-definition.json" LogicalName="EventPublicDefinition" />
    <EmbeddedResource Include="../../examples/islamu-event/answers/*" LogicalName="EventAnswers.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../examples/islamu-event/expected/*" LogicalName="EventExpected.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
