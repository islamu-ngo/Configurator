{
  "format": "recursive-conformance-0.0.1",
  "cases": [
    {
      "id": "literal-map-keys-and-null",
      "definition": "root-map",
      "values": {"a~b": null, "a/b": 30, "A": 0, "0": 7},
      "omitted": [],
      "ready": true,
      "expectedJson": "{\"0\":7,\"A\":0,\"a/b\":30,\"a~b\":null}",
      "expectedDraftJson": "{\"0\":7,\"A\":0,\"a/b\":30,\"a~b\":null}"
    },
    {
      "id": "empty-map-requires-entry",
      "definition": "root-map",
      "values": {},
      "omitted": [],
      "ready": false,
      "expectedJson": null,
      "expectedDraftJson": null
    },
    {
      "id": "map-rejects-unlisted-integer",
      "definition": "root-map",
      "values": {"archive": 2},
      "omitted": [],
      "ready": false,
      "expectedJson": null,
      "expectedDraftJson": null
    },
    {
      "id": "map-rejects-string-instead-of-integer",
      "definition": "root-map",
      "values": {"archive": "7"},
      "omitted": [],
      "ready": false,
      "expectedJson": null,
      "expectedDraftJson": null
    },
    {
      "id": "map-retains-ordinal-case-distinction",
      "definition": "root-map",
      "values": {"a": 7, "A": 30},
      "omitted": [],
      "ready": true,
      "expectedJson": "{\"A\":30,\"a\":7}",
      "expectedDraftJson": "{\"A\":30,\"a\":7}"
    },
    {
      "id": "variant-applies-initialization-without-suggestion",
      "definition": "root-variant",
      "values": {"mode": "disk", "directory": "spool"},
      "omitted": [],
      "ready": true,
      "expectedJson": "{\"batch\":2,\"directory\":\"spool\",\"mode\":\"disk\"}",
      "expectedDraftJson": "{\"batch\":2,\"directory\":\"spool\",\"mode\":\"disk\"}"
    },
    {
      "id": "variant-omission-suppresses-initialization",
      "definition": "root-variant",
      "values": {"mode": "disk", "directory": "spool"},
      "omitted": ["/batch"],
      "ready": true,
      "expectedJson": "{\"directory\":\"spool\",\"mode\":\"disk\"}",
      "expectedDraftJson": "{\"directory\":\"spool\",\"mode\":\"disk\"}"
    },
    {
      "id": "variant-null-is-present",
      "definition": "root-variant",
      "values": {"mode": "disk", "directory": "spool", "note": null, "batch": 3},
      "omitted": [],
      "ready": true,
      "expectedJson": "{\"batch\":3,\"directory\":\"spool\",\"mode\":\"disk\",\"note\":null}",
      "expectedDraftJson": "{\"batch\":3,\"directory\":\"spool\",\"mode\":\"disk\",\"note\":null}"
    },
    {
      "id": "variant-missing-secret-is-draft-only",
      "definition": "root-variant",
      "values": {"mode": "queue", "endpoint": "queue.example.invalid"},
      "omitted": [],
      "ready": false,
      "expectedJson": null,
      "expectedDraftJson": "{\"endpoint\":\"queue.example.invalid\",\"mode\":\"queue\",\"token\":\"\"}"
    },
    {
      "id": "variant-supplied-synthetic-secret-is-complete",
      "definition": "root-variant",
      "values": {"mode": "queue", "endpoint": "queue.example.invalid", "token": "synthetic-token"},
      "omitted": [],
      "ready": true,
      "expectedJson": "{\"endpoint\":\"queue.example.invalid\",\"mode\":\"queue\",\"token\":\"synthetic-token\"}",
      "expectedDraftJson": "{\"endpoint\":\"queue.example.invalid\",\"mode\":\"queue\",\"token\":\"synthetic-token\"}"
    },
