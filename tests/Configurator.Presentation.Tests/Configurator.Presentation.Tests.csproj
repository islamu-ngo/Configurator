<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Configurator.Presentation\Configurator.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../Conformance/root-map.definition.json" LogicalName="Conformance.RootMap" />
    <EmbeddedResource Include="../Conformance/root-variant.definition.json" LogicalName="Conformance.RootVariant" />
    <EmbeddedResource Include="../Conformance/recursive-cases.json" LogicalName="Conformance.Cases" />
    <EmbeddedResource Include="../Conformance/synthetic-library.definition.json" LogicalName="Conformance.Library" />
    <None Include="../../examples/islamu-event/definition.json"
          Link="Fixtures/Event/definition.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/islamu-event/expected/configuration-manifest-1-tenants.json"
          Link="Fixtures/Event/configuration-manifest-1-tenants.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
