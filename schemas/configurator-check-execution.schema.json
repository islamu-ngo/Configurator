        "focused"
      ]
    },
    "testCaptureDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "executable": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "length",
        "sha256",
        "kind"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
