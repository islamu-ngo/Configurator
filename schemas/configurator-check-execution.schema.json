        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "length": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "length",
          "sha256",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "commandExitCode": {
      "type": "integer",
      "minimum": 0
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "type": "integer",
      "minimum": 0
    },
    "outcome": {
      "type": "string",
