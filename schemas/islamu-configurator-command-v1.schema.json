    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "path",
        "severity"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]\u002B)*$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\$(?:\\.[a-z][A-Za-z0-9-]*)*$"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        }
