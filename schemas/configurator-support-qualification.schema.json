{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "productSourceInputsDigest",
    "buildRecipeDigest",
    "payloadDigest",
    "commit",
    "dirtyInputsDigest",
    "toolVersion",
    "records"
  ],
  "properties": {
    "format": {
      "const": "configurator-support-qualification-0.0.1"
    },
    "productSourceInputsDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "buildRecipeDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payloadDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dirtyInputsDigest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "toolVersion": {
      "const": "0.0.1"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "client",
          "packageRid",
          "testRunnerRid",
          "hostOs",
          "hostDigest",
          "capability",
          "locale",
          "scenario",
          "recordedAt",
          "status",
          "exitCode",
          "passedCount",
          "failedCount",
          "artifactCreated"
        ],
        "properties": {
          "client": {
            "enum": [
              "cli",
              "terminal",
              "desktop",
              "browser"
            ]
          },
          "packageRid": {
            "enum": [
              "linux-arm64",
              "linux-musl-arm64",
              "linux-musl-x64",
              "linux-x64",
              "osx-arm64",
              "osx-x64",
              "win-x64",
              "browser-wasm"
            ]
          },
          "testRunnerRid": {
            "enum": [
              "linux-arm64",
              "linux-musl-arm64",
              "linux-musl-x64",
              "linux-x64",
              "osx-arm64",
              "osx-x64",
              "win-x64",
              null
            ]
          },
          "hostOs": {
            "enum": [
              "linux",
              "osx",
              "win",
              null
            ]
          },
          "hostDigest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "capability": {
            "enum": [
              "prepare",
              "edit",
              "import",
              "protected-save",
              "machine-contract",
              "lifecycle",
              "accessibility",
              "custody",
              "export",
              "offline",
              "performance"
            ]
          },
          "locale": {
            "enum": [
              "en",
              "ar"
            ]
          },
          "scenario": {
            "enum": [
              "prepare-output",
              "root-map",
              "root-variant",
              "correction",
              "compare-adopt",
              "create-only-save",
              "machine-envelope",
              "cancel-close",
              "installed-lifecycle",
              "keyboard-focus",
              "assistive-technology",
              "consent-revoke",
              "deliberate-export",
              "cache-update",
              "interactive-response"
            ]
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 20,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "verified-unsupported",
              "unexecuted"
            ]
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 255
          },
          "passedCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "failedCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "artifactCreated": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by ValidateSupportQualification.cs. Native validation additionally enforces 1 MiB input, duplicate keys and identities, expected digests, current per-client admission, scenario relevance, actual host/target equality and status/exit/count/artifact relationships. Schema acceptance alone is not evidence validation or qualification."
}
