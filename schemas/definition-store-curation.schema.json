{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Definition store optional curation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion"
  ],
  "dependentRequired": {
    "slug": [
      "slugReason"
    ],
    "slugReason": [
      "slug"
    ],
    "iconDataUri": [
      "iconLicense",
      "iconAttribution"
    ],
    "iconLicense": [
      "iconDataUri",
      "iconAttribution"
    ],
    "iconAttribution": [
      "iconDataUri",
      "iconLicense"
    ]
  },
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.0.1"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "slugReason": {
      "type": "string",
      "minLength": 16,
      "maxLength": 512,
      "pattern": "^\\S(?:[^\\x00-\\x1f\\x7f]*\\S)?$"
    },
    "tags": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32,
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
      }
    },
    "iconDataUri": {
      "type": "string",
      "minLength": 66,
      "maxLength": 16406,
      "pattern": "^data:image/png;base64,[A-Za-z0-9\u002B/]\u002B={0,2}$"
    },
    "iconLicense": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:[^\\x00-\\x1f\\x7f]*\\S)?$"
    },
    "iconAttribution": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^\\S(?:[^\\x00-\\x1f\\x7f]*\\S)?$"
    }
  }
}
