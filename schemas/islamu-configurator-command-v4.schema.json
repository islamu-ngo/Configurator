            "kind": {
              "const": "authoring"
            },
            "id": {
              "const": "urn:islamu:configurator:authoring:v2"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "runtime"
            },
            "id": {
              "const": "urn:islamu:configurator:setup-definition:v2"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "answers"
            },
            "id": {
              "const": "urn:islamu:configurator:answers:v1"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "command"
            },
            "id": {
              "const": "https://schemas.islamu.org/configurator/command/v4/schema.json"
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "mediaType",
        "digest",
        "sensitivity",
        "pathIntent",
        "writeStatus",
        "installation",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
        },
        "kind": {
          "enum": [
            "catalogue",
            "definition-artifact",
            "answer-snapshot",
            "doctor-report",
            "authoring-source",
            "compiled-definition",
            "logical-id-map"
          ]
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9.\u002B-]*/[a-z0-9][a-z0-9.\u002B-]*(?:;v=[a-z0-9.-]\u002B)?$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sensitivity": {
          "enum": [
            "public",
            "restricted"
          ]
        },
        "pathIntent": {
          "enum": [
            "none",
            "input",
            "output",
            "stdout"
          ]
        },
        "writeStatus": {
          "enum": [
            "none",
            "planned",
            "written",
            "not-attempted",
            "conflict",
            "blocked",
            "failed",
            "unknown"
          ]
        },
        "installation": {
          "enum": [
            "not-applicable",
            "not-attempted",
            "not-established",
            "established",
            "unknown"
          ]
        },
        "verification": {
          "enum": [
            "not-applicable",
            "not-attempted",
            "succeeded",
            "failed",
            "unknown"
          ]
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coveredCount",
        "missingCount",
        "detailDigest"
      ],
      "properties": {
        "coveredCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "missingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "detailDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "missingCount",
        "blockedCount"
      ],
      "properties": {
        "state": {
          "enum": [
            "ready",
            "incomplete",
            "blocked",
            "unassessed"
          ]
        },
        "missingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "blockedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      }
    },
    "coverageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
        },
        "state": {
          "enum": [
            "covered",
            "missing"
          ]
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definitionDigest",
        "artifactId",
        "compatibility",
        "coverage",
        "inventory",
        "autofill",
        "retainedCount"
      ],
      "properties": {
        "definitionDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
        },
        "compatibility": {
          "enum": [
            "compatible",
            "changes-required",
            "incomplete",
            "unsupported",
            "invalid-input"
          ]
        },
        "coverage": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "inventory": {
          "enum": [
            "complete",
            "stopped"
          ]
        },
        "autofill": {
          "enum": [
            "eligible",
            "ineligible"
          ]
        },
        "retainedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      },
      "oneOf": [
        {
          "properties": {
            "inventory": {
              "const": "complete"
            }
          },
          "required": [
            "total"
          ]
        },
        {
          "properties": {
            "inventory": {
              "const": "stopped"
            }
          },
          "not": {
            "required": [
              "total"
            ]
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "code"
      ],
      "properties": {
        "classification": {
          "enum": [
            "missing-required",
            "invalid-supplied-value",
            "unrecognized-input",
            "structural-output-change",
            "unassessed",
            "context-derived-value"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]\u002B)*$"
        },
        "source": {
          "$ref": "#/$defs/findingSource"
        },
        "schema": {
          "$ref": "#/$defs/findingSchema"
        }
      }
    },
    "findingSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinals"
      ],
      "properties": {
        "ordinals": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          }
        }
      }
    },
    "findingSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldId",
        "relativePath"
      ],
      "properties": {
        "fieldId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z][A-Za-z0-9._-]*)?$"
        },
        "relativePath": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 256,
            "pattern": "^[\\s\\S]*$"
          }
        }
      }
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "offset",
        "limit",
        "retainedCount",
        "returnedCount",
        "nextOffset",
        "terminal",
        "digest",
        "diagnostics",
        "coverage",
        "findings"
      ],
      "properties": {
        "kind": {
          "enum": [
            "diagnostics",
            "coverage",
            "findings"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "retainedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "returnedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "nextOffset": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "terminal": {
          "type": "boolean"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "coverage": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/coverageEntry"
          }
        },
        "findings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "terminal": {
              "const": true
            },
            "nextOffset": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "terminal": {
              "const": false
            },
            "nextOffset": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "returnedCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "schema"
        ]
      },
      "then": {
        "properties": {
          "invocation": {
            "properties": {
              "commandFamily": {
                "const": "definition"
              },
              "operation": {
                "const": "schema"
              }
            }
          },
          "exitCode": {
            "const": 0
          }
        },
        "not": {
          "required": [
            "help"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "invocation": {
            "properties": {
              "commandFamily": {
                "const": "definition"
              },
              "operation": {
                "const": "schema"
              }
            }
          },
          "exitCode": {
            "const": 0
          }
        },
        "not": {
          "required": [
            "help"
          ]
        }
      },
      "then": {
        "required": [
          "schema"
        ]
      }
    }
  ]
}
