@implements IDisposable
@using System.Text.Json
@using System.Security.Cryptography
@using Configurator.Core.Definitions

<section class="workspace" aria-labelledby="template-heading">
    <h2 id="template-heading">Public choices only</h2>
    <p id="template-boundary">
        This partial template contains only declared public enum and boolean choices.
        No secrets or arbitrary text can be entered. It is not full native configuration,
        cannot apply to a target, and does not establish configuration readiness.
        Complete all other answers in a native client using this exact definition revision and digest.
    </p>
    @foreach (SetupFieldState state in _validation!.Fields)
    {
        var field = state.Definition;
        @if (field.Sensitivity == SetupFieldSensitivity.Public && state.IsActive)
        {
            <div class="question" data-field="@field.Id" data-active="@state.IsActive.ToString().ToLowerInvariant()">
                @if (BrowserPublicTemplate.IsSelectable(field) && state.IsActive)
                {
                    <label for="@($"choice-{field.Id}")">@field.Title @(state.IsRequired ? "(required)" : "(optional)")</label>
                    <select id="@($"choice-{field.Id}")" aria-describedby="@($"help-{field.Id}")"
                            value="@SelectedText(field.Id)" @onchange="args => ChangeSelection(field, args)">
                        <option value="">Not selected</option>
                        @if (field.Type == "boolean")
                        {
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        }
                        else
                        {
                            @foreach (JsonElement choice in field.Choices)
                            {
                                <option value="@choice.GetString()">@choice.GetString()</option>
                            }
                        }
                    </select>
                    <p id="@($"help-{field.Id}")">@field.Help @field.Consequence</p>
                }
                else
                {
                    <h3>@field.Title</h3>
                    <p>@(BrowserPublicTemplate.IsSelectable(field) ? "Inactive for current public choices." : "Native-only answer.")</p>
                    <p>@field.Help @field.Consequence</p>
                }
            </div>
        }
    }
    <p data-native-required="@NativeRequiredCount">
        @NativeRequiredCount active required native-only answers remain outside this template.
    </p>
    <label class="file-label" for="template-file">Import a public template JSON (maximum 64 KiB)</label>
    <InputFile @key="_inputKey" @ref="_fileInput" id="template-file" accept="application/json,.json"
               aria-describedby="template-boundary" OnChange="LoadFileAsync" />
    <div class="actions">
        <button class="button" type="button" @onclick="Export">Prepare public template</button>
        <button class="button button--secondary" type="button" @onclick="Invalidate">Clear choices</button>
    </div>
    @if (_rejected)
    {
        <p role="alert" class="notice notice--error" data-code="template-rejected">
            Template rejected. Only this pinned definition's active public choices are accepted.
        </p>
    }
    else
    {
        <p role="status" class="notice">@_status</p>
    }
    @if (_result?.IsAccepted == true)
    {
        <h3>Public template preview</h3>
        <pre dir="ltr" tabindex="0">@_result.Preview</pre>
        <a class="button" download="configurator-public-template.json" href="@_result.DownloadHref">Download public template</a>
    }
</section>

@code {
    [Parameter, EditorRequired] public SetupDefinition Definition { get; set; } = null!;
    private SetupDefinition? _pinned;
    private readonly Dictionary<string, JsonElement> _selections = new(StringComparer.Ordinal);
    private DefinitionValidationResult? _validation;
    private BrowserTemplateResult? _result;
    private string _status = "Choose public options or import a public template.";
    private bool _rejected;
    private long _generation;
    private long _inputKey;
    private CancellationTokenSource? _readCancellation;
    private byte[]? _readBuffer;
    private InputFile? _fileInput;
    private bool _restoreInputFocus;
    private bool _disposed;
    private int NativeRequiredCount => _validation!.Fields.Count(state =>
        state.IsActive && state.IsRequired && !state.IsProvided && !BrowserPublicTemplate.IsSelectable(state.Definition));

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_pinned, Definition)) return;
        Invalidate();
        _pinned = Definition;
        Validate();
    }

    private void Validate() => _validation = DefinitionValidator.Validate(
        Definition, new SetupAnswerSnapshot(0, _selections));

    private string SelectedText(string id) => _selections.TryGetValue(id, out var value)
        ? value.ValueKind == JsonValueKind.String ? value.GetString()! : value.GetRawText()
        : string.Empty;

    private void ChangeSelection(SetupFieldDefinition field, ChangeEventArgs args)
    {
        StopRead();
        ++_inputKey;
        _result = null;
        _rejected = false;
        string text = args.Value?.ToString() ?? string.Empty;
        if (text.Length == 0) _selections.Remove(field.Id);
        else
        {
            JsonElement value = field.Type == "boolean"
                ? JsonSerializer.SerializeToElement(text == "true")
                : JsonSerializer.SerializeToElement(text);
            if (field.Type == "boolean" && text is not ("true" or "false")
                || !BrowserPublicTemplate.IsSelectable(field)
                || !_validation!.Fields.Any(state => state.Id == field.Id && state.IsActive)
                || field.Type == "enum" && !field.Choices.Any(choice => JsonElement.DeepEquals(choice, value)))
            {
                Reject();
                return;
            }
            _selections[field.Id] = value;
        }
        Validate();
        foreach (SetupFieldState state in _validation!.Fields.Where(state => !state.IsActive))
            _selections.Remove(state.Id);
        Validate();
        _status = "Public choices changed. Prepare a new partial template to download.";
    }

    private void Export()
    {
        StopRead();
        ++_inputKey;
        _result = BrowserPublicTemplate.Create(Definition, _selections);
        _rejected = !_result.IsAccepted;
        _status = "Public template prepared locally. Native configuration is still incomplete.";
    }

    public async Task LoadAsync(Stream input)
    {
        ArgumentNullException.ThrowIfNull(input);
        if (_disposed) return;
        StopRead();
        _selections.Clear();
        Validate();
        _result = null;
        _rejected = false;
        _status = "Reading a bounded public template.";
        long generation = _generation;
        SetupDefinition definition = Definition;
        using var cancellation = new CancellationTokenSource();
        _readCancellation = cancellation;
        byte[] buffer = new byte[BrowserPublicTemplate.MaximumBytes + 1];
        _readBuffer = buffer;
        await InvokeAsync(StateHasChanged);
        try
        {
            int length = 0;
            while (length < buffer.Length)
            {
                int read = await input.ReadAsync(buffer.AsMemory(length, buffer.Length - length), cancellation.Token);
                if (read == 0) break;
                length += read;
            }
            if (_disposed || generation != _generation) return;
            BrowserTemplateResult result = BrowserPublicTemplate.Parse(definition, buffer.AsMemory(0, length));
            if (!result.IsAccepted) Reject();
            else
            {
                foreach ((string id, JsonElement value) in result.Answers!.Values) _selections.Add(id, value);
                Validate();
                _result = result;
                _status = "Public template imported locally. Native configuration is still incomplete.";
            }
        }
        catch (Exception exception) when (exception is IOException or OperationCanceledException)
        {
            if (_disposed || generation != _generation) return;
            Reject();
        }
        finally
        {
            CryptographicOperations.ZeroMemory(buffer);
            if (ReferenceEquals(_readCancellation, cancellation)) _readCancellation = null;
            if (ReferenceEquals(_readBuffer, buffer)) _readBuffer = null;
        }
        if (!_disposed && generation == _generation) await InvokeAsync(StateHasChanged);
    }

    private async Task LoadFileAsync(InputFileChangeEventArgs args)
    {
        long generation = _generation + 1;
        try
        {
            if (args.File.Size > BrowserPublicTemplate.MaximumBytes)
            {
                Invalidate();
                Reject();
                return;
            }
            await using Stream input = args.File.OpenReadStream(BrowserPublicTemplate.MaximumBytes);
            await LoadAsync(input);
        }
        catch (IOException)
        {
            if (!_disposed && (generation == _generation || generation == _generation + 1))
            {
                Invalidate();
                Reject();
            }
        }
        finally
        {
            if (!_disposed && generation == _generation)
            {
                ++_inputKey;
                _restoreInputFocus = true;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_restoreInputFocus && _fileInput?.Element is { } element)
        {
            _restoreInputFocus = false;
            await element.FocusAsync(preventScroll: true);
        }
    }

    private void Reject()
    {
        _selections.Clear();
        Validate();
        _result = null;
        _rejected = true;
    }

    private void StopRead()
    {
        ++_generation;
        _readCancellation?.Cancel();
        _readCancellation = null;
        if (_readBuffer is { } buffer) CryptographicOperations.ZeroMemory(buffer);
        _readBuffer = null;
    }

    public void Invalidate()
    {
        StopRead();
        _selections.Clear();
        _result = null;
        _rejected = false;
        _status = "Choose public options or import a public template.";
        ++_inputKey;
        if (_pinned is not null) Validate();
    }

    public void Dispose()
    {
        _disposed = true;
        Invalidate();
    }
}
