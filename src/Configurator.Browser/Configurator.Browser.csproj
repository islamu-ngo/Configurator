<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!-- Local answer custody is deliberate; hosting trade-offs: docs/internal/LAUNCH_CONTRACT.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Configurator.Browser</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <!-- Workspace locales can differ from the browser's startup culture without a reload. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Configurator.Core\Configurator.Core.csproj" />
    <ProjectReference Include="..\Configurator.Presentation\Configurator.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="MudBlazor" />
    <ServiceWorker Include="wwwroot/service-worker.js" PublishedContent="wwwroot/service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both languages travel with the app; changing workspace locale performs no satellite fetch. -->
    <EmbeddedResource Update="Resources/BrowserStrings.resx"
                      WithCulture="false" LogicalName="Configurator.Browser.Resources.BrowserStrings.resources" />
    <EmbeddedResource Update="Resources/BrowserStrings.ar.resx"
                      WithCulture="false" LogicalName="Configurator.Browser.Resources.BrowserStrings.ar.resources" />
    <EmbeddedResource Include="Definitions/**/*.json" />
    <!-- Registry orders resource names; put the neutral first-run example before optional target examples. -->
    <EmbeddedResource Include="../../examples/minimal-self-hosted/setup-definition.json"
                      LogicalName="Configurator.Browser.Definitions.00-neutral-service.json" />
    <EmbeddedResource Include="../../examples/islamu-event/definition.json"
                      LogicalName="Configurator.Browser.Definitions.islamu-event.public.json" />
  </ItemGroup>

  <Target Name="PrepareDefinitionStoreAssets" BeforeTargets="ResolveProjectStaticWebAssets">
    <PropertyGroup>
      <_DefinitionStoreOutput>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)definition-store'))</_DefinitionStoreOutput>
    </PropertyGroup>
    <RemoveDir Directories="$(_DefinitionStoreOutput)" />
    <Exec Condition="'$(DefinitionStoreSourceRoot)' != ''"
          WorkingDirectory="$(MSBuildProjectDirectory)/../.."
          Command="dotnet run --file &quot;$(MSBuildProjectDirectory)/../../eng/configurator/BuildDefinitionStore.cs&quot; -- --source &quot;$(DefinitionStoreSourceRoot)&quot; --output &quot;$(_DefinitionStoreOutput)&quot; --write" />
    <ItemGroup Condition="'$(DefinitionStoreSourceRoot)' != ''">
      <_DefinitionStoreAsset Include="$(_DefinitionStoreOutput)/**/*" />
      <Content Include="@(_DefinitionStoreAsset)">
        <Link>wwwroot/definition-store/%(_DefinitionStoreAsset.RecursiveDir)%(_DefinitionStoreAsset.Filename)%(_DefinitionStoreAsset.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
      <FileWrites Include="@(_DefinitionStoreAsset)" />
    </ItemGroup>
  </Target>

  <Target Name="ClearPublishedDefinitionStore" BeforeTargets="PrepareForPublish"
          Condition="'$(PublishDir)' != ''">
    <RemoveDir Directories="$(PublishDir)wwwroot/definition-store" />
  </Target>

  <Target Name="VerifyBrowserEditorAssets" BeforeTargets="PrepareForPublish">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../.."
          Command="dotnet run --file &quot;$(MSBuildProjectDirectory)/../../eng/configurator/BuildBrowserEditor.cs&quot; -- --check &quot;$(MSBuildProjectDirectory)/../..&quot;" />
  </Target>
</Project>
