<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Configurator.Browser</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SetupTargetEnabled>true</SetupTargetEnabled>
    <SetupTargetRole>StandalonePublicBrowser</SetupTargetRole>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Configurator.Core\Configurator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Definitions/**/*.json" />
    <!-- Registry orders resource names; put the neutral first-run example before optional target examples. -->
    <EmbeddedResource Include="../../examples/minimal-self-hosted/setup-definition.json"
                      LogicalName="Configurator.Browser.Definitions.00-neutral-service.json" />
  </ItemGroup>
</Project>
