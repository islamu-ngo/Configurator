<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!-- Local answer custody is deliberate; hosting trade-offs: docs/internal/LAUNCH_CONTRACT.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Configurator.Browser</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <!-- Workspace locales can differ from the browser's startup culture without a reload. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <ConfiguratorProfileWorkerArtifactsPath>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'profile-worker-cache'))</ConfiguratorProfileWorkerArtifactsPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Configurator.Core\Configurator.Core.csproj" />
    <ProjectReference Include="..\Configurator.Presentation\Configurator.Presentation.csproj" />
    <Compile Include="../Configurator.Browser.Worker/Contracts/ProfileWorkerContracts.cs"
             Link="Profiles/ProfileWorkerContracts.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="MudBlazor" />
    <ServiceWorker Include="wwwroot/service-worker.js" PublishedContent="wwwroot/service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both languages travel with the app; changing workspace locale performs no satellite fetch. -->
    <EmbeddedResource Update="Resources/BrowserStrings.resx"
                      WithCulture="false" LogicalName="Configurator.Browser.Resources.BrowserStrings.resources" />
    <EmbeddedResource Update="Resources/BrowserStrings.ar.resx"
                      WithCulture="false" LogicalName="Configurator.Browser.Resources.BrowserStrings.ar.resources" />
    <EmbeddedResource Include="Definitions/**/*.json" />
    <!-- Registry orders resource names; put the neutral first-run example before optional target examples. -->
    <EmbeddedResource Include="../../examples/minimal-self-hosted/setup-definition.json"
                      LogicalName="Configurator.Browser.Definitions.00-neutral-service.json" />
    <EmbeddedResource Include="../../examples/islamu-event/definition.json"
                      LogicalName="Configurator.Browser.Definitions.islamu-event.public.json" />
  </ItemGroup>

  <!-- Each executable owns its runtime graph. Only published public files cross this boundary. -->
  <Target Name="PublishBrowserProfileWorker" BeforeTargets="AssignTargetPaths"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_ConfiguratorProfileWorkerPublishDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'profile-worker-publish'))</_ConfiguratorProfileWorkerPublishDirectory>
    </PropertyGroup>
    <!-- Retire stale public files while retaining the SDK's compilation and AOT caches. -->
    <RemoveDir Directories="$(_ConfiguratorProfileWorkerPublishDirectory)" />
    <Exec Condition="'$(ConfiguratorCaptureSession)' == ''" WorkingDirectory="$(MSBuildProjectDirectory)/../.."
      Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Configurator.Browser.Worker/Configurator.Browser.Worker.csproj&quot; --configuration &quot;$(Configuration)&quot; --output &quot;$(_ConfiguratorProfileWorkerPublishDirectory)&quot; --tl:off -p:UseArtifactsOutput=true -p:ArtifactsPath=&quot;$(ConfiguratorProfileWorkerArtifactsPath)&quot; -p:RestoreLockedMode=true" />
    <BuildCaptureTask Condition="'$(ConfiguratorCaptureSession)' != ''" Session="$(ConfiguratorCaptureSession)"
      Project="$(MSBuildProjectDirectory)/../Configurator.Browser.Worker/Configurator.Browser.Worker.csproj" Target="Publish"
      Properties="Configuration=$(Configuration);PublishDir=$(_ConfiguratorProfileWorkerPublishDirectory);RestoreLockedMode=true" />
    <Error Condition="!Exists('$(_ConfiguratorProfileWorkerPublishDirectory)wwwroot/profile-worker.js') or !Exists('$(_ConfiguratorProfileWorkerPublishDirectory)wwwroot/_framework/dotnet.js')"
      Text="The independent profile worker publication is incomplete." />
    <ItemGroup>
      <_ConfiguratorProfileWorkerAsset Include="$(_ConfiguratorProfileWorkerPublishDirectory)wwwroot/**/*" />
      <Content Include="@(_ConfiguratorProfileWorkerAsset)"
               Link="wwwroot/profile-worker/%(_ConfiguratorProfileWorkerAsset.RecursiveDir)%(_ConfiguratorProfileWorkerAsset.Filename)%(_ConfiguratorProfileWorkerAsset.Extension)"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="VerifyBrowserEditorAssets" BeforeTargets="PrepareForPublish">
    <Exec Condition="'$(ConfiguratorCaptureSession)' == ''" WorkingDirectory="$(MSBuildProjectDirectory)/../.."
          Command="dotnet run --file &quot;$(MSBuildProjectDirectory)/../../eng/configurator/BuildBrowserEditor.cs&quot; -- --check &quot;$(MSBuildProjectDirectory)/../..&quot;" />
    <BuildCaptureTask Condition="'$(ConfiguratorCaptureSession)' != ''" Session="$(ConfiguratorCaptureSession)"
      Project="$(MSBuildProjectFullPath)" Operation="editor" Arguments="--check;$(MSBuildProjectDirectory)/../.." />
  </Target>
  <Target Name="VerifyBrowserProfileAssets" BeforeTargets="PrepareForPublish">
    <Exec Condition="'$(ConfiguratorCaptureSession)' == ''" WorkingDirectory="$(MSBuildProjectDirectory)/../.."
          Command="dotnet run --file &quot;$(MSBuildProjectDirectory)/../../eng/configurator/BuildBrowserProfileWorker.cs&quot; -- --check &quot;$(MSBuildProjectDirectory)/../..&quot;" />
    <BuildCaptureTask Condition="'$(ConfiguratorCaptureSession)' != ''" Session="$(ConfiguratorCaptureSession)"
      Project="$(MSBuildProjectFullPath)" Operation="profile-worker" Arguments="--check;$(MSBuildProjectDirectory)/../.." />
  </Target>
</Project>
