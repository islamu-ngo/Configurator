@using System.Globalization
@using System.Text.Json
@using Configurator.Presentation
@using Configurator.Core.Definitions
@implements IDisposable

<div class="configuration-field" data-field="@string.Join('.', Path)">
    @if (Type is "object" or "list")
    {
        <fieldset @ref="_group" tabindex="-1" aria-describedby="@(ControlId + "-help " + ControlId + "-error")"
                  aria-invalid="@((_invalid || Error.Length > 0).ToString().ToLowerInvariant())" disabled="@(!Form.CanEdit(Path))">
            <legend>@Title @(Required ? "(required)" : "(optional)")</legend>
            @if (Type == "object")
            {
                @if (Value is null)
                {
                    <button type="button" class="button button--secondary" @onclick="SupplyObject">Supply @Title object</button>
                }
                bool focusRemaining = FocusFirstControl || _focusObjectChildren;
                @foreach (JsonElement child in Schema.GetProperty("properties").EnumerateArray())
                {
                    string childId = child.GetProperty("id").GetString()!;
                    string[] childPath = Path.Append(childId).ToArray();
                    bool focusChild = focusRemaining && CanFocus(child, childPath);
                    if (focusChild) focusRemaining = false;
                    <ConfigurationField @key="childId" Form="Form" Schema="child"
                                        Path="childPath" Validation="Validation" ValidationChanged="ValidationChanged" InheritedSecret="IsSecret" FocusFirstControl="focusChild" />
                }
            }
            else
            {
                @if (Value is null)
                {
                    <button type="button" class="button button--secondary" data-action="supply-list" @onclick="SupplyList">Supply an empty @Title list</button>
                }
                @for (int index = 0; index < Count; index++)
                {
                    int row = index;
                    <div class="configuration-field__row" @key="_rowKeys[row]">
                        <ConfigurationField Form="Form" Schema="ItemSchema" Path="@Path.Append(row.ToString(CultureInfo.InvariantCulture)).ToArray()" Validation="Validation" ValidationChanged="ValidationChanged" InheritedSecret="IsSecret" FocusFirstControl="@(row == _focusNewRow || FocusFirstControl && row == 0)" />
                        <button type="button" class="button button--secondary" aria-label="@($"Remove {Title} item {row + 1}")"
                                @onclick="() => Remove(row)">Remove item @(row + 1)</button>
                    </div>
                }
                <button @ref="_addButton" type="button" class="button button--secondary" data-action="add-item" disabled="@(Count >= MaximumItems)"
                        @onclick="Add">Add @Title item</button>
                <p>@Count / @MaximumItems items</p>
            }
        </fieldset>
    }
    else
    {
        <label for="@ControlId">@Title @(Required ? "(required)" : "(optional)")</label>
        @if (Type is "boolean" or "enum" && !IsSecret)
        {
            <select @ref="_control" id="@ControlId" value="@Text" aria-describedby="@(ControlId + "-help " + ControlId + "-error")"
                    aria-invalid="@((_invalid || Error.Length > 0).ToString().ToLowerInvariant())" aria-required="@Required.ToString().ToLowerInvariant()" disabled="@(!Form.CanEdit(Path))" @onchange="Edit">
                <option value="">Not supplied</option>
                @if (Type == "boolean")
                {
                    <option value="true">Yes</option><option value="false">No</option>
                }
                else
                {
                    @foreach (JsonElement choice in Schema.GetProperty("choices").EnumerateArray())
                    {
                        <option value="@Display(choice)">@Display(choice)</option>
                    }
                }
            </select>
        }
        else
        {
            <input @ref="_control" id="@ControlId" type="@(IsSecret ? "password" : Type is "integer" or "number" ? "number" : "text")"
                   inputmode="@(Type == "integer" ? "numeric" : Type == "number" ? "decimal" : "text")"
                   step="@(Type == "integer" ? "1" : "any")" value="@Text" maxlength="65536"
                   autocomplete="off" spellcheck="false" aria-describedby="@(ControlId + "-help " + ControlId + "-error")"
                   aria-invalid="@((_invalid || Error.Length > 0).ToString().ToLowerInvariant())" aria-required="@Required.ToString().ToLowerInvariant()" disabled="@(!Form.CanEdit(Path))" @oninput="Edit" />
        }
    }
    <p id="@(ControlId + "-help")">@Help @Consequence @(IsSecret && !Form.CanEdit(Path) ? "Secret entry is disabled. You can prepare a draft and fill this value in the exported file." : "")
        @if (IsSecret && Type == "boolean") { <span>Use true or false.</span> }
        @if (IsSecret && Type == "enum") { <span>Declared choices: @string.Join(", ", Schema.GetProperty("choices").EnumerateArray().Select(Display)).</span> }
    </p>
    <p id="@(ControlId + "-error")" class="notice--error">@(_invalid ? "Supply a value of the declared type." : Error)</p>
</div>

@code {
    [Parameter, EditorRequired] public DefinitionFormModel Form { get; set; } = null!;
    [Parameter, EditorRequired] public JsonElement Schema { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<string> Path { get; set; } = [];
    [Parameter] public DefinitionValidationResult? Validation { get; set; }
    [Parameter] public EventCallback<(string Id, bool Invalid)> ValidationChanged { get; set; }
    [Parameter] public bool InheritedSecret { get; set; }
    [Parameter] public bool? RequiredOverride { get; set; }
    [Parameter] public bool FocusFirstControl { get; set; }
    private readonly string _controlId = "field-" + Guid.NewGuid().ToString("N");
    private readonly List<Guid> _rowKeys = [];
    private ElementReference _addButton;
    private ElementReference _group;
    private ElementReference _control;
    private bool _focusedForRequest;
    private int _focusNewRow = -1;
    private bool _focusObjectChildren;
    private bool _focusAdd;
    private bool _invalid;
    private string? _editing;
    private string? _observedText;
    private string Error => string.Join(", ", Validation?.Diagnostics.Where(item => MatchesDiagnostic(item.FieldId)).Select(item => item.Code) ?? []);
    private bool MatchesDiagnostic(string? fieldId) => fieldId == Path[0] || fieldId is not null &&
        (Path.Count == 1 ? fieldId.StartsWith(Path[0] + "/", StringComparison.Ordinal) : fieldId == Path[0] + "/" + Path[1]);
    private string ControlId => Path.Count == 1 ? "choice-" + Path[0] : _controlId;
    private string Type => Schema.GetProperty("type").GetString()!;
    private string Title => Schema.TryGetProperty("title", out var value) ? value.GetString()! : "Item";
    private string? Help => Schema.TryGetProperty("help", out var value) ? value.GetString() : null;
    private string? Consequence => Schema.TryGetProperty("consequence", out var value) ? value.GetString() : null;
    private bool Required => RequiredOverride ?? (Schema.TryGetProperty("required", out var value) && value.GetBoolean());
    private bool IsSecret => InheritedSecret || Schema.TryGetProperty("sensitivity", out var value) && value.GetString() == "secret";
    private int MaximumItems => Schema.TryGetProperty("maxItems", out var value) ? value.GetInt32() : 256;
    private int Count => Value is { ValueKind: JsonValueKind.Array } value ? value.GetArrayLength() : 0;
    private string Text => !Form.CanEdit(Path) ? string.Empty : Path.Count == 1
        ? Form.Fields.Single(input => input.Definition.Id == Path[0]).Text
        : _editing ?? (Value is { } value ? Display(value) : string.Empty);
    private JsonElement ItemSchema => JsonSerializer.SerializeToElement(new Dictionary<string, object?>
    {
        ["type"] = Schema.GetProperty("itemType").GetString(), ["title"] = Title + " item",
        ["sensitivity"] = Schema.GetProperty("sensitivity").GetString(),
        ["properties"] = Schema.TryGetProperty("properties", out var value) ? value : (JsonElement?)null
    });

    private JsonElement? Value
    {
        get
        {
            var input = Form.Fields.Single(inputField => inputField.Definition.Id == Path[0]);
            if (!input.TryValue(out JsonElement? supplied) || supplied is not { } value) return null;
            foreach (string segment in Path.Skip(1))
            {
                if (value.ValueKind == JsonValueKind.Object && value.TryGetProperty(segment, out var child)) value = child;
                else if (value.ValueKind == JsonValueKind.Array && int.TryParse(segment, out int index) && index >= 0 && index < value.GetArrayLength()) value = value[index];
                else return null;
            }
            return value;
        }
    }

    protected override void OnParametersSet()
    {
        if (!FocusFirstControl) _focusedForRequest = false;
        while (_rowKeys.Count < Count) _rowKeys.Add(Guid.NewGuid());
        if (_rowKeys.Count > Count) _rowKeys.RemoveRange(Count, _rowKeys.Count - Count);
        if (!Form.CanEdit(Path))
        {
            _editing = null;
            if (_invalid)
            {
                _invalid = false;
                _ = ValidationChanged.InvokeAsync((ControlId, false));
            }
        }
        string? current = Value is { } value ? Display(value) : null;
        if (_observedText != current) _editing = null;
        _observedText = current;
    }

    private void Edit(ChangeEventArgs args)
    {
        string text = args.Value?.ToString() ?? string.Empty;
        _editing = text;
        if (Path.Count == 1)
        {
            var input = Form.Fields.Single(field => field.Definition.Id == Path[0]);
            input.Text = text;
            _invalid = input.InputDiagnosticCode is not null || !input.TryValue(out _);
            _ = ValidationChanged.InvokeAsync((ControlId, _invalid));
            return;
        }
        JsonElement? value = null;
        _invalid = false;
        if (text.Length > 0)
        {
            if (Type is "string" or "enum") value = JsonSerializer.SerializeToElement(text);
            else if (Type == "boolean" && bool.TryParse(text, out bool boolean)) value = JsonSerializer.SerializeToElement(boolean);
            else if (Type == "integer" && long.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out long integer)) value = JsonSerializer.SerializeToElement(integer);
            else if (Type == "number" && decimal.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out decimal number)) value = JsonSerializer.SerializeToElement(number);
            else _invalid = true;
        }
        // Remove an invalid previous value so strict preparation cannot use stale input.
        if (!Form.SetValue(Path, _invalid ? null : value)) _invalid = true;
        _observedText = Value is { } supplied ? Display(supplied) : null;
        _ = ValidationChanged.InvokeAsync((ControlId, _invalid));
    }

    private void Add()
    {
        _focusNewRow = Count;
        _rowKeys.Add(Guid.NewGuid());
        if (!Form.AddListItem(Path)) { _rowKeys.RemoveAt(_rowKeys.Count - 1); _focusNewRow = -1; }
    }
    private void SupplyObject()
    {
        _focusObjectChildren = true;
        if (!Form.SupplyObject(Path)) _focusObjectChildren = false;
    }
    private void SupplyList()
    {
        if (Form.SetValue(Path, JsonSerializer.SerializeToElement(Array.Empty<object>()))) _focusAdd = true;
    }
    private void Remove(int index)
    {
        Guid identity = _rowKeys[index];
        _rowKeys.RemoveAt(index);
        if (!Form.RemoveListItem(Path, index)) { _rowKeys.Insert(index, identity); return; }
        _focusAdd = true;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _focusNewRow = -1;
        if (_focusObjectChildren)
        {
            _focusObjectChildren = false;
            if (!CanFocus(Schema, Path)) await _group.FocusAsync(preventScroll: true);
        }
        if (FocusFirstControl && !_focusedForRequest && Form.CanEdit(Path) && Type != "object")
        {
            _focusedForRequest = true;
            await (Type == "list" ? _addButton : _control).FocusAsync(preventScroll: true);
        }
        if (!_focusAdd) return;
        _focusAdd = false;
        await _addButton.FocusAsync(preventScroll: true);
    }
    private bool CanFocus(JsonElement schema, IReadOnlyList<string> path)
    {
        if (!Form.CanEdit(path)) return false;
        if (schema.GetProperty("type").GetString() != "object") return true;
        return schema.GetProperty("properties").EnumerateArray().Any(child =>
            CanFocus(child, path.Append(child.GetProperty("id").GetString()!).ToArray()));
    }
    private static string Display(JsonElement value) => value.ValueKind == JsonValueKind.String ? value.GetString()! : value.GetRawText();
    public void Dispose()
    {
        if (_invalid) _ = ValidationChanged.InvokeAsync((ControlId, false));
    }
}
