<div class="app-text-field">
    @if (Multiline && !Masked)
    {
        <textarea @ref="_textarea" id="@InputId" class="app-text-field__textarea" value="@Value" dir="ltr"
                  disabled="@Disabled" readonly="@ReadOnly" required="@Required" rows="8" @attributes="InputAttributes"></textarea>
    }
    else
    {
    <MudInput T="string" @ref="_input" Value="@Value" InputId="@InputId"
                  InputType="@(Masked ? InputType.Password : InputType.Text)" InputMode="@InputMode"
                  Disabled="@Disabled" ReadOnly="@ReadOnly" Required="@Required" Error="@Error" ErrorText="@ErrorText" ErrorId="@(InputId + "-error")" HelperId="@(InputId + "-help")"
                  MaxLength="int.MaxValue" Immediate="true" FullWidth="true"
                  Variant="Variant.Outlined" Margin="Margin.Dense" UserAttributes="@InputAttributes" />
    }
    <p id="@(InputId + "-error")" class="app-text-field__error" hidden="@(!Error)">@ErrorText</p>
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter, EditorRequired] public string InputId { get; set; } = string.Empty;
    [Parameter] public bool Masked { get; set; }
    [Parameter] public bool Multiline { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public InputMode InputMode { get; set; } = InputMode.text;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Error { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public Dictionary<string, object>? InputAttributes { get; set; }
    private bool _suppressParameterRender;
    private MudInput<string> _input = null!;
    private ElementReference _textarea;

    public override Task SetParametersAsync(ParameterView parameters)
    {
        bool Changed<T>(string name, T current) =>
            parameters.TryGetValue<T>(name, out var supplied) && !EqualityComparer<T>.Default.Equals(current, supplied);

        // A reused dictionary may have changed since its last render; retain no snapshot.
        bool attributesChanged = parameters.TryGetValue(nameof(InputAttributes), out Dictionary<string, object>? attributes)
            && (attributes is not null && ReferenceEquals(InputAttributes, attributes)
                || (InputAttributes?.Count ?? 0) != (attributes?.Count ?? 0)
                || attributes?.Any(item => item.Value is not (null or string or bool)
                    || InputAttributes is null || !InputAttributes.TryGetValue(item.Key, out object? current)
                    || !Equals(current, item.Value)) == true);
        _suppressParameterRender = !(attributesChanged
            || Changed(nameof(Value), Value)
            || Changed(nameof(InputId), InputId)
            || Changed(nameof(Masked), Masked)
            || Changed(nameof(Multiline), Multiline)
            || Changed(nameof(ReadOnly), ReadOnly)
            || Changed(nameof(InputMode), InputMode)
            || Changed(nameof(Disabled), Disabled)
            || Changed(nameof(Required), Required)
            || Changed(nameof(Error), Error)
            || Changed(nameof(ErrorText), ErrorText));
        try
        {
            return base.SetParametersAsync(parameters);
        }
        finally
        {
            _suppressParameterRender = false;
        }
    }

    protected override bool ShouldRender() => !_suppressParameterRender;

    public async Task FocusAsync()
    {
        if (Multiline && !Masked) await _textarea.FocusAsync();
        else await _input.FocusAsync();
    }
}
