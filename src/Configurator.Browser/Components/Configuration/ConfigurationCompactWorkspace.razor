@implements IAsyncDisposable
@using System.Globalization
@using Configurator.Core.Definitions
@using Configurator.Presentation
@using Configurator.Browser.Resources

<div class="configuration-compact-workspace" data-compact-workspace>
    @{
        var sections = ApplicableSections;
        HashSet<string>? activeMatchedFieldIds = ShowMatchesOnly && Form.Projection.Matches.Count > 0 ? MatchedFieldIds : null;
    }
    <div class="configuration-compact-workspace__toolbar">
        @if (!LiteralRoot && sections.Length > 1)
        {
            <nav class="configuration-compact-workspace__jumps" aria-label="@Ui("CompactSectionJumpLabel")">
                @foreach (var section in sections)
                {
                    <button type="button" class="configuration-compact-workspace__jump"
                            data-compact-section-jump="@section.Id"
                            @onclick="() => JumpToSectionAsync(section.Id)">
                        <bdi>@section.Title</bdi>
                    </button>
                }
            </nav>
        }
        <label class="configuration-compact-workspace__matches-filter">
            <input type="checkbox" data-compact-matches-only checked="@ShowMatchesOnly"
                   @onchange="OnShowMatchesOnlyChanged" />
            <span>@Ui("CompactShowMatchesOnly")</span>
        </label>
    </div>

    <div @ref="_mountElement" class="configuration-compact-workspace__mount" data-configuration-mount
         data-mount-generation="@_mountGeneration.ToString(CultureInfo.InvariantCulture)"
         data-mount-state="@(Busy ? "pending" : "complete")"
         data-discovery-state="@(Discovering ? "pending" : "complete")"
         data-pending-fields="@(Discovering ? "unknown" : PendingCount.ToString(CultureInfo.InvariantCulture))"
         aria-busy="@Busy.ToString().ToLowerInvariant()">
        @if (LiteralRoot)
        {
            var root = _plan.Roots[0];
            @if (root.Admitted)
            {
                <ConfigurationField @key="root.Identity" Form="Form" Schema="Form.Definition.Configuration"
                                    Path="Array.Empty<string>()" LiteralPath="true" MountNode="root" MountRevision="_planRevision"
                                    CompactPresentation="true"
                                    Validation="Validation" RequiredOverride="true"
                                    TitleOverride="@Form.GetEditorPresentation(root.Location)!.Title"
                                    FocusFirstControl="@(FocusField == string.Empty)" FocusGeneration="FocusGeneration" FocusPath="FocusPath" />
            }
        }
        else
        {
            @foreach (var section in sections)
            {
                var sectionLayout = GetSectionLayout(section);
                bool sectionHidden = IsSectionHiddenByFilter(sectionLayout.All);
                bool focusedHere = FocusField is not null && sectionLayout.FieldIds.Contains(FocusField);
                <ConfigurationCompactSection @key="section.Id"
                                             Form="Form"
                                             Section="section"
                                             SectionProgress="@(Form.Projection.SectionProgress.GetValueOrDefault(section.Id) ?? new(0, 0, 0, 0, 0))"
                                             Layout="sectionLayout"
                                             ActiveFields="_activeFields"
                                             PlanRoots="_plan.Roots"
                                             PlanRevision="_planRevision"
                                             Validation="Validation"
                                             SectionHidden="sectionHidden"
                                             FocusField="@(focusedHere ? FocusField : null)"
                                             FocusGeneration="@(focusedHere ? FocusGeneration : 0L)"
                                             FocusPath="@(focusedHere ? FocusPath : Array.Empty<string>())"
                                             ShowMatchesOnly="ShowMatchesOnly"
                                             MatchedFieldIds="activeMatchedFieldIds" />
            }
        }
    </div>
    @if (Busy)
    {
        <p class="configuration-section-fields__status" role="status" data-mount-status="pending">@Ui("SectionSettingsLoading")</p>
    }
</div>
