@if (Stage != WorkspaceStartupStage.Ready)
{
    <div class="workspace-startup-gate" role="region" aria-labelledby="startup-gate-heading"
         aria-busy="@(Stage == WorkspaceStartupStage.Preparing ? "true" : null)"
         data-startup-state="@StateToken">
        <div class="workspace-startup-gate__card">
            <h3 id="startup-gate-heading" class="workspace-startup-gate__title">
                <bdi>@(string.IsNullOrWhiteSpace(Title) ? T("WorkspaceTitle") : Title)</bdi>
            </h3>
            <p class="workspace-startup-gate__privacy">@T("StartupBeforeEntryBody")</p>

            @if (Stage == WorkspaceStartupStage.Preparing)
            {
                <p role="status" class="notice" data-code="@(StatusCode ?? "workspace-starting")">@T("Preparing")</p>
            }
            else if (Stage == WorkspaceStartupStage.PreparationFailed)
            {
                <p role="alert" class="notice" data-code="@(StatusCode ?? "app-preparation-incomplete")">
                    @(string.IsNullOrWhiteSpace(StatusMessage) ? T("AppPreparationIncompleteStatus") : StatusMessage)
                </p>
            }

            <div class="workspace-startup-gate__actions">
                @if (Stage == WorkspaceStartupStage.BeforeEntry)
                {
                    <button @ref="_startButton" class="button" type="button" data-action="start-workspace"
                            @onclick="() => StartRequested.InvokeAsync()">
                        @T("StartWorkspace")
                    </button>
                }
                else if (Stage == WorkspaceStartupStage.PreparationFailed)
                {
                    <button @ref="_startButton" class="button" type="button" data-action="start-workspace"
                            @onclick="() => StartRequested.InvokeAsync()">
                        @T("RetryStartup")
                    </button>
                }
                <a class="button button--secondary" href="">@T("BackToCatalogue")</a>
            </div>
        </div>
    </div>
}
