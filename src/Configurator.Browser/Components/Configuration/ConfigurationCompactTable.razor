@implements IDisposable
@using System.Globalization
@using System.Text.Json
@using Configurator.Browser.Resources
@using Configurator.Core.Definitions
@using Configurator.Presentation
@using Microsoft.AspNetCore.Components.Web.Virtualization

<section class="configuration-compact" aria-labelledby="configuration-compact-heading">
    <header class="configuration-compact__toolbar">
        <h3 id="configuration-compact-heading" class="configuration-compact__heading">@Ui("ModeCompact")</h3>
        <div class="configuration-compact__controls">
            <div class="configuration-compact__search-box">
                <label class="sr-only" for="configuration-compact-search">@Ui("CompactSearchLabel")</label>
                <input id="configuration-compact-search"
                       data-compact-search
                       type="search"
                       class="form-control configuration-compact__search"
                       maxlength="256"
                       placeholder="@Ui("CompactSearchLabel")"
                       value="@_pendingSearch"
                       @oninput="OnSearchInput" />
            </div>
            <div class="configuration-compact__filters" role="group" aria-label="@Ui("DiscoverySelectedFilters")">
                @foreach (DefinitionDiscoveryFilter filter in Filters)
                {
                    <button type="button"
                            class="button button--secondary configuration-compact__chip @(_filter == filter ? "configuration-compact__chip--active" : "")"
                            data-compact-filter="@FilterToken(filter)"
                            aria-pressed="@(_filter == filter ? "true" : "false")"
                            @onclick="() => SetFilter(filter)">@Ui(FilterResourceKey(filter))</button>
                }
            </div>
            <label class="configuration-compact__toggle">
                <input type="checkbox"
                       data-compact-include-inactive
                       checked="@_includeInactive"
                       @onchange="ToggleIncludeInactive" />
                <span>@Ui("CompactIncludeInactive")</span>
            </label>
            <span class="configuration-compact__count" role="status">@UiFormat("CompactRowCountSummary", _indexedRows.Length)</span>
        </div>
    </header>

    @if (_indexedRows.Length == 0)
    {
        <p class="configuration-compact__empty" role="status">@Ui("CompactNoMatches")</p>
    }
    else
    {
        <div class="configuration-compact__table"
             role="table"
             data-compact-table
             aria-rowcount="@(_indexedRows.Length + 1)"
             lang="@Form.Locale">
            <div class="configuration-compact__header" role="row" aria-rowindex="1">
                <div class="configuration-compact__th" role="columnheader" aria-sort="@SortAria("section")">
                    <button type="button" class="configuration-compact__sort" data-compact-sort="section" @onclick='() => ToggleSort("section")'>
                        @Ui("CompactColSection")
                    </button>
                </div>
                <div class="configuration-compact__th" role="columnheader" aria-sort="@SortAria("setting")">
                    <button type="button" class="configuration-compact__sort" data-compact-sort="setting" @onclick='() => ToggleSort("setting")'>
                        @Ui("CompactColSetting")
                    </button>
                </div>
                <div class="configuration-compact__th" role="columnheader">
                    <span>@Ui("CompactColValue")</span>
                </div>
                <div class="configuration-compact__th" role="columnheader" aria-sort="@SortAria("origin")">
                    <button type="button" class="configuration-compact__sort" data-compact-sort="origin" @onclick='() => ToggleSort("origin")'>
                        @Ui("CompactColOrigin")
                    </button>
                </div>
                <div class="configuration-compact__th" role="columnheader" aria-sort="@SortAria("status")">
                    <button type="button" class="configuration-compact__sort" data-compact-sort="status" @onclick='() => ToggleSort("status")'>
                        @Ui("CompactColStatus")
                    </button>
                </div>
            </div>

            <div class="configuration-compact__body" role="rowgroup">
                @if (_indexedRows.Length > 40)
                {
                    <Virtualize Items="@_indexedRows" ItemSize="52" OverscanCount="6" Context="indexed">
                        @RenderRow(indexed)
                    </Virtualize>
                }
                else
                {
                    @foreach (IndexedCompactRow indexed in _indexedRows)
                    {
                        @RenderRow(indexed)
                    }
                }
            </div>
        </div>
    }
</section>

@code {
    private static string CompactRowKey(CompactPropertyRow row) =>
        row.IsSensitiveMasked && !row.HasCopyableWireToken
            ? row.EditorIdentity
            : string.Join('.', row.DataPath.Segments);

    private RenderFragment<IndexedCompactRow> RenderRow => indexed => __builder =>
    {
        CompactPropertyRow row = indexed.Row;
        bool isActive = string.Equals(_activeIdentity, row.EditorIdentity, StringComparison.Ordinal);
        <div class="configuration-compact__row @(row.HasError ? "configuration-compact__row--error" : "") @(isActive ? "configuration-compact__row--active" : "")"
             role="row"
             @key="row.EditorIdentity"
             data-compact-row="@CompactRowKey(row)"
             data-compact-active="@(isActive ? "" : null)"
             aria-rowindex="@(indexed.Index + 2)">
            <div class="configuration-compact__cell configuration-compact__cell--section" role="cell">
                <span>@row.SectionTitle</span>
            </div>
            <div class="configuration-compact__cell configuration-compact__cell--setting" role="cell">
                <span class="configuration-compact__title">
                    @row.PrimaryLabel
                    @if (!string.IsNullOrWhiteSpace(row.Units))
                    {
                        <span class="configuration-compact__units">@row.Units</span>
                    }
                    @if (row.IsDeprecated)
                    {
                        <span class="configuration-compact__badge configuration-compact__badge--deprecated">@Ui("FieldDeprecated")</span>
                    }
                </span>
                @if (row.HasCopyableWireToken && !string.IsNullOrWhiteSpace(row.WireToken) && !string.Equals(row.PrimaryLabel, row.WireToken, StringComparison.Ordinal))
                {
                    <code class="configuration-compact__wire" dir="ltr">@row.WireToken</code>
                }
                @if (!row.IsSensitiveMasked && !string.IsNullOrWhiteSpace(row.IfOmittedDisplay))
                {
                    <span class="configuration-compact__meta">@row.IfOmittedDisplay</span>
                }
            </div>
            <div class="configuration-compact__cell configuration-compact__cell--value" role="cell">
                @if (row.IsSecretLocked)
                {
                    <div class="configuration-compact__locked" data-compact-secret-locked>
                        <span>@Ui("CompactSecretLockedText")</span>
                        @if (RequestSecretConsent.HasDelegate)
                        {
                            <button type="button"
                                    class="button button--secondary"
                                    data-action="compact-secret-consent"
                                    @onclick="() => RequestSecretConsent.InvokeAsync()">@Ui("ReviewSecretConsent")</button>
                        }
                    </div>
                }
                else if (row.IsSensitiveMasked)
                {
                    <div class="configuration-compact__masked">
                        <span>@(string.IsNullOrEmpty(row.ValuePreview) ? Ui("CompactSecretEditableMasked") : row.ValuePreview)</span>
                        @if (OpenFieldInGuided.HasDelegate)
                        {
                            <button type="button"
                                    class="button button--secondary"
                                    data-action="compact-open-guided"
                                    @onclick="() => OpenFieldInGuided.InvokeAsync(row.DataPath)">@Ui("ModeGuided")</button>
                        }
                    </div>
                }
                else if (row.NodeType == DefinitionNodeType.Boolean)
                {
                    <select class="form-control configuration-compact__input"
                            aria-label="@row.PrimaryLabel"
                            disabled="@(!row.CanEdit || row.IsReadOnly)"
                            value="@BooleanValueToken(row)"
                            @onfocus="() => SetActiveRow(row.EditorIdentity)"
                            @onchange="args => OnBooleanChanged(row, args)">
                        <option value="">@Ui("NotSupplied")</option>
                        <option value="true">@Ui("Yes")</option>
                        <option value="false">@Ui("No")</option>
                    </select>
                }
                else if (row.Choices.Count > 0)
                {
                    <select class="form-control configuration-compact__input"
                            aria-label="@row.PrimaryLabel"
                            disabled="@(!row.CanEdit || row.IsReadOnly)"
                            value="@ChoiceIndexToken(row)"
                            @onfocus="() => SetActiveRow(row.EditorIdentity)"
                            @onchange="args => OnChoiceChanged(row, args)">
                        <option value="">@Ui("NotSupplied")</option>
                        @for (int i = 0; i < row.Choices.Count; i++)
                        {
                            int choiceIndex = i;
                            <option value="@choiceIndex.ToString(CultureInfo.InvariantCulture)">@row.Choices[choiceIndex].DisplayLabel</option>
                        }
                    </select>
                }
                else if (row.NodeType is DefinitionNodeType.Mapping or DefinitionNodeType.Sequence)
                {
                    <div class="configuration-compact__composite">
                        <span>@(string.IsNullOrEmpty(row.ValuePreview) ? Ui("NotSupplied") : row.ValuePreview)</span>
                        @if (OpenFieldInGuided.HasDelegate)
                        {
                            <button type="button"
                                    class="button button--secondary"
                                    data-action="compact-open-guided"
                                    @onclick="() => OpenFieldInGuided.InvokeAsync(row.DataPath)">@Ui("ModeGuided")</button>
                        }
                    </div>
                }
                else
                {
                    <input class="form-control configuration-compact__input"
                           type="text"
                           aria-label="@row.PrimaryLabel"
                           dir="@(row.NodeType is DefinitionNodeType.WholeNumber or DefinitionNodeType.Number ? "ltr" : null)"
                           placeholder="@(row.IfOmittedDisplay ?? row.DefaultText)"
                           value="@ScalarValue(row)"
                           disabled="@(!row.CanEdit || row.IsReadOnly)"
                           @onfocus="() => SetActiveRow(row.EditorIdentity)"
                           @oninput="args => OnScalarInput(row, args)" />
                }
            </div>
            <div class="configuration-compact__cell configuration-compact__cell--origin" role="cell">
                <span>@OriginText(row.Origin)</span>
            </div>
            <div class="configuration-compact__cell configuration-compact__cell--status" role="cell">
                <span>@StatusText(row)</span>
            </div>
        </div>
    };
}
