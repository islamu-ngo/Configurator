@using Configurator.Core.Profiles
@using Configurator.Browser.Profiles
@implements IDisposable

@{
    ProfileWorkerAuthority rendered = Controller.CaptureAuthority();
    bool ready = Controller.Ready;
    bool busy = Controller.IsBusy;
    bool consented = Controller.Consented;
    var form = Controller.Form;
}
<div class="configuration-vault" data-profile-panel data-operation-phase="private-profile">
    <div class="configuration-vault__header">
        <h3 id="profile-vault-heading" @ref="_heading" tabindex="-1">@Text("ProfileTitle")</h3>
        @if (CloseRequested.HasDelegate)
        {
            <AppButton Variant="Variant.Text"
                       OnClick="CloseRequested"
                       data-action="close-profile-panel"
                       aria-label="@Text("CloseProfilesPanel")">@Text("Close")</AppButton>
        }
    </div>
    <ol class="configuration-vault__steps" data-vault-steps aria-label="@Text("VaultSequenceIntro")">
        <li>@Text("VaultStep1LockUnlock")</li>
        <li>@Text("VaultStep2ReviewDiff")</li>
        <li>@Text("VaultStep3DownloadCopy")</li>
    </ol>
    <details class="configuration-vault__crypto" data-vault-crypto-details>
        <summary>@Text("VaultCryptoDetails")</summary>
        <p>@Text("ProfileLocalOnly")</p>
        <p>@Text("ProfileAlgorithm") <bdi dir="ltr">JWE · A256GCM · PBES2-HS512+A256KW · 600000</bdi></p>
        <p>@Text("ProfileNoRecoveryBackdoor")</p>
    </details>
    <p role="status" aria-live="polite" data-profile-status="@Controller.Status">
        @Text(Controller.Status) @if (Controller.Code is not null) { <bdi dir="ltr">@Controller.Code</bdi> }
    </p>
    @if (Controller.Status is "ProfileRejected" or "ProfileCancelled" && !busy)
    {
        <button type="button" class="button button--secondary" data-action="retry-profile-task"
                @onclick="() => Controller.RetryProfileTask(rendered)">@Text("RetryProfileTask")</button>
    }
    @if (form.RequiresBrowserProfileComposition)
    {
        <p class="notice" data-profile-incomplete>@Text("ProfilePrivateOutputRequired")</p>
    }
    <fieldset disabled="@(!ready || busy)" class="configuration-vault__group" data-profile-task="compare">
        <legend>@Text("ProfileComparison")</legend>
        <p id="profile-comparison-help">@Text("ProfileComparisonHelp")</p>
        <label for="profile-comparison-file">@Text("ProfileComparisonOpen")</label>
        <InputFile id="profile-comparison-file" @key="(Controller.FileKey, 0)" accept=".json"
                   aria-describedby="profile-comparison-help"
                   OnChange="args => Controller.CompareAsync(rendered, args.File)" />
        <button type="button" class="button button--secondary" data-action="profile-save-comparison"
                @onclick="() => Controller.SaveComparisonAsync(rendered)">@Text("ProfileComparisonSave")</button>
    </fieldset>
    @if (!consented)
    {
        <p>@Text("ProfileConsentHelp")</p>
        <button type="button" class="button button--secondary" data-action="profile-consent"
                @onclick="() => Controller.IsCurrent(rendered) ? RequestConsent.InvokeAsync() : Task.CompletedTask">@Text("ReviewSecretConsent")</button>
    }
    <fieldset disabled="@(!ready || !consented || busy)" class="configuration-vault__group" data-profile-task="open">
        <legend>@Text("ProfileOpen")</legend>
        <p id="profile-open-help">@Text("ProfileOpenHelp")</p>
        <label for="profile-vault-file">@Text("ProfileChooseVault")</label>
        <InputFile id="profile-vault-file" @key="(Controller.FileKey, 1)" accept=".cfgvault,.json"
                   disabled="@(form.BrowserProfile is not null)" aria-describedby="profile-open-help"
                   OnChange="args => { if (Controller.IsCurrent(rendered) && !Controller.IsBusy && Controller.Consented) _vaultFile = args.File; }" />
        <label for="profile-open-passphrase">@Text("ProfilePassphrase")</label>
        <div class="configuration-vault__secret-row">
            <input id="profile-open-passphrase" class="form-control" type="@(IsPassphraseVisible("open") ? "text" : "password")" autocomplete="off" maxlength="1024"
                   value="@_passphrase" @oninput='args => SetCredential(rendered, "open", args)' />
            <button type="button" class="button button--secondary configuration-vault__toggle"
                    data-passphrase-toggle="profile-open-passphrase"
                    aria-controls="profile-open-passphrase"
                    aria-pressed="@IsPassphraseVisible("open").ToString().ToLowerInvariant()"
                    aria-label="@Format("TogglePassphraseVisibility", Text("ProfilePassphrase"))"
                    @onclick='() => TogglePassphraseVisibility("open")'>@Text(IsPassphraseVisible("open") ? "HidePassphrase" : "ShowPassphrase")</button>
        </div>
        <label for="profile-recipient">@Text("ProfileRecipientIndex")</label>
        <input id="profile-recipient" class="form-control" type="number" min="0" max="7" value="@Controller.RecipientIndex"
               @onchange="args => Controller.SetRecipientIndex(rendered, args.Value?.ToString(), recovery: false)" aria-describedby="profile-recipient-help" />
        <p id="profile-recipient-help">@Text("ProfileRecipientHelp")</p>
        <button type="button" class="button" data-action="profile-open"
                disabled="@(_vaultFile is null || form.BrowserProfile is not null)"
                @onclick="() => OpenAsync(rendered)">@Text("ProfileOpen")</button>
    </fieldset>
    @if (form.BrowserProfile is { } profile)
    {
        <div class="configuration-vault__group" data-profile-task="active-profile">
            <p>@Text("ProfileMode"): @Text(profile.Mode == ProfileProtectionMode.ImportUpgradeOnly ? "ProfileBlind" : "ProfileInspectable")</p>
            <p class="form-help" data-profile-mode-disclosure="@(profile.Mode == ProfileProtectionMode.InspectableEncrypted ? "inspectable-encrypted" : "upgrade-only")">
                @Text(profile.Mode == ProfileProtectionMode.InspectableEncrypted ? "ProfileModeInspectableDisclosure" : "ProfileModeUpgradeOnlyDisclosure")
            </p>
            <p>@Text("ProfileRetainedHelp")</p>
            <ul class="configuration-vault__fields">
                @foreach (var path in profile.RetainedPaths)
                {
                    string pointer = path.ToPointer();
                    <li @key="pointer">
                        <bdi dir="ltr">@(pointer.Length == 0 ? "/" : pointer)</bdi>
                        @if (Controller.Replacement == pointer)
                        {
                            <p>@Text("ProfileReplaceConfirmation")</p>
                            <button type="button" class="button" disabled="@busy" data-action="profile-confirm-replace"
                                    @onclick="() => Controller.ReplaceAsync(rendered, pointer)">@Text("ProfileConfirmReplace")</button>
                            <button type="button" class="button button--secondary" disabled="@busy"
                                    @onclick="() => Controller.CancelReplacement(rendered)">@Text("Cancel")</button>
                        }
                        else
                        {
                            <button type="button" class="button button--secondary" disabled="@busy" data-profile-replace="@pointer"
                                    @onclick="() => Controller.BeginReplacement(rendered, pointer)">@Text("ProfileReplace")</button>
                        }
                    </li>
                }
            </ul>
            @if (profile.Mode == ProfileProtectionMode.InspectableEncrypted)
            {
                <label class="configuration-vault__confirmation">
                    <input id="profile-inspect-consent" type="checkbox" checked="@Controller.InspectConfirmed" disabled="@busy"
                           @onchange="args => Controller.SetInspectConfirmed(rendered, args.Value is true)" />
                    @Text("ProfileInspectConsent")
                </label>
                <button type="button" class="button button--secondary" data-action="profile-inspect"
                        disabled="@(busy || !Controller.InspectConfirmed)" @onclick="() => Controller.InspectAsync(rendered)">@Text("ProfileInspect")</button>
            }
            <button type="button" class="button button--secondary" data-action="profile-plan" disabled="@busy"
                    @onclick="() => Controller.RefreshPlanAsync(rendered)">@Text("ProfileRefreshPlan")</button>
            <label for="profile-artifact">@Text("ProfileArtifact")</label>
            <select id="profile-artifact" value="@Controller.ArtifactId" disabled="@busy"
                    @onchange="args => Controller.SetArtifactId(rendered, args.Value?.ToString() ?? string.Empty)">
                @foreach (var artifact in form.EligibleArtifacts)
                {
                    <option value="@artifact.Id">@artifact.Title</option>
                }
            </select>
            <button type="button" class="button" data-action="profile-download-private"
                    disabled="@(busy || Controller.ArtifactId.Length == 0)" @onclick="() => Controller.DownloadPrivateAsync(rendered)">@Text("ProfileDownloadPrivate")</button>
            <p>@Text("ProfileDownloadBoundary")</p>
        </div>
    }
    @if (Controller.Fields.Count > 0)
    {
        <table class="configuration-vault__table">
            <caption>@Text("ProfileComparisonResults")</caption>
            <thead><tr><th scope="col">@Text("ProfileField")</th><th scope="col">@Text("ProfileEligibility")</th><th scope="col">@Text("ProfileComparison")</th></tr></thead>
            <tbody>
                @foreach (var field in Controller.Fields)
                {
                    <tr><th scope="row"><bdi dir="ltr">@field.Path</bdi></th><td>@Text("ProfileEligibility" + field.Eligibility)</td><td>@Text("ProfileComparison" + field.Comparison)</td></tr>
                }
            </tbody>
        </table>
    }
    <fieldset disabled="@(!ready || !consented || busy || form.RequiresBrowserProfileComposition && form.BrowserProfile is null)" class="configuration-vault__group" data-profile-task="save">
        <legend>@Text("ProfileSave")</legend>
        <p id="profile-save-help">@Text("ProfileSaveHelp")</p>
        <p class="form-help" data-profile-recovery-state="@(Controller.Status == "ProfileRecoveryVerified" ? "verified" : "unverified")">
            @Text(Controller.Status == "ProfileRecoveryVerified" ? "ProfileRecoveryStateVerified" : "ProfileRecoveryStateUnverified")
        </p>
        @if (form.BrowserProfile is null)
        {
            <label for="profile-mode">@Text("ProfileMode")</label>
            <select id="profile-mode" value="@Controller.Mode" @onchange="args => SetMode(rendered, args)">
                <option value="ImportUpgradeOnly">@Text("ProfileBlind")</option>
                <option value="InspectableEncrypted">@Text("ProfileInspectable")</option>
            </select>
        }
        <label for="profile-new-passphrase">@Text("ProfileNewPassphrase")</label>
        <div class="configuration-vault__secret-row">
            <input id="profile-new-passphrase" class="form-control" type="@(IsPassphraseVisible("new") ? "text" : "password")" autocomplete="new-password" maxlength="1024"
                   aria-describedby="profile-save-help" value="@_newPassphrase" @oninput='args => SetCredential(rendered, "new", args)' />
            <button type="button" class="button button--secondary configuration-vault__toggle"
                    data-passphrase-toggle="profile-new-passphrase"
                    aria-controls="profile-new-passphrase"
                    aria-pressed="@IsPassphraseVisible("new").ToString().ToLowerInvariant()"
                    aria-label="@Format("TogglePassphraseVisibility", Text("ProfileNewPassphrase"))"
                    @onclick='() => TogglePassphraseVisibility("new")'>@Text(IsPassphraseVisible("new") ? "HidePassphrase" : "ShowPassphrase")</button>
        </div>
        <label for="profile-confirm-passphrase">@Text("ProfileConfirmPassphrase")</label>
        <div class="configuration-vault__secret-row">
            <input id="profile-confirm-passphrase" class="form-control" type="@(IsPassphraseVisible("confirmation") ? "text" : "password")" autocomplete="new-password" maxlength="1024"
                   value="@_confirmation" @oninput='args => SetCredential(rendered, "confirmation", args)' />
            <button type="button" class="button button--secondary configuration-vault__toggle"
                    data-passphrase-toggle="profile-confirm-passphrase"
                    aria-controls="profile-confirm-passphrase"
                    aria-pressed="@IsPassphraseVisible("confirmation").ToString().ToLowerInvariant()"
                    aria-label="@Format("TogglePassphraseVisibility", Text("ProfileConfirmPassphrase"))"
                    @onclick='() => TogglePassphraseVisibility("confirmation")'>@Text(IsPassphraseVisible("confirmation") ? "HidePassphrase" : "ShowPassphrase")</button>
        </div>
        <label class="configuration-vault__confirmation">
            <input id="profile-add-recovery" type="checkbox" checked="@Controller.AddRecovery"
                   @onchange="args => Controller.SetAddRecovery(rendered, args.Value is true)" />@Text("ProfileAddRecovery")
        </label>
        @if (Controller.AddRecovery)
        {
            <label for="profile-backup-passphrase">@Text("ProfileRecoveryPassphrase")</label>
            <div class="configuration-vault__secret-row">
                <input id="profile-backup-passphrase" class="form-control" type="@(IsPassphraseVisible("backup") ? "text" : "password")" autocomplete="new-password" maxlength="1024"
                       value="@_backupPassphrase" @oninput='args => SetCredential(rendered, "backup", args)' />
                <button type="button" class="button button--secondary configuration-vault__toggle"
                        data-passphrase-toggle="profile-backup-passphrase"
                        aria-controls="profile-backup-passphrase"
                        aria-pressed="@IsPassphraseVisible("backup").ToString().ToLowerInvariant()"
                        aria-label="@Format("TogglePassphraseVisibility", Text("ProfileRecoveryPassphrase"))"
                        @onclick='() => TogglePassphraseVisibility("backup")'>@Text(IsPassphraseVisible("backup") ? "HidePassphrase" : "ShowPassphrase")</button>
            </div>
            <label for="profile-backup-confirmation">@Text("ProfileConfirmRecovery")</label>
            <div class="configuration-vault__secret-row">
                <input id="profile-backup-confirmation" class="form-control" type="@(IsPassphraseVisible("backupConfirmation") ? "text" : "password")" autocomplete="new-password" maxlength="1024"
                       value="@_backupConfirmation" @oninput='args => SetCredential(rendered, "backupConfirmation", args)' />
                <button type="button" class="button button--secondary configuration-vault__toggle"
                        data-passphrase-toggle="profile-backup-confirmation"
                        aria-controls="profile-backup-confirmation"
                        aria-pressed="@IsPassphraseVisible("backupConfirmation").ToString().ToLowerInvariant()"
                        aria-label="@Format("TogglePassphraseVisibility", Text("ProfileConfirmRecovery"))"
                        @onclick='() => TogglePassphraseVisibility("backupConfirmation")'>@Text(IsPassphraseVisible("backupConfirmation") ? "HidePassphrase" : "ShowPassphrase")</button>
            </div>
        }
        <button type="button" class="button" data-action="profile-save" @onclick="() => SaveAsync(rendered)">@Text("ProfileSave")</button>
    </fieldset>
    @if (Controller.RecoveryReference is { } recovery)
    {
        <fieldset disabled="@(!ready || !consented || busy)" class="configuration-vault__group" data-profile-task="verify-recovery">
            <legend>@Text("ProfileVerifyRecovery")</legend>
            <p id="profile-recovery-help">@Text("ProfileRecoveryHelp")</p>
            <p>@Text("ProfileSnapshot"): <bdi dir="ltr">@recovery.SnapshotId</bdi></p>
            <label for="profile-recovery-file">@Text("ProfileChooseSavedCopy")</label>
            <InputFile id="profile-recovery-file" @key="(Controller.FileKey, 2)" accept=".cfgvault,.json"
                       aria-describedby="profile-recovery-help"
                       OnChange="args => { if (Controller.IsCurrent(rendered) && !Controller.IsBusy && Controller.Consented) _recoveryFile = args.File; }" />
            <label for="profile-recovery-passphrase">@Text("ProfileRecoveryPassphrase")</label>
            <div class="configuration-vault__secret-row">
                <input id="profile-recovery-passphrase" class="form-control" type="@(IsPassphraseVisible("recovery") ? "text" : "password")" autocomplete="off" maxlength="1024"
                       value="@_recoveryPassphrase" @oninput='args => SetCredential(rendered, "recovery", args)' />
                <button type="button" class="button button--secondary configuration-vault__toggle"
                        data-passphrase-toggle="profile-recovery-passphrase"
                        aria-controls="profile-recovery-passphrase"
                        aria-pressed="@IsPassphraseVisible("recovery").ToString().ToLowerInvariant()"
                        aria-label="@Format("TogglePassphraseVisibility", Text("ProfileRecoveryPassphrase"))"
                        @onclick='() => TogglePassphraseVisibility("recovery")'>@Text(IsPassphraseVisible("recovery") ? "HidePassphrase" : "ShowPassphrase")</button>
            </div>
            <label for="profile-recovery-index">@Text("ProfileRecipientIndex")</label>
            <input id="profile-recovery-index" class="form-control" type="number" min="0" max="7" value="@Controller.RecoveryIndex"
                   @onchange="args => Controller.SetRecipientIndex(rendered, args.Value?.ToString(), recovery: true)" />
            <button type="button" class="button" data-action="profile-recover" disabled="@(_recoveryFile is null)"
                    @onclick="() => RecoverAsync(rendered)">@Text("ProfileVerifyRecovery")</button>
        </fieldset>
    }
    @if (busy || form.BrowserProfile is not null)
    {
        <button type="button" class="button button--secondary" data-action="profile-cancel"
                @onclick="() => Controller.Cancel(rendered)">@Text("ProfileClose")</button>
    }
</div>

@code {
    public ElementReference Heading => _heading;
}
