@implements IAsyncDisposable
@using System.Globalization
@using Configurator.Core.Definitions
@using Configurator.Presentation
@using Configurator.Browser.Resources
@using Microsoft.JSInterop
@inject IJSRuntime Javascript

@if (!_disposed && !MountCancellation.IsCancellationRequested)
{
    _renderedStamp = CurrentRenderStamp();
    _hasRendered = true;
    bool allSections = Form.ConfigureLayoutMode == ConfigureLayoutMode.AllSections;
    bool literalRoot = !DefinitionEditingSupport.HasPropertyRoot(Form.Definition);
    var experience = Form.DisplayExperiences.Single(item => item.Id == Form.SelectedExperienceId);
    var projection = Form.Projection;
    var actionForm = Form;
    long inputRevision = Form.InputRevision;
    var actionMount = MountCancellation;
    var (states, sections) = ResolveVisibleSectionsWithStates(Form, Sections);
    string? outputField = Form.Definition.Presentation?.OutputSelector is { } selector
        ? DefinitionProfile.FieldId(selector.Location.Segments[0]) : null;
    string? selected = sections.Any(section => section.Id == SelectedSection)
        ? SelectedSection
        : sections.FirstOrDefault(section => section.Fields.Any(fieldId => fieldId != outputField && states[fieldId].IsActive
              && (experience.Sections.Contains(section.Id) || projection.IsFieldVisible(fieldId))))?.Id
          ?? sections.FirstOrDefault()?.Id;
    string? activeScrollspySection = allSections
        ? (sections.Any(section => section.Id == _scrollspySectionId) ? _scrollspySectionId : selected)
        : null;
    string? railActiveSection = allSections ? activeScrollspySection : selected;
    bool showFormNav = !literalRoot && sections.Length > 1;
    _lastRenderedRailSection = showFormNav ? railActiveSection : null;

    <div @ref="_panelElement" class="configuration-configure-panel @(allSections || sections.Length <= 1 ? "configuration-configure-panel--single" : "")"
         data-navigation="@experience.Navigation" data-layout-active="@(allSections ? "all-sections" : "section-by-section")">
        <div class="configuration-configure-panel__body @(showFormNav ? "configuration-configure-panel__body--with-nav" : "")">
            @if (showFormNav)
            {
                <div @ref="_navContainer" class="configuration-configure-panel__nav">
                    <ConfigurationNavigation Sections="@(sections.Select(section => new ConfigurationSection(section.Id, section.Title, projection.SectionProgress[section.Id], projection.SectionStatuses.GetValueOrDefault(section.Id))).ToArray())"
                                             Selected="@railActiveSection" ActiveSectionId="@railActiveSection"
                                             LayoutMode="@Form.ConfigureLayoutMode"
                                             SelectedChanged="HandleSectionSelectedAsync" Locale="@Form.Locale"
                                             NavigationMode="@experience.Navigation" Navigation="@projection.Navigation" />
                </div>
            }
            <div class="configuration-configure-panel__main">
                <div class="configuration-configure-panel__toolbar" data-layout-switcher role="group"
                     aria-label="@BrowserStrings.Get("ConfigureLayoutLabel", Form.Locale)">
                    <div class="configuration-configure-panel__layout-modes">
                        <button type="button"
                                class="button button--secondary configuration-configure-panel__layout-btn @(!allSections ? "configuration-configure-panel__layout-btn--active" : "")"
                                data-layout-mode="section-by-section"
                                aria-pressed="@((!allSections).ToString().ToLowerInvariant())"
                                @onclick="() => LayoutModeChanged.InvokeAsync(ConfigureLayoutMode.SectionBySection)">
                            @BrowserStrings.Get("LayoutSectionBySection", Form.Locale)
                        </button>
                        <button type="button"
                                class="button button--secondary configuration-configure-panel__layout-btn @(allSections ? "configuration-configure-panel__layout-btn--active" : "")"
                                data-layout-mode="all-sections"
                                aria-pressed="@(allSections.ToString().ToLowerInvariant())"
                                @onclick="() => LayoutModeChanged.InvokeAsync(ConfigureLayoutMode.AllSections)">
                            @BrowserStrings.Get("LayoutAllSections", Form.Locale)
                        </button>
                    </div>
                    @if (allSections && !literalRoot)
                    {
                        <label class="configuration-configure-panel__matches-filter">
                            <input type="checkbox" data-compact-matches-only checked="@CompactShowMatchesOnly"
                                   @onchange="args => CompactShowMatchesOnlyChanged.InvokeAsync(args.Value is true)" />
                            <span>@BrowserStrings.Get("CompactShowMatchesOnly", Form.Locale)</span>
                        </label>
                    }
                </div>

        @if (allSections)
        {
            <div class="configuration-configure-panel__fields">
                @if (literalRoot)
                {
                    <section data-section-panel="root">
                        <ConfigurationSectionFields @key="Form" Form="Form" LiteralRoot="true"
                                                    ContinuousMode="true" MountCancellation="MountCancellation" Validation="Validation"
                                                    FocusField="@FocusField" FocusGeneration="FocusGeneration" FocusPath="FocusPath" />
                    </section>
                }
                else
                {
                    HashSet<string>? matchedIds = CompactShowMatchesOnly ? GetMatchedFieldIds(projection) : null;
                    string? focusSectionId = FocusField is null ? null : sections.FirstOrDefault(section => section.Fields.Contains(FocusField))?.Id;
                    var renderedSections = new List<(DefinitionFormSection Section, FieldState[] VisibleFields)>(sections.Length);
                    foreach (var section in sections)
                    {
                        FieldState[] sectionFields = section.Fields
                            .Where(fieldId => fieldId != outputField && states.TryGetValue(fieldId, out var fs) && fs.IsActive &&
                                              projection.IsFieldVisible(fieldId) &&
                                              (matchedIds is null || matchedIds.Contains(fieldId)))
                            .Select(fieldId => states[fieldId])
                            .ToArray();
                        if (matchedIds is not null && sectionFields.Length == 0) continue;
                        renderedSections.Add((section, sectionFields));
                    }

                    if (CompactShowMatchesOnly && renderedSections.Count == 0)
                    {
                        DiscoveryZeroMatchSummary? zeroSummary = Form.GetDiscoveryZeroMatchSummary();
                        <div class="configuration-configure-panel__empty" role="status" data-empty-matches-state>
                            <p>@BrowserStrings.Get("CompactNoMatches", Form.Locale)</p>
                            @if (zeroSummary is { HasOutOfScopeMatches: true })
                            {
                                <p class="configuration-configure-panel__description">
                                    @string.Format(CultureInfo.GetCultureInfo(Form.Locale), BrowserStrings.Get("ZeroMatchesOutOfScope", Form.Locale), zeroSummary.FilterOrFacetExcludedCount, zeroSummary.HiddenInactiveMatchCount)
                                </p>
                            }
                            <button type="button" class="button button--secondary" data-action="reset-discovery-filters"
                                    @onclick="ResetDiscoveryFiltersAsync">
                                @BrowserStrings.Get("ResetFiltersAction", Form.Locale)
                            </button>
                        </div>
                    }
                    else
                    {
                        string? centerId = renderedSections.Any(entry => entry.Section.Id == _windowCenterSectionId)
                            ? _windowCenterSectionId
                            : (focusSectionId is not null && renderedSections.Any(entry => entry.Section.Id == focusSectionId)
                                ? focusSectionId
                                : (renderedSections.Any(entry => entry.Section.Id == railActiveSection)
                                    ? railActiveSection
                                    : renderedSections.FirstOrDefault().Section?.Id));
                        int centerIndex = centerId is null ? 0 : renderedSections.FindIndex(entry => entry.Section.Id == centerId);

                        <div class="configuration-configure-panel__continuous" data-configuration-continuous>
                            @for (int i = 0; i < renderedSections.Count; i++)
                            {
                                var (section, visibleFields) = renderedSections[i];
                                string headingId = AllSectionsHeadingId(section.Id);
                                var sectionStatus = projection.SectionStatuses.GetValueOrDefault(section.Id);
                                bool sectionReviewed = sectionStatus?.Coverage == SectionReviewCoverage.Reviewed;
                                bool focusHere = FocusField is not null && string.Equals(focusSectionId, section.Id, StringComparison.Ordinal);
                                bool inWindow = Math.Abs(i - centerIndex) <= 1 || focusHere;
                                var sectionProgress = projection.SectionProgress.GetValueOrDefault(section.Id) ?? new(0, 0, 0, 0, 0);
                                bool sectionAllRequired = visibleFields.Length > 0 && visibleFields.All(field => field.IsRequired);
                                string countText = sectionProgress.Required > 0
                                    ? $"{sectionProgress.Ready}/{sectionProgress.Required} {BrowserStrings.Get("Required", Form.Locale)}"
                                    : BrowserStrings.Get("CompactSectionOptionalStatus", Form.Locale);

                                <section @key="section.Id"
                                         id="@(headingId + "-section")"
                                         class="configuration-configure-panel__continuous-section"
                                         data-section-panel="@section.Id"
                                         data-compact-section="@section.Id"
                                         data-section-windowed="@(inWindow ? "hydrated" : "deferred")"
                                         aria-labelledby="@headingId"
                                         aria-describedby="@(string.IsNullOrWhiteSpace(section.Description) ? null : headingId + "-description")">
                                    <header class="configuration-configure-panel__section-header">
                                        <h3 id="@headingId" class="configuration-configure-panel__heading" tabindex="-1"><bdi>@section.Title</bdi></h3>
                                        <div class="configuration-configure-panel__section-actions">
                                            @if (sectionAllRequired)
                                            {
                                                <span class="configuration-configure-panel__all-required" data-section-requirement="all-required">
                                                    @BrowserStrings.Get("SectionAllFieldsRequired", Form.Locale)
                                                </span>
                                            }
                                            <span class="configuration-configure-panel__section-count"
                                                  data-compact-section-count
                                                  aria-label="@countText">@countText</span>
                                            <button type="button" class="button button--secondary configuration-configure-panel__review-toggle"
                                                    data-action="toggle-section-reviewed" data-section-id="@section.Id"
                                                    aria-pressed="@(sectionReviewed ? "true" : "false")"
                                                    @onclick="() => { if (!_disposed && !actionMount.IsCancellationRequested && ReferenceEquals(Form, actionForm)) Form.SetSectionReviewed(section.Id, !sectionReviewed); }">
                                                @BrowserStrings.Get(sectionReviewed ? "SectionReviewedAction" : "MarkSectionReviewedAction", Form.Locale)
                                            </button>
                                        </div>
                                    </header>
                                    @if (!string.IsNullOrWhiteSpace(section.Description))
                                    {
                                        <p id="@(headingId + "-description")" class="configuration-configure-panel__description">@section.Description</p>
                                    }
                                    @if (inWindow)
                                    {
                                        <ConfigurationSectionFields @key="Form"
                                                                    Form="Form"
                                                                    SectionId="@section.Id"
                                                                    Groups="section.Groups"
                                                                    Fields="@visibleFields"
                                                                    ContinuousMode="true"
                                                                    SectionAllRequired="sectionAllRequired"
                                                                    MountCancellation="MountCancellation"
                                                                    Validation="Validation"
                                                                    FocusField="@(focusHere ? FocusField : null)"
                                                                    FocusGeneration="@(focusHere ? FocusGeneration : 0L)"
                                                                    FocusPath="@(focusHere ? FocusPath : Array.Empty<string>())" />
                                    }
                                    else
                                    {
                                        <div class="configuration-configure-panel__window-placeholder" aria-hidden="true"></div>
                                    }
                                </section>
                            }
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <div class="configuration-configure-panel__fields">
                @if (literalRoot)
                {
                    <ConfigurationRoot @ref="_root" Form="Form" Validation="Validation" MountCancellation="MountCancellation"
                                       FocusFirstControl="@(FocusField == string.Empty)" FocusGeneration="FocusGeneration" FocusPath="FocusPath" />
                    <AppButton Variant="Variant.Outlined" OnClick="() => ReviewRequested.InvokeAsync()">@BrowserStrings.Get("ReviewConfiguration", Form.Locale)</AppButton>
                }
                else
                {
                    @foreach (var section in sections.Where(section => section.Id == selected))
                    {
                        var sectionStatus = projection.SectionStatuses.GetValueOrDefault(section.Id);
                        bool sectionReviewed = sectionStatus?.Coverage == SectionReviewCoverage.Reviewed;
                        var visibleFields = section.Fields
                            .Where(fieldId => fieldId != outputField && projection.IsFieldVisible(fieldId))
                            .Select(fieldId => states[fieldId])
                            .ToArray();
                        bool sectionAllRequired = visibleFields.Length > 0 && visibleFields.All(field => field.IsRequired);
                        bool hasHiddenOptional = section.Fields.Any(fieldId => fieldId != outputField && states[fieldId].IsActive && !projection.IsFieldVisible(fieldId));
                        <section @key="section.Id" data-section-panel="@section.Id" aria-labelledby="@SectionId(section.Id)"
                                 aria-describedby="@(string.IsNullOrWhiteSpace(section.Description) ? null : SectionId(section.Id) + "-description")">
                            <header class="configuration-configure-panel__section-header">
                                <h3 @ref="_heading" class="configuration-configure-panel__heading" id="@SectionId(section.Id)" tabindex="-1">@section.Title</h3>
                                <div class="configuration-configure-panel__section-actions">
                                    @if (sectionAllRequired)
                                    {
                                        <span class="configuration-configure-panel__all-required" data-section-requirement="all-required">
                                            @BrowserStrings.Get("SectionAllFieldsRequired", Form.Locale)
                                        </span>
                                    }
                                    <button type="button" class="button button--secondary configuration-configure-panel__review-toggle"
                                            data-action="toggle-section-reviewed" data-section-id="@section.Id"
                                            aria-pressed="@(sectionReviewed ? "true" : "false")"
                                            @onclick="() => { if (!_disposed && !actionMount.IsCancellationRequested && ReferenceEquals(Form, actionForm)) Form.SetSectionReviewed(section.Id, !sectionReviewed); }">
                                        @BrowserStrings.Get(sectionReviewed ? "SectionReviewedAction" : "MarkSectionReviewedAction", Form.Locale)
                                    </button>
                                </div>
                            </header>
                            @if (!string.IsNullOrWhiteSpace(section.Description))
                            {
                                <p id="@(SectionId(section.Id) + "-description")" class="configuration-configure-panel__description">@section.Description</p>
                            }
                            @if (visibleFields.Length > 0)
                            {
                                <ConfigurationSectionFields @key="Form" Form="Form" SectionId="@section.Id" Groups="section.Groups"
                                                            Fields="visibleFields" ContinuousMode="false" SectionAllRequired="sectionAllRequired"
                                                            MountCancellation="MountCancellation" Validation="Validation"
                                                            FocusField="@FocusField" FocusGeneration="FocusGeneration" FocusPath="FocusPath" />
                                @if (hasHiddenOptional)
                                {
                                    <AppButton Variant="Variant.Outlined" data-action="show-section-options"
                                               OnClick="() => { if (!_disposed && !actionMount.IsCancellationRequested && ReferenceEquals(Form, actionForm) && Form.InputRevision == inputRevision) Form.SetSectionExpanded(section.Id, true); }">@BrowserStrings.Get("ShowOptionalSettings", Form.Locale)</AppButton>
                                }
                            }
                            else if (sectionStatus?.ConfigurationStatus == SectionConfigurationStatus.OutsideSelectedScope)
                            {
                                <div class="configuration-configure-panel__empty" role="status" data-empty-section-state="outside-scope">
                                    <p>@BrowserStrings.Get("EmptySectionOutsideScope", Form.Locale)</p>
                                </div>
                            }
                            else if (hasHiddenOptional)
                            {
                                <div class="configuration-configure-panel__empty" role="status" data-empty-section-state="hidden-optional">
                                    <p>@BrowserStrings.Get("EmptySectionHiddenOptional", Form.Locale)</p>
                                    <AppButton Variant="Variant.Outlined" data-action="show-section-options"
                                               OnClick="() => { if (!_disposed && !actionMount.IsCancellationRequested && ReferenceEquals(Form, actionForm) && Form.InputRevision == inputRevision) Form.SetSectionExpanded(section.Id, true); }">@BrowserStrings.Get("ShowOptionalSettings", Form.Locale)</AppButton>
                                </div>
                            }
                            else
                            {
                                <div class="configuration-configure-panel__empty" role="status" data-empty-section-state="no-fields">
                                    <p>@BrowserStrings.Get("EmptySectionNoFields", Form.Locale)</p>
                                </div>
                            }
                        </section>
                    }
                }
                @if (!literalRoot && sections.Length > 0)
                {
                    int index = Array.FindIndex(sections, section => section.Id == selected);
                    <div class="actions configuration-configure-panel__actions">
                        @if (index > 0)
                        {
                            <AppButton Variant="Variant.Outlined" data-action="previous-section" OnClick="() => SelectedChanged.InvokeAsync(sections[index - 1].Id)">@BrowserStrings.Get("PreviousSection", Form.Locale)</AppButton>
                        }
                        @if (index < sections.Length - 1)
                        {
                            <AppButton Variant="Variant.Outlined" data-action="next-section" OnClick="() => SelectedChanged.InvokeAsync(sections[index + 1].Id)">@BrowserStrings.Get("NextSection", Form.Locale)</AppButton>
                        }
                        else
                        {
                            <AppButton Variant="Variant.Outlined" OnClick="() => ReviewRequested.InvokeAsync()">@BrowserStrings.Get("ReviewConfiguration", Form.Locale)</AppButton>
                        }
                    </div>
                }
                </div>
        }
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public DefinitionFormModel Form { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<DefinitionFormSection> Sections { get; set; } = [];
    [Parameter] public string? SelectedSection { get; set; }
    [Parameter] public EventCallback<string> SelectedChanged { get; set; }
    [Parameter] public DefinitionValidationResult? Validation { get; set; }
    [Parameter] public CancellationToken MountCancellation { get; set; }
    [Parameter] public string? FocusField { get; set; }
    [Parameter] public long FocusGeneration { get; set; }
    [Parameter] public IReadOnlyList<string> FocusPath { get; set; } = [];
    [Parameter] public EventCallback ReviewRequested { get; set; }
    [Parameter] public EventCallback RequestSecretConsent { get; set; }
    [Parameter] public EventCallback<ConfigureLayoutMode> LayoutModeChanged { get; set; }
    [Parameter] public bool CompactShowMatchesOnly { get; set; }
    [Parameter] public EventCallback<bool> CompactShowMatchesOnlyChanged { get; set; }
    private ElementReference _heading;
    private ElementReference _panelElement;
    private ElementReference _navContainer;
    private ConfigurationRoot? _root;
    private Task<IJSObjectReference>? _scrollspyModule;
    private DotNetObjectReference<ConfigurationConfigurePanel>? _scrollspyRef;
    private string? _scrollspySectionId;
    private string? _windowCenterSectionId;
    private string? _lastRenderedRailSection;
    private string? _lastSyncedNavSectionId;
    private bool _headerObserved;
    private long _scrollspyGeneration;
    private bool _scrollspyActive;
    private DefinitionFormProjection? _cachedMatchProjection;
    private HashSet<string>? _cachedMatchedFieldIds;
    private bool _disposed;
    private bool _hasRendered;
    private RenderStamp _renderedStamp;

    internal string? ActiveScrollspySectionId => _scrollspySectionId;

    internal static DefinitionFormSection[] ResolveVisibleSections(
        DefinitionFormModel form,
        IReadOnlyList<DefinitionFormSection> sections) =>
        ResolveVisibleSectionsWithStates(form, sections).Sections;

    private static (Dictionary<string, FieldState> States, DefinitionFormSection[] Sections) ResolveVisibleSectionsWithStates(
        DefinitionFormModel form,
        IReadOnlyList<DefinitionFormSection> sections)
    {
        ArgumentNullException.ThrowIfNull(form);
        ArgumentNullException.ThrowIfNull(sections);

        bool allSections = form.ConfigureLayoutMode == ConfigureLayoutMode.AllSections;
        DefinitionFormExperience experience = form.DisplayExperiences.Single(item => item.Id == form.SelectedExperienceId);
        DefinitionFormProjection projection = form.Projection;
        Dictionary<string, FieldState> states = form.Validate().Fields.ToDictionary(state => state.Id, StringComparer.Ordinal);
        string? outputField = form.Definition.Presentation?.OutputSelector is { } selector
            ? DefinitionProfile.FieldId(selector.Location.Segments[0])
            : null;

        DefinitionFormSection[] visible = sections.Where(section =>
            allSections
                ? section.IsApplicable &&
                  projection.SectionStatuses.GetValueOrDefault(section.Id)?.ConfigurationStatus != SectionConfigurationStatus.OutsideSelectedScope &&
                  section.Fields.Any(fieldId => fieldId != outputField && states[fieldId].IsActive && projection.IsFieldVisible(fieldId))
                : (experience.Sections.Contains(section.Id)
                  || section.Fields.Any(fieldId => fieldId != outputField && states[fieldId].IsActive && projection.IsFieldVisible(fieldId))))
            .ToArray();

        return (states, visible);
    }

    private readonly record struct RenderStamp(
        bool Disposed,
        bool Cancelled,
        CancellationToken MountCancellation,
        DefinitionFormModel Form,
        DefinitionFormProjection Projection,
        IReadOnlyList<DefinitionFormSection> ProjectionSections,
        DefinitionDiscoverySelection? CompactDiscoverySelection,
        long InputRevision,
        string Locale,
        ConfigureLayoutMode LayoutMode,
        WorkspaceDensity Density,
        WorkspaceNamingMode NamingMode,
        string SelectedExperienceId,
        FieldDisclosure? DisclosureOverride,
        string? SelectedSection,
        string? ScrollspySectionId,
        string? WindowCenterSectionId,
        DefinitionValidationResult? Validation,
        string? FocusField,
        long FocusGeneration,
        string? FocusPathKey,
        bool CompactShowMatchesOnly);

    private RenderStamp CurrentRenderStamp()
    {
        bool allSections = Form.ConfigureLayoutMode == ConfigureLayoutMode.AllSections;
        DefinitionFormProjection projection = Form.Projection;
        bool hasFocus = FocusField is not null;
        return new RenderStamp(
            _disposed,
            MountCancellation.IsCancellationRequested,
            MountCancellation,
            Form,
            projection,
            projection.Sections,
            allSections && CompactShowMatchesOnly ? Form.DiscoverySelection : null,
            Form.InputRevision,
            Form.Locale,
            Form.ConfigureLayoutMode,
            Form.WorkspaceDensity,
            Form.WorkspaceNamingMode,
            Form.SelectedExperienceId,
            Form.DisclosureOverride,
            allSections ? null : SelectedSection,
            allSections ? _scrollspySectionId : null,
            allSections ? _windowCenterSectionId : null,
            Validation,
            FocusField,
            hasFocus ? FocusGeneration : 0L,
            hasFocus && FocusPath.Count > 0 ? string.Join('\0', FocusPath) : null,
            CompactShowMatchesOnly);
    }

    private HashSet<string> GetMatchedFieldIds(DefinitionFormProjection projection)
    {
        if (!ReferenceEquals(_cachedMatchProjection, projection) || _cachedMatchedFieldIds is null)
        {
            _cachedMatchProjection = projection;
            _cachedMatchedFieldIds = projection.Matches
                .Select(match => match.Entry.FieldId)
                .ToHashSet(StringComparer.Ordinal);
        }
        return _cachedMatchedFieldIds;
    }

    private async Task ResetDiscoveryFiltersAsync()
    {
        if (_disposed || MountCancellation.IsCancellationRequested) return;
        await CompactShowMatchesOnlyChanged.InvokeAsync(false);
        Form.SetDiscovery(string.Empty);
    }

    protected override bool ShouldRender() => !_hasRendered || !_renderedStamp.Equals(CurrentRenderStamp());

    protected override void OnParametersSet()
    {
        if (DefinitionEditingSupport.HasPropertyRoot(Form.Definition)) _root = null;
        if (Form.ConfigureLayoutMode != ConfigureLayoutMode.AllSections)
        {
            _scrollspySectionId = null;
            _windowCenterSectionId = null;
        }
        else
        {
            if (_scrollspySectionId is null && SelectedSection is not null)
                _scrollspySectionId = SelectedSection;
            if (_windowCenterSectionId is null)
                _windowCenterSectionId = SelectedSection ?? Sections.FirstOrDefault()?.Id;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || MountCancellation.IsCancellationRequested) return;

        if (!_headerObserved && !string.IsNullOrEmpty(_panelElement.Id))
            await EnsureHeaderObservedAsync();

        bool wantScrollspy = Form.ConfigureLayoutMode == ConfigureLayoutMode.AllSections;
        if (!wantScrollspy && _scrollspyActive)
        {
            await DetachScrollspyAsync();
        }
        else if (wantScrollspy && !_scrollspyActive)
        {
            await AttachScrollspyAsync();
        }

        if (!string.IsNullOrEmpty(_navContainer.Id)
            && !string.Equals(_lastSyncedNavSectionId, _lastRenderedRailSection, StringComparison.Ordinal))
        {
            _lastSyncedNavSectionId = _lastRenderedRailSection;
            await SyncActiveNavScrollAsync();
        }
    }

    private async Task EnsureHeaderObservedAsync()
    {
        if (_disposed || MountCancellation.IsCancellationRequested || string.IsNullOrEmpty(_panelElement.Id))
            return;

        _headerObserved = true;
        try
        {
            _scrollspyModule ??= Javascript.InvokeAsync<IJSObjectReference>("import", "./js/configuration-rendering.js").AsTask();
            IJSObjectReference module = await _scrollspyModule.WaitAsync(MountCancellation);
            if (_disposed || MountCancellation.IsCancellationRequested) return;
            await module.InvokeVoidAsync("observeHeaderHeight", _panelElement).AsTask().WaitAsync(MountCancellation);
        }
        catch (Exception ex) when (ex is OperationCanceledException or JSException or InvalidOperationException)
        {
            // Ignore disconnected interop or non-layout test module boundaries.
        }
    }

    private async Task SyncActiveNavScrollAsync()
    {
        if (_disposed || MountCancellation.IsCancellationRequested || string.IsNullOrEmpty(_navContainer.Id))
            return;

        try
        {
            _scrollspyModule ??= Javascript.InvokeAsync<IJSObjectReference>("import", "./js/configuration-rendering.js").AsTask();
            IJSObjectReference module = await _scrollspyModule.WaitAsync(MountCancellation);
            if (_disposed || MountCancellation.IsCancellationRequested || string.IsNullOrEmpty(_navContainer.Id)) return;
            await module.InvokeVoidAsync("syncActiveNavScroll", _navContainer).AsTask().WaitAsync(MountCancellation);
        }
        catch (Exception ex) when (ex is OperationCanceledException or JSException or InvalidOperationException)
        {
            // Ignore disconnected interop or non-layout test module boundaries.
        }
    }

    private async Task AttachScrollspyAsync()
    {
        if (_disposed || MountCancellation.IsCancellationRequested || string.IsNullOrEmpty(_panelElement.Id)) return;
        _scrollspyActive = true;
        long generation = ++_scrollspyGeneration;
        _scrollspyRef ??= DotNetObjectReference.Create(this);
        try
        {
            _scrollspyModule ??= Javascript.InvokeAsync<IJSObjectReference>("import", "./js/configuration-rendering.js").AsTask();
            IJSObjectReference module = await _scrollspyModule.WaitAsync(MountCancellation);
            if (_disposed || MountCancellation.IsCancellationRequested || generation != _scrollspyGeneration ||
                Form.ConfigureLayoutMode != ConfigureLayoutMode.AllSections) return;
            await module.InvokeVoidAsync("observeScrollspy", _panelElement, _scrollspyRef, generation);
        }
        catch (Exception ex) when (ex is OperationCanceledException or JSException or InvalidOperationException)
        {
        }
    }

    private async Task DetachScrollspyAsync()
    {
        _scrollspyActive = false;
        ++_scrollspyGeneration;
        if (_scrollspyModule is { IsCompletedSuccessfully: true } && !string.IsNullOrEmpty(_panelElement.Id))
        {
            try
            {
                IJSObjectReference module = await _scrollspyModule;
                await module.InvokeVoidAsync("unobserveScrollspy", _panelElement);
            }
            catch (Exception ex) when (ex is JSException or InvalidOperationException)
            {
            }
        }
    }

    private async Task HandleSectionSelectedAsync(string sectionId)
    {
        if (Form.ConfigureLayoutMode == ConfigureLayoutMode.AllSections)
        {
            _scrollspySectionId = sectionId;
            _windowCenterSectionId = sectionId;
        }
        await SelectedChanged.InvokeAsync(sectionId);
    }

    public ElementReference? SectionHeading => _disposed ? null : _root?.Heading ?? _heading;
    public bool IsCompactSettled => _hasRendered;
    public async Task JumpToCompactSectionAsync(string sectionId)
    {
        if (_disposed) return;
        _scrollspySectionId = sectionId;
        _windowCenterSectionId = sectionId;
        StateHasChanged();
        try
        {
            _scrollspyModule ??= Javascript.InvokeAsync<IJSObjectReference>("import", "./js/configuration-rendering.js").AsTask();
            IJSObjectReference module = await _scrollspyModule.WaitAsync(MountCancellation);
            if (!_disposed && !MountCancellation.IsCancellationRequested && !string.IsNullOrEmpty(_panelElement.Id))
                await module.InvokeVoidAsync("revealHeading", _panelElement, AllSectionsHeadingId(sectionId)).AsTask().WaitAsync(MountCancellation);
        }
        catch (Exception ex) when (ex is OperationCanceledException or JSException)
        {
        }
    }

    [JSInvokable]
    public Task OnScrollspySectionChangedAsync(string sectionId)
    {
        if (_disposed || MountCancellation.IsCancellationRequested ||
            Form.ConfigureLayoutMode != ConfigureLayoutMode.AllSections ||
            !Sections.Any(section => string.Equals(section.Id, sectionId, StringComparison.Ordinal)))
            return Task.CompletedTask;
        if (!string.Equals(_scrollspySectionId, sectionId, StringComparison.Ordinal) ||
            !string.Equals(_windowCenterSectionId, sectionId, StringComparison.Ordinal))
        {
            _scrollspySectionId = sectionId;
            _windowCenterSectionId = sectionId;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    private string SectionId(string id) => "configuration-section-" + Array.FindIndex(Sections.ToArray(), section => section.Id == id);
    private string AllSectionsHeadingId(string id) => "configuration-continuous-section-" + Array.FindIndex(Sections.ToArray(), section => section.Id == id);

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        await DetachScrollspyAsync();
        if (_headerObserved && _scrollspyModule is { IsCompletedSuccessfully: true } && !string.IsNullOrEmpty(_panelElement.Id))
        {
            try
            {
                IJSObjectReference module = await _scrollspyModule;
                await module.InvokeVoidAsync("unobserveHeaderHeight", _panelElement);
            }
            catch (Exception ex) when (ex is JSException or InvalidOperationException)
            {
            }
        }
        _headerObserved = false;
        _scrollspyRef?.Dispose();
        _scrollspyRef = null;
        if (_scrollspyModule is { IsCompletedSuccessfully: true })
        {
            try
            {
                IJSObjectReference module = await _scrollspyModule;
                await module.DisposeAsync();
            }
            catch (JSException)
            {
            }
        }
        _scrollspyModule = null;
        _heading = default;
        _panelElement = default;
        _navContainer = default;
    }
}
