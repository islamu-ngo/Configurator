@implements IAsyncDisposable
@using Configurator.Presentation

<section class="workspace configuration-editor" aria-labelledby="configuration-heading" data-experience="@_form!.SelectedExperienceId">
    <header class="configuration-editor__header">
        <h2 @ref="_configureHeading" id="configuration-heading" tabindex="-1">Configuration answers</h2>
        <p id="session-boundary">Answers stay in this tab. Preparation does not change your target.</p>
        <p class="form-help" data-declared-outputs>Declared files: @string.Join(", ", Definition.Artifacts.Select(artifact => artifact.FileName)). Inclusion depends on the definition's conditions; target validation remains separate.</p>
    </header>
    <details class="configuration-editor__boundary">
        <summary>Privacy and export limits</summary>
        <p>Preparation does not apply configuration or establish target acceptance. Copy and download deliberately release private output.
            The browser cannot guarantee restricted file permissions. Closing or reloading discards this workspace;
            clearing cannot erase files or clipboard contents already exported.</p>
    </details>
    @if (!_ready)
    {
        <button @ref="_startButton" class="button" type="button" @onclick="BeginAsync">Start local workspace</button>
    }
    <fieldset class="configuration-editor__controls" disabled="@(!_ready)">
        <legend class="sr-only">Local configuration answers</legend>
        @{ var projection = _form.Projection; var progress = projection.Progress; }
        <nav class="configuration-editor__workflow" aria-label="Configuration workflow">
            <ol>
                <li><button type="button" data-workflow-step="configure" aria-current="@(_activeWorkflowStage == "configure" ? "step" : null)" @onclick='() => SelectWorkflowStage("configure")'><span aria-hidden="true">1</span> Configure</button></li>
                <li><button type="button" data-workflow-step="review" aria-current="@(_activeWorkflowStage == "review" ? "step" : null)" @onclick='() => SelectWorkflowStage("review")'><span aria-hidden="true">2</span> Review</button></li>
                <li><button type="button" data-workflow-step="prepare" aria-current="@(_activeWorkflowStage == "prepare" ? "step" : null)" @onclick='() => SelectWorkflowStage("prepare")'><span aria-hidden="true">3</span> Prepare</button></li>
            </ol>
        </nav>
        <div class="configuration-editor__progress" aria-live="polite" aria-atomic="true"
             data-required-count="@progress.Required" data-ready-count="@progress.Ready">
            @if (progress.Required == 0)
            {
                <strong>No required answers</strong>
            }
            else
            {
                <strong>@progress.Ready of @progress.Required required answers ready</strong>
                <progress value="@progress.Ready" max="@progress.Required" aria-label="Required answers ready"></progress>
            }
            <span>@progress.Missing missing · @progress.Invalid invalid · @progress.Deferred @(progress.Deferred == 1 ? "secret" : "secrets") awaiting entry</span>
        </div>
        <div class="configuration-editor__toolbar">
            @if (_form.Experiences.Count > 1)
            {
                <div class="configuration-editor__mode">
                    <label for="configuration-experience">Configuration experience</label>
                    <select id="configuration-experience" value="@_form.SelectedExperienceId" @onchange="ChangeExperience">
                        @foreach (var experience in _form.Experiences)
                        {
                            <option value="@experience.Id">@experience.Title</option>
                        }
                    </select>
                </div>
            }
            <div class="configuration-editor__disclosure">
                <button type="button" class="button button--secondary" data-action="expand-all-optional"
                        aria-expanded="@_form.OptionalEditorsExpanded.ToString().ToLowerInvariant()"
                        @onclick="() => _form.SetAllSectionsExpanded(!_form.OptionalEditorsExpanded)">
                    @(_form.OptionalEditorsExpanded ? "Restore initial disclosure" : "Show optional settings")
                </button>
            </div>
            <div class="configuration-editor__consent">
                <input @ref="_consentControl" id="secret-consent" type="checkbox" checked="@(_form.SessionPrivacy == DefinitionSessionPrivacy.BrowserSecretsEnabled)"
                       aria-describedby="session-boundary secret-consent-help" @onchange="ConsentAsync" />
                <div>
                    <label for="secret-consent">Enable secret entry for this workspace</label>
                    <p id="secret-consent-help" class="form-help">Optional. Values remain masked; turning this off clears secret answers and prepared files.</p>
                </div>
            </div>
        </div>
        @if (ImportableArtifacts.Length > 0)
        {
            <details class="configuration-editor__import">
                <summary>Start from an existing configuration <span class="configuration-editor__optional">Optional</span></summary>
                <p class="form-help" id="artifact-import-help">Maximum 1 MiB. Supported direct mappings only. Import replaces untouched defaults; conflicting manual answers reject the whole file. Secret values require workspace consent above.</p>
                <div class="configuration-editor__import-controls">
                    <div class="form-group">
                        <label for="import-artifact">Artifact format to import</label>
                        <select id="import-artifact" value="@_importArtifact" @onchange="ChangeImportFormat">
                            @foreach (var artifact in ImportableArtifacts) { <option value="@artifact.Id">@artifact.FileName</option> }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="artifact-import">Choose an existing declared artifact</label>
                        <InputFile @key="_fileKey" id="artifact-import" @ref="_fileInput" OnChange="ImportAsync" aria-describedby="session-boundary artifact-import-help" />
                    </div>
                </div>
                @if (_importDiagnostic is { } importDiagnostic)
                {
                    <p>The rejected file has not changed your answers. Review the affected setting or consent, then choose the corrected file again.</p>
                    <AppButton Variant="Variant.Outlined" data-import-correction="@importDiagnostic.FieldId"
                               OnClick="() => CorrectImportField(importDiagnostic)">@ImportCorrectionLabel(importDiagnostic)</AppButton>
                }
            </details>
        }
        <ConfigurationDiscovery Form="_form" Navigate="CorrectField" />
        @{ var fieldStates = _form.Validate().Fields; var editorSections = EditorSections();
            var sections = editorSections.Where(section => section.Fields.Any(input =>
                fieldStates.Any(state => state.Id == input.Definition.Id && state.IsActive) &&
                (SelectedExperience.Sections.Contains(section.Id) || EditorVisible(input)))).ToArray(); }
        <div class="@("configuration-editor__guided" + (sections.Length == 1 ? " configuration-editor__guided--single" : ""))" data-navigation="@SelectedExperience.Navigation">
            @if (sections.Length > 1)
            {
                <ConfigurationNavigation Sections="@(sections.Select(section => new ConfigurationSection(section.Id, section.Title, projection.SectionProgress[section.Id])).ToArray())"
                                         Selected="SelectedSection(sections)" SelectedChanged="SelectSection" />
            }
            <div class="configuration-editor__fields">
                @foreach (var section in sections.Where(item => item.Id == SelectedSection(sections)))
                {
                    <section @key="section.Id" data-section-panel="@section.Id" aria-labelledby="@SectionId(section.Id)">
                        <h3 @ref="_sectionHeading" id="@SectionId(section.Id)" tabindex="-1">@section.Title</h3>
                        @foreach (var input in section.Fields.Where(input => fieldStates.Any(state => state.Id == input.Definition.Id && state.IsActive)))
                        {
                            var state = fieldStates.Single(item => item.Id == input.Definition.Id);
                            <ConfigurationField @key="input" Form="_form" Schema="input.Definition.Constraints" Path="@(new[] { input.Definition.Id })"
                                                Validation="_validation" RequiredOverride="state.IsRequired"
                                                FocusFirstControl="@(_focusField == input.Definition.Id)" FocusGeneration="_focusGeneration"
                                                FocusPath="@(_focusField == input.Definition.Id ? _focusPath : Array.Empty<string>())" />
                        }
                    </section>
                }
                @if (SelectedExperience.Navigation == "guided" && sections.Length > 1)
                {
                    int sectionIndex = Array.FindIndex(sections, item => item.Id == SelectedSection(sections));
                    <div class="actions configuration-editor__section-actions">
                        @if (sectionIndex > 0)
                        {
                            <AppButton Variant="Variant.Outlined" data-action="previous-section" OnClick="() => SelectSection(sections[sectionIndex - 1].Id)">Previous section</AppButton>
                        }
                        @if (sectionIndex < sections.Length - 1)
                        {
                            <AppButton Variant="Variant.Outlined" data-action="next-section" OnClick="() => SelectSection(sections[sectionIndex + 1].Id)">Next section</AppButton>
                        }
                        else
                        {
                            <AppButton Variant="Variant.Outlined" OnClick='() => SelectWorkflowStage("review")'>Review configuration</AppButton>
                        }
                    </div>
                }
            </div>
        </div>
        @if (_returnToReview)
        {
            <AppButton Variant="Variant.Outlined" data-action="return-to-review" OnClick="ReturnToReview">Return to review</AppButton>
        }
        <section class="configuration-editor__review-stage" aria-labelledby="configuration-review-stage-heading">
            <h3 @ref="_reviewHeading" id="configuration-review-stage-heading" tabindex="-1">Review configuration</h3>
            <p class="form-help">Check required answers and optional changes before preparing files. Preparation does not apply them to your target.</p>
            <ConfigurationReview Definition="Definition" Form="_form" ShowEffects="@(_activeWorkflowStage == "review")"
                                 ChangeField="ChangeReviewField" Validation="_validation" DiagnosticCodes="_diagnostics"
                                 InvalidFields="_form.InputDiagnostics"
                                 SecretsEnabled="@(_form.SessionPrivacy == DefinitionSessionPrivacy.BrowserSecretsEnabled)"
                                 CorrectField="CorrectField" EnableSecrets="EnableSecretsAsync" PrepareDraft="() => PrepareAsync(true)" />
        </section>
        <div class="configuration-editor__preparation">
            <h3 @ref="_prepareHeading" id="configuration-prepare-heading" tabindex="-1">Prepare your files</h3>
            <p class="form-help">A draft defers missing secrets for local completion. Complete preparation checks all required settings.</p>
            <div class="actions">
                <AppButton id="prepare-complete" OnClick="() => PrepareAsync(false)">Prepare complete configuration</AppButton>
                <AppButton id="prepare-draft" Variant="Variant.Outlined" OnClick="() => PrepareAsync(true)">Prepare draft (defer missing secrets)</AppButton>
                <AppButton id="clear-workspace" Variant="Variant.Text" Color="Color.Default" OnClick="ClearAsync">Clear answers and output</AppButton>
            </div>
        </div>
        <p role="status" class="notice" data-code="@_statusCode">@_status</p>
        @foreach (var prepared in _prepared)
        {
            <section class="configuration-editor__artifact" aria-labelledby="@("artifact-" + prepared.Metadata.ArtifactId)" data-readiness="@(prepared.Metadata.IsDraft ? "draft" : "complete")">
                <h3 id="@("artifact-" + prepared.Metadata.ArtifactId)">@prepared.Metadata.FileName</h3>
                <p>@(prepared.Metadata.IsDraft ? "Draft — secrets still required." : "Complete preparation — target validation still required.") Output is private and hidden.</p>
                @if (prepared.Metadata.Completions.Count > 0)
                {
                    <ul>@foreach (var item in prepared.Metadata.Completions) { <li>@item.FieldPath → @item.OutputPath</li> }</ul>
                }
                <div class="actions">
                    <AppButton Variant="Variant.Outlined" OnClick="() => CopyAsync(prepared)">Copy @prepared.Metadata.FileName</AppButton>
                    <AppButton OnClick="() => DownloadAsync(prepared)">Download @prepared.Metadata.FileName</AppButton>
                    <AppButton Variant="Variant.Outlined" aria-expanded="@prepared.Revealed.ToString().ToLowerInvariant()" OnClick="() => RevealAsync(prepared)">@(prepared.Revealed ? "Hide" : "Reveal") @prepared.Metadata.FileName</AppButton>
                </div>
                <pre @ref="prepared.PreviewElement" hidden="@(!prepared.Revealed)" dir="ltr" tabindex="0" aria-label="@("Private preview of " + prepared.Metadata.FileName)"></pre>
            </section>
        }
    </fieldset>
</section>
