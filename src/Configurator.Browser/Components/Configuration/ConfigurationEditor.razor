@implements IAsyncDisposable
@using Configurator.Browser.Components.Docking
@using Configurator.Browser.Services.Docking
@using Configurator.Core.Definitions
@using Configurator.Presentation

@if (_form is null)
{
    StartupRequest actionStartup = _startup!;
    <MudRTLProvider RightToLeft="@(DisplayDirection == "rtl")">
        <section @key="_startup" @ref="_startupControl" class="workspace configuration-editor"
                 aria-labelledby="configuration-heading" aria-busy="true"
                 lang="@_startup!.Locale" dir="@DisplayDirection"
                 data-startup-generation="@_startup.View.ToString(System.Globalization.CultureInfo.InvariantCulture)">
            <h2 class="sr-only" id="configuration-heading">@BrowserStrings.Get("WorkspaceTitle", _startup.Locale)</h2>
            <WorkspaceStartupGate @ref="_startupGate" Locale="@_startup.Locale" Stage="@StartupStage"
                                  Title="@Definition.Title" StatusCode="workspace-starting"
                                  IsOffline="Offline.IsOffline" OfflineReady="Offline.OfflineReady"
                                  CancelRequested="() => IsCurrentStartup(actionStartup) ? CancelStartupAsync() : Task.CompletedTask" />
            @if (SourceDetails is not null)
            {
                <div class="configuration-editor__startup-source" hidden aria-hidden="true">@SourceDetails</div>
            }
        </section>
    </MudRTLProvider>
}
else
{
    DefinitionFormModel actionForm = _form; long actionView = _viewGeneration;
    _renderedConfigureForm = actionForm; _renderedConfigureView = actionView;
    DefinitionTransitionTransferPlan? actionReview = _transferReview;
    string densityToken = AppearanceState.FromWorkspaceDensity(Density);
<MudRTLProvider RightToLeft="@(DisplayDirection == "rtl")">
<section @key="_form" class="workspace configuration-editor configuration-editor--@densityToken" aria-labelledby="configuration-heading"
         lang="@_form!.Locale" dir="@DisplayDirection"
         data-workspace-phase="@(_ready ? "ready" : null)"
         data-experience="@_form!.SelectedExperienceId" data-density="@densityToken"
         data-naming-mode="@AppearanceState.FromWorkspaceNamingMode(NamingMode)"
         @onkeydown="args => IsCurrentView(actionForm, actionView) ? HandleWorkspaceKeyAsync(args) : Task.CompletedTask">
    <header class="configuration-editor__header">
        <h2 class="sr-only" id="configuration-heading">@UiText("WorkspaceTitle")</h2>
        <p class="sr-only" id="session-boundary">@UiText("AnswersStayLocal")</p>
    </header>
    @if (!_ready)
    {
        <WorkspaceStartupGate @ref="_startupGate" Locale="@_form.Locale" Stage="@StartupStage"
                              Title="@_form.Definition.Title"
                              StatusMessage="@UiFormat(_statusKey, _statusArguments)"
                              StatusCode="@_statusCode"
                              IsOffline="Offline.IsOffline" OfflineReady="Offline.OfflineReady"
                              StartRequested="() => IsCurrentView(actionForm, actionView) ? BeginAsync() : Task.CompletedTask"
                              CancelRequested="() => IsCurrentView(actionForm, actionView) ? CancelStartupAsync() : Task.CompletedTask" />
        @if (SourceDetails is not null)
        {
            <div class="configuration-editor__startup-source" hidden aria-hidden="true">@SourceDetails</div>
        }
    }
    else
    {
    <CascadingValue Name="SuggestionReviewRequested" Value="_suggestionReviewCallback" IsFixed="true">
    <fieldset class="configuration-editor__controls">
        <legend class="sr-only">@UiText("ConfigurationAnswers")</legend>
        @{ var projection = _form.Projection; var progress = projection.Progress; var viewSections = EditorSections();
            string? currentSectionId = SelectedSection(viewSections);
            var summary = projection.ProgressSummary;
            string readyState = !summary.IsReadyForExport
                ? (summary.MissingRequired == 0 && summary.DeferredSecretCount == 0 && summary.OptionalInvalidCount > 0 ? "issues"
                    : summary.MissingRequired == 0 && summary.DeferredSecretCount > 0 ? "deferred" : "incomplete")
                : progress.Required == 0 ? "none" : "complete";
            int totalAttention = summary.MissingRequired + summary.TotalInvalidCount;
            bool secretsUnlocked = actionForm.SessionPrivacy == DefinitionSessionPrivacy.BrowserSecretsEnabled; }
        <WorkspaceHeader @ref="_workspaceHeader"
                         Form="_form"
                         Locale="@_form.Locale"
                         ActiveStage="@ActiveHeaderStage"
                         DeveloperMode="@_developerMode"
                         AdvancedOpen="@_advancedOptionsOpen"
                         ActiveAdvancedCount="@ActiveAdvancedOptionsCount"
                         OnToggleAdvanced="() => { if (IsCurrentView(actionForm, actionView)) ToggleAdvancedOptions(); }"
                         StageSelected="stage => IsCurrentView(actionForm, actionView) ? RequestWorkflowStageAsync(stage) : Task.CompletedTask">
            <StatusContent>
                <div class="configuration-editor__progress configuration-editor__progress--@readyState" aria-live="polite" aria-atomic="true"
                     data-required-count="@progress.Required" data-ready-count="@progress.Ready" data-ready-state="@readyState">
                    @if (summary.MissingRequired == 0 && summary.DeferredSecretCount == 0 && summary.OptionalInvalidCount > 0)
                    {
                        <strong>@progress.Ready / @progress.Required · @UiFormat(summary.OptionalInvalidCount == 1 ? "RequiredReadyOptionalIssue" : "RequiredReadyOptionalIssues", summary.OptionalInvalidCount)</strong>
                        @if (progress.Required > 0)
                        {
                            <progress value="@Math.Max(0, progress.Required - summary.OptionalInvalidCount)" max="@progress.Required" aria-label="@UiText("RequiredAnswersProgress")"></progress>
                        }
                    }
                    else if (progress.Required == 0)
                    {
                        <strong>@UiText("NoRequiredAnswers")</strong>
                    }
                    else
                    {
                        <strong aria-hidden="true" dir="ltr">@progress.Ready / @progress.Required</strong>
                        <span class="sr-only">@UiFormat(progress.Required == 1 ? "RequiredAnswerReady" : "RequiredAnswersReady", progress.Ready, progress.Required)</span>
                        <progress value="@progress.Ready" max="@progress.Required" aria-label="@UiText("RequiredAnswersProgress")"></progress>
                    }
                    @if (totalAttention > 0)
                    {
                        <button type="button" class="button button--secondary" data-action="review-required-work"
                                @onclick="() => IsCurrentView(actionForm, actionView) ? FocusNextRequiredWorkAsync() : Task.CompletedTask">@UiText("NeedsAttention"): @totalAttention</button>
                    }
                </div>
                @if (secretsUnlocked)
                {
                    <span class="configuration-editor__secrets-pill" data-workspace-secrets-unlocked>
                        <MudIcon Icon="@Icons.Material.Outlined.LockOpen" Size="Size.Small" aria-hidden="true" />
                        <span>@UiText("SecretsEnabledChip")</span>
                    </span>
                }
                <div class="configuration-editor__status @(_statusCode == "workspace-ready" && StatusRecovery is null ? "configuration-editor__status--quiet" : "configuration-editor__status--alert")"
                     data-workspace-phase="private-workspace"
                     data-status-code="@_statusCode" data-status-slot="reserved">
                    <p role="status" class="configuration-editor__status-text @(_statusCode == "workspace-ready" ? "configuration-editor__status-text--quiet" : "notice")"
                       data-code="@_statusCode" title="@UiFormat(_statusKey, _statusArguments)">@UiFormat(_statusKey, _statusArguments)</p>
                    @if (StatusRecovery is { } recovery)
                    {
                        <button type="button" class="button button--secondary" data-action="recover-status"
                                data-recovery-target="@recovery.TargetToken"
                                @onclick="() => IsCurrentView(actionForm, actionView) ? ExecuteStatusRecoveryAsync() : Task.CompletedTask">
                            @UiText(recovery.LabelKey)
                        </button>
                    }
                </div>
            </StatusContent>
        </WorkspaceHeader>
        <section id="workspace-advanced-options"
                 class="configuration-editor__advanced-panel"
                 hidden="@(!_advancedOptionsOpen)"
                 inert="@(!_advancedOptionsOpen)"
                 aria-label="@UiText("AdvancedWorkspaceOptions")">
            <div class="configuration-editor__advanced-toolbar">
                @if (!string.IsNullOrEmpty(ScopeSummary))
                {
                    <button type="button" class="configuration-editor__advanced-chip configuration-editor__advanced-chip--scope"
                            data-workspace-scope data-action="change-scope"
                            aria-controls="configuration-context"
                            aria-expanded="@_contextOpen.ToString().ToLowerInvariant()"
                            @onclick="() => { if (IsCurrentView(actionForm, actionView)) OpenScopeSelector(); }">
                        <MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" aria-hidden="true" />
                        <span><bdi>@ScopeSummary</bdi> · @UiText("ScopeChangeAction")</span>
                    </button>
                }
                <button type="button"
                        class="configuration-editor__advanced-chip @(secretsUnlocked ? "configuration-editor__advanced-chip--active" : "")"
                        data-workspace-consent-chip
                        data-consent-active="@secretsUnlocked.ToString().ToLowerInvariant()"
                        @onclick="() => { if (IsCurrentView(actionForm, actionView)) RequestFocus(FocusTarget.Consent); }">
                    <MudIcon Icon="@(secretsUnlocked ? Icons.Material.Outlined.LockOpen : Icons.Material.Outlined.Lock)" Size="Size.Small" aria-hidden="true" />
                    <span>@UiText(secretsUnlocked ? "SecretsEnabledChip" : "SecretsLockedChip")</span>
                </button>
                @if (OutputSelector is { Options.Count: > 1 } outputTaskSelector)
                {
                    <div class="configuration-editor__ribbon-field configuration-editor__output-task">
                        <label for="configuration-output">@UiText("OutputTask")</label>
                        <select @key="_outputChoiceKey" @ref="_outputControl" id="configuration-output" value="@OutputSelection"
                                data-output-field="@DefinitionProfile.FieldId(outputTaskSelector.Location.Segments[0])"
                                @onchange="args => IsCurrentView(actionForm, actionView) ? RequestOutputChangeAsync(args) : Task.CompletedTask">
                            <option value="-1" disabled>@UiText("NotSupplied")</option>
                            @for (int index = 0; index < outputTaskSelector.Options.Count; ++index)
                            {
                                <option value="@index.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-output-value="@outputTaskSelector.Options[index].Value">@OutputTitle(index)</option>
                            }
                        </select>
                    </div>
                }
            </div>
            @if (_form.ConfigurationContext is { } configurationContext)
            {
                <section id="configuration-context" class="configuration-editor__context" hidden="@(!_contextOpen)" inert="@(!_contextOpen)">
                <fieldset class="configuration-editor__context-fields" @key="(_form, _contextChoiceKey)">
                    <legend class="sr-only">@UiText("ConfigurationContext")</legend>
                    <p id="configuration-context-help">@UiText("ConfigurationContextHelp")</p>
                    @if (projection.ContextSummary is { } contextSummary)
                    {
                        <p class="form-help" data-context-summary>
                            <bdi>@contextSummary.Summary</bdi>
                            @if (contextSummary.ComponentTitles.Count > 0)
                            {
                                <span> · <bdi>@string.Join(", ", contextSummary.ComponentTitles)</bdi></span>
                            }
                            @if (contextSummary.ArtifactFileNames.Count > 0)
                            {
                                <span> · <bdi dir="ltr">@string.Join(", ", contextSummary.ArtifactFileNames)</bdi></span>
                            }
                        </p>
                    }
                    <div class="configuration-editor__mode">
                        <label for="configuration-recipe">@UiText("ConfigurationRecipe")</label>
                        <select id="configuration-recipe" @ref="_contextControl" value="@configurationContext.RecipeId"
                                aria-describedby="configuration-context-help"
                                @onchange="args => IsCurrentView(actionForm, actionView) ? ChangeRecipeAsync(args) : Task.CompletedTask">
                            <option value="" disabled>@UiText("ConfigurationRecipe")</option>
                            @foreach (var recipe in _form.ConfigurationRecipes)
                            {
                                <option value="@recipe.Id">@RecipeTitle(recipe)</option>
                            }
                        </select>
                    </div>
                    <div class="configuration-editor__mode">
                        <label for="configuration-scope">@UiText("ConfigurationScope")</label>
                        <select id="configuration-scope" value="@configurationContext.ScopeId" aria-describedby="configuration-context-help"
                                @onchange="args => IsCurrentView(actionForm, actionView) ? ChangeScopeAsync(args) : Task.CompletedTask">
                            <option value="" disabled>@UiText("ConfigurationScope")</option>
                            @foreach (var scope in _form.ConfigurationScopes)
                            {
                                var recipe = _form.ConfigurationRecipes.Single(item => item.Id == configurationContext.RecipeId);
                                <option value="@scope.Id">@ScopeTitle(recipe, scope)</option>
                            }
                        </select>
                    </div>
                    <details>
                        <summary>@UiText("CompatibleContextChoices")</summary>
                        <div class="actions">
                            @foreach (var recipe in _form.ConfigurationRecipes)
                            {
                                @foreach (var scope in recipe.Scopes)
                                {
                                    <AppButton Variant="Variant.Outlined" data-context-pair="@(recipe.Id + ":" + scope.Id)"
                                               OnClick="() => IsCurrentView(actionForm, actionView) ? SelectContextAsync(recipe.Id, scope.Id) : Task.CompletedTask">@RecipeTitle(recipe) / @ScopeTitle(recipe, scope)</AppButton>
                                }
                            }
                        </div>
                    </details>
                </fieldset>
                </section>
            }
            @if (_activeWorkflowStage == WorkspaceStage.Configure)
            {
            <div class="configuration-editor__configure-ribbon"
                 data-configure-ribbon
                 role="toolbar"
                 aria-label="@UiText("WorkspaceEditorTools")">
                <div class="configuration-editor__ribbon-group" role="group" aria-label="@UiText("ConfigurationAnswers")">
                    <AppButton Variant="@(!_developerMode ? Variant.Filled : Variant.Outlined)"
                               data-editing-mode="form"
                               aria-pressed="@((!_developerMode).ToString().ToLowerInvariant())"
                               OnClick="() => IsCurrentView(actionForm, actionView) ? RequestEditorModeAsync(false) : Task.CompletedTask">@ConfigurationDeveloper.ModeLabel(false, actionForm.Locale)</AppButton>
                    <AppButton Variant="@(_developerMode ? Variant.Filled : Variant.Outlined)"
                               data-editing-mode="developer"
                               aria-pressed="@_developerMode.ToString().ToLowerInvariant()"
                               OnClick="() => IsCurrentView(actionForm, actionView) ? RequestEditorModeAsync(true) : Task.CompletedTask">@ConfigurationDeveloper.ModeLabel(true, actionForm.Locale)</AppButton>
                    <button @ref="_inspectorToggleControl"
                            type="button"
                            class="button button--secondary"
                            data-action="toggle-inspector"
                            aria-pressed="@((IsAnyEndDockOpen || _inspectorOpen) ? "true" : "false")"
                            @onclick="() => IsCurrentView(actionForm, actionView) ? ToggleInspectorAsync() : Task.CompletedTask">@UiText("ToggleInspector")</button>
                </div>
                <div class="configuration-editor__ribbon-group">
                    @if (_form.Experiences.Count > 1)
                    {
                        <div class="configuration-editor__ribbon-field">
                            <label for="configuration-experience">@UiText("ConfigurationExperience")</label>
                            <select id="configuration-experience" value="@_form.SelectedExperienceId" @onchange="args => { if (IsCurrentView(actionForm, actionView)) ChangeExperience(args); }">
                                @foreach (var experience in _form.DisplayExperiences)
                                {
                                    <option value="@experience.Id">@experience.Title</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="configuration-editor__ribbon-field">
                        <label for="configuration-detail">@UiText("ProfileDetail")</label>
                        <select id="configuration-detail" value="@(_form.DisclosureOverride?.ToString().ToLowerInvariant() ?? "authored")" @onchange="args => { if (IsCurrentView(actionForm, actionView)) ChangeDetail(args); }">
                            <option value="authored">@UiText("DefaultDetail")</option>
                            <option value="essential">@UiText("Basic")</option>
                            <option value="guided">@UiText("Standard")</option>
                            <option value="advanced">@UiText("AllActive")</option>
                        </select>
                    </div>
                    <div class="configuration-editor__ribbon-field">
                        <label for="configuration-density">@UiText("Density")</label>
                        <select id="configuration-density" aria-label="@UiText("Density")"
                                value="@AppearanceState.FromWorkspaceDensity(Density)"
                                @onchange="args => IsCurrentView(actionForm, actionView) ? ChangeDensitySelectAsync(args) : Task.CompletedTask">
                            <option value="spacious">@UiText("Spacious")</option>
                            <option value="comfortable">@UiText("Comfortable")</option>
                            <option value="compact">@UiText("Compact")</option>
                            <option value="dense">@UiText("Dense")</option>
                        </select>
                    </div>
                </div>
                <div class="configuration-editor__ribbon-group">
                    <button type="button"
                            class="button button--secondary configuration-editor__naming-button"
                            data-action="toggle-naming-mode"
                            aria-pressed="@(NamingMode == WorkspaceNamingMode.Technical ? "true" : "false")"
                            title="@($"{UiText("NamingMode")} (Ctrl+Shift+K)")"
                            @onclick="() => IsCurrentView(actionForm, actionView) ? ChangeNamingModeAsync(NamingMode == WorkspaceNamingMode.Technical ? WorkspaceNamingMode.Humanized : WorkspaceNamingMode.Technical) : Task.CompletedTask">
                        <span>@UiText(NamingMode == WorkspaceNamingMode.Technical ? "Technical" : "Humanized")</span>
                        <kbd class="configuration-editor__shortcut" dir="ltr">Ctrl+Shift+K</kbd>
                    </button>
                    <button type="button" class="button button--secondary" data-action="undo"
                            disabled="@(!_form.CanUndo)" aria-label="@UiText("UndoAction")"
                            @onclick="() => { if (IsCurrentView(actionForm, actionView)) PerformUndo(); }">@UiText("UndoAction")</button>
                    <button type="button" class="button button--secondary" data-action="redo"
                            disabled="@(!_form.CanRedo)" aria-label="@UiText("RedoAction")"
                            @onclick="() => { if (IsCurrentView(actionForm, actionView)) PerformRedo(); }">@UiText("RedoAction")</button>
                    <button type="button" class="button button--secondary" data-action="open-shortcuts"
                            aria-label="@UiText("SettingsShortcuts")"
                            @onclick="() => IsCurrentView(actionForm, actionView) ? OpenShortcutsHelpAsync() : Task.CompletedTask">?</button>
                </div>
            </div>
            }
            @if (SourceDetails is not null)
            {
                <div class="configuration-editor__source-details">@SourceDetails</div>
            }
        </section>
        @if (_activeWorkflowStage == WorkspaceStage.Configure)
        {
        <DockLayoutHost Scope="DockScope.Workspace"
                        MinimumContentWidth="@WorkspaceMinimumContentWidth"
                        DataTestId="workspace-dock-host"
                        ContentDataTestId="workspace-dock-content"
                        TabSelectRequested="HandleDockTabRequestedAsync"
                        OverlayCloseRequested="_ => CloseEndDockAsync()">
            <CascadingValue @key="_workspaceLifetime" Name="WorkspaceConsentAction" Value="_consentAction" IsFixed="true">
            <CascadingValue Name="OnFieldFocused" Value="_fieldFocusCallback" IsFixed="true">
            <CascadingValue Name="OnWorkspaceKeyDown" Value="_keyDownCallback" IsFixed="true">
            <ConfigurationErrorSummary Form="_form"
                                       Validation="_validation"
                                       ShowRequiredSummary="_errorSummaryRequested"
                                       TargetSelected="target => IsCurrentView(actionForm, actionView) ? JumpToActionableTargetAsync(target) : Task.CompletedTask" />
            <ConfigurationConfigurePanel @ref="_configurePanel" Form="_form" Sections="viewSections" SelectedSection="@_selectedSection"
                                         SelectedChanged="HandleConfigureSectionSelectedAsync"
                                         LayoutModeChanged="layout => IsCurrentView(actionForm, actionView) ? SelectLayoutModeAsync(layout) : Task.CompletedTask"
                                         MountCancellation="_mountCancellation.Token" Validation="_validation"
                                         FocusField="@_focusField" FocusGeneration="_focusGeneration" FocusPath="_focusPath"
                                         RequestSecretConsent="_consentAction"
                                         CompactShowMatchesOnly="_compactShowMatchesOnly"
                                         CompactShowMatchesOnlyChanged="HandleCompactShowMatchesOnlyChanged"
                                         ReviewRequested="HandleConfigureReviewRequested" />
            @if (_returnToReview)
            {
                <AppButton Variant="Variant.Outlined" data-action="return-to-review" OnClick="() => { if (IsCurrentView(actionForm, actionView)) ReturnToReview(); }">@UiText("ReturnToReview")</AppButton>
            }
            </CascadingValue>
            </CascadingValue>
            </CascadingValue>
            <div class="configuration-editor__entry-strip" data-returning-entry role="group" aria-label="@UiText("ReturningUserEntry")">
                <button type="button" class="button button--secondary" data-entry-choice="fresh"
                        aria-pressed="@((!_importOpen && !_profileOpen).ToString().ToLowerInvariant())"
                        @onclick='() => { if (IsCurrentView(actionForm, actionView)) SelectReturningEntry("fresh"); }'>@UiText("StartFreshEntry")</button>
                @if (ImportArtifacts.Length > 0)
                {
                    <button type="button" class="button button--secondary" data-entry-choice="import"
                            aria-pressed="@(_importOpen.ToString().ToLowerInvariant())"
                            @onclick='() => { if (IsCurrentView(actionForm, actionView)) SelectReturningEntry("import"); }'>@UiText("UseExistingConfigurationEntry")</button>
                }
                <button type="button" class="button button--secondary" data-entry-choice="profile"
                        aria-pressed="@(_profileOpen.ToString().ToLowerInvariant())"
                        @onclick='() => { if (IsCurrentView(actionForm, actionView)) SelectReturningEntry("profile"); }'>@UiText("OpenSavedProfileEntry")</button>
            </div>
            <details class="configuration-editor__view-options">
                <summary>@UiText("ThisWorkspace")</summary>
                <ConfigurationFieldHelp @key="(_form, _form.SelectedExperienceId, currentSectionId)" Schema="default" Title="@UiText("ThisWorkspace")" FieldPath="workspace"
                                        Locale="@_form.Locale"
                                        SecretsEnabled="@(_form.SessionPrivacy == DefinitionSessionPrivacy.BrowserSecretsEnabled)"
                                        ContextTitle="@($"{Definition.Title} / {SelectedExperience.Title}")" Description="@SelectedExperience.Description"
                                        SectionDescription="@(currentSectionId is null ? null : _editorSections[currentSectionId].Description)" />
            </details>
        </DockLayoutHost>
        @if (!_developerMode && ImportArtifacts.Length > 0)
        {
            <details class="configuration-editor__import" data-import-panel open="@_importOpen">
                <summary @onclick="() => { if (IsCurrentView(actionForm, actionView)) _importOpen = !_importOpen; }" @onclick:preventDefault>@UiText("StartExistingConfiguration") <span class="configuration-editor__optional">@UiText("Optional")</span></summary>
                <p class="form-help" id="artifact-import-help">@UiText("ArtifactImportHelp")</p>
                <div class="configuration-editor__import-controls">
                    <div class="form-group">
                        <label for="import-purpose">@UiText("ImportPurpose")</label>
                        <select id="import-purpose" value="@_importPurpose" @onchange="args => { if (IsCurrentView(actionForm, actionView)) ChangeImportPurpose(args); }">
                            <option value="compare">@UiText("CompareDefinition")</option>
                            <option value="fill">@UiText("FillFields")</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="import-artifact">@UiText("ImportArtifactFormat")</label>
                        <select id="import-artifact" value="@_importArtifact" @onchange="args => { if (IsCurrentView(actionForm, actionView)) ChangeImportFormat(args); }">
                            <option value="" disabled>@UiText("ImportChooseFormat")</option>
                            @foreach (var artifact in ImportArtifacts) { <option value="@artifact.Id">@artifact.FileName</option> }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="artifact-import">@UiText("ChooseDeclaredArtifact")</label>
                        <InputFile @key="_fileKey" id="artifact-import" @ref="_fileInput" OnChange="args => IsCurrentView(actionForm, actionView) ? ImportAsync(args) : Task.CompletedTask"
                                   disabled="@(ImportCapability?.InspectionSupported != true || _importPurpose == "fill" && ImportCapability?.StrictAutofillSupported != true)"
                                   aria-describedby="session-boundary artifact-import-help import-capability" />
                    </div>
                </div>
                @if (ImportCapability is { } capability)
                {
                    <p id="import-capability" class="form-help"
                       data-import-inspection="@capability.InspectionSupported.ToString().ToLowerInvariant()"
                       data-import-strict-autofill="@capability.StrictAutofillSupported.ToString().ToLowerInvariant()">
                        @UiText(capability.InspectionSupported ? "InspectionSupported" : "InspectionUnsupported")
                        @UiText(capability.StrictAutofillSupported ? "AutofillSupported" : "AutofillUnsupported")
                        @UiText("ImportAssessmentBoundary")
                    </p>
                }
                @if (_importPending)
                {
                    long importGeneration = _generation;
                    <p aria-live="polite">@UiText("ImportPending")</p>
                    <AppButton Variant="Variant.Outlined" data-action="cancel-import-comparison" OnClick="() => { if (IsCurrentView(actionForm, actionView)) CancelComparison(importGeneration); }">@UiText("CancelComparison")</AppButton>
                }
                @if (_importConsentRequired)
                {
                    <AppButton Variant="Variant.Outlined" data-action="review-import-consent"
                               OnClick="() => { if (IsCurrentView(actionForm, actionView)) ReviewImportConsent(); }">@UiText("ReviewSecretConsent")</AppButton>
                }
                <ConfigurationImportReview @key="_form" Form="_form" FillFields="report => IsCurrentView(actionForm, actionView) ? AdoptComparison(report) : Task.CompletedTask"
                                           Clear="report => { if (IsCurrentView(actionForm, actionView)) ClearComparison(report); }" />
            </details>
        }
        }
        @if (_activeWorkflowStage == WorkspaceStage.Review)
        {
            <ConfigurationReviewPanel @ref="_reviewPanel" Form="_form"
                                 Readiness="@PreparationReadiness"
                                 PrepareComplete="() => IsCurrentView(actionForm, actionView) ? PrepareAsync(false) : Task.CompletedTask"
                                 ChangeField="diagnostic => { if (IsCurrentView(actionForm, actionView)) ChangeReviewField(diagnostic); }" Validation="_validation" DiagnosticCodes="_diagnostics"
                                 CorrectField="diagnostic => { if (IsCurrentView(actionForm, actionView)) ChangeReviewField(diagnostic); }"
                                 EnableSecrets="() => IsCurrentView(actionForm, actionView) ? EnableSecretsAsync() : Task.CompletedTask"
                                 PrepareDraft="() => IsCurrentView(actionForm, actionView) ? PrepareAsync(true) : Task.CompletedTask" />
        }
        @if (_activeWorkflowStage == WorkspaceStage.Files)
        {
        <ConfigurationFilesPanel @ref="_filesPanel" Locale="@_form.Locale"
                                 Readiness="@PreparationReadiness" HasPreparedFiles="@(_prepared.Count > 0)"
                                 OutputInvalidated="@(_hadPreparedOutput && _prepared.Count == 0)"
                                 Review='() => { if (IsCurrentView(actionForm, actionView)) SelectWorkflowStage(WorkspaceStage.Review); }'
                                 Prepare="draft => IsCurrentView(actionForm, actionView) ? PrepareAsync(draft) : Task.CompletedTask"
                                 Clear="() => IsCurrentView(actionForm, actionView) ? ClearAsync() : Task.CompletedTask">
        <ConfigurationReview Definition="Definition" Form="_form" Validation="_validation" DiagnosticCodes="_diagnostics"
                             InvalidFields="_form.InputDiagnostics" SecretsEnabled="@(_form.SessionPrivacy == DefinitionSessionPrivacy.BrowserSecretsEnabled)"
                             CorrectField="diagnostic => { if (IsCurrentView(actionForm, actionView)) ChangeReviewField(diagnostic); }"
                             EnableSecrets="() => IsCurrentView(actionForm, actionView) ? EnableSecretsAsync() : Task.CompletedTask" />
        @if (_prepared.Count > 1)
        {
            <div class="actions">
                <AppButton Variant="Variant.Outlined" data-action="copy-all-files"
                           OnClick="() => IsCurrentView(actionForm, actionView) ? ExportAllAsync(false) : Task.CompletedTask">@UiText("CopyAllArtifacts")</AppButton>
                <AppButton data-action="download-all-files"
                           OnClick="() => IsCurrentView(actionForm, actionView) ? ExportAllAsync(true) : Task.CompletedTask">@UiText("DownloadAllArtifacts")</AppButton>
            </div>
        }
        @foreach (var prepared in _prepared)
        {
            <div class="configuration-editor__artifact" @key="prepared">
                <ConfigurationFiles @ref="prepared.View" Metadata="prepared.Metadata" Form="_form" Locale="@_form.Locale"
                                    Destination="@Definition.Artifacts.Single(artifact => artifact.Id == prepared.Metadata.ArtifactId)"
                                    Revealed="@prepared.Revealed" StatusKey="@prepared.StatusKey" StatusCode="@prepared.StatusCode"
                                    Copy="() => IsCurrentView(actionForm, actionView) ? CopyAsync(prepared) : Task.CompletedTask"
                                    Download="() => IsCurrentView(actionForm, actionView) ? DownloadAsync(prepared) : Task.CompletedTask"
                                    Reveal="() => IsCurrentView(actionForm, actionView) ? RevealAsync(prepared) : Task.CompletedTask" />
            </div>
        }
        </ConfigurationFilesPanel>
        }
        <ConfigurationNextActionsPanel @ref="_nextActionsPanel" Form="actionForm"
                                       ShowNextActions="@IsFilesSurfaceActive" Review="actionReview"
                                       ReviewRequested="target => IsCurrentView(actionForm, actionView) ? ReviewTransitionAsync(target) : Task.CompletedTask"
                                       ApplyRequested="selection => IsCurrentView(actionForm, actionView) && ReferenceEquals(selection.Review, actionReview) ? ApplyReviewedTransferAsync(selection) : Task.CompletedTask"
                                       CancelRequested="review => { if (IsCurrentView(actionForm, actionView) && ReferenceEquals(review, actionReview)) CancelTransferReview(review); }" />
        <ConfigurationVaultPanel @key="_form" @ref="_vaultPanel" Form="_form" CaptureAuthority="CaptureProfileAuthority"
                                 Ready="_ready" Open="@_profileOpen" RequestConsent="_consentAction" />
        @if (_form.Definition.Locales.Count > 1)
        {
            <details class="configuration-editor__task-tools" open="@_taskToolsOpen">
                <summary @onclick="() => { if (IsCurrentView(actionForm, actionView)) _taskToolsOpen = !_taskToolsOpen; }" @onclick:preventDefault>@UiText("Language")</summary>
                <div class="configuration-editor__toolbar">
                    <div class="configuration-editor__mode">
                        <label for="configuration-locale">@UiText("Language")</label>
                        <select id="configuration-locale" value="@_form.Locale" @onchange="args => { if (IsCurrentView(actionForm, actionView)) ChangeLocale(args); }">
                            @foreach (string locale in _form.Definition.Locales)
                            {
                                <option value="@locale">@LanguageName(locale)</option>
                            }
                        </select>
                    </div>
                </div>
            </details>
        }
        @if (_form.SessionPrivacy == DefinitionSessionPrivacy.BrowserSecretsEnabled)
        {
            <AppButton Variant="Variant.Outlined" data-action="revoke-secret-entry"
                       OnClick="() => IsCurrentView(actionForm, actionView) ? ConsentAsync(new ChangeEventArgs { Value = false }) : Task.CompletedTask">@UiText("RevokeSecrets")</AppButton>
        }
        <details class="configuration-editor__privacy" data-secret-consent open="@_consentOpen">
            <summary @onclick="() => { if (IsCurrentView(actionForm, actionView)) _consentOpen = !_consentOpen; }" @onclick:preventDefault>@UiText("ReviewSecretConsent")</summary>
            <div class="configuration-editor__consent">
                <input @ref="_consentControl" id="secret-consent" type="checkbox" data-workspace-lifetime="@_workspaceLifetime" checked="@(_form.SessionPrivacy == DefinitionSessionPrivacy.BrowserSecretsEnabled)"
                       aria-describedby="session-boundary secret-consent-help secret-consent-hosted-help" @onchange="args => IsCurrentView(actionForm, actionView) ? ConsentAsync(args) : Task.CompletedTask" />
                <div>
                    <label for="secret-consent">@UiText("EnableWorkspaceSecrets")</label>
                    <p id="secret-consent-help" class="form-help">@UiText("WorkspaceSecretHelp") @UiText("CredentialCustodyHelp")</p>
                    <p id="secret-consent-hosted-help" class="form-help" data-hosted-code-custody>
                        @UiText("WorkspaceHostedCodeCustodyHelp")
                        <a href="help#custody" data-action="custody-guidance">@UiText("WorkspaceCustodyGuideLink")</a>
                    </p>
                </div>
            </div>
        </details>
    <details class="configuration-editor__boundary">
        <summary>@UiText("PrivacyExportLimits")</summary>
        <p class="form-help" data-declared-outputs>@UiFormat("DeclaredFiles", string.Join(", ", Definition.Artifacts.Select(artifact => artifact.FileName)))</p>
        <p>@UiText("WorkspaceExportBoundary")</p>
    </details>
    </fieldset>
    </CascadingValue>
    }
</section>
</MudRTLProvider>
}

@code {
    private RenderFragment RenderInspectorDockPanel() => @<ConfigurationInspectorPane Form="_form"
                                                                                      InspectedPath="@_inspectedPath"
                                                                                      ProjectionRevision="@(_form?.InputRevision ?? 0)"
                                                                                      Locale="@(_form?.Locale ?? "en")"
                                                                                      IsMobileSheet="_inspectorMobileSheet"
                                                                                      CloseRequested="CloseEndDockAsync" />;

    private RenderFragment RenderDocumentJsonDockPanel() => @<div class="configuration-editor__document-dock">
        @if (_form is { } actionForm)
        {
            long actionView = _viewGeneration;
            <div class="configuration-editor__document-dock-header">
                <AppButton Variant="Variant.Text"
                           OnClick="CloseEndDockAsync"
                           data-action="close-document-json-dock"
                           aria-label="@UiText("CloseDocumentJsonDock")">@UiText("Close")</AppButton>
            </div>
            @if (DeveloperArtifacts.Length > 1)
            {
                <div class="configuration-editor__mode">
                    <label for="developer-destination">@UiText("EnvironmentDestination")</label>
                    <select id="developer-destination" @key="_developerDestinationKey" @ref="_developerDestinationControl" value="@DeveloperArtifactId"
                            @onchange="args => IsCurrentView(actionForm, actionView) ? ChangeDeveloperDestinationAsync(args) : Task.CompletedTask">
                        <option value="" disabled>@UiText("ImportChooseFormat")</option>
                        @foreach (var artifact in DeveloperArtifacts)
                        {
                            <option value="@artifact.Id">@artifact.Title / @artifact.FileName</option>
                        }
                    </select>
                </div>
            }
            <ConfigurationDeveloper @key="(_form, _developerEpoch)" @ref="_developerPanel" Form="actionForm"
                                    ConsentControl="() => _consentControl" WorkspaceLifetime="@_workspaceLifetime"
                                    EnvironmentArtifactId="@DeveloperArtifactId"
                                    DirtyChanged="_ => { if (IsCurrentView(actionForm, actionView)) _navigation?.RefreshWork(this, _navigationLease); }"
                                    RequestConsent="() => { if (IsCurrentView(actionForm, actionView)) RequestFocus(FocusTarget.Consent); }" />
        }
    </div>;
}
