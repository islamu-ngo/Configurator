@implements IAsyncDisposable
@using Configurator.Core.Definitions
@using Configurator.Presentation

@{ DefinitionFormModel actionForm = _form!; long actionView = _viewGeneration; }
<MudRTLProvider RightToLeft="@(DisplayDirection == "rtl")">
<section @key="_form" class="workspace configuration-editor @(_compact ? "configuration-editor--compact" : "")" aria-labelledby="configuration-heading"
         lang="@_form!.Locale" dir="@DisplayDirection"
         data-experience="@_form!.SelectedExperienceId" data-density="@(_compact ? "compact" : "comfortable")">
    <header class="configuration-editor__header">
        <h2 class="sr-only" id="configuration-heading">@UiText("WorkspaceTitle")</h2>
        <p class="sr-only" id="session-boundary">@UiText("AnswersStayLocal")</p>
    </header>
    @if (!_ready)
    {
        <button @ref="_startButton" class="button" type="button" @onclick="() => IsCurrentView(actionForm, actionView) ? BeginAsync() : Task.CompletedTask">@UiText("StartWorkspace")</button>
    }
    <fieldset class="configuration-editor__controls" disabled="@(!_ready)">
        <legend class="sr-only">@UiText("ConfigurationAnswers")</legend>
        @{ var projection = _form.Projection; var progress = projection.Progress; var viewSections = EditorSections();
            string? currentSectionId = SelectedSection(viewSections); }
        <nav class="configuration-editor__workflow" aria-label="@UiText("ConfigurationWorkflow")">
            <ol>
                <li><button type="button" data-workflow-step="configure" aria-current="@(_activeWorkflowStage == "configure" ? "step" : null)" @onclick='() => IsCurrentView(actionForm, actionView) ? RequestWorkflowStageAsync("configure") : Task.CompletedTask'><span aria-hidden="true">1</span> @UiText("WorkflowConfigure")</button></li>
                <li><button type="button" data-workflow-step="review" aria-current="@(_activeWorkflowStage == "review" ? "step" : null)" @onclick='() => IsCurrentView(actionForm, actionView) ? RequestWorkflowStageAsync("review") : Task.CompletedTask'><span aria-hidden="true">2</span> @UiText("WorkflowReview")</button></li>
                <li><button type="button" data-workflow-step="prepare" aria-current="@(_activeWorkflowStage == "prepare" ? "step" : null)" @onclick='() => IsCurrentView(actionForm, actionView) ? RequestWorkflowStageAsync("prepare") : Task.CompletedTask'><span aria-hidden="true">3</span> @UiText("WorkflowFiles")</button></li>
            </ol>
        </nav>
        <div class="configuration-editor__progress" aria-live="polite" aria-atomic="true"
             data-required-count="@progress.Required" data-ready-count="@progress.Ready">
            @if (progress.Required == 0)
            {
                <strong>@UiText("NoRequiredAnswers")</strong>
            }
            else
            {
                <strong>@UiFormat(progress.Required == 1 ? "RequiredAnswerReady" : "RequiredAnswersReady", progress.Ready, progress.Required)</strong>
                <progress value="@progress.Ready" max="@progress.Required" aria-label="@UiText("RequiredAnswersProgress")"></progress>
            }
            @if (progress.Missing + progress.Invalid > 0)
            {
                <button type="button" class="button button--secondary" data-action="review-required-work"
                        @onclick='() => IsCurrentView(actionForm, actionView) ? RequestWorkflowStageAsync("review") : Task.CompletedTask'>@UiText("NeedsAttention"): @(progress.Missing + progress.Invalid)</button>
            }
        </div>
        <p role="status" class="@(_statusCode == "workspace-ready" ? "sr-only" : "notice")" data-code="@_statusCode">@UiFormat(_statusKey, _statusArguments)</p>
        @if (_form.SessionPrivacy == DefinitionSessionPrivacy.BrowserSecretsEnabled)
        {
            <AppButton Variant="Variant.Outlined" data-action="revoke-secret-entry"
                       OnClick="() => IsCurrentView(actionForm, actionView) ? ConsentAsync(new ChangeEventArgs { Value = false }) : Task.CompletedTask">@UiText("RevokeSecrets")</AppButton>
        }
        @if (_activeWorkflowStage == "configure")
        {
        @if (_developerMode)
        {
            <ConfigurationDeveloper @key="(_form, _developerEpoch)" @ref="_developerPanel" Form="_form"
                                    EnvironmentArtifactId="@(Definition.Artifacts.FirstOrDefault(artifact => artifact.Format == DefinitionArtifactFormat.Dotenv)?.Id)"
                                    DirtyChanged="_ => { if (IsCurrentView(actionForm, actionView)) _navigation?.RefreshWork(this, _navigationLease); }"
                                    RequestConsent="() => { if (IsCurrentView(actionForm, actionView)) RequestFocus(FocusTarget.Consent); }" />
        }
        else
        {
        <CascadingValue Name="WorkspaceConsentAction" Value="_consentAction">
        <ConfigurationConfigurePanel @ref="_configurePanel" Form="_form" Sections="viewSections" SelectedSection="@_selectedSection"
                                     SelectedChanged="section => { if (IsCurrentView(actionForm, actionView)) SelectSection(section); }"
                                     MountCancellation="_mountCancellation.Token" Validation="_validation"
                                     FocusField="@_focusField" FocusGeneration="_focusGeneration" FocusPath="_focusPath"
                                     ReviewRequested='() => { if (IsCurrentView(actionForm, actionView)) SelectWorkflowStage("review"); }' />
        </CascadingValue>
        @if (_returnToReview)
        {
            <AppButton Variant="Variant.Outlined" data-action="return-to-review" OnClick="() => { if (IsCurrentView(actionForm, actionView)) ReturnToReview(); }">@UiText("ReturnToReview")</AppButton>
        }
        }
        <div class="configuration-editor__toolbar">
            <details class="configuration-editor__view-options">
            <summary>@UiText("WorkspaceEditorTools")</summary>
            <div class="actions" role="group" aria-label="@UiText("ConfigurationAnswers")">
                <AppButton Variant="@(_developerMode ? Variant.Outlined : Variant.Filled)" data-editing-mode="form"
                           aria-pressed="@((!_developerMode).ToString().ToLowerInvariant())"
                           OnClick="() => IsCurrentView(actionForm, actionView) ? RequestEditorModeAsync(false) : Task.CompletedTask">@ConfigurationDeveloper.ModeLabel(false, actionForm.Locale)</AppButton>
                <AppButton Variant="@(_developerMode ? Variant.Filled : Variant.Outlined)" data-editing-mode="developer"
                           aria-pressed="@_developerMode.ToString().ToLowerInvariant()"
                           OnClick="() => IsCurrentView(actionForm, actionView) ? RequestEditorModeAsync(true) : Task.CompletedTask">@ConfigurationDeveloper.ModeLabel(true, actionForm.Locale)</AppButton>
            </div>
            @if (_form.Experiences.Count > 1)
            {
                <div class="configuration-editor__mode">
                    <label for="configuration-experience">@UiText("ConfigurationExperience")</label>
                    <select id="configuration-experience" value="@_form.SelectedExperienceId" @onchange="args => { if (IsCurrentView(actionForm, actionView)) ChangeExperience(args); }">
                        @foreach (var experience in _form.DisplayExperiences)
                        {
                            <option value="@experience.Id">@experience.Title</option>
                        }
                    </select>
                </div>
            }
            <div class="configuration-editor__mode">
                <label for="configuration-detail">@UiText("ProfileDetail")</label>
                <select id="configuration-detail" value="@(_form.DisclosureOverride?.ToString().ToLowerInvariant() ?? "authored")" @onchange="args => { if (IsCurrentView(actionForm, actionView)) ChangeDetail(args); }">
                    <option value="authored">@UiText("DefaultDetail")</option>
                    <option value="essential">@UiText("Basic")</option>
                    <option value="guided">@UiText("Standard")</option>
                    <option value="advanced">@UiText("AllActive")</option>
                </select>
            </div>
            <div class="configuration-editor__mode">
                <label for="configuration-density">@UiText("Density")</label>
                <select id="configuration-density" value="@(_compact ? "compact" : "comfortable")" @onchange="args => { if (IsCurrentView(actionForm, actionView)) ChangeDensity(args); }">
                    <option value="comfortable">@UiText("Comfortable")</option>
                    <option value="compact">@UiText("Compact")</option>
                </select>
            </div>
            <ConfigurationFieldHelp @key="(_form, _form.SelectedExperienceId, currentSectionId)" Schema="default" Title="@UiText("ThisWorkspace")" FieldPath="workspace"
                                    SecretsEnabled="@(_form.SessionPrivacy == DefinitionSessionPrivacy.BrowserSecretsEnabled)"
                                    ContextTitle="@($"{Definition.Title} / {SelectedExperience.Title}")" Description="@SelectedExperience.Description"
                                    SectionDescription="@(currentSectionId is null ? null : _editorSections[currentSectionId].Description)" />
            </details>
        </div>
        @if (!_developerMode && ImportArtifacts.Length > 0)
        {
            <details class="configuration-editor__import">
                <summary>@UiText("StartExistingConfiguration") <span class="configuration-editor__optional">@UiText("Optional")</span></summary>
                <p class="form-help" id="artifact-import-help">@UiText("ArtifactImportHelp")</p>
                <div class="configuration-editor__import-controls">
                    <div class="form-group">
                        <label for="import-purpose">@UiText("ImportPurpose")</label>
                        <select id="import-purpose" value="@_importPurpose" @onchange="args => { if (IsCurrentView(actionForm, actionView)) ChangeImportPurpose(args); }">
                            <option value="compare">@UiText("CompareDefinition")</option>
                            <option value="fill">@UiText("FillFields")</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="import-artifact">@UiText("ImportArtifactFormat")</label>
                        <select id="import-artifact" value="@_importArtifact" @onchange="args => { if (IsCurrentView(actionForm, actionView)) ChangeImportFormat(args); }">
                            <option value="" disabled>@UiText("ImportChooseFormat")</option>
                            @foreach (var artifact in ImportArtifacts) { <option value="@artifact.Id">@artifact.FileName</option> }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="artifact-import">@UiText("ChooseDeclaredArtifact")</label>
                        <InputFile @key="_fileKey" id="artifact-import" @ref="_fileInput" OnChange="args => IsCurrentView(actionForm, actionView) ? ImportAsync(args) : Task.CompletedTask"
                                   disabled="@(ImportCapability?.InspectionSupported != true || _importPurpose == "fill" && ImportCapability?.StrictAutofillSupported != true)"
                                   aria-describedby="session-boundary artifact-import-help import-capability" />
                    </div>
                </div>
                @if (ImportCapability is { } capability)
                {
                    <p id="import-capability" class="form-help"
                       data-import-inspection="@capability.InspectionSupported.ToString().ToLowerInvariant()"
                       data-import-strict-autofill="@capability.StrictAutofillSupported.ToString().ToLowerInvariant()">
                        @UiText(capability.InspectionSupported ? "InspectionSupported" : "InspectionUnsupported")
                        @UiText(capability.StrictAutofillSupported ? "AutofillSupported" : "AutofillUnsupported")
                        @UiText("ImportAssessmentBoundary")
                    </p>
                }
                @if (_importPending)
                {
                    long importGeneration = _generation;
                    <p aria-live="polite">@UiText("ImportPending")</p>
                    <AppButton Variant="Variant.Outlined" data-action="cancel-import-comparison" OnClick="() => { if (IsCurrentView(actionForm, actionView)) CancelComparison(importGeneration); }">@UiText("CancelComparison")</AppButton>
                }
                @if (_importConsentRequired)
                {
                    <AppButton Variant="Variant.Outlined" data-action="review-import-consent"
                               OnClick="() => { if (IsCurrentView(actionForm, actionView)) ReviewImportConsent(); }">@UiText("ReviewSecretConsent")</AppButton>
                }
                <ConfigurationImportReview @key="_form" Form="_form" FillFields="report => IsCurrentView(actionForm, actionView) ? AdoptComparison(report) : Task.CompletedTask"
                                           Clear="report => { if (IsCurrentView(actionForm, actionView)) ClearComparison(report); }" />
            </details>
        }
        }
        @if (_activeWorkflowStage == "review")
        {
            <ConfigurationReviewPanel @ref="_reviewPanel" Form="_form"
                                 Readiness="@PreparationReadiness"
                                 PrepareComplete="() => IsCurrentView(actionForm, actionView) ? PrepareAsync(false) : Task.CompletedTask"
                                 ChangeField="diagnostic => { if (IsCurrentView(actionForm, actionView)) ChangeReviewField(diagnostic); }" Validation="_validation" DiagnosticCodes="_diagnostics"
                                 CorrectField="diagnostic => { if (IsCurrentView(actionForm, actionView)) ChangeReviewField(diagnostic); }"
                                 EnableSecrets="() => IsCurrentView(actionForm, actionView) ? EnableSecretsAsync() : Task.CompletedTask"
                                 PrepareDraft="() => IsCurrentView(actionForm, actionView) ? PrepareAsync(true) : Task.CompletedTask" />
        }
        @if (_activeWorkflowStage == "prepare")
        {
        <ConfigurationFilesPanel @ref="_filesPanel" Locale="@_form.Locale"
                                 Readiness="@PreparationReadiness" HasPreparedFiles="@(_prepared.Count > 0)"
                                 Review='() => { if (IsCurrentView(actionForm, actionView)) SelectWorkflowStage("review"); }'
                                 Prepare="draft => IsCurrentView(actionForm, actionView) ? PrepareAsync(draft) : Task.CompletedTask"
                                 Clear="() => IsCurrentView(actionForm, actionView) ? ClearAsync() : Task.CompletedTask">
        <ConfigurationReview Definition="Definition" Form="_form" Validation="_validation" DiagnosticCodes="_diagnostics"
                             InvalidFields="_form.InputDiagnostics" SecretsEnabled="@(_form.SessionPrivacy == DefinitionSessionPrivacy.BrowserSecretsEnabled)"
                             CorrectField="diagnostic => { if (IsCurrentView(actionForm, actionView)) ChangeReviewField(diagnostic); }"
                             EnableSecrets="() => IsCurrentView(actionForm, actionView) ? EnableSecretsAsync() : Task.CompletedTask" />
        @foreach (var prepared in _prepared)
        {
            <div class="configuration-editor__artifact" @key="prepared">
                <ConfigurationFiles @ref="prepared.View" Metadata="prepared.Metadata" Form="_form" Locale="@_form.Locale"
                                    Revealed="@prepared.Revealed" StatusKey="@prepared.StatusKey" StatusCode="@prepared.StatusCode"
                                    Copy="() => IsCurrentView(actionForm, actionView) ? CopyAsync(prepared) : Task.CompletedTask"
                                    Download="() => IsCurrentView(actionForm, actionView) ? DownloadAsync(prepared) : Task.CompletedTask"
                                    Reveal="() => IsCurrentView(actionForm, actionView) ? RevealAsync(prepared) : Task.CompletedTask" />
            </div>
        }
        </ConfigurationFilesPanel>
        }
        <details class="configuration-editor__task-tools" open="@_taskToolsOpen">
        <summary @onclick="() => { if (IsCurrentView(actionForm, actionView)) _taskToolsOpen = !_taskToolsOpen; }" @onclick:preventDefault>@UiText("WorkspaceTaskTools")</summary>
        <div class="configuration-editor__toolbar">
            @if (OutputSelector is { } outputSelector)
            {
                <div class="configuration-editor__mode configuration-editor__output">
                    <label for="configuration-output">@UiText("SelectOutput")</label>
                    <select @key="_outputChoiceKey" @ref="_outputControl" id="configuration-output" value="@OutputSelection"
                            data-output-field="@DefinitionProfile.FieldId(outputSelector.Location.Segments[0])"
                            @onchange="args => IsCurrentView(actionForm, actionView) ? RequestOutputChangeAsync(args) : Task.CompletedTask">
                        <option value="-1" disabled>@UiText("NotSupplied")</option>
                        @for (int index = 0; index < outputSelector.Options.Count; ++index)
                        {
                            <option value="@index.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    data-output-value="@outputSelector.Options[index].Value">@OutputTitle(index)</option>
                        }
                    </select>
                </div>
            }
            @if (_form.Definition.Locales.Count > 1)
            {
                <div class="configuration-editor__mode">
                    <label for="configuration-locale">@UiText("Language")</label>
                    <select id="configuration-locale" value="@_form.Locale" @onchange="args => { if (IsCurrentView(actionForm, actionView)) ChangeLocale(args); }">
                        @foreach (string locale in _form.Definition.Locales)
                        {
                            <option value="@locale">@LanguageName(locale)</option>
                        }
                    </select>
                </div>
            }
        </div>
        </details>
        <details class="configuration-editor__privacy" data-secret-consent open="@_consentOpen">
            <summary @onclick="() => { if (IsCurrentView(actionForm, actionView)) _consentOpen = !_consentOpen; }" @onclick:preventDefault>@UiText("ReviewSecretConsent")</summary>
            <div class="configuration-editor__consent">
                <input @ref="_consentControl" id="secret-consent" type="checkbox" checked="@(_form.SessionPrivacy == DefinitionSessionPrivacy.BrowserSecretsEnabled)"
                       aria-describedby="session-boundary secret-consent-help" @onchange="args => IsCurrentView(actionForm, actionView) ? ConsentAsync(args) : Task.CompletedTask" />
                <div>
                    <label for="secret-consent">@UiText("EnableWorkspaceSecrets")</label>
                    <p id="secret-consent-help" class="form-help">@UiText("WorkspaceSecretHelp")</p>
                </div>
            </div>
        </details>
    <details class="configuration-editor__boundary">
        <summary>@UiText("PrivacyExportLimits")</summary>
        <p class="form-help" data-declared-outputs>@UiFormat("DeclaredFiles", string.Join(", ", Definition.Artifacts.Select(artifact => artifact.FileName)))</p>
        <p>@UiText("WorkspaceExportBoundary")</p>
    </details>
    </fieldset>
</section>
</MudRTLProvider>
