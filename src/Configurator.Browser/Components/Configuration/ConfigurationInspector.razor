@using System.Text.Json
@using Configurator.Core.Definitions
@using Configurator.Presentation

<MudDialog>
    <DialogContent>
        <div class="configuration-inspector">
            @if (!string.IsNullOrWhiteSpace(ContextTitle)) { <p><strong>@ContextTitle</strong></p> }
            @if (!string.IsNullOrWhiteSpace(PublicTitle)) { <p data-help-title><strong>@PublicTitle</strong></p> }
            @if (!string.IsNullOrWhiteSpace(Description)) { <p data-experience-description>@Description</p> }
            @if (!string.IsNullOrWhiteSpace(SectionDescription)) { <p data-section-description>@SectionDescription</p> }
            @if (PublicSchema.ValueKind == JsonValueKind.Object)
            {
            @if (!string.IsNullOrWhiteSpace(PublicDescription)) { <p data-help-description>@PublicDescription</p> }
            @if (!string.IsNullOrWhiteSpace(Instructions))
            {
                <p data-help-instructions>@Instructions</p>
            }
            @if (Links.Count > 0)
            {
                    <ul>
                        @foreach (var link in Links)
                        {
                            <li><a href="@link.Url" target="_blank"
                                   rel="noopener noreferrer" referrerpolicy="no-referrer">@link.Title<span class="sr-only"> (new tab)</span></a></li>
                        }
                    </ul>
            }
            @if (ChoiceExplanations.Any())
            {
                <dl data-choice-explanations>
                    @foreach (var choice in ChoiceExplanations)
                    {
                        <dt>@choice.Label</dt><dd>@choice.Explanation</dd>
                    }
                </dl>
            }
            <dl>
                <dt>Definition path</dt><dd><code data-definition-path>@FieldPath</code></dd>
                <dt>Declared type</dt><dd>@(PublicSchema.GetProperty("type").ValueKind == JsonValueKind.Array
                    ? string.Join(" or ", PublicSchema.GetProperty("type").EnumerateArray().Select(item => item.GetString()))
                    : PublicSchema.GetProperty("type").GetString())</dd>
                @if (!string.IsNullOrWhiteSpace(Units))
                {
                    <dt>Units</dt><dd data-help-units>@Units</dd>
                }
                @if (Metadata.ValueKind == JsonValueKind.Object && Metadata.TryGetProperty("sensitivity", out var sensitivity))
                {
                    <dt>Declared sensitivity</dt><dd>@sensitivity.GetString()</dd>
                }
            </dl>
            }
            else
            {
                <p>Detail changes which optional settings are shown. Required work and active errors remain reachable. Comfortable and Compact change spacing, not answers or validation.</p>
            }
            @if (OutputArtifactIds.Count > 0)
            {
                <section aria-label="Declared output bindings">
                    <h3>Declared output bindings</h3>
                    <p>Artifact IDs: <code>@string.Join(", ", OutputArtifactIds)</code></p>
                    <ul>
                        @foreach (string key in BindingKeys) { <li><code data-output-key>@key</code></li> }
                    </ul>
                    <p class="form-help">These are declared references, not a guarantee that a conditional output is included.</p>
                </section>
            }
            <p class="form-help">Help contains public definition and interface guidance, never your answers. Preparation does not grant target acceptance or apply permission.</p>
        </div>
    </DialogContent>
    <DialogActions>
        <AppButton Variant="Variant.Outlined" OnClick="Close" aria-label="Close field help">Close</AppButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter] public JsonElement Schema { get; set; }
    [Parameter] public DefinitionEditorPresentation? Presentation { get; set; }
    [Parameter] public string FieldPath { get; set; } = string.Empty;
    [Parameter] public string? ContextTitle { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? SectionDescription { get; set; }
    [Parameter] public IReadOnlyList<string> OutputArtifactIds { get; set; } = [];
    [Parameter] public IReadOnlyList<string> BindingKeys { get; set; } = [];
    private JsonElement PublicSchema => Presentation?.Schema.Keywords ?? Schema;
    private JsonElement Metadata => PublicSchema.ValueKind == JsonValueKind.Object &&
        PublicSchema.TryGetProperty("x-configurator", out var metadata) ? metadata : default;
    private JsonElement Guidance => Metadata.ValueKind == JsonValueKind.Object &&
        Metadata.TryGetProperty("guidance", out var guidance) ? guidance : default;
    private string? PublicTitle => Presentation?.Title ?? Text(PublicSchema, "title");
    private string? PublicDescription => Presentation?.Description ?? Text(PublicSchema, "description");
    private string? Instructions => Presentation?.Instructions ?? Text(Guidance, "instructions");
    private string? Units => Presentation?.Units ?? Text(Metadata, "units");
    private IReadOnlyList<DefinitionGuidanceLink> Links => Presentation?.Links ??
        (Guidance.ValueKind == JsonValueKind.Object && Guidance.TryGetProperty("links", out var links)
            ? links.EnumerateArray().Select(link => new DefinitionGuidanceLink(
                link.GetProperty("title").GetString()!, link.GetProperty("url").GetString()!)).ToArray()
            : Array.Empty<DefinitionGuidanceLink>());
    private IEnumerable<(string Label, string? Explanation)> ChoiceExplanations =>
        (Presentation is not null
            ? Presentation.Choices.Select(choice => (choice.Label, choice.Explanation))
            : Metadata.ValueKind == JsonValueKind.Object && Metadata.TryGetProperty("choices", out var choices)
                ? choices.EnumerateArray().Select(choice => (
                    Label: choice.GetProperty("label").GetString()!, Explanation: Text(choice, "explanation")))
                : Enumerable.Empty<(string Label, string? Explanation)>())
        .Where(choice => !string.IsNullOrWhiteSpace(choice.Explanation));
    private static string? Text(JsonElement source, string name) => source.ValueKind == JsonValueKind.Object &&
        source.TryGetProperty(name, out var text) ? text.GetString() : null;
    private void Close() => Dialog.Close();
}
