@implements IAsyncDisposable
@using System.Security.Cryptography
@using System.Text
@using Configurator.Core.Definitions
@using Configurator.Presentation
@using Microsoft.JSInterop
@inject IJSRuntime Javascript

@{
    long generation = _generation;
    bool busy = _operation is not null || Form.SecretOperation.IsRunning;
}
<div class="configuration-secret-actions" aria-busy="@(busy ? "true" : "false")">
    @if (Schema.Secret is { Kind: "password-hash" or "digest", Generation: { Input: "entered" } })
    {
        <label for="@(ControlId + "-derive-input")">@Ui("SecretDerivationInput")</label>
        <input id="@(ControlId + "-derive-input")" type="password" autocomplete="off" spellcheck="false"
               value="@_input" disabled="@busy" @oninput="args => SetInput(args, generation)" />
    }
    @if (Schema.Secret?.Generation is not null)
    {
        <button @ref="_generateButton" type="button" class="button button--secondary" data-secret-action="generate"
                aria-label="@(Ui(Value.Length == 0 ? "SecretGenerate" : "SecretRegenerate") + " " + Title)"
                disabled="@(busy || !Form.CanGenerateSecret(Path))" @onclick="() => GenerateAsync(generation)">
            @Ui(Value.Length == 0 ? "SecretGenerate" : "SecretRegenerate")
        </button>
    }
    @if (_operation is not null && busy)
    {
        <button type="button" class="button button--secondary" data-secret-action="cancel"
                aria-label="@(Ui("SecretCancel") + " " + Title)" @onclick="() => Cancel(generation)">@Ui("SecretCancel")</button>
    }
    <button type="button" class="button button--secondary" data-secret-action="reveal" disabled="@(Value.Length == 0 && Schema.Secret?.Encoding != "pkcs8-pem" || busy)"
            aria-label="@(Ui(Revealed ? "SecretHide" : "SecretShow") + " " + Title)"
            aria-controls="@ControlId" aria-pressed="@(Revealed ? "true" : "false")" @onclick="() => RevealAsync(generation)">@Ui(Revealed ? "SecretHide" : "SecretShow")</button>
    <button type="button" class="button button--secondary" data-secret-action="copy" disabled="@(Value.Length == 0 || busy || _export is not null)"
            aria-label="@(Ui("SecretCopy") + " " + Title)"
            @onclick="() => CopyAsync(false, generation)">@Ui("SecretCopy")</button>
    @if (OwnsResult && Form.SecretOperation.HasGeneratedPassword)
    {
        <div class="configuration-secret-actions__original">
            <label for="@(ControlId + "-original")">@Ui("SecretOriginalPassword")</label>
            <input id="@(ControlId + "-original")" type="@(_original is null ? "password" : "text")" readonly
                   autocomplete="off" spellcheck="false" value="@(_original ?? "••••••••")" />
            <button type="button" class="button button--secondary" data-secret-action="reveal-original"
                    aria-label="@(Ui(_original is null ? "SecretShow" : "SecretHide") + " " + Ui("SecretOriginalPassword") + " " + Title)"
                    aria-controls="@(ControlId + "-original")" aria-pressed="@(_original is null ? "false" : "true")"
                    @onclick="() => RevealOriginal(generation)">@Ui(_original is null ? "SecretShow" : "SecretHide")</button>
            <button type="button" class="button button--secondary" data-secret-action="copy-original"
                    disabled="@(_export is not null)"
                    aria-label="@(Ui("SecretCopy") + " " + Ui("SecretOriginalPassword") + " " + Title)"
                    @onclick="() => CopyAsync(true, generation)">@Ui("SecretCopy")</button>
            <button type="button" class="button button--secondary" data-secret-action="dismiss-original"
                    aria-label="@(Ui("SecretDismiss") + " " + Title)"
                    @onclick="() => Dismiss(generation)">@Ui("SecretDismiss")</button>
        </div>
    }
    @if (_status is not null)
    {
        <p role="status" data-secret-status="@_status">@StatusText</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public DefinitionFormModel Form { get; set; } = null!;
    [Parameter, EditorRequired] public DefinitionNode Schema { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<string> Path { get; set; } = [];
    [Parameter, EditorRequired] public string ControlId { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public bool Revealed { get; set; }
    [Parameter] public EventCallback<bool> RevealedChanged { get; set; }
    private DefinitionFormModel? _subscribed;
    private string? _identity;
    private string _input = "";
    private string? _original;
    private string? _status;
    private long _generation;
    private bool _disposed;
    private BrowserArtifactExport? _export;
    private bool _copyingOriginal;
    private CancellationTokenSource? _operation;
    private ElementReference _generateButton;
    private bool _restoreFocus;
    private bool OwnsResult => Form.SecretOperation.EditorIdentity == ControlId;
    private string Ui(string key) => BrowserStrings.Get(key, Form.Locale);
    private string StatusText => _status switch
    {
        "secret-running" => Ui("SecretRunning"),
        "secret-generated" => Ui("SecretGenerated"),
        "copied" => Ui("ArtifactCopiedStatus"),
        "clipboard-unavailable" => Ui("ClipboardUnavailableStatus"),
        _ => Ui("SecretFailed") + " " + DefinitionFormModel.SecretRuleMessage(_status!, Form.Locale)
    };
    private bool Current(long generation) => !_disposed && generation == _generation && Form.CanEdit(Path)
        && Form.SessionPrivacy == DefinitionSessionPrivacy.BrowserSecretsEnabled && Form.GetEditorIdentity(Path) == _identity;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Form) && _identity == ControlId) return;
        Unsubscribe();
        Retire();
        _subscribed = Form;
        _identity = ControlId;
        Form.InputChanged += InputChanged;
        Form.ViewChanged += ViewChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_restoreFocus || _disposed) return;
        _restoreFocus = false;
        if (Form.CanGenerateSecret(Path)) await _generateButton.FocusAsync();
    }

    private void SetInput(ChangeEventArgs args, long generation)
    {
        if (Current(generation) && !Form.SecretOperation.IsRunning) _input = args.Value?.ToString() ?? "";
    }

    private async Task GenerateAsync(long generation)
    {
        if (!Current(generation) || _operation is not null || !Form.CanGenerateSecret(Path)) return;
        generation = ++_generation;
        ReadOnlyMemory<char> input = _input.AsMemory();
        _input = "";
        _original = null;
        _status = "secret-running";
        using var cancellation = new CancellationTokenSource();
        _operation = cancellation;
        try
        {
            StateHasChanged();
            await using (IJSObjectReference rendering = await Javascript.InvokeAsync<IJSObjectReference>("import", "./configuration-rendering.js"))
                await rendering.InvokeVoidAsync("nextFrame", cancellation.Token);
            if (!Current(generation)) return;
            var result = await Form.GenerateSecretAsync(Path, input, YieldAsync, cancellation.Token);
            if (!_disposed && OwnsResult) _status = result.Code;
            else if (Current(generation)) _status = result.Code;
        }
        catch (OperationCanceledException) { if (Current(generation)) _status = "secret-cancelled"; }
        catch (JSException) { if (Current(generation)) _status = "secret-generation-failed"; }
        finally
        {
            if (ReferenceEquals(_operation, cancellation)) _operation = null;
        }
    }

    private void Cancel(long generation) { if (Current(generation)) _operation?.Cancel(); }

    private async ValueTask YieldAsync(CancellationToken token)
    {
        token.ThrowIfCancellationRequested();
        await using IJSObjectReference rendering = await Javascript.InvokeAsync<IJSObjectReference>("import", "./configuration-rendering.js");
        await rendering.InvokeVoidAsync("nextTask", token);
        token.ThrowIfCancellationRequested();
    }

    private Task RevealAsync(long generation) => Current(generation) && !Form.SecretOperation.IsRunning
        ? RevealedChanged.InvokeAsync(!Revealed) : Task.CompletedTask;

    private void RevealOriginal(long generation)
    {
        if (Current(generation) && OwnsResult) _original = _original is null ? Form.CopyGeneratedPassword() : null;
    }

    private void Dismiss(long generation)
    {
        if (!Current(generation) || !OwnsResult) return;
        Retire();
        Form.DismissSecretResult();
        _restoreFocus = true;
    }

    private async Task CopyAsync(bool original, long generation)
    {
        if (!Current(generation) || _export is not null || Form.SecretOperation.IsRunning || original && !OwnsResult) return;
        string? value = original ? Form.CopyGeneratedPassword() : Value;
        if (string.IsNullOrEmpty(value)) return;
        await using var export = new BrowserArtifactExport(Javascript);
        _export = export;
        _copyingOriginal = original;
        byte[] bytes = Encoding.UTF8.GetBytes(value);
        try
        {
            export.SetOutput(bytes);
            bool copied = await export.CopyAsync();
            if (Current(generation)) _status = copied ? "copied" : "clipboard-unavailable";
        }
        finally
        {
            CryptographicOperations.ZeroMemory(bytes);
            if (ReferenceEquals(_export, export)) { _export = null; _copyingOriginal = false; }
        }
    }

    private void Retire()
    {
        ++_generation;
        _input = "";
        _original = null;
        _status = null;
        _operation?.Cancel();
        if (_export is not null) _ = _export.InvalidateAsync();
    }
    private void InputChanged(object? sender, EventArgs args) { Retire(); }
    private void ViewChanged(object? sender, EventArgs args)
    {
        if (_disposed) return;
        if (!OwnsResult || !Form.SecretOperation.HasGeneratedPassword)
        {
            _original = null;
            if (_copyingOriginal && _export is not null) _ = _export.InvalidateAsync();
        }
        if (OwnsResult && Form.SecretOperation.IsRunning) _status = "secret-running";
        _ = InvokeAsync(StateHasChanged);
    }
    private void Unsubscribe()
    {
        if (_subscribed is null) return;
        _subscribed.InputChanged -= InputChanged;
        _subscribed.ViewChanged -= ViewChanged;
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Unsubscribe();
        Retire();
        if (OwnsResult) Form.DismissSecretResult();
        if (_export is not null) await _export.DisposeAsync();
    }
}
