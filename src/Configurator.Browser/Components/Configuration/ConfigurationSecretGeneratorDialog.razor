@using System.ComponentModel
@using System.Globalization
@using System.Security.Cryptography
@using System.Text
@using Configurator.Core.Secrets
@using Configurator.Presentation
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime Javascript

<MudDialog DefaultFocus="DefaultFocus.FirstChild">
    <DialogContent>
        <div class="secret-generator-dialog" data-secret-generator-dialog lang="@Locale" dir="@(PresentationStrings.Culture(Locale).TextInfo.IsRightToLeft ? "rtl" : "ltr")">
            <p class="form-help">@T("SecretGeneratorPrivacyNote")</p>

            @if (Session.Bounds.IsPasswordBased)
            {
                <div class="secret-generator-dialog__field">
                    <label for="secret-generator-length">@T("SecretLengthLabel") (@Session.Bounds.MinLength–@Session.Bounds.MaxLength)</label>
                    <input id="secret-generator-length" type="number" data-generator-length
                           value="@_lengthInput" @oninput="OnLengthChanged" />
                </div>
                <div class="secret-generator-dialog__options">
                    @if (Session.Bounds.AllowsLowercaseToggle || Session.Bounds.RequireLowercase)
                    {
                        <label class="secret-generator-dialog__check">
                            <input type="checkbox" data-generator-option="lowercase"
                                   checked="@(Session.Options.IncludeLowercase ?? false)"
                                   disabled="@(!Session.Bounds.AllowsLowercaseToggle)"
                                   @onchange="args => ToggleOption(options => options with { IncludeLowercase = args.Value is true })" />
                            <span>@T("SecretIncludeLowercase")</span>
                        </label>
                    }
                    @if (Session.Bounds.AllowsUppercaseToggle || Session.Bounds.RequireUppercase)
                    {
                        <label class="secret-generator-dialog__check">
                            <input type="checkbox" data-generator-option="uppercase"
                                   checked="@(Session.Options.IncludeUppercase ?? false)"
                                   disabled="@(!Session.Bounds.AllowsUppercaseToggle)"
                                   @onchange="args => ToggleOption(options => options with { IncludeUppercase = args.Value is true })" />
                            <span>@T("SecretIncludeUppercase")</span>
                        </label>
                    }
                    @if (Session.Bounds.AllowsDigitsToggle || Session.Bounds.RequireDigits)
                    {
                        <label class="secret-generator-dialog__check">
                            <input type="checkbox" data-generator-option="digits"
                                   checked="@(Session.Options.IncludeDigits ?? false)"
                                   disabled="@(!Session.Bounds.AllowsDigitsToggle)"
                                   @onchange="args => ToggleOption(options => options with { IncludeDigits = args.Value is true })" />
                            <span>@T("SecretIncludeDigits")</span>
                        </label>
                    }
                    @if (Session.Bounds.AllowsSymbolsToggle || Session.Bounds.RequireSymbols)
                    {
                        <label class="secret-generator-dialog__check">
                            <input type="checkbox" data-generator-option="symbols"
                                   checked="@(Session.Options.IncludeSymbols ?? false)"
                                   disabled="@(!Session.Bounds.AllowsSymbolsToggle)"
                                   @onchange="args => ToggleOption(options => options with { IncludeSymbols = args.Value is true })" />
                            <span>@T("SecretIncludeSymbols")</span>
                        </label>
                    }
                </div>
            }
            else if (Session.Bounds.IsByteTokenBased && Session.Bounds.MaxBytes > Session.Bounds.MinBytes)
            {
                <div class="secret-generator-dialog__field">
                    <label for="secret-generator-length">@T("SecretByteLengthLabel") (@Session.Bounds.MinBytes–@Session.Bounds.MaxBytes)</label>
                    <input id="secret-generator-length" type="number" data-generator-length
                           value="@_lengthInput" @oninput="OnByteLengthChanged" />
                </div>
            }

            <p class="secret-generator-dialog__entropy" data-entropy-bits="@Session.EstimatedEntropyBits.ToString("F1", CultureInfo.InvariantCulture)">
                @string.Format(PresentationStrings.Culture(Locale), T("SecretEntropyLabel"), Session.EstimatedEntropyBits)
            </p>

            @if (Session.ErrorCode is { } errorCode)
            {
                <p role="alert" class="notice notice--error" data-secret-generator-error="@errorCode">@ErrorMessage(errorCode)</p>
            }

            <div class="secret-generator-dialog__actions">
                <button type="button" class="button button--secondary" data-secret-generator-generate
                        disabled="@(!Session.CanGenerate || Session.IsBusy)" @onclick="GeneratePreviewAsync">@T("SecretGeneratePreview")</button>
            </div>

            @if (Session.HasCandidate)
            {
                <div class="secret-generator-dialog__preview">
                    <label for="secret-generator-preview">@T("SecretPreviewLabel")</label>
                    <div class="secret-generator-dialog__preview-row">
                        <input id="secret-generator-preview" dir="ltr" readonly data-secret-generator-preview
                               type="@(_reveal ? "text" : "password")" value="@(_preview ?? string.Empty)" />
                        <button type="button" class="button button--secondary" data-secret-generator-reveal
                                aria-pressed="@(_reveal ? "true" : "false")" @onclick="ToggleReveal">@T(_reveal ? "SecretHide" : "SecretShow")</button>
                        <button type="button" class="button button--secondary" data-secret-generator-copy
                                @onclick="CopyPreviewAsync">@T("SecretCopy")</button>
                    </div>
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <button type="button" class="button button--secondary" data-secret-generator-cancel @onclick="CancelAsync">@T("Cancel")</button>
        <button type="button" class="button" data-secret-generator-apply disabled="@(!Session.CanApply || Session.IsBusy || _applying)" @onclick="ApplyAsync">@T("SecretApplyGenerated")</button>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public DefinitionFormModel Form { get; set; } = null!;
    [Parameter, EditorRequired] public DefinitionSecretGeneratorSession Session { get; set; } = null!;
    [Parameter] public string Locale { get; set; } = "en";

    private string _lengthInput = string.Empty;
    private string? _preview;
    private bool _reveal;
    private bool _applying;
    private bool _disposed;
    private BrowserArtifactExport? _export;

    protected override void OnInitialized()
    {
        _lengthInput = (Session.Bounds.IsPasswordBased
            ? Session.Options.Length ?? Session.Bounds.DefaultLength
            : Session.Options.Bytes ?? Session.Bounds.DefaultBytes)
            .ToString(CultureInfo.InvariantCulture);
        Session.PropertyChanged += OnSessionChanged;
        Form.InputChanged += OnFormInputChanged;
    }

    private string T(string key) => BrowserStrings.Get(key, Locale);

    private string ErrorMessage(string code) => code switch
    {
        "secret-options-out-of-bounds" => PresentationStrings.Get("SecretOptionsOutOfBounds", Locale),
        "secret-generation-policy-invalid" => PresentationStrings.Get("SecretGenerationPolicyInvalid", Locale),
        "secret-generation-entropy-insufficient" => PresentationStrings.Get("SecretGenerationEntropyInsufficient", Locale),
        _ => T("SecretFailed")
    };

    private void OnLengthChanged(ChangeEventArgs args)
    {
        _lengthInput = args.Value?.ToString() ?? string.Empty;
        _preview = null;
        int parsed = int.TryParse(_lengthInput, NumberStyles.Integer, CultureInfo.InvariantCulture, out int value) ? value : 0;
        Session.UpdateOptions(Session.Options with { Length = parsed });
    }

    private void OnByteLengthChanged(ChangeEventArgs args)
    {
        _lengthInput = args.Value?.ToString() ?? string.Empty;
        _preview = null;
        int parsed = int.TryParse(_lengthInput, NumberStyles.Integer, CultureInfo.InvariantCulture, out int value) ? value : 0;
        Session.UpdateOptions(Session.Options with { Bytes = parsed });
    }

    private void ToggleOption(Func<SecretGenerationOptions, SecretGenerationOptions> update)
    {
        _preview = null;
        Session.UpdateOptions(update(Session.Options));
    }

    private async Task GeneratePreviewAsync()
    {
        if (_disposed || !Session.CanGenerate) return;
        _reveal = false;
        _preview = null;
        var result = await Session.GeneratePreviewAsync();
        if (_disposed) return;
        _preview = result.Succeeded ? Session.CopyPreview() : null;
    }

    private void ToggleReveal() => _reveal = !_reveal;

    private async Task CopyPreviewAsync()
    {
        if (_disposed) return;
        string? candidate = Session.CopyPreview();
        if (string.IsNullOrEmpty(candidate)) return;
        await using var export = new BrowserArtifactExport(Javascript);
        _export = export;
        byte[] bytes = Encoding.UTF8.GetBytes(candidate);
        try
        {
            export.SetOutput(bytes);
            await export.CopyAsync();
        }
        finally
        {
            CryptographicOperations.ZeroMemory(bytes);
            if (ReferenceEquals(_export, export)) _export = null;
        }
    }

    private async Task ApplyAsync()
    {
        if (_disposed || _applying || !Session.CanApply) return;
        _applying = true;
        try
        {
            var result = await Session.ApplyAsync();
            if (!_disposed && result.Succeeded)
            {
                _preview = null;
                _reveal = false;
                Dialog.Close(DialogResult.Ok(true));
            }
        }
        finally
        {
            _applying = false;
        }
    }

    private Task CancelAsync()
    {
        _preview = null;
        _reveal = false;
        Session.Cancel();
        Dialog.Cancel();
        return Task.CompletedTask;
    }

    private void OnSessionChanged(object? sender, PropertyChangedEventArgs args)
    {
        if (_disposed) return;
        if (Session.IsStale && !_applying)
        {
            _preview = null;
            _reveal = false;
            _ = InvokeAsync(() => { if (!_disposed) Dialog.Cancel(); });
            return;
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnFormInputChanged(object? sender, EventArgs args)
    {
        if (_disposed) return;
        if (Form.SessionPrivacy != DefinitionSessionPrivacy.BrowserSecretsEnabled)
        {
            _preview = null;
            _reveal = false;
            Session.Cancel();
            _ = InvokeAsync(() => { if (!_disposed) Dialog.Cancel(); });
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        _preview = null;
        _reveal = false;
        Session.PropertyChanged -= OnSessionChanged;
        Form.InputChanged -= OnFormInputChanged;
        if (_export is not null) await _export.DisposeAsync();
        Session.Dispose();
    }
}
