@implements IDisposable
@using Configurator.Core.Definitions
@using Configurator.Presentation

@if (Form.ImportComparison is { } report)
{
    <section class="configuration-import-review" data-import-comparison aria-labelledby="import-comparison-heading"
             data-import-compatibility="@report.Compatibility"
             data-import-file-autofill="@report.AutofillEligible.ToString().ToLowerInvariant()">
        <h3 id="import-comparison-heading">@Text("ImportComparisonTitle")</h3>
        <p>@Text("ImportComparisonScope")</p>
        <dl class="configuration-import-review__facts">
            <div><dt><strong>@Text("ImportExecution")</strong></dt><dd>@Text(report.ExecutionCompleted ? "ImportCompleted" : "ImportNotCompleted")</dd></div>
            <div><dt><strong>@Text("ImportCompatibility")</strong></dt><dd>@CompatibilityText(report.Compatibility)</dd></div>
            <div><dt><strong>@Text("ImportCoverage")</strong></dt><dd>@Text(report.CoverageComplete ? "ImportCoverageComplete" : "ImportCoveragePartial")</dd></div>
            <div><dt><strong>@Text("ImportInventory")</strong></dt><dd data-import-inventory="@report.InventoryComplete.ToString().ToLowerInvariant()">@Format(report.InventoryComplete ? "ImportInventoryComplete" : "ImportInventoryStopped", report.RetainedFindingCount)</dd></div>
            <div><dt><strong>@Text("ImportFileAutofill")</strong></dt><dd>@Text(report.AutofillEligible ? "ImportEligible" : "ImportIneligible")</dd></div>
            <div><dt><strong>@Text("ImportTargetAcceptance")</strong></dt><dd>@Text("ImportNotAssessed")</dd></div>
        </dl>
        <p id="import-workspace-autofill" data-import-workspace-autofill="@Form.ImportAutofillCode">
            <strong>@Text("ImportFillWorkspace")</strong> @AutofillText(Form.ImportAutofillCode)
            @if (Form.ImportAutofillCode is { } autofillCode) { <code>@($" ({autofillCode})")</code> }
        </p>
        @if (!report.AutofillEligible)
        {
            <p>@Text("ImportRepairCopy")</p>
        }
        else if (Form.ImportAutofillCode == "import-workspace-unsupported")
        {
            <p>@Text("ImportUnsupportedWorkspace")</p>
        }
        else if (!Form.CanAdoptImportComparison)
        {
            <p>@Text("ImportConflictHelp")</p>
        }
        <p>@Text("ImportComparisonBoundary")</p>
        <ul class="configuration-import-review__findings">
            @foreach (var finding in report.Findings.Skip(_page * PageSize).Take(PageSize))
            {
                <li class="@("configuration-import-review__finding" + (Blocking(finding.Kind) ? " configuration-import-review__finding--blocking" : ""))"
                    data-import-finding data-import-severity="@Severity(finding.Kind)">
                    <div class="configuration-import-review__finding-heading">
                        <strong>@Text("ImportSeverity" + Severity(finding.Kind)): @FindingText(finding.Kind) - @FindingTitle(finding)</strong>
                        @if (finding.Schema is not null)
                        {
                            <button type="button" class="button button--secondary" data-action="explain-import-finding"
                                    data-import-schema="@finding.Schema.FieldId"
                                    aria-expanded="@ReferenceEquals(_explainedFinding, finding).ToString().ToLowerInvariant()"
                                    aria-controls="import-schema-explanation"
                                    @onclick="() => Explain(finding)">@Text("ImportExplainSchema")</button>
                        }
                    </div>
                    <p><code>@finding.Code</code></p>
                </li>
            }
        </ul>
        @if (report.Findings.Count > PageSize)
        {
            <nav class="actions" aria-label="@Text("ImportFindingPages")">
                <button type="button" class="button button--secondary" data-action="import-previous"
                        disabled="@(_page == 0)" @onclick="() => ChangePage(-1)">@Text("ImportPrevious")</button>
                <span aria-live="polite" aria-atomic="true" data-import-page="@(_page + 1)">@Format("Page", _page + 1, PageCount(report))</span>
                <button type="button" class="button button--secondary" data-action="import-next"
                        disabled="@(_page + 1 >= PageCount(report))" @onclick="() => ChangePage(1)">@Text("ImportNext")</button>
            </nav>
        }
        @if (_explanation is { } explanation)
        {
            var presentation = Form.GetEditorPresentation(explanation.Path);
            <section id="import-schema-explanation" class="configuration-import-review__explanation" aria-labelledby="import-schema-heading">
                <h4 id="import-schema-heading">@Text("ImportDeclaredSchema") @(presentation?.Title ?? explanation.Title)</h4>
                @if (!string.IsNullOrWhiteSpace(presentation?.Description ?? explanation.Help))
                {
                    <p>@(presentation?.Description ?? explanation.Help)</p>
                }
                <p>@Text("ImportSchemaPath") <code>@string.Join(" / ", explanation.Path)</code></p>
                <p>@Text("ImportExplanationBoundary")</p>
            </section>
        }
        <div class="actions">
            <AppButton data-action="adopt-import-comparison" Disabled="@(!Form.CanAdoptImportComparison)"
                       aria-describedby="import-workspace-autofill" OnClick="() => FillFields.InvokeAsync(report)">@Text("ImportFillFields")</AppButton>
            <AppButton Variant="Variant.Outlined" data-action="clear-import-comparison" OnClick="() => Clear.InvokeAsync(report)">@Text("ImportClearComparison")</AppButton>
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public DefinitionFormModel Form { get; set; } = null!;
    [Parameter] public EventCallback<DefinitionImportReport> FillFields { get; set; }
    [Parameter] public EventCallback<DefinitionImportReport> Clear { get; set; }
    private const int PageSize = 50;
    private DefinitionFormModel? _observedForm;
    private DefinitionImportReport? _observedReport;
    private DefinitionImportFinding? _explainedFinding;
    private DefinitionImportSchemaExplanation? _explanation;
    private int _page;
    private bool _disposed;
    private string Text(string key) => BrowserStrings.Get(key, Form.Locale);
    private string Format(string key, params object[] arguments) => string.Format(System.Globalization.CultureInfo.GetCultureInfo(Form.Locale), Text(key), arguments);

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_observedForm, Form))
        {
            if (_observedForm is not null) _observedForm.ImportComparisonChanged -= ComparisonChanged;
            _observedForm = Form;
            Form.ImportComparisonChanged += ComparisonChanged;
        }
        ObserveComparison();
    }
    private void ComparisonChanged(object? sender, EventArgs args)
    {
        if (_disposed || !ReferenceEquals(sender, Form)) return;
        ObserveComparison();
        _ = InvokeAsync(StateHasChanged);
    }
    private void ObserveComparison()
    {
        if (ReferenceEquals(_observedReport, Form.ImportComparison)) return;
        _observedReport = Form.ImportComparison;
        _page = 0;
        _explainedFinding = null;
        _explanation = null;
    }
    private void Explain(DefinitionImportFinding finding)
    {
        _explanation = Form.ExplainImportFinding(finding);
        _explainedFinding = _explanation is null ? null : finding;
    }
    private void ChangePage(int direction)
    {
        if (Form.ImportComparison is not { } report) return;
        _page = Math.Clamp(_page + direction, 0, PageCount(report) - 1);
        _explainedFinding = null;
        _explanation = null;
    }
    private static int PageCount(DefinitionImportReport report) => Math.Max(1, (report.Findings.Count + PageSize - 1) / PageSize);
    private string FindingTitle(DefinitionImportFinding finding) => finding.Schema is { } schema
        ? Form.GetEditorPresentation([schema.FieldId])?.Title ?? Text("ImportDeclaredSetting") : Text("ImportFileStructure");
    private static bool Blocking(DefinitionImportFindingKind kind) => kind is
        DefinitionImportFindingKind.MissingRequired or DefinitionImportFindingKind.InvalidSuppliedValue or
        DefinitionImportFindingKind.UnrecognizedInput or DefinitionImportFindingKind.StructuralOutputChange;
    private static string Severity(DefinitionImportFindingKind kind) => Blocking(kind) ? "Blocking"
        : kind == DefinitionImportFindingKind.Unassessed ? "Unassessed" : "Information";
    private string FindingText(DefinitionImportFindingKind kind) => PresentationStrings.ImportFinding(kind, Form.Locale);
    private string CompatibilityText(DefinitionImportCompatibility compatibility) => PresentationStrings.ImportCompatibility(compatibility, Form.Locale);
    private string AutofillText(string? code) => PresentationStrings.ImportAutofill(code, Form.Locale);
    public void Dispose()
    {
        _disposed = true;
        if (_observedForm is not null) _observedForm.ImportComparisonChanged -= ComparisonChanged;
        _observedForm = null;
        _observedReport = null;
        _explainedFinding = null;
        _explanation = null;
    }
}
