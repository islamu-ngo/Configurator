@using Configurator.Core.Definitions
@using Configurator.Presentation

@if (ShowEffects && Form is not null)
{
    <section class="configuration-review__effects" data-review-effects aria-label="Configuration effects">
        <p>Values stay masked here. Answer readiness is separate from file preparation and target acceptance.</p>
        <ul class="configuration-review__outputs">
            @foreach (var artifact in Definition.Artifacts)
            {
                <li><strong>@artifact.FileName</strong> · @artifact.ApplySemantics · restart: @artifact.Restart</li>
            }
        </ul>
        <div class="actions">
            <label><input id="review-include-omitted" type="checkbox" checked="@_includeOmitted" @onchange="IncludeOmitted" /> Inspect omitted optional settings</label>
            <label><input id="review-include-inactive" type="checkbox" checked="@_includeInactive" @onchange="IncludeInactive" /> Inspect inactive settings (does not enable them)</label>
        </div>
        <p data-review-count="@_entries.Count">@_entries.Count settings in this review</p>
        <ul class="configuration-review__answers">
            @foreach (var entry in _entries.Skip(_page * PageSize).Take(PageSize))
            {
                var diagnostic = new DefinitionDiagnostic("review-change", entry.FieldId, entry.RelativePath);
                <li @key="Form.GetEditorIdentity(new[] { entry.FieldId }.Concat(entry.RelativePath).ToArray())"
                    data-review-path="@string.Join(".", new[] { entry.FieldId }.Concat(entry.RelativePath))" data-origin="@entry.Origin">
                    <div class="configuration-review__answer">
                        <strong>@FieldTitle(diagnostic)</strong>
                        @if (entry.IsActive)
                        {
                            <button type="button" class="button button--secondary" @onclick="() => ChangeField.InvokeAsync(diagnostic)"
                                    aria-label="@("Change " + FieldTitle(diagnostic))">Change</button>
                        }
                    </div>
                    <p>@OriginText(entry.Origin) · @StateText(entry)</p>
                    @if (entry.Sensitivity != SetupFieldSensitivity.Public && entry.Origin != DefinitionAnswerOrigin.Omitted)
                    {
                        <p>Private value masked.</p>
                    }
                    @if (entry.OutputArtifactIds.Count > 0)
                    {
                        <details><summary>Declared output bindings</summary>
                            <p>@string.Join(", ", entry.OutputArtifactIds)</p>
                            <p>@string.Join(", ", entry.BindingKeys)</p>
                            <p>These are declared references, not a guarantee that a conditional output is included.</p>
                        </details>
                    }
                </li>
            }
        </ul>
        @if (_entries.Count > PageSize)
        {
            <nav class="actions" aria-label="Review pages">
                <button type="button" class="button button--secondary" data-action="review-previous"
                        disabled="@(_page == 0)" @onclick="() => _page--">Previous settings</button>
                <span role="status">Page @(_page + 1) of @PageCount</span>
                <button type="button" class="button button--secondary" data-action="review-next"
                        disabled="@(_page + 1 >= PageCount)" @onclick="() => _page++">Next settings</button>
            </nav>
        }
    </section>
}

@if (Validation is not null || DiagnosticCodes.Count > 0 || InvalidFields.Count > 0)
{
    <section class="configuration-review" aria-labelledby="configuration-review-heading" role="@(DiagnosticCodes.Count > 0 ? "alert" : null)">
        <h3 id="configuration-review-heading">Review preparation</h3>
        @if (Validation?.IsReady == false || InvalidFields.Count > 0 || DiagnosticCodes.Count > 0)
        {
            <p>Check these settings. Values are omitted from diagnostics.</p>
            <ul>
                @foreach (var diagnostic in Validation?.Diagnostics ?? [])
                {
                    <li><button type="button" class="button button--secondary" data-correction="@diagnostic.FieldId" @onclick="() => CorrectField.InvokeAsync(diagnostic)">@FieldTitle(diagnostic)</button>
                        <span>@ConfigurationDiagnosticText.Describe(diagnostic.Code)</span></li>
                }
                @foreach (DefinitionDiagnostic diagnostic in InvalidFields)
                {
                    <li><button type="button" class="button button--secondary" data-correction="@diagnostic.FieldId" @onclick="() => CorrectField.InvokeAsync(diagnostic)">@FieldTitle(diagnostic)</button>
                        <span>@ConfigurationDiagnosticText.Describe("input-type-invalid")</span></li>
                }
            </ul>
            @if (DiagnosticCodes.Count > 0)
            {
                <details><summary>Preparation details</summary><ul>@foreach (string diagnosticCode in DiagnosticCodes.Distinct(StringComparer.Ordinal)) { <li>@diagnosticCode</li> }</ul></details>
            }
        }
        @if (!SecretsEnabled && Validation?.Fields.Any(field => field.IsActive && field.HasError && field.Definition.Sensitivity == SetupFieldSensitivity.Secret) == true)
        {
            <p>Secret entry is disabled for these settings. A draft defers only missing secrets; correct ordinary errors first, or enable masked entry for this workspace.</p>
            <div class="actions">
                <AppButton Variant="Variant.Outlined" data-action="enable-secret-entry" OnClick="() => EnableSecrets.InvokeAsync()">Enable secret entry for this workspace</AppButton>
                <AppButton Variant="Variant.Outlined" OnClick="() => PrepareDraft.InvokeAsync()">Prepare a draft instead</AppButton>
            </div>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public SetupDefinition Definition { get; set; } = null!;
    [Parameter] public DefinitionFormModel? Form { get; set; }
    [Parameter] public bool ShowEffects { get; set; }
    [Parameter] public EventCallback<DefinitionDiagnostic> ChangeField { get; set; }
    [Parameter] public DefinitionValidationResult? Validation { get; set; }
    [Parameter] public IReadOnlyList<string> DiagnosticCodes { get; set; } = [];
    [Parameter] public IReadOnlyList<DefinitionDiagnostic> InvalidFields { get; set; } = [];
    [Parameter] public bool SecretsEnabled { get; set; }
    [Parameter] public EventCallback<DefinitionDiagnostic> CorrectField { get; set; }
    [Parameter] public EventCallback EnableSecrets { get; set; }
    [Parameter] public EventCallback PrepareDraft { get; set; }
    private const int PageSize = 50;
    private DefinitionFormModel? _observedForm;
    private SetupDefinition? _observedDefinition;
    private IReadOnlyDictionary<string, SetupFieldDefinition> _fieldsById = new Dictionary<string, SetupFieldDefinition>();
    private string? _observedExperience;
    private bool _includeOmitted;
    private bool _includeInactive;
    private int _page;
    private IReadOnlyList<DefinitionDiscoveryEntry> _entries = [];
    private int PageCount => Math.Max(1, (_entries.Count + PageSize - 1) / PageSize);
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_observedDefinition, Definition))
        {
            _observedDefinition = Definition;
            _fieldsById = Definition.Fields.ToDictionary(field => field.Id, StringComparer.Ordinal);
        }
        if (!ReferenceEquals(_observedForm, Form))
        {
            _observedForm = Form;
            _includeOmitted = false;
            _includeInactive = false;
            _page = 0;
        }
        if (_observedExperience != Form?.SelectedExperienceId) _page = 0;
        _observedExperience = Form?.SelectedExperienceId;
        SelectEntries();
    }
    private void IncludeOmitted(ChangeEventArgs args)
    {
        _includeOmitted = args.Value is true;
        _page = 0;
        SelectEntries();
    }
    private void IncludeInactive(ChangeEventArgs args)
    {
        _includeInactive = args.Value is true;
        _page = 0;
        SelectEntries();
    }
    private void SelectEntries()
    {
        if (ShowEffects && Form is not null)
        {
            var projection = Form.Projection;
            var relevant = projection.RelevantEntries.ToHashSet();
            _entries = projection.Entries.Where(entry => relevant.Contains(entry) ||
                (entry.IsActive ? _includeOmitted : _includeInactive)).ToArray();
        }
        else _entries = [];
        _page = Math.Min(_page, PageCount - 1);
    }
    private static string OriginText(DefinitionAnswerOrigin origin) => origin switch
    {
        DefinitionAnswerOrigin.Defaulted => "Authored default",
        DefinitionAnswerOrigin.Imported => "Imported",
        DefinitionAnswerOrigin.Explicit => "Explicitly supplied",
        _ => "Omitted"
    };
    private static string StateText(DefinitionDiscoveryEntry entry) => !entry.IsActive ? "Inactive; not exported"
        : entry.IsDeferred ? "Secret deferred; incomplete"
        : entry.NeedsAttention ? "Needs correction"
        : entry.IsReady ? "Answer ready"
        : entry.IsRequired ? "Required answer missing" : "Optional; no supplied answer";
    private string FieldTitle(DefinitionDiagnostic diagnostic)
    {
        if (!_fieldsById.TryGetValue(diagnostic.FieldId, out var field)) return "Preparation";
        var titles = new List<string> { ConfigurationDiagnosticText.Title(field) };
        DefinitionNode node = field.Node;
        foreach (string segment in diagnostic.RelativePath)
        {
            if (node.Items is { } item && int.TryParse(segment, out int row))
            {
                node = item;
                titles.Add($"Item {row + 1}");
            }
            else
            {
                if (!node.Properties.TryGetValue(segment, out var child)) break;
                node = child;
                titles.Add(node.Keywords.TryGetProperty("title", out var title) ? title.GetString()!
                    : string.IsNullOrWhiteSpace(segment) ? "Setting" : segment);
            }
        }
        return string.Join(" / ", titles);
    }
}
