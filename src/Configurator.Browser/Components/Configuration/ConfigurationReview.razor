@using System.Globalization
@using Configurator.Core.Definitions
@using Configurator.Presentation

@if (Validation is not null || DiagnosticCodes.Count > 0 || InvalidFields.Count > 0)
{
    <section class="configuration-review" aria-labelledby="configuration-review-heading" role="@(DiagnosticCodes.Count > 0 ? "alert" : null)">
        <h3 id="configuration-review-heading">@Ui("ReviewPreparationTitle")</h3>
        @if (Validation?.IsReady == false || InvalidFields.Count > 0 || DiagnosticCodes.Count > 0)
        {
            <p>@Ui("ReviewCorrectionsHelp")</p>
            <ul>
                @foreach (var diagnostic in Validation?.Diagnostics ?? [])
                {
                    <li><button type="button" class="button button--secondary" data-correction="@diagnostic.FieldId"
                                aria-label="@UiFormat("ReviewCorrectField", FieldTitle(diagnostic))" @onclick="() => CorrectField.InvokeAsync(diagnostic)">@FieldTitle(diagnostic)</button>
                        <span>@DescribeDiagnostic(diagnostic.Code)</span></li>
                }
                @foreach (DefinitionDiagnostic diagnostic in InvalidFields)
                {
                    <li><button type="button" class="button button--secondary" data-correction="@diagnostic.FieldId"
                                aria-label="@UiFormat("ReviewCorrectField", FieldTitle(diagnostic))" @onclick="() => CorrectField.InvokeAsync(diagnostic)">@FieldTitle(diagnostic)</button>
                        <span>@DescribeDiagnostic("input-type-invalid")</span></li>
                }
            </ul>
            @if (DiagnosticCodes.Count > 0)
            {
                <details><summary>@Ui("ReviewDetails")</summary><ul>@foreach (string diagnosticCode in DiagnosticCodes.Distinct(StringComparer.Ordinal)) { <li>@diagnosticCode</li> }</ul></details>
            }
        }
        @if (!SecretsEnabled && Validation?.Fields.Any(field => field.IsActive && field.HasError && field.Definition.Sensitivity == SetupFieldSensitivity.Secret) == true)
        {
            <p>@Ui("ReviewSecretsDisabled")</p>
            <div class="actions">
                <AppButton Variant="Variant.Outlined" data-action="enable-secret-entry" OnClick="() => EnableSecrets.InvokeAsync()">@Ui("EnableWorkspaceSecrets")</AppButton>
            </div>
        }
    </section>
}

@if (ShowEffects && Form is not null)
{
    <section class="configuration-review__effects" data-review-effects aria-label="@Ui("ReviewEffects")">
        <p>@Ui("ReviewEffectsHelp")</p>
        <p>@Ui("ReviewDeclaredOutputs")</p>
        <ul class="configuration-review__outputs">
            @foreach (var artifact in SelectedArtifacts())
            {
                <li data-review-output="@artifact.Id"><strong>@artifact.FileName</strong> · @artifact.Format · @artifact.ApplySemantics · @UiFormat("ReviewRestart", artifact.Restart)</li>
            }
        </ul>
        <div class="actions">
            <label><input id="review-include-omitted" type="checkbox" checked="@_includeOmitted" @onchange="IncludeOmitted" /> @Ui("ReviewInspectOmitted")</label>
            <label><input id="review-include-inactive" type="checkbox" checked="@_includeInactive" @onchange="IncludeInactive" /> @Ui("ReviewInspectInactive")</label>
        </div>
        <p data-review-count="@_entries.Count">@UiFormat("ReviewSettingsCount", _entries.Count)</p>
        <ul class="configuration-review__answers">
            @foreach (var entry in _entries.Skip(_page * PageSize).Take(PageSize))
            {
                var diagnostic = new DefinitionDiagnostic("review-change", entry.FieldId, entry.RelativePath);
                <li @key="Form.GetEditorIdentity(new[] { entry.FieldId }.Concat(entry.RelativePath).ToArray())"
                    data-review-path="@string.Join(".", new[] { entry.FieldId }.Concat(entry.RelativePath))" data-origin="@entry.Origin">
                    <div class="configuration-review__answer">
                        <strong>@FieldTitle(diagnostic)</strong>
                        @if (entry.IsActive)
                        {
                            <button type="button" class="button button--secondary" @onclick="() => ChangeField.InvokeAsync(diagnostic)"
                                    aria-label="@UiFormat("ReviewChangeField", FieldTitle(diagnostic))">@Ui("ReviewChange")</button>
                        }
                    </div>
                    <p>@StateText(entry)</p>
                    @if (entry.Sensitivity != SetupFieldSensitivity.Public && entry.Origin != DefinitionAnswerOrigin.Omitted)
                    {
                        <p>@Ui("ReviewPrivateMasked")</p>
                    }
                    @if (entry.OutputArtifactIds.Count > 0)
                    {
                        <details><summary>@Ui("ReviewBindings")</summary>
                            <p>@OriginText(entry.Origin)</p>
                            <p>@string.Join(", ", entry.OutputArtifactIds)</p>
                            <p>@string.Join(", ", entry.BindingKeys)</p>
                            <p>@Ui("ReviewBindingsHelp")</p>
                        </details>
                    }
                </li>
            }
        </ul>
        @if (_entries.Count > PageSize)
        {
            <nav class="actions" aria-label="@Ui("ReviewPages")">
                <button type="button" class="button button--secondary" data-action="review-previous"
                        disabled="@(_page == 0)" @onclick="() => _page--">@Ui("ReviewPrevious")</button>
                <span role="status">@UiFormat("ReviewPage", _page + 1, PageCount)</span>
                <button type="button" class="button button--secondary" data-action="review-next"
                        disabled="@(_page + 1 >= PageCount)" @onclick="() => _page++">@Ui("ReviewNext")</button>
            </nav>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public SetupDefinition Definition { get; set; } = null!;
    [Parameter] public DefinitionFormModel? Form { get; set; }
    [Parameter] public bool ShowEffects { get; set; }
    [Parameter] public EventCallback<DefinitionDiagnostic> ChangeField { get; set; }
    [Parameter] public DefinitionValidationResult? Validation { get; set; }
    [Parameter] public IReadOnlyList<string> DiagnosticCodes { get; set; } = [];
    [Parameter] public IReadOnlyList<DefinitionDiagnostic> InvalidFields { get; set; } = [];
    [Parameter] public bool SecretsEnabled { get; set; }
    [Parameter] public EventCallback<DefinitionDiagnostic> CorrectField { get; set; }
    [Parameter] public EventCallback EnableSecrets { get; set; }
    private const int PageSize = 50;
    private DefinitionFormModel? _observedForm;
    private SetupDefinition? _observedDefinition;
    private IReadOnlyDictionary<string, SetupFieldDefinition> _fieldsById = new Dictionary<string, SetupFieldDefinition>();
    private string? _observedExperience;
    private bool _includeOmitted;
    private bool _includeInactive;
    private int _page;
    private IReadOnlyList<DefinitionDiscoveryEntry> _entries = [];
    private int PageCount => Math.Max(1, (_entries.Count + PageSize - 1) / PageSize);
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_observedDefinition, Definition))
        {
            _observedDefinition = Definition;
            _fieldsById = Definition.Fields.ToDictionary(field => field.Id, StringComparer.Ordinal);
        }
        if (!ReferenceEquals(_observedForm, Form))
        {
            _observedForm = Form;
            _includeOmitted = false;
            _includeInactive = false;
            _page = 0;
        }
        if (_observedExperience != Form?.SelectedExperienceId) _page = 0;
        _observedExperience = Form?.SelectedExperienceId;
        SelectEntries();
    }
    private void IncludeOmitted(ChangeEventArgs args)
    {
        _includeOmitted = args.Value is true;
        _page = 0;
        SelectEntries();
    }
    private void IncludeInactive(ChangeEventArgs args)
    {
        _includeInactive = args.Value is true;
        _page = 0;
        SelectEntries();
    }
    private void SelectEntries()
    {
        if (ShowEffects && Form is not null)
        {
            var projection = Form.Projection;
            var relevant = projection.RelevantEntries.ToHashSet();
            string? selectorField = Definition.Presentation?.OutputSelector is { } selector
                ? DefinitionProfile.FieldId(selector.Location.Segments[0]) : null;
            _entries = projection.Entries.Where(entry => (relevant.Contains(entry) && entry.FieldId != selectorField) ||
                (entry.IsActive ? _includeOmitted : _includeInactive)).ToArray();
        }
        else _entries = [];
        _page = Math.Min(_page, PageCount - 1);
    }
    private string Ui(string key) => BrowserStrings.Get(key, Form?.Locale ?? "en");
    private IEnumerable<SetupArtifactDefinition> SelectedArtifacts()
    {
        if (Definition.Presentation?.OutputSelector is not { } selector || Form is null)
            return Definition.Artifacts;
        if (!Form.Validate().TryGetEffectiveValue(selector.Location, out var value)) return [];
        var option = selector.Options.FirstOrDefault(option => option.Value == value.GetString());
        return option is null ? [] : Definition.Artifacts.Where(artifact => option.ArtifactIds.Contains(artifact.Id));
    }
    private string UiFormat(string key, params object[] values) =>
        string.Format(CultureInfo.GetCultureInfo(Form?.Locale ?? "en"), Ui(key), values);
    private string OriginText(DefinitionAnswerOrigin origin) => Ui(origin switch
    {
        DefinitionAnswerOrigin.Defaulted => "ReviewOriginDefault",
        DefinitionAnswerOrigin.Imported => "ReviewOriginImported",
        DefinitionAnswerOrigin.Explicit => "ReviewOriginExplicit",
        _ => "ReviewOriginOmitted"
    });
    private string StateText(DefinitionDiscoveryEntry entry) => Ui(!entry.IsActive ? "ReviewStateInactive"
        : entry.IsDeferred ? "ReviewStateDeferred"
        : entry.NeedsAttention ? "ReviewStateCorrection"
        : entry.IsProvided && entry.IsReady ? "ReviewStateReady"
        : entry.IsRequired ? "ReviewStateRequiredMissing" : "ReviewStateOptionalMissing");
    private string DescribeDiagnostic(string code)
    {
        string key = code switch
        {
            "value-required" => "ReviewValueRequired",
            "value-type-invalid" or "input-type-invalid" => "ReviewTypeInvalid",
            "value-duplicate" => "ReviewUniqueKey",
            "value-invalid" or "value-constraint-invalid" => "ReviewConstraints",
            "answer-budget-exceeded" => "ReviewInputTooLarge",
            "draft-dependency-unresolved" => "ReviewDeferredDependency",
            "artifact-omitted" => "ReviewArtifactOmitted",
            _ => "ReviewCheckDefinition"
        };
        return $"{Ui(key)} ({code})";
    }
    private string FieldTitle(DefinitionDiagnostic diagnostic)
    {
        var entry = Form?.Projection.Entries.FirstOrDefault(entry => entry.FieldId == diagnostic.FieldId &&
            entry.RelativePath.SequenceEqual(diagnostic.RelativePath));
        if (entry is not null) return entry.Title;
        if (!_fieldsById.TryGetValue(diagnostic.FieldId, out var field)) return Ui("ReviewPreparation");
        var titles = new List<string> { ConfigurationDiagnosticText.Title(field) };
        DefinitionNode node = field.Node;
        foreach (string segment in diagnostic.RelativePath)
        {
            if (node.Items is { } item && int.TryParse(segment, out int row))
            {
                node = item;
                titles.Add($"{Ui("FieldItem")} {row + 1}");
            }
            else
            {
                if (!node.Properties.TryGetValue(segment, out var child)) break;
                node = child;
                titles.Add(node.Keywords.TryGetProperty("title", out var title) ? title.GetString()!
                    : string.IsNullOrWhiteSpace(segment) ? Ui("FieldSetting") : segment);
            }
        }
        return string.Join(" / ", titles);
    }
}
