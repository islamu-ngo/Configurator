@using System.Globalization
@using Configurator.Core.Definitions
@using Configurator.Presentation

@if (Validation is not null || DiagnosticCodes.Count > 0 || InvalidFields.Count > 0)
{
    <section class="configuration-review" aria-labelledby="configuration-review-heading" role="@(DiagnosticCodes.Count > 0 ? "alert" : null)">
        <h3 id="configuration-review-heading">@Ui("ReviewPreparationTitle")</h3>
        @if (Validation?.IsReady == false || InvalidFields.Count > 0 || DiagnosticCodes.Count > 0)
        {
            Dictionary<(string FieldId, string RelKey), DefinitionDiscoveryEntry>? diagTitleLookup = BuildDiagnosticTitleLookup();
            IReadOnlyList<DefinitionDiagnostic> validationDiagnostics = Validation?.Diagnostics ?? [];
            int totalCorrections = validationDiagnostics.Count + InvalidFields.Count;
            int correctionsPageCount = Math.Max(1, (totalCorrections + CorrectionsPageSize - 1) / CorrectionsPageSize);
            int currentCorrectionPage = Math.Clamp(_correctionsPage, 0, correctionsPageCount - 1);
            int start = currentCorrectionPage * CorrectionsPageSize;
            int end = Math.Min(totalCorrections, start + CorrectionsPageSize);
            <p>@Ui("ReviewCorrectionsHelp")</p>
            <ul>
                @for (int index = start; index < end; index++)
                {
                    bool fromValidation = index < validationDiagnostics.Count;
                    DefinitionDiagnostic diagnostic = fromValidation
                        ? validationDiagnostics[index]
                        : InvalidFields[index - validationDiagnostics.Count];
                    string code = fromValidation ? diagnostic.Code : "input-type-invalid";
                    string diagTitle = FieldTitle(diagnostic, diagTitleLookup);
                    <li><button type="button" class="button button--secondary" data-correction="@diagnostic.FieldId"
                                aria-label="@UiFormat("ReviewCorrectField", diagTitle)" @onclick="() => CorrectField.InvokeAsync(diagnostic)">@diagTitle</button>
                        <span>@DescribeDiagnostic(code)</span></li>
                }
            </ul>
            @if (totalCorrections > CorrectionsPageSize)
            {
                <nav class="actions" aria-label="@Ui("ReviewPages")">
                    <button type="button" class="button button--secondary" data-action="review-corrections-previous"
                            disabled="@(currentCorrectionPage == 0)" @onclick="() => _correctionsPage = Math.Max(0, currentCorrectionPage - 1)">@Ui("ReviewPrevious")</button>
                    <span role="status">@UiFormat("ReviewPage", currentCorrectionPage + 1, correctionsPageCount)</span>
                    <button type="button" class="button button--secondary" data-action="review-corrections-next"
                            disabled="@(currentCorrectionPage + 1 >= correctionsPageCount)" @onclick="() => _correctionsPage = Math.Min(correctionsPageCount - 1, currentCorrectionPage + 1)">@Ui("ReviewNext")</button>
                </nav>
            }
            @if (DiagnosticCodes.Count > 0)
            {
                <details><summary>@Ui("ReviewDetails")</summary><ul>@foreach (string diagnosticCode in DiagnosticCodes.Distinct(StringComparer.Ordinal)) { <li>@diagnosticCode</li> }</ul></details>
            }
        }
        @if (!SecretsEnabled && Validation?.Nodes.Any(node => node.IsActive && node.HasError && node.Sensitivity == FieldSensitivity.Secret) == true)
        {
            <p>@Ui("ReviewSecretsDisabled")</p>
            <div class="actions">
                <AppButton Variant="Variant.Outlined" data-action="enable-secret-entry" OnClick="() => EnableSecrets.InvokeAsync()">@Ui("EnableWorkspaceSecrets")</AppButton>
            </div>
        }
    </section>
}

@if (ShowEffects && Form is not null)
{
    <section class="configuration-review__effects" data-review-effects aria-label="@Ui("ReviewEffects")">
        <p class="form-help configuration-review__steps" data-review-steps>@Ui("FilesStepSequence")</p>
        <p>@Ui("ReviewEffectsHelp")</p>
        <p>@Ui("ReviewDeclaredOutputs")</p>
        <ul class="configuration-review__outputs">
            @foreach (var artifact in SelectedArtifacts())
            {
                <li data-review-output="@artifact.Id"><strong><bdi dir="ltr">@artifact.FileName</bdi></strong> · <bdi dir="ltr">@artifact.Format.ToToken()</bdi> · <bdi dir="ltr">@artifact.ApplySemantics.ToToken()</bdi> · @UiFormat("ReviewRestart", artifact.Restart.ToToken())</li>
            }
        </ul>
        <div class="actions">
            <label><input id="review-include-omitted" type="checkbox" checked="@_includeOmitted" @onchange="IncludeOmitted" /> @Ui("ReviewInspectOmitted")</label>
            <label><input id="review-include-inactive" type="checkbox" checked="@_includeInactive" @onchange="IncludeInactive" /> @Ui("ReviewInspectInactive")</label>
        </div>
        <div class="configuration-review__origin-filters" role="group" aria-label="@Ui("ReviewOriginFilterLabel")">
            <button type="button"
                    class="button button--secondary configuration-review__filter-chip @(_originFilter is null ? "configuration-review__filter-chip--active" : "")"
                    data-review-origin-filter="All"
                    aria-pressed="@(_originFilter is null ? "true" : "false")"
                    @onclick="() => SetOriginFilter(null)">@Ui("ReviewOriginAll")</button>
            @foreach (DefinitionAnswerOrigin origin in OriginFilters)
            {
                <button type="button"
                        class="button button--secondary configuration-review__filter-chip @(_originFilter == origin ? "configuration-review__filter-chip--active" : "")"
                        data-review-origin-filter="@origin.ToString()"
                        aria-pressed="@(_originFilter == origin ? "true" : "false")"
                        @onclick="() => SetOriginFilter(origin)">@OriginText(origin)</button>
            }
        </div>
        <p data-review-count="@_entries.Count">@UiFormat("ReviewSettingsCount", _entries.Count)</p>
        @{
            Dictionary<(string FieldId, string RelKey), DefinitionNodeState>? reviewNodes = GetReviewNodes();
            Dictionary<(string FieldId, string RelKey), DefinitionDiscoveryEntry>? entryTitleLookup = BuildDiagnosticTitleLookup();
        }
        <ul class="configuration-review__answers">
            @foreach (var entry in _entries.Skip(_page * PageSize).Take(PageSize))
            {
                var node = reviewNodes![(entry.FieldId, string.Join('\0', entry.RelativePath))];
                var diagnostic = new DefinitionDiagnostic("review-change", entry.FieldId, node.Location);
                string entryTitle = FieldTitle(diagnostic, entryTitleLookup);
                <li @key="(entry.FieldId, node.Location)"
                    data-review-path="@string.Join(".", entry.FieldId.Length == 0 ? entry.RelativePath : new[] { entry.FieldId }.Concat(entry.RelativePath))" data-origin="@entry.Origin">
                    <div class="configuration-review__answer">
                        <strong>@entryTitle</strong>
                        @if (entry.IsActive)
                        {
                            <button type="button" class="button button--secondary" data-action="review-focus-row" @onclick="() => ChangeField.InvokeAsync(diagnostic)"
                                    aria-label="@UiFormat("ReviewChangeField", entryTitle)">@Ui("ReviewChange")</button>
                        }
                    </div>
                    <p>@StateText(entry)</p>
                    @if (entry.Sensitivity != FieldSensitivity.Public && entry.Origin != DefinitionAnswerOrigin.Omitted)
                    {
                        <p>@Ui("ReviewPrivateMasked")</p>
                    }
                    @if (entry.OutputArtifactIds.Count > 0)
                    {
                        <details><summary>@Ui("ReviewBindings")</summary>
                            <p>@OriginText(entry.Origin)</p>
                            <p><bdi dir="ltr">@string.Join(", ", entry.OutputArtifactIds)</bdi></p>
                            <p><code dir="ltr">@string.Join(", ", entry.BindingKeys)</code></p>
                            <p>@Ui("ReviewBindingsHelp")</p>
                        </details>
                    }
                </li>
            }
        </ul>
        @if (_entries.Count > PageSize)
        {
            <nav class="actions" aria-label="@Ui("ReviewPages")">
                <button type="button" class="button button--secondary" data-action="review-previous"
                        disabled="@(_page == 0)" @onclick="() => _page--">@Ui("ReviewPrevious")</button>
                <span role="status">@UiFormat("ReviewPage", _page + 1, PageCount)</span>
                <button type="button" class="button button--secondary" data-action="review-next"
                        disabled="@(_page + 1 >= PageCount)" @onclick="() => _page++">@Ui("ReviewNext")</button>
            </nav>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public Definition Definition { get; set; } = null!;
    [Parameter] public DefinitionFormModel? Form { get; set; }
    [Parameter] public bool ShowEffects { get; set; }
    [Parameter] public EventCallback<DefinitionDiagnostic> ChangeField { get; set; }
    [Parameter] public DefinitionValidationResult? Validation { get; set; }
    [Parameter] public IReadOnlyList<string> DiagnosticCodes { get; set; } = [];
    [Parameter] public IReadOnlyList<DefinitionDiagnostic> InvalidFields { get; set; } = [];
    [Parameter] public bool SecretsEnabled { get; set; }
    [Parameter] public EventCallback<DefinitionDiagnostic> CorrectField { get; set; }
    [Parameter] public EventCallback EnableSecrets { get; set; }
    private const int PageSize = 50;
    private const int CorrectionsPageSize = 25;
    private static readonly DefinitionAnswerOrigin[] OriginFilters =
    [
        DefinitionAnswerOrigin.Explicit,
        DefinitionAnswerOrigin.Generated,
        DefinitionAnswerOrigin.Defaulted,
        DefinitionAnswerOrigin.Imported
    ];
    private DefinitionFormModel? _observedForm;
    private Definition? _observedDefinition;
    private IReadOnlyDictionary<string, FieldDefinition> _fieldsById = new Dictionary<string, FieldDefinition>();
    private string? _observedExperience;
    private bool _includeOmitted;
    private bool _includeInactive;
    private DefinitionAnswerOrigin? _originFilter;
    private int _page;
    private int _correctionsPage;
    private IReadOnlyList<DefinitionDiscoveryEntry> _entries = [];
    private DefinitionFormProjection? _cachedEntryProjection;
    private Dictionary<(string FieldId, string RelKey), DefinitionDiscoveryEntry>? _cachedEntryLookup;
    private DefinitionValidationResult? _cachedNodeValidation;
    private Dictionary<(string FieldId, string RelKey), DefinitionNodeState>? _cachedReviewNodes;
    private int PageCount => Math.Max(1, (_entries.Count + PageSize - 1) / PageSize);
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_observedDefinition, Definition))
        {
            _observedDefinition = Definition;
            _fieldsById = Definition.Fields.ToDictionary(field => field.Id, StringComparer.Ordinal);
        }
        if (!ReferenceEquals(_observedForm, Form))
        {
            _observedForm = Form;
            _includeOmitted = false;
            _includeInactive = false;
            _originFilter = null;
            _page = 0;
            _correctionsPage = 0;
        }
        if (_observedExperience != Form?.SelectedExperienceId)
        {
            _page = 0;
            _correctionsPage = 0;
        }
        int totalCorrections = (Validation?.Diagnostics.Count ?? 0) + InvalidFields.Count;
        int correctionsPageCount = Math.Max(1, (totalCorrections + CorrectionsPageSize - 1) / CorrectionsPageSize);
        _correctionsPage = Math.Min(_correctionsPage, correctionsPageCount - 1);
        _observedExperience = Form?.SelectedExperienceId;
        SelectEntries();
    }
    private void IncludeOmitted(ChangeEventArgs args)
    {
        _includeOmitted = args.Value is true;
        _page = 0;
        SelectEntries();
    }
    private void IncludeInactive(ChangeEventArgs args)
    {
        _includeInactive = args.Value is true;
        _page = 0;
        SelectEntries();
    }
    private void SetOriginFilter(DefinitionAnswerOrigin? origin)
    {
        if (_originFilter == origin) return;
        _originFilter = origin;
        _page = 0;
        SelectEntries();
    }
    private void SelectEntries()
    {
        if (ShowEffects && Form is not null)
        {
            var projection = Form.Projection;
            var relevant = new HashSet<DefinitionDiscoveryEntry>(projection.RelevantEntries, ReferenceEqualityComparer.Instance);
            string? selectorField = Definition.Presentation?.OutputSelector is { } selector
                ? DefinitionProfile.FieldId(selector.Location.Segments[0]) : null;
            _entries = projection.Entries.Where(entry =>
                ((relevant.Contains(entry) && entry.FieldId != selectorField) || (entry.IsActive ? _includeOmitted : _includeInactive))
                && (_originFilter is null || entry.Origin == _originFilter.Value)).ToArray();
        }
        else _entries = [];
        _page = Math.Min(_page, PageCount - 1);
    }
    private string Ui(string key) => BrowserStrings.Get(key, Form?.Locale ?? "en");
    private IEnumerable<ArtifactDefinition> SelectedArtifacts()
    {
        if (Definition.Presentation?.OutputSelector is not { } selector || Form is null)
            return Definition.Artifacts;
        if (!Form.Validate().TryGetEffectiveValue(selector.Location, out var value)) return [];
        var option = selector.Options.FirstOrDefault(option => option.Value == value.GetString());
        return option is null ? [] : Definition.Artifacts.Where(artifact => option.ArtifactIds.Contains(artifact.Id));
    }
    private string UiFormat(string key, params object[] values) =>
        string.Format(CultureInfo.GetCultureInfo(Form?.Locale ?? "en"), Ui(key), values);
    private string OriginText(DefinitionAnswerOrigin origin) => Ui(origin switch
    {
        DefinitionAnswerOrigin.Defaulted => "ReviewOriginDefault",
        DefinitionAnswerOrigin.Imported => "ReviewOriginImported",
        DefinitionAnswerOrigin.Generated => "SecretGeneratedOrigin",
        DefinitionAnswerOrigin.Explicit => "ReviewOriginExplicit",
        _ => "ReviewOriginOmitted"
    });
    private string StateText(DefinitionDiscoveryEntry entry) => Ui(!entry.IsActive ? "ReviewStateInactive"
        : entry.IsDeferred ? "ReviewStateDeferred"
        : entry.NeedsAttention ? "ReviewStateCorrection"
        : entry.IsProvided && entry.IsReady ? "ReviewStateReady"
        : entry.IsRequired ? "ReviewStateRequiredMissing" : "ReviewStateOptionalMissing");
    private static string EntryStateToken(DefinitionDiscoveryEntry entry) => !entry.IsActive ? "inactive"
        : entry.IsDeferred ? "deferred"
        : entry.NeedsAttention ? "correction"
        : entry.IsProvided && entry.IsReady ? "ready"
        : entry.IsRequired ? "missing-required" : "optional-missing";
    private string DescribeDiagnostic(string code) => ConfigurationDiagnosticText.Describe(code, Form?.Locale ?? "en");
    private Dictionary<(string FieldId, string RelKey), DefinitionNodeState>? GetReviewNodes()
    {
        if (Form is null) return null;
        DefinitionValidationResult validation = Validation ?? Form.Validate();
        if (ReferenceEquals(_cachedNodeValidation, validation) && _cachedReviewNodes is not null)
            return _cachedReviewNodes;
        var map = new Dictionary<(string FieldId, string RelKey), DefinitionNodeState>(validation.Nodes.Count);
        foreach (var node in validation.Nodes)
            map[(node.FieldId, node.RelativePath.Count == 0 ? string.Empty : string.Join('\0', node.RelativePath))] = node;
        _cachedNodeValidation = validation;
        return _cachedReviewNodes = map;
    }

    private Dictionary<(string FieldId, string RelKey), DefinitionDiscoveryEntry>? BuildDiagnosticTitleLookup()
    {
        if (Form is null) return null;
        DefinitionFormProjection projection = Form.Projection;
        if (ReferenceEquals(_cachedEntryProjection, projection) && _cachedEntryLookup is not null)
            return _cachedEntryLookup;
        var entries = projection.Entries;
        var map = new Dictionary<(string FieldId, string RelKey), DefinitionDiscoveryEntry>(entries.Count);
        foreach (var entry in entries)
            map.TryAdd((entry.FieldId, entry.RelativePath.Count == 0 ? string.Empty : string.Join('\0', entry.RelativePath)), entry);
        _cachedEntryProjection = projection;
        return _cachedEntryLookup = map;
    }

    private string FieldTitle(DefinitionDiagnostic diagnostic, Dictionary<(string FieldId, string RelKey), DefinitionDiscoveryEntry>? lookup = null)
    {
        var entry = lookup is not null
            ? lookup.GetValueOrDefault((diagnostic.FieldId, string.Join('\0', diagnostic.RelativePath)))
            : Form?.Projection.Entries.FirstOrDefault(entry => entry.FieldId == diagnostic.FieldId &&
                entry.RelativePath.SequenceEqual(diagnostic.RelativePath));
        if (entry is not null) return entry.Title;
        if (!_fieldsById.TryGetValue(diagnostic.FieldId, out var field)) return Ui("ReviewPreparation");
        var titles = new List<string> { Form?.GetEditorPresentation([diagnostic.FieldId])?.Title ?? DefinitionDisplayText.Resolve(field.Title, field.Name) };
        DefinitionNode node = field.Node;
        foreach (string segment in diagnostic.RelativePath)
        {
            if (node.Items is { } item && int.TryParse(segment, out int row))
            {
                node = item;
                titles.Add($"{Ui("FieldItem")} {row + 1}");
            }
            else
            {
                if (!node.Properties.TryGetValue(segment, out var child)) break;
                node = child;
                titles.Add(node.Keywords.TryGetProperty("title", out var title) ? title.GetString()!
                    : string.IsNullOrWhiteSpace(segment) ? Ui("FieldSetting") : segment);
            }
        }
        return string.Join(" / ", titles);
    }
}
