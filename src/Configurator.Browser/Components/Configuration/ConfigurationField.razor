@implements IDisposable
@using System.Globalization
@using System.Text.Json

<div class="configuration-field" data-field="@string.Join('.', Path)">
    @if (!Form.IsEditorVisible(Path))
    {
        <div class="configuration-field__collapsed">
            <div><strong>@Title</strong><p class="configuration-field__help">@Help</p></div>
            <button type="button" class="button button--secondary" data-action="expand-field"
                    aria-expanded="false" @onclick="ExpandEditor">Configure @Title</button>
        </div>
    }
    else
    {
    @if (Type is "object" or "list")
    {
        <fieldset @ref="_group" tabindex="-1" aria-describedby="@(ControlId + "-help " + ControlId + "-error")"
                  aria-invalid="@((_invalid || Error.Length > 0).ToString().ToLowerInvariant())" disabled="@(!Form.CanEdit(Path))">
            <legend>@Title @(Required ? "(required)" : "(optional)")</legend>
            @if (HasOptionalChildren)
            {
                <button type="button" class="button button--secondary configuration-field__disclosure"
                        data-action="expand-optional" aria-expanded="@OptionalEditorsExpanded.ToString().ToLowerInvariant()"
                        @onclick="ToggleOptionalEditors">
                    @(OptionalEditorsExpanded ? "Hide optional settings" : "Show optional settings")
                </button>
            }
            @if (Type == "object")
            {
                @if (Value is null)
                {
                    <button type="button" class="button button--secondary" @onclick="SupplyObject">Supply @Title object</button>
                }
                bool focusRemaining = FocusFirstControl || _focusObjectChildren;
                @foreach (JsonElement child in Schema.GetProperty("properties").EnumerateArray())
                {
                    string childId = child.GetProperty("id").GetString()!;
                    string[] childPath = Path.Append(childId).ToArray();
                    bool focusChild = focusRemaining && CanFocus(child, childPath);
                    if (focusChild) focusRemaining = false;
                    <ConfigurationField @key="childId" Form="Form" Schema="child" Path="childPath" Validation="Validation" ValidationChanged="ValidationChanged"
                                        InheritedSecret="IsSecret" InheritedSensitive="IsMasked" FocusFirstControl="focusChild" FocusGeneration="FocusGeneration" FocusPath="FocusPath" />
                }
            }
            else
            {
                @if (Value is null)
                {
                    <button type="button" class="button button--secondary" data-action="supply-list" @onclick="SupplyList">Supply an empty @Title list</button>
                }
                @for (int index = 0; index < Count; index++)
                {
                    int row = index;
                    <div class="configuration-field__row" @key="_rowKeys[row]">
                        <ConfigurationField Form="Form" Schema="ItemSchema" Path="@Path.Append(row.ToString(CultureInfo.InvariantCulture)).ToArray()" Validation="Validation" ValidationChanged="ValidationChanged"
                                            InheritedSecret="IsSecret" InheritedSensitive="IsMasked" FocusFirstControl="@(row == _focusNewRow || FocusFirstControl && (FocusPath.Count > Path.Count ? FocusPath[Path.Count] == row.ToString(CultureInfo.InvariantCulture) : row == (FocusRow >= 0 ? FocusRow : 0)))" FocusGeneration="FocusGeneration" FocusPath="FocusPath" />
                        <button type="button" class="button button--secondary" aria-label="@($"Remove {Title} item {row + 1}")" @onclick="() => Remove(row)">Remove item @(row + 1)</button>
                    </div>
                }
                <button @ref="_addButton" type="button" class="button button--secondary" data-action="add-item" disabled="@(Count >= MaximumItems)" @onclick="Add">Add @Title item</button>
                <p>@Count / @MaximumItems items</p>
            }
        </fieldset>
    }
    else
    {
        @if (IsSecret && !Form.CanEdit(Path))
        {
            <p class="configuration-field__label"><strong>@Title</strong> <span class="configuration-field__requirement">@(Required ? "Required" : "Optional")</span></p>
            <p data-secret-denied>Secret entry is disabled for this workspace. Enable it deliberately above, or complete a downloaded draft locally.</p>
        }
        else
        {
        <label for="@ControlId">@Title <span class="configuration-field__requirement">@(Required ? "Required" : "Optional")</span></label>
        @if (Type is "boolean" or "enum" && !IsMasked)
        {
            <select @ref="_control" id="@ControlId" value="@Selection" aria-describedby="@(ControlId + "-help " + ControlId + "-error")"
                    aria-invalid="@((_invalid || Error.Length > 0).ToString().ToLowerInvariant())" aria-required="@Required.ToString().ToLowerInvariant()" disabled="@(!Form.CanEdit(Path))" @onchange="Edit">
                <option value="">Not supplied</option>
                @if (Type == "boolean")
                {
                    <option value="true">Yes</option><option value="false">No</option>
                }
                else
                {
                    int choiceIndex = 0;
                    @foreach (JsonElement choice in Schema.GetProperty("choices").EnumerateArray())
                    {
                        <option value="@ChoiceIdentity(choiceIndex++, choice)">@(Display(choice).Length == 0 ? "Empty string" : Display(choice))</option>
                    }
                }
            </select>
        }
        else
        {
            var editForm = Form;
            var editPath = Path.ToArray();
            long editRevision = Form.InputRevision;
            <div class="configuration-field__input" @oninput="args => EditText(args.Value?.ToString(), editForm, editPath, editRevision)"
                 @onchange="args => EditText(args.Value?.ToString(), editForm, editPath, editRevision)">
                <MudInput T="string" @ref="_input" InputId="@ControlId" InputType="@(IsMasked ? InputType.Password : InputType.Text)"
                          InputMode="@(Type == "integer" ? InputMode.numeric : Type == "number" ? InputMode.@decimal : InputMode.text)"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Value="@Text" MaxLength="65536"
                          Error="@(_invalid || Error.Length > 0)" HelperId="@(ControlId + "-help")" ErrorId="@(ControlId + "-error")"
                          Disabled="@(!Form.CanEdit(Path))" UserAttributes="InputAttributes" />
            </div>
        }
        }
    }
    @if (!Required)
    {
        <button type="button" class="button button--secondary" data-action="omit" aria-label="@($"Omit {Title}")"
                disabled="@(!Form.CanEdit(Path))" @onclick="Omit">Omit @Title</button>
    }
    <p id="@(ControlId + "-help")" class="configuration-field__help">@Help @Consequence
        @if (IsMasked && Type == "boolean") { <span>Use true or false.</span> }
        @if (IsMasked && Type == "enum") { <span>Declared choices: @string.Join(", ", Schema.GetProperty("choices").EnumerateArray().Select(Display)).</span> }
    </p>
    @if (InputPurposeHelp is { } purposeHelp)
    {
        <p class="configuration-field__help">@purposeHelp</p>
    }
    @if (Schema.TryGetProperty("guidance", out JsonElement guidance) &&
        (guidance.TryGetProperty("instructions", out _) ||
         guidance.TryGetProperty("links", out JsonElement guidanceLinks) && guidanceLinks.GetArrayLength() > 0))
    {
        <details class="configuration-field__guidance">
            <summary>Help with @Title</summary>
            @if (guidance.TryGetProperty("instructions", out JsonElement instructions))
            {
                <p>@instructions.GetString()</p>
            }
            @if (guidance.TryGetProperty("links", out JsonElement links) && links.GetArrayLength() > 0)
            {
                <ul>
                    @foreach (JsonElement link in links.EnumerateArray())
                    {
                        <li><a href="@(link.GetProperty("url").GetString())" target="_blank"
                               rel="noopener noreferrer" referrerpolicy="no-referrer">@link.GetProperty("title").GetString() <span class="sr-only">(new tab)</span></a></li>
                    }
                </ul>
            }
        </details>
    }
    <p id="@(ControlId + "-error")" class="configuration-field__error">@(_invalid ? "Supply a value of the declared type. (input-type-invalid)" : Error)</p>
    @if (Schema.TryGetProperty("id", out var identifier))
    {
        <details class="configuration-field__key"><summary>Definition key</summary><code>@identifier.GetString()</code></details>
    }
    }
</div>
