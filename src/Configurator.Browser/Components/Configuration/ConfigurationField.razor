@implements IDisposable
@using System.Globalization
@using System.Text.Json

<div class="configuration-field @(Type is "object" or "array" ? "configuration-field--group" : "")" data-field="@string.Join('.', Path)">
    @if (!Form.IsEditorVisible(Path))
    {
        <div class="configuration-field__collapsed">
            <div><strong>@Title</strong><p class="configuration-field__help">@Help</p></div>
            <button type="button" class="button button--secondary" data-action="expand-field"
                    aria-expanded="false" @onclick="ExpandEditor">Configure @Title</button>
        </div>
    }
    else
    {
    string type = Type;
    var actionForm = Form;
    IReadOnlyList<string> actionPath = Path.ToArray();
    long actionRevision = Form.InputRevision;
    long actionGeneration = _actionGeneration;
    string error = Error;
    bool canEdit = Form.CanEdit(Path);
    bool required = Required;
    bool isSecret = IsSecret;
    bool isMasked = IsMasked;
    @if (type is "object" or "array")
    {
        <fieldset @ref="_group" tabindex="-1" aria-describedby="@(ControlId + "-help " + ControlId + "-error")"
                  aria-invalid="@((_invalid || error.Length > 0).ToString().ToLowerInvariant())" disabled="@(!canEdit)">
            <legend>@Title @(required ? "(required)" : "(optional)")
                <ConfigurationFieldActions Schema="Schema" Presentation="_presentation" Path="Path" ControlId="@ControlId" Title="@Title" Required="@required" InputRevision="actionRevision"
                                           CanEdit="@canEdit" SecretsEnabled="@SecretsEnabled"
                                           OnOmit="@(() => OmitCurrent(actionForm, actionPath, actionRevision, actionGeneration))"
                                           OnReset="@(() => Reset(actionForm, actionPath, actionRevision, actionGeneration))"
                                           OnSuggest="@(() => Suggest(actionForm, actionPath, actionRevision, actionGeneration))"
                                           OnNull="@(() => SupplyNull(actionForm, actionPath, actionRevision, actionGeneration))"
                                           GetBindings="InspectorBindings" />
            </legend>
            @if (Schema.Variants.Count > 0)
            {
                <MudSelect T="string" Label="@(Title + " type")" InputId="@(ControlId + "-variant")"
                           Value="@VariantSelection" Disabled="@(!canEdit)" data-variant-owner="@ControlId"
                           ValueChanged="@(choice => ChooseVariant(choice, actionForm, actionPath, actionRevision, actionGeneration))">
                    @for (int variant = 0; variant < Schema.Variants.Count; variant++)
                    {
                        int variantIndex = variant;
                        <MudSelectItem T="string" Value="@ChoiceIdentity(variantIndex)">@Form.GetVariantTitle(Path, variantIndex)</MudSelectItem>
                    }
                </MudSelect>
            }
            @if (HasOptionalChildren)
            {
                <button type="button" class="button button--secondary configuration-field__disclosure"
                        data-action="expand-optional" aria-expanded="@OptionalEditorsExpanded.ToString().ToLowerInvariant()"
                        @onclick="ToggleOptionalEditors">
                    @(OptionalEditorsExpanded ? "Hide optional settings" : "Show optional settings")
                </button>
            }
            @if (Value is { ValueKind: JsonValueKind.Null })
            {
                <p class="configuration-field__help">Null is supplied. Reset or choose another value to continue editing.</p>
            }
            else if (type == "object")
            {
                @if (Value is null)
                {
                    <button type="button" class="button button--secondary" data-action="supply-object"
                            @onclick="@(() => { if (IsCurrentAction(actionForm, actionPath, actionRevision, actionGeneration)) SupplyObject(); })">Supply @Title object</button>
                }
                bool focusRemaining = FocusFirstControl || _focusObjectChildren;
                @foreach (var child in ObjectSchema.Properties)
                {
                    string childId = child.Key;
                    string[] childPath = Path.Append(childId).ToArray();
                    bool focusChild = focusRemaining && CanFocus(child.Value, childPath);
                    if (focusChild) focusRemaining = false;
                    <ConfigurationField @key="childId" Form="Form" Schema="child.Value" Path="childPath" Validation="Validation" ValidationChanged="ValidationChanged"
                                        TitleOverride="@(Form.GetEditorPresentation(childPath)?.Title ?? (string.IsNullOrWhiteSpace(childId) ? "Setting" : childId))"
                                        RequiredOverride="@ObjectSchema.Required.Contains(childId, StringComparer.Ordinal)"
                                        InheritedSecret="isSecret" InheritedSensitive="isMasked" FocusFirstControl="focusChild" FocusGeneration="FocusGeneration" FocusPath="FocusPath" />
                }
                @foreach (JsonProperty entry in MapEntries)
                {
                    string name = entry.Name;
                    string[] entryPath = Path.Append(name).ToArray();
                    <div class="configuration-field__row" @key="Form.GetEditorIdentity(entryPath)">
                        <ConfigurationField Form="Form" Schema="ObjectSchema.AdditionalProperties!" Path="entryPath"
                                            Validation="Validation" ValidationChanged="ValidationChanged" TitleOverride="@name"
                                            InheritedSecret="isSecret" InheritedSensitive="isMasked"
                                            FocusFirstControl="@(_focusMapEntry == name)" FocusGeneration="_mapFocusGeneration" FocusPath="FocusPath" />
                        <button type="button" class="button button--secondary" data-action="remove-map-entry"
                                @onclick="@(() => RemoveMapEntry(name, actionForm, actionPath, actionRevision, actionGeneration))">Remove entry</button>
                    </div>
                }
                @if (ObjectSchema.AdditionalProperties is not null)
                {
                    <MudTextField T="string" Label="@(Title + " new entry key")" InputId="@(ControlId + "-new-key")"
                                  Value="@_newMapKey" MaxLength="65536" Immediate="true" Disabled="@(!canEdit)"
                                  Error="_invalidMapKey" ErrorText="Use a valid bounded key that is not already present."
                                  ValueChanged="@(key => UpdateMapKey(key, actionForm, actionPath, actionRevision, actionGeneration))" />
                    <button type="button" class="button button--secondary" data-action="add-map-entry" disabled="@(!canEdit)"
                            @onclick="@(() => AddMapEntry(actionForm, actionPath, actionRevision, actionGeneration))">Add entry</button>
                }
            }
            else
            {
                @if (Value is null)
                {
                    <button type="button" class="button button--secondary" data-action="supply-list"
                            @onclick="@(() => { if (IsCurrentAction(actionForm, actionPath, actionRevision, actionGeneration)) SupplyList(); })">Supply an empty @Title list</button>
                }
                @for (int index = 0; index < Count; index++)
                {
                    int row = index;
                    <div class="configuration-field__row" @key="Form.GetEditorIdentity(Path.Append(row.ToString(CultureInfo.InvariantCulture)).ToArray())">
                        <ConfigurationField Form="Form" Schema="ItemSchema" Path="@Path.Append(row.ToString(CultureInfo.InvariantCulture)).ToArray()" Validation="Validation" ValidationChanged="ValidationChanged"
                                            TitleOverride="@(Title + " item")" RequiredOverride="true"
                                            InheritedSecret="isSecret" InheritedSensitive="isMasked" FocusFirstControl="@(row == _focusNewRow || FocusFirstControl && (FocusPath.Count > Path.Count ? FocusPath[Path.Count] == row.ToString(CultureInfo.InvariantCulture) : row == (FocusRow >= 0 ? FocusRow : 0)))" FocusGeneration="FocusGeneration" FocusPath="FocusPath" />
                        <button type="button" class="button button--secondary" aria-label="@($"Remove {Title} item {row + 1}")"
                                @onclick="@(() => { if (IsCurrentAction(actionForm, actionPath, actionRevision, actionGeneration)) Remove(row); })">Remove item @(row + 1)</button>
                    </div>
                }
                <button @ref="_addButton" type="button" class="button button--secondary" data-action="add-item" disabled="@(Count >= MaximumItems)"
                        @onclick="@(() => { if (IsCurrentAction(actionForm, actionPath, actionRevision, actionGeneration)) Add(); })">Add @Title item</button>
                <p>@Count / @MaximumItems items</p>
            }
        </fieldset>
    }
    else
    {
        @if (isSecret && !canEdit)
        {
            <div class="configuration-field__heading">
                <p class="configuration-field__label"><strong>@Title</strong> <span class="configuration-field__requirement">@(required ? "Required" : "Optional")</span></p>
                <ConfigurationFieldActions Schema="Schema" Presentation="_presentation" Path="Path" ControlId="@ControlId" Title="@Title" Required="@required" InputRevision="actionRevision"
                                           CanEdit="@canEdit" SecretsEnabled="@SecretsEnabled"
                                           OnOmit="@(() => OmitCurrent(actionForm, actionPath, actionRevision, actionGeneration))"
                                           OnReset="@(() => Reset(actionForm, actionPath, actionRevision, actionGeneration))"
                                           OnSuggest="@(() => Suggest(actionForm, actionPath, actionRevision, actionGeneration))"
                                           OnNull="@(() => SupplyNull(actionForm, actionPath, actionRevision, actionGeneration))"
                                           GetBindings="InspectorBindings" />
            </div>
            <p data-secret-denied>Secret entry is disabled for this workspace. Enable it deliberately above, or complete a downloaded draft locally.</p>
        }
        else
        {
        <div class="configuration-field__heading">
            <label id="@(ControlId + "-label")" for="@ControlId" @onclick="() => FocusScalarAsync()">@Title <span class="configuration-field__requirement">@(required ? "Required" : "Optional")</span></label>
            <ConfigurationFieldActions Schema="Schema" Presentation="_presentation" Path="Path" ControlId="@ControlId" Title="@Title" Required="@required" InputRevision="actionRevision"
                                       CanEdit="@canEdit" SecretsEnabled="@SecretsEnabled"
                                       OnOmit="@(() => OmitCurrent(actionForm, actionPath, actionRevision, actionGeneration))"
                                       OnReset="@(() => Reset(actionForm, actionPath, actionRevision, actionGeneration))"
                                       OnSuggest="@(() => Suggest(actionForm, actionPath, actionRevision, actionGeneration))"
                                       OnNull="@(() => SupplyNull(actionForm, actionPath, actionRevision, actionGeneration))"
                                       GetBindings="InspectorBindings" />
        </div>
        @if ((type == "boolean" || HasChoices) && !isMasked)
        {
            var editForm = Form;
            var editPath = Path.ToArray();
            long editRevision = Form.InputRevision;
            long editControlGeneration = _controlGeneration;
            <div class="configuration-field__choice">
            <AppSelectField ChoiceSchema="Schema" @ref="_choiceControl" InputId="@ControlId" Value="@Selection" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Disabled="@(!canEdit)" Error="@(_invalid || error.Length > 0)"
                       ErrorId="@(ControlId + "-error")" HelperId="@(ControlId + "-help")"
                       ErrorText="@(_invalid ? "Supply a value of the declared type. (input-type-invalid)" : error)"
                       UserAttributes="@(new Dictionary<string, object> { ["aria-required"] = required.ToString().ToLowerInvariant(), ["aria-labelledby"] = ControlId + "-label" })"
                       ValueChanged="value => { if (Edit(new ChangeEventArgs { Value = value }, editForm, editPath, editRevision, editControlGeneration)) editRevision = editForm.InputRevision; }">
                <MudSelectItem T="string" Value="@string.Empty">Not supplied</MudSelectItem>
                @if (!HasChoices)
                {
                    <MudSelectItem T="string" Value="@("true")">Yes</MudSelectItem>
                    <MudSelectItem T="string" Value="@("false")">No</MudSelectItem>
                }
                else
                {
                    int choiceIndex = 0;
                    @foreach (JsonElement choice in Choices.EnumerateArray())
                    {
                        int index = choiceIndex++;
                        <MudSelectItem T="string" Value="@ChoiceIdentity(index)">@ChoiceLabel(index, choice)</MudSelectItem>
                    }
                }
            </AppSelectField>
            </div>
        }
        else
        {
            var editForm = Form;
            var editPath = Path.ToArray();
            long editRevision = Form.InputRevision;
            long editControlGeneration = _controlGeneration;
            <div class="configuration-field__input" @oninput="args => { if (EditText(args.Value?.ToString(), editForm, editPath, editRevision, editControlGeneration)) editRevision = editForm.InputRevision; }"
                 @onchange="args => { if (EditText(args.Value?.ToString(), editForm, editPath, editRevision, editControlGeneration, changeOnly: true)) editRevision = editForm.InputRevision; }">
                <AppTextField @ref="_textControl" InputId="@ControlId" Value="@Text" Masked="@isMasked"
                              InputMode="@(type == "integer" ? InputMode.numeric : type == "number" ? InputMode.@decimal : InputMode.text)"
                              Disabled="@(!canEdit)" Error="@(_invalid || error.Length > 0)" InputAttributes="@(new Dictionary<string, object>
                              {
                                  ["name"] = ControlId, ["autocomplete"] = Autocomplete, ["spellcheck"] = "false",
                                  ["aria-required"] = required.ToString().ToLowerInvariant(),
                                  ["aria-invalid"] = (_invalid || error.Length > 0).ToString().ToLowerInvariant(),
                                  ["aria-describedby"] = ControlId + "-help " + ControlId + "-error"
                              })" ErrorText="@(_invalid ? "Supply a value of the declared type. (input-type-invalid)" : error)" />
            </div>
        }
        }
    }
    <p id="@(ControlId + "-help")" class="configuration-field__help" hidden="@(!HasHelp)">@Help
        @if (isMasked && type == "boolean") { <span>Use true or false.</span> }
        @if (isMasked && HasChoices) { <span>Declared choices: @string.Join(", ", Choices.EnumerateArray().Select(Display)).</span> }
        @if (InputPurposeHelp is { } purposeHelp) { <span>@purposeHelp</span> }
    </p>
    @if (type is "object" or "array" || !canEdit)
    {
        <p id="@(ControlId + "-error")" class="configuration-field__error">@(_invalid ? "Supply a value of the declared type. (input-type-invalid)" : error)</p>
    }
    }
</div>
