@implements IDisposable
@using System.Globalization
@using System.Text.Json

<div class="configuration-field @(Type is "object" or "array" ? "configuration-field--group" : "")"
     data-field="@string.Join('.', Path)"
     @onfocusin="NotifyFocused" @onfocusin:stopPropagation="true">
    @if (!IsVisible)
    {
        <div class="configuration-field__collapsed">
            <div><strong>@Title</strong><p class="configuration-field__help">@Help</p></div>
            @if (CanEdit)
            {
                <button type="button" class="button button--secondary" data-action="expand-field"
                        aria-expanded="false" @onclick="ExpandEditor">@UiFormat("ConfigureProject", Title)</button>
            }
            else if (IsRetainedByProfile)
            {
                <p class="configuration-field__help" data-profile-retained>@Ui("ProfileRetainedHelp")</p>
            }
            else if (IsSecret)
            {
                <p data-secret-denied>@Ui("FieldSecretDenied")</p>
                @if (RequestSecretConsent.HasDelegate)
                {
                    <button type="button" class="button button--secondary" data-action="field-secret-consent" @onclick="RequestSecretConsent">@Ui("ReviewSecretConsent")</button>
                }
            }
        </div>
    }
    else
    {
    string type = Type;
    var actionForm = Form;
    IReadOnlyList<string> actionPath = Path.ToArray();
    long actionRevision = Form.InputRevision;
    long actionGeneration = _actionGeneration;
    string error = Error;
    var correctionFacts = CorrectionFacts;
    bool canEdit = correctionFacts.CanEdit;
    bool required = Required;
    bool isSecret = IsSecret;
    bool isMasked = correctionFacts.RequiresMasking;
    bool useSwitch = UseSwitch;
    bool useRadios = UseRadios;
    @if (type is "object" or "array")
    {
        <fieldset @ref="_group" tabindex="-1" aria-describedby="@(ControlId + "-help " + ControlId + "-error")"
                  aria-invalid="@((_invalid || error.Length > 0).ToString().ToLowerInvariant())" disabled="@(!canEdit)">
            <legend>@Title @if (required && !SectionAllRequired) { <span class="configuration-field__requirement" data-requirement-badge="required">@Ui("Required")</span> }
                <ConfigurationFieldActions Locale="@Form.Locale" Schema="Schema" Presentation="_presentation" Path="Path" ControlId="@ControlId" Title="@Title" Required="@required" InputRevision="actionRevision"
                                           Facts="correctionFacts" SecretsEnabled="@SecretsEnabled"
                                           OnOmit="@(() => OmitCurrent(actionForm, actionPath, actionRevision, actionGeneration))"
                                           OnReset="@(() => Reset(actionForm, actionPath, actionRevision, actionGeneration))"
                                           OnSuggest="@(() => Suggest(actionForm, actionPath, actionRevision, actionGeneration))"
                                           OnNull="@(() => SupplyNull(actionForm, actionPath, actionRevision, actionGeneration))"
                                           GetBindings="GetBindingsDelegate" />
            </legend>
            @if (Schema.Variants.Count > 0)
            {
                <MudSelect T="string" @ref="_variantControl" Label="@UiFormat("FieldVariantType", Title)" InputId="@(ControlId + "-variant")"
                           Value="@VariantSelection" Disabled="@(!canEdit)" data-variant-owner="@ControlId"
                           ValueChanged="@(choice => ChooseVariant(choice, actionForm, actionPath, actionRevision, actionGeneration))">
                    @for (int variant = 0; variant < Schema.Variants.Count; variant++)
                    {
                        int variantIndex = variant;
                        <MudSelectItem T="string" Value="@ChoiceIdentity(variantIndex)">@Form.GetVariantTitle(EditorPath, variantIndex)</MudSelectItem>
                    }
                </MudSelect>
            }
            @if (HasOptionalChildren)
            {
                <button type="button" class="button button--secondary configuration-field__disclosure"
                        data-action="expand-optional" aria-expanded="@OptionalEditorsExpanded.ToString().ToLowerInvariant()"
                        @onclick="ToggleOptionalEditors">
                    @Ui(OptionalEditorsExpanded ? "HideOptionalSettings" : "ShowOptionalSettings")
                </button>
            }
            @if (Value is { ValueKind: JsonValueKind.Null })
            {
                <p class="configuration-field__help">@Ui("FieldNullSupplied")</p>
            }
            else if (type == "object")
            {
                var objectSchema = ObjectSchema;
                var requiredProperties = objectSchema.Required.ToHashSet(StringComparer.Ordinal);
                @if (Value is null)
                {
                    <button type="button" class="button button--secondary" data-action="supply-object"
                            @onclick="@(() => { if (IsCurrentAction(actionForm, actionPath, actionRevision, actionGeneration)) SupplyObject(); })">@UiFormat("SupplyFieldObject", Title)</button>
                }
                bool focusRemaining = FocusFirstControl || _focusObjectChildren;
                @foreach (var childMount in MountNode.Children)
                {
                    string childId = childMount.Location.Segments[^1];
                    string[] childPath = Path.Append(childId).ToArray();
                    bool declared = objectSchema.Properties.TryGetValue(childId, out var childSchema);
                    childSchema ??= objectSchema.AdditionalProperties!;
                    bool focusChild = declared && focusRemaining && CanFocus(childSchema, childPath);
                    if (focusChild) focusRemaining = false;
                    @if (childMount.Admitted && declared)
                    {
                    <ConfigurationField @key="childMount.Identity" Form="Form" Schema="childSchema" Path="childPath" LiteralPath="LiteralPath" MountNode="childMount" MountRevision="MountRevision" Validation="Validation" ValidationChanged="ValidationChanged"
                                        RequiredOverride="@requiredProperties.Contains(childId)"
                                        InheritedSecret="isSecret" FocusFirstControl="focusChild" FocusGeneration="FocusGeneration" FocusPath="@(_focusObjectChildren ? PendingFocusPath : FocusPath)" />
                    }
                    else if (childMount.Admitted)
                    {
                    <div class="configuration-field__row" @key="childMount.Identity">
                        <ConfigurationField Form="Form" Schema="childSchema" Path="childPath" LiteralPath="LiteralPath" MountNode="childMount" MountRevision="MountRevision"
                                            Validation="Validation" ValidationChanged="ValidationChanged" TitleOverride="@childId"
                                            InheritedSecret="isSecret"
                                            FocusFirstControl="@(_focusMapEntry == childId || FocusFirstControl && FocusPath.Count > Path.Count && FocusPath[Path.Count] == childId)"
                                            FocusGeneration="@(_focusMapEntry == childId ? _mapFocusGeneration : FocusGeneration)"
                                            FocusPath="@(_focusMapEntry == childId ? PendingFocusPath : FocusPath)" />
                        <button type="button" class="button button--secondary" data-action="remove-map-entry"
                                @onclick="@(() => RemoveMapEntry(childId, actionForm, actionPath, actionRevision, actionGeneration))">@Ui("RemoveFieldEntry")</button>
                    </div>
                    }
                }
                @if (objectSchema.AdditionalProperties is not null)
                {
                    <MudTextField T="string" @ref="_mapKeyControl" Label="@UiFormat("FieldNewEntryKey", Title)" InputId="@(ControlId + "-new-key")"
                                  Value="@_newMapKey" MaxLength="65536" Immediate="true" Disabled="@(!canEdit)"
                                  Error="_invalidMapKey" ErrorText="@Ui("FieldInvalidMapKey")"
                                  ValueChanged="@(key => UpdateMapKey(key, actionForm, actionPath, actionRevision, actionGeneration))" />
                    <button type="button" class="button button--secondary" data-action="add-map-entry" disabled="@(!canEdit)"
                            @onclick="@(() => AddMapEntry(actionForm, actionPath, actionRevision, actionGeneration))">@Ui("AddFieldEntry")</button>
                }
            }
            else
            {
                @if (Value is null)
                {
                    <button type="button" class="button button--secondary" data-action="supply-list"
                            @onclick="@(() => { if (IsCurrentAction(actionForm, actionPath, actionRevision, actionGeneration)) SupplyList(); })">@UiFormat("SupplyFieldList", Title)</button>
                }
                @foreach (var childMount in MountNode.Children)
                {
                    int row = int.Parse(childMount.Location.Segments[^1], CultureInfo.InvariantCulture);
                    @if (childMount.Admitted)
                    {
                    <div class="configuration-field__row" data-list-item-index="@row" @key="childMount.Identity">
                        @{
                            string? dynamicTitle = ArrayItemTitle(row);
                            bool duplicateRow = IsDuplicateArrayItem(row);
                        }
                        <p class="configuration-field__item-heading"><strong data-item-title>@(dynamicTitle ?? (UiFormat("FieldListItem", Title) + " " + (row + 1)))</strong></p>
                        @if (duplicateRow)
                        {
                            <p class="configuration-field__duplicate" role="status" data-duplicate-key>@Ui("DuplicateUniqueKey")</p>
                        }
                        <ConfigurationField Form="Form" Schema="ItemSchema" Path="@Path.Append(row.ToString(CultureInfo.InvariantCulture)).ToArray()" LiteralPath="LiteralPath" MountNode="childMount" MountRevision="MountRevision" Validation="Validation" ValidationChanged="ValidationChanged"
                                            TitleOverride="@UiFormat("FieldListItem", Title)" RequiredOverride="true"
                                            InheritedSecret="isSecret" FocusFirstControl="@(row == _focusNewRow || FocusFirstControl && (FocusPath.Count > Path.Count ? FocusPath[Path.Count] == row.ToString(CultureInfo.InvariantCulture) : row == (FocusRow >= 0 ? FocusRow : 0)))" FocusGeneration="FocusGeneration" FocusPath="@(row == _focusNewRow ? PendingFocusPath : FocusPath)" />
                        <button type="button" class="button button--secondary" data-action="remove-item" aria-label="@UiFormat("RemoveFieldItem", Title, row + 1)"
                                @onclick="@(() => { if (IsCurrentAction(actionForm, actionPath, actionRevision, actionGeneration)) Remove(row); })">@Ui("RemoveItem") @(row + 1)</button>
                    </div>
                    }
                }
                <button @ref="_addButton" type="button" class="button button--secondary" data-action="add-item" disabled="@(Count >= MaximumItems)"
                        @onclick="@(() => { if (IsCurrentAction(actionForm, actionPath, actionRevision, actionGeneration)) Add(); })">@UiFormat("AddFieldItem", Title)</button>
                <p>@UiFormat("FieldItemCount", Count, MaximumItems)</p>
            }
        </fieldset>
    }
    else
    {
        @if (isSecret && !canEdit)
        {
            <div class="configuration-field__heading">
                <p class="configuration-field__label"><strong>@Title</strong> @if (required && !SectionAllRequired) { <span class="configuration-field__requirement" data-requirement-badge="required">@Ui("Required")</span> }</p>
                <ConfigurationFieldActions Locale="@Form.Locale" Schema="Schema" Presentation="_presentation" Path="Path" ControlId="@ControlId" Title="@Title" Required="@required" InputRevision="actionRevision"
                                           Facts="correctionFacts" SecretsEnabled="@SecretsEnabled"
                                           OnOmit="@(() => OmitCurrent(actionForm, actionPath, actionRevision, actionGeneration))"
                                           OnReset="@(() => Reset(actionForm, actionPath, actionRevision, actionGeneration))"
                                           OnSuggest="@(() => Suggest(actionForm, actionPath, actionRevision, actionGeneration))"
                                           OnNull="@(() => SupplyNull(actionForm, actionPath, actionRevision, actionGeneration))"
                                           GetBindings="GetBindingsDelegate" />
            </div>
            @if (IsRetainedByProfile)
            {
                <p class="configuration-field__help" data-profile-retained>@Ui("ProfileRetainedHelp")</p>
            }
            else
            {
                <p data-secret-denied>@Ui("FieldSecretDenied")</p>
                @if (RequestSecretConsent.HasDelegate)
                {
                    <button type="button" class="button button--secondary" data-action="field-secret-consent" @onclick="RequestSecretConsent">@Ui("ReviewSecretConsent")</button>
                }
            }
        }
        else
        {
        <div class="configuration-field__heading">
            <div class="configuration-field__identity">
                @if (useRadios)
                {
                    <span id="@(ControlId + "-label")" class="configuration-field__label">@Title
                        @if (required && !SectionAllRequired) { <span class="configuration-field__requirement" data-requirement-badge="required">@Ui("Required")</span> }
                        @if (!string.IsNullOrWhiteSpace(_presentation?.Units)) { <span class="configuration-field__units" data-field-units>@_presentation.Units</span> }
                        @if (_presentation?.IsDeprecated == true) { <span class="configuration-field__badge configuration-field__badge--deprecated" data-field-deprecated>@Ui("FieldDeprecated")</span> }
                        @if (_presentation?.IsController == true) { <span class="configuration-field__badge configuration-field__badge--controller" data-controller-impact>@_presentation.ControllerImpactSummary</span> }
                    </span>
                }
                else
                {
                    <label id="@(ControlId + "-label")" for="@ControlId" @onclick="() => FocusScalarAsync()">@Title
                        @if (required && !SectionAllRequired) { <span class="configuration-field__requirement" data-requirement-badge="required">@Ui("Required")</span> }
                        @if (!string.IsNullOrWhiteSpace(_presentation?.Units)) { <span class="configuration-field__units" data-field-units>@_presentation.Units</span> }
                        @if (_presentation?.IsDeprecated == true) { <span class="configuration-field__badge configuration-field__badge--deprecated" data-field-deprecated>@Ui("FieldDeprecated")</span> }
                        @if (_presentation?.IsController == true) { <span class="configuration-field__badge configuration-field__badge--controller" data-controller-impact>@_presentation.ControllerImpactSummary</span> }
                    </label>
                }
                @if (_presentation is { HasCopyableWireToken: true })
                {
                    <span class="configuration-field__key-row">
                        @if (Title != _presentation.WireToken || _presentation.SecondaryLabel is not null)
                        {
                            <code class="configuration-field__key" dir="ltr" data-wire-key>@_presentation.WireToken</code>
                        }
                        <button type="button" class="configuration-field__copy-key" data-action="copy-wire-key"
                                aria-label="@UiFormat("WireKeyCopyTitle", _presentation.WireToken)"
                                @onclick="CopyWireKeyAsync">@Ui("CopyWireKey")</button>
                    </span>
                }
                else if (!IsDynamicPrivateMapEntry && Title != Path[^1])
                {
                    <code class="configuration-field__key" dir="ltr">@Path[^1]</code>
                }
            </div>
            <ConfigurationFieldActions Locale="@Form.Locale" Schema="Schema" Presentation="_presentation" Path="Path" ControlId="@ControlId" Title="@Title" Required="@required" InputRevision="actionRevision"
                                       Facts="correctionFacts" SecretsEnabled="@SecretsEnabled"
                                       OnOmit="@(() => OmitCurrent(actionForm, actionPath, actionRevision, actionGeneration))"
                                       OnReset="@(() => Reset(actionForm, actionPath, actionRevision, actionGeneration))"
                                       OnSuggest="@(() => Suggest(actionForm, actionPath, actionRevision, actionGeneration))"
                                       OnNull="@(() => SupplyNull(actionForm, actionPath, actionRevision, actionGeneration))"
                                       GetBindings="GetBindingsDelegate" />
        </div>
        @if (!string.IsNullOrWhiteSpace(_presentation?.DeprecationGuidance))
        {
            <p class="configuration-field__help" data-deprecation-guidance>@_presentation.DeprecationGuidance</p>
        }
        @if (HasChoices || type == "boolean" && !isMasked)
        {
            var editForm = Form;
            var editPath = Path.ToArray();
            long editRevision = Form.InputRevision;
            long editControlGeneration = _controlGeneration;
            @if (useSwitch)
            {
                <label class="configuration-field__switch">
                    <input id="@ControlId" type="checkbox" role="switch" aria-checked="@SwitchAriaChecked"
                           aria-labelledby="@(ControlId + "-label")"
                           aria-describedby="@(ControlId + "-help " + ControlId + "-error")"
                           checked="@(Value is { ValueKind: JsonValueKind.True })"
                           disabled="@(!canEdit)"
                           @onchange="@(args => { string next = args.Value is true ? "true" : "false"; if (Edit(new ChangeEventArgs { Value = next }, editForm, editPath, editRevision, editControlGeneration)) editRevision = editForm.InputRevision; })" />
                    <span>@SwitchLabelText</span>
                </label>
            }
            else if (useRadios && !HasChoices)
            {
                <div class="configuration-field__radios" @ref="_radioGroup">
                    <MudRadioGroup T="string" Name="@ControlId" Value="@Selection" Disabled="@(!canEdit)"
                                   Required="@required" aria-invalid="@((_invalid || error.Length > 0).ToString().ToLowerInvariant())"
                                   aria-labelledby="@(ControlId + "-label")" aria-describedby="@(ControlId + "-help " + ControlId + "-error")"
                                   ValueChanged="value => { if (Edit(new ChangeEventArgs { Value = value }, editForm, editPath, editRevision, editControlGeneration)) editRevision = editForm.InputRevision; }">
                        <MudRadio T="string" Value="@string.Empty" AriaLabel="@Ui("NotSupplied")">
                            <span id="@(ControlId + "-absence-label")">@Ui("NotSupplied")</span>
                        </MudRadio>
                        <MudRadio T="string" Value="@("true")" AriaLabel="@(_presentation?.BooleanLabels?.TrueLabel ?? Ui("Yes"))">
                            <span id="@(ControlId + "-yes-label")">@(_presentation?.BooleanLabels?.TrueLabel ?? Ui("Yes"))</span>
                        </MudRadio>
                        <MudRadio T="string" Value="@("false")" AriaLabel="@(_presentation?.BooleanLabels?.FalseLabel ?? Ui("No"))">
                            <span id="@(ControlId + "-no-label")">@(_presentation?.BooleanLabels?.FalseLabel ?? Ui("No"))</span>
                        </MudRadio>
                    </MudRadioGroup>
                </div>
            }
            else if (useRadios)
            {
                <div class="configuration-field__radios" @ref="_radioGroup">
                    <MudRadioGroup T="string" Name="@ControlId" Value="@Selection" Disabled="@(!canEdit)"
                                   Required="@required" aria-invalid="@((_invalid || error.Length > 0).ToString().ToLowerInvariant())"
                                   aria-labelledby="@(ControlId + "-label")" aria-describedby="@(ControlId + "-help " + ControlId + "-error")"
                                   ValueChanged="value => { if (Edit(new ChangeEventArgs { Value = value }, editForm, editPath, editRevision, editControlGeneration)) editRevision = editForm.InputRevision; }">
                        @{ int enumIndex = 0; }
                        @foreach (JsonElement choice in Choices.EnumerateArray())
                        {
                            int index = enumIndex++;
                            var choiceMeta = _presentation?.Choices.ElementAtOrDefault(index);
                            <MudRadio T="string" Value="@ChoiceIdentity(index)" AriaLabel="@ChoiceLabel(index, choice)">
                                <span>@ChoiceLabel(index, choice)</span>
                                @if (!string.IsNullOrWhiteSpace(choiceMeta?.Explanation))
                                {
                                    <span class="configuration-field__help" data-choice-explanation="@choiceMeta.Value"> — @choiceMeta.Explanation</span>
                                }
                            </MudRadio>
                        }
                    </MudRadioGroup>
                </div>
            }
            else
            {
            <div class="configuration-field__choice">
            <AppSelectField @key="_controlGeneration" ChoiceSchema="Schema" @ref="_choiceControl" InputId="@ControlId" Value="@(isMasked ? string.Empty : Selection)" Variant="Variant.Outlined"
                       ToStringFunc="SelectionLabel" QuickSearchInterval="@TimeSpan.FromMilliseconds(700)"
                       Margin="Margin.Dense" Disabled="@(!canEdit)" Required="@required" Error="@(_invalid || error.Length > 0)"
                       ErrorId="@(ControlId + "-error")" HelperId="@(ControlId + "-help")"
                       ErrorText="@(_invalid ? Ui("FieldInputTypeInvalid") : error)"
                       UserAttributes="@(new Dictionary<string, object> { ["aria-labelledby"] = ControlId + "-label", ["lang"] = Form.Locale })"
                       ValueChanged="value => { if (Edit(new ChangeEventArgs { Value = value }, editForm, editPath, editRevision, editControlGeneration)) editRevision = editForm.InputRevision; }">
                <MudSelectItem T="string" Value="@string.Empty" Disabled="@isMasked">@SelectionLabel(string.Empty)</MudSelectItem>
                @{
                    int choiceIndex = 0;
                }
                @foreach (JsonElement choice in Choices.EnumerateArray())
                {
                    int index = choiceIndex++;
                    <MudSelectItem T="string" Value="@ChoiceIdentity(index)">@ChoiceLabel(index, choice)</MudSelectItem>
                }
            </AppSelectField>
            </div>
            @if (!isMasked && _presentation?.Choices.Any(choice => !string.IsNullOrWhiteSpace(choice.Explanation) || !string.IsNullOrWhiteSpace(choice.DeprecationGuidance)) == true)
            {
                <div class="configuration-field__choice-explanations">
                    @foreach (var choice in _presentation.Choices.Where(c => !string.IsNullOrWhiteSpace(c.Explanation) || !string.IsNullOrWhiteSpace(c.DeprecationGuidance)))
                    {
                        <p data-choice-explanation="@choice.Value">
                            <strong>@choice.DisplayLabel:</strong> @choice.Explanation
                            @if (!string.IsNullOrWhiteSpace(choice.DeprecationGuidance)) { <span> @choice.DeprecationGuidance</span> }
                        </p>
                    }
                </div>
            }
            }
        }
        else if (UseSlider && TryGetSliderBounds(out double sliderMin, out double sliderMax, out double sliderStep))
        {
            var editForm = Form;
            var editPath = Path.ToArray();
            long editRevision = Form.InputRevision;
            long editControlGeneration = _controlGeneration;
            <div class="configuration-field__slider-pair" data-widget="slider">
                <input type="range" class="configuration-field__slider-range"
                       min="@sliderMin.ToString(CultureInfo.InvariantCulture)"
                       max="@sliderMax.ToString(CultureInfo.InvariantCulture)"
                       step="@sliderStep.ToString(CultureInfo.InvariantCulture)"
                       value="@TextFor(canEdit)"
                       disabled="@(!canEdit)"
                       aria-labelledby="@(ControlId + "-label")"
                       @oninput="args => { if (EditText(args.Value?.ToString(), editForm, editPath, editRevision, editControlGeneration)) editRevision = editForm.InputRevision; }"
                       @onchange="args => { if (EditText(args.Value?.ToString(), editForm, editPath, editRevision, editControlGeneration, changeOnly: true)) editRevision = editForm.InputRevision; }" />
                <div class="configuration-field__input"
                     @oninput="args => { if (EditText(args.Value?.ToString(), editForm, editPath, editRevision, editControlGeneration)) editRevision = editForm.InputRevision; }"
                     @onchange="args => { if (EditText(args.Value?.ToString(), editForm, editPath, editRevision, editControlGeneration, changeOnly: true)) editRevision = editForm.InputRevision; }">
                    <AppTextField @ref="_textControl" InputId="@ControlId" Value="@TextFor(canEdit)" Masked="false"
                                  Multiline="false" InputMode="@(type == "integer" ? InputMode.numeric : InputMode.@decimal)"
                                  Disabled="@(!canEdit)" Required="@required" Error="@(_invalid || error.Length > 0)"
                                  InputAttributes="@BuildInputAttributes(canEdit, _invalid || error.Length > 0)"
                                  ErrorText="@(_invalid ? Ui("FieldInputTypeInvalid") : error)" />
                </div>
            </div>
        }
        else
        {
            var editForm = Form;
            var editPath = Path.ToArray();
            long editRevision = Form.InputRevision;
            long editControlGeneration = _controlGeneration;
            <div class="configuration-field__input"
                 @oninput="args => { if (EditText(args.Value?.ToString(), editForm, editPath, editRevision, editControlGeneration)) editRevision = editForm.InputRevision; }"
                 @onchange="args => { if (EditText(args.Value?.ToString(), editForm, editPath, editRevision, editControlGeneration, changeOnly: true)) editRevision = editForm.InputRevision; }"
                 @onkeydown="HandleInputKeyDownAsync" @onkeydown:stopPropagation="true">
                <AppTextField @ref="_textControl" InputId="@ControlId" Value="@TextFor(canEdit)" Masked="@(isMasked && !_secretRevealed)"
                              Multiline="@(IsMultilineSecret || IsMultilineWidget)" Rows="@ResolvedRows" ReadOnly="@(IsMultilineSecret && !_secretRevealed)"
                              InputMode="@(type == "integer" ? InputMode.numeric : type == "number" ? InputMode.@decimal : InputMode.text)"
                              Disabled="@(!canEdit)" Required="@required" Error="@(_invalid || error.Length > 0)"
                              InputAttributes="@BuildInputAttributes(canEdit, _invalid || error.Length > 0)"
                              ErrorText="@(_invalid ? Ui("FieldInputTypeInvalid") : error)" />
            </div>
            @if (isSecret && canEdit && type == "string")
            {
                <ConfigurationSecretActions Form="Form" Schema="Schema" Location="EditorPath" ControlId="@ControlId" Title="@Title"
                                            Value="@TextFor(canEdit)" Revealed="_secretRevealed" RevealedChanged="SetSecretRevealed" />
            }
        }
        }
    }
    <p id="@(ControlId + "-help")" class="configuration-field__help" hidden="@(!HasHelp(isMasked))">@Help
        @if (isMasked && type == "boolean") { <span>@Ui("FieldBooleanHelp")</span> }
        @if (InputPurposeHelp is { } purposeHelp) { <span>@purposeHelp</span> }
        @if (IsMultilineSecret) { <span>@Ui("SecretMultilineHelp")</span> }
    </p>
    @if (!string.IsNullOrWhiteSpace(_presentation?.IfOmittedDisplay))
    {
        <p class="configuration-field__help" data-if-omitted>@_presentation.IfOmittedDisplay</p>
    }
    @if (Schema.Secret is not null && canEdit)
    {
        <ul class="configuration-field__help" id="@(ControlId + "-rules")">
            @foreach (var rule in Form.GetSecretValidation(EditorPath).Requirements)
            {
                <li data-secret-rule="@rule.Code">@rule.Message</li>
            }
        </ul>
    }
    @if (type is "object" or "array" || !canEdit || useRadios)
    {
        <p id="@(ControlId + "-error")" class="configuration-field__error">@(_invalid ? Ui("FieldInputTypeInvalid") : error)</p>
    }
    }
</div>
