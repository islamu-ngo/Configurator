@using Configurator.Browser.Resources
@using Configurator.Browser.Services
@using Configurator.Core.Definitions
@using Configurator.Presentation

<header class="workspace-header" role="region" aria-label="@T("WorkspaceTitle")">
    <div class="workspace-header__identity">
        @if (!string.IsNullOrEmpty(ScopeSummary))
        {
            <button type="button" class="workspace-header__chip workspace-header__chip--scope"
                    data-workspace-scope data-action="change-scope"
                    @onclick="() => OnScopeRequested.InvokeAsync()">
                <MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" aria-hidden="true" />
                <span><bdi>@ScopeSummary</bdi> · @T("ScopeChangeAction")</span>
            </button>
        }
        else
        {
            <span class="workspace-header__title"><bdi>@Form.Definition.Title</bdi></span>
        }
        <button type="button" class="workspace-header__chip @(SecretsEnabled ? "workspace-header__chip--active" : "")"
                data-workspace-consent-chip
                data-consent-active="@SecretsEnabled.ToString().ToLowerInvariant()"
                @onclick="() => OnSecretConsentRequested.InvokeAsync()">
            <MudIcon Icon="@(SecretsEnabled ? Icons.Material.Outlined.LockOpen : Icons.Material.Outlined.Lock)" Size="Size.Small" aria-hidden="true" />
            <span>@T(SecretsEnabled ? "SecretsEnabledChip" : "SecretsLockedChip")</span>
        </button>
    </div>
    <nav class="workspace-header__modes" aria-label="@T("WorkspaceModes")">
        <button type="button" class="workspace-header__mode" data-workflow-step="configure" data-layout-mode="guided"
                aria-current="@(!DeveloperMode && ActiveStage == "configure" && LayoutMode == WorkspaceLayoutMode.Guided ? "step" : null)"
                @onclick='() => StageSelected.InvokeAsync(("configure", WorkspaceLayoutMode.Guided))'>
            @T("ModeGuided")
        </button>
        <button type="button" class="workspace-header__mode" data-layout-mode="compact"
                aria-current="@(!DeveloperMode && ActiveStage == "configure" && LayoutMode == WorkspaceLayoutMode.Compact ? "step" : null)"
                @onclick='() => StageSelected.InvokeAsync(("configure", WorkspaceLayoutMode.Compact))'>
            @T("ModeCompact")
        </button>
        <button type="button" class="workspace-header__mode" data-workflow-step="review" data-layout-mode="review"
                aria-current="@(!DeveloperMode && ActiveStage == "review" ? "step" : null)"
                @onclick='() => StageSelected.InvokeAsync(("review", LayoutMode))'>
            @T("WorkflowReview")
        </button>
        <button type="button" class="workspace-header__mode" data-workflow-step="prepare" data-layout-mode="files"
                aria-current="@(!DeveloperMode && ActiveStage == "prepare" ? "step" : null)"
                @onclick='() => StageSelected.InvokeAsync(("prepare", LayoutMode))'>
            @T("WorkflowFiles")
        </button>
    </nav>
    <div class="workspace-header__preferences">
        <button type="button" class="workspace-header__chip workspace-header__naming"
                data-action="toggle-naming-mode"
                aria-pressed="@(NamingMode == WorkspaceNamingMode.Technical ? "true" : "false")"
                title="@($"{T("NamingMode")} (Ctrl+Shift+K)")"
                @onclick="ToggleNamingAsync">
            <span>@T(NamingMode == WorkspaceNamingMode.Technical ? "Technical" : "Humanized")</span>
            <kbd class="workspace-header__shortcut" dir="ltr">Ctrl+Shift+K</kbd>
        </button>
        <div class="workspace-header__density">
            <label for="configuration-density" class="sr-only">@T("Density")</label>
            <select id="configuration-density" aria-label="@T("Density")"
                    value="@AppearanceState.FromWorkspaceDensity(Density)"
                    @onchange="HandleDensityChanged">
                <option value="spacious">@T("Spacious")</option>
                <option value="comfortable">@T("Comfortable")</option>
                <option value="compact">@T("Compact")</option>
                <option value="dense">@T("Dense")</option>
            </select>
        </div>
    </div>
</header>

@code {
    [Parameter, EditorRequired] public DefinitionFormModel Form { get; set; } = null!;
    [Parameter, EditorRequired] public string Locale { get; set; } = "en";
    [Parameter, EditorRequired] public string ActiveStage { get; set; } = "configure";
    [Parameter, EditorRequired] public WorkspaceLayoutMode LayoutMode { get; set; } = WorkspaceLayoutMode.Guided;
    [Parameter, EditorRequired] public WorkspaceDensity Density { get; set; } = WorkspaceDensity.Comfortable;
    [Parameter, EditorRequired] public WorkspaceNamingMode NamingMode { get; set; } = WorkspaceNamingMode.Humanized;
    [Parameter] public bool DeveloperMode { get; set; }
    [Parameter] public string? ScopeSummary { get; set; }
    [Parameter] public EventCallback OnScopeRequested { get; set; }
    [Parameter] public EventCallback OnSecretConsentRequested { get; set; }
    [Parameter] public EventCallback<WorkspaceNamingMode> NamingModeChanged { get; set; }
    [Parameter] public EventCallback<WorkspaceDensity> DensityChanged { get; set; }
    [Parameter] public EventCallback<(string Stage, WorkspaceLayoutMode Layout)> StageSelected { get; set; }

    private bool SecretsEnabled => Form.SessionPrivacy == DefinitionSessionPrivacy.BrowserSecretsEnabled;
    private string T(string key) => BrowserStrings.Get(key, Locale);

    private Task ToggleNamingAsync() =>
        NamingModeChanged.InvokeAsync(NamingMode == WorkspaceNamingMode.Technical
            ? WorkspaceNamingMode.Humanized
            : WorkspaceNamingMode.Technical);

    private Task HandleDensityChanged(ChangeEventArgs args)
    {
        WorkspaceDensity target = args.Value?.ToString() switch
        {
            "spacious" => WorkspaceDensity.Spacious,
            "compact" => WorkspaceDensity.Compact,
            "dense" => WorkspaceDensity.Dense,
            _ => WorkspaceDensity.Comfortable
        };
        return DensityChanged.InvokeAsync(target);
    }
}
