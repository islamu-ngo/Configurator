@implements IDisposable
@using System.Globalization
@using Configurator.Browser.Resources
@using Configurator.Presentation
@using Configurator.Core.Definitions

<section class="configuration-files" aria-labelledby="@("artifact-" + Metadata.ArtifactId)"
         data-operation-phase="private-export"
         data-prepared-file="@Metadata.ArtifactId" data-readiness="@(Metadata.IsDraft ? "draft" : "complete")">
    <h4 id="@("artifact-" + Metadata.ArtifactId)" class="configuration-files__heading"><bdi dir="ltr">@Metadata.FileName</bdi></h4>
    @if (Destination is { } destination)
    {
        @if (destination.Title != destination.Id) { <p>@DestinationText("title", destination.Title)</p> }
        @if (destination.Description is { } description) { <p>@DestinationText("description", description)</p> }
        @if (destination.Surface is { } surface)
        {
            <p data-artifact-surface="@surface">@Text(surface == "compose-input" ? "ComposeInputDestination" : "ProcessEnvironmentDestination")</p>
        }
    }
    <p>@Text(Metadata.IsDraft ? "DraftArtifactReadiness" : "CompleteArtifactReadiness") @Text(Revealed ? "PrivateOutputRevealed" : "PrivateOutputHidden")</p>
    @if (Metadata.Completions.Count > 0)
    {
        <p class="configuration-files__draft-summary" data-deferred-secret-summary="@Metadata.Completions.Count">
            @Format("FilesDeferredCountSummary", Metadata.Completions.Count)
        </p>
        var completionEntries = new Dictionary<(string FieldId, string RelKey), DefinitionDiscoveryEntry>(Form.Projection.Entries.Count);
        foreach (var candidate in Form.Projection.Entries)
            completionEntries.TryAdd((candidate.FieldId, string.Join('\0', candidate.RelativePath)), candidate);
        <ul class="configuration-files__completions">
            @foreach (var item in Metadata.Completions)
            {
                var path = DefinitionPath.Parse(item.FieldPath).Segments;
                var entry = path.Count > 0
                    ? completionEntries.GetValueOrDefault((DefinitionProfile.FieldId(path[0]), string.Join('\0', path.Skip(1))))
                    : null;
                <li data-completion-field="@item.FieldPath" data-completion-output="@item.OutputPath"
                    data-completion-required="@(entry?.IsRequired.ToString().ToLowerInvariant() ?? "unknown")">
                    <strong>@(entry?.Title ?? Text("FilesDeferredSecret"))</strong>
                    <span>@Text(entry is null ? "FilesDeferredUnknown" : entry.IsRequired ? "FilesDeferredRequired" : "FilesDeferredOptional")</span>
                    <details><summary>@Text("ReviewDetails")</summary>
                        <code dir="ltr">@item.FieldPath</code> <span aria-hidden="true">&rarr;</span> <code dir="ltr">@item.OutputPath</code>
                    </details>
                </li>
            }
        </ul>
    }
    <div class="actions">
        <AppButton Variant="Variant.Outlined" data-action="copy-file" OnClick="InvokeCopyAsync">@Format("CopyArtifact", Metadata.FileName)</AppButton>
        <AppButton data-action="download-file" OnClick="InvokeDownloadAsync">@Format("DownloadArtifact", Metadata.FileName)</AppButton>
        <AppButton Variant="Variant.Outlined" data-action="reveal-file" aria-expanded="@Revealed.ToString().ToLowerInvariant()"
                   OnClick="InvokeRevealAsync">@Format(Revealed ? "HideArtifact" : "RevealArtifact", Metadata.FileName)</AppButton>
    </div>
    <p class="form-help configuration-files__download-custody" data-download-custody-note>@Text("FilesDownloadCustodyNote")</p>
    @if (StatusKey is not null)
    {
        <p role="status" class="notice configuration-files__status" data-file-status="@StatusCode">
            <span>@Format(StatusKey, Metadata.FileName)</span>
            @if (StatusCode is "clipboard-unavailable" or "download-unavailable" or "preview-unavailable")
            {
                <AppButton Variant="Variant.Outlined" data-action="retry-file-export" OnClick="RetryLastActionAsync">@Text("RetryFileExport")</AppButton>
            }
        </p>
    }
    <pre @ref="_preview" class="configuration-files__preview" hidden="@(!Revealed)" dir="ltr" tabindex="0"
         aria-label="@Format("PrivateArtifactPreview", Metadata.FileName)"></pre>
</section>

@code {
    [Parameter, EditorRequired] public DefinitionPreparationMetadata Metadata { get; set; } = null!;
    [Parameter, EditorRequired] public DefinitionFormModel Form { get; set; } = null!;
    [Parameter] public ArtifactDefinition? Destination { get; set; }
    [Parameter] public string Locale { get; set; } = "en";
    [Parameter] public bool Revealed { get; set; }
    [Parameter] public string? StatusKey { get; set; }
    [Parameter] public string? StatusCode { get; set; }
    [Parameter] public EventCallback Copy { get; set; }
    [Parameter] public EventCallback Download { get; set; }
    [Parameter] public EventCallback Reveal { get; set; }
    private ElementReference _preview;
    private bool _disposed;
    private string _lastAttemptedAction = "copy";
    public ElementReference? PreviewElement => _disposed ? null : _preview;
    private Task InvokeCopyAsync() { _lastAttemptedAction = "copy"; return Copy.InvokeAsync(); }
    private Task InvokeDownloadAsync() { _lastAttemptedAction = "download"; return Download.InvokeAsync(); }
    private Task InvokeRevealAsync() { _lastAttemptedAction = "reveal"; return Reveal.InvokeAsync(); }
    private Task RetryLastActionAsync() => _lastAttemptedAction switch
    {
        "download" => Download.InvokeAsync(),
        "reveal" => Reveal.InvokeAsync(),
        _ => Copy.InvokeAsync()
    };
    private string Text(string key) => BrowserStrings.Get(key, Locale);
    private string Format(string key, params object?[] arguments) => string.Format(CultureInfo.GetCultureInfo(Locale), Text(key), arguments);
    private string DestinationText(string member, string fallback)
    {
        int index = Form.Definition.Artifacts.ToList().FindIndex(artifact => artifact.Id == Metadata.ArtifactId);
        return Form.LocalizedText(DefinitionPath.FromSegments(["artifacts", index.ToString(CultureInfo.InvariantCulture), member]), fallback)!;
    }
    public void Dispose() { _disposed = true; _preview = default; }
}
