@using Microsoft.AspNetCore.Components.Sections

<header class="nav-menu__header">
    <a class="nav-menu__brand" href="" aria-label="@T("HomeLabel")"><span class="nav-menu__mark" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg></span> <bdi dir="ltr">ISLAMU Configurator</bdi></a>
    <button @ref="_toggle" class="nav-menu__toggle" type="button"
            aria-controls="application-navigation" aria-expanded="@(_open ? "true" : "false")" @onclick="ToggleAsync" @onkeydown="HandleMenuKeyAsync">@T("Menu")</button>
    <WorkspaceSearch />
</header>
<nav id="application-navigation" class="nav-menu @(_open ? "nav-menu--open" : "")"
     aria-label="@T("ApplicationNavigation")" @onkeydown="HandleNavigationKeyAsync">
    <button class="nav-menu__close" type="button" @onclick="CloseAsync">@T("CloseMenu")</button>
    <div class="nav-menu__sections" @onclick="CloseSectionNavigation">
        <SectionOutlet SectionName="configuration-sections" />
    </div>
    <p class="nav-menu__section">@T("Workspace")</p>
    <ul class="nav-menu__links">
        <li class="nav-menu__item">
            <NavLink href="" Match="NavLinkMatch.All" Class="d-block text-decoration-none" @onclick="CloseAsync"><span class="nav-menu__link"><MudIcon Icon="@Icons.Material.Outlined.Home" Size="Size.Small" aria-hidden="true" />@T("CatalogueTitle")</span></NavLink>
        </li>
        <li class="nav-menu__item">
            <NavLink href="open" Class="d-block text-decoration-none" @onclick="CloseAsync"><span class="nav-menu__link"><MudIcon Icon="@Icons.Material.Outlined.FolderOpen" Size="Size.Small" aria-hidden="true" />@T("OpenFileOrLink")</span></NavLink>
        </li>
        <li class="nav-menu__item">
            <NavLink href="help" Class="d-block text-decoration-none" @onclick="CloseAsync"><span class="nav-menu__link"><MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" aria-hidden="true" />@T("Help")</span></NavLink>
        </li>
    </ul>
    <div class="nav-menu__settings">
        <button @ref="_settingsToggle" class="nav-menu__settings-toggle" type="button"
                aria-controls="navigation-settings" aria-expanded="@(_settingsOpen ? "true" : "false")"
                @onclick="ToggleSettingsAsync">@T("Settings")</button>
        <div id="navigation-settings" class="nav-menu__settings-content" hidden="@(!_settingsOpen)">
            @if (_settingsOpen)
            {
                <ThemeQuickSwitcher />
            }
        </div>
    </div>
    <div class="nav-menu__local">
        <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" aria-hidden="true" />
        <p class="nav-menu__local-copy"><strong class="nav-menu__local-title">@T("LocalWorkspace")</strong><br />@T("AnswersStayLocal")</p>
    </div>
</nav>

@code {
    [CascadingParameter] public (string Locale, string Direction) Culture { get; set; } = ("en", "ltr");
    private string T(string key) => BrowserStrings.Get(key, Culture.Locale);
    private bool _open;
    private bool _settingsOpen;
    private ElementReference _toggle;
    private ElementReference _settingsToggle;

    private async Task ToggleAsync()
    {
        if (_open) await CloseAsync();
        else _open = true;
    }

    private async Task CloseAsync()
    {
        if (!_open) return;
        _open = false;
        _settingsOpen = false;
        await _toggle.FocusAsync();
    }

    private void CloseSectionNavigation()
    {
        // Section selection owns heading focus; closing this disclosure must not restore the toggle.
        _open = false;
        _settingsOpen = false;
    }

    private async Task ToggleSettingsAsync()
    {
        if (_settingsOpen) await CloseSettingsAsync();
        else _settingsOpen = true;
    }

    private async Task CloseSettingsAsync()
    {
        _settingsOpen = false;
        await _settingsToggle.FocusAsync();
    }

    private async Task HandleMenuKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") await CloseAsync();
    }

    private async Task HandleNavigationKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key != "Escape") return;
        if (_settingsOpen) await CloseSettingsAsync();
        else await CloseAsync();
    }
}
