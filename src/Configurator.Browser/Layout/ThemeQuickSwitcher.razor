@inject AppearanceThemeService Appearance
@implements IDisposable

<div class="theme-quick-switcher">
    <div class="theme-quick-switcher__control">
        <label for="appearance-mode">@T("Appearance")</label>
        <select id="appearance-mode" value="@Appearance.Current.ThemeMode" @onchange="ModeChanged">
            <option value="system">@T("System")</option>
            <option value="light">@T("Light")</option>
            <option value="dark">@T("Dark")</option>
            <option value="lighthighcontrast">@T("LightHighContrast")</option>
            <option value="darkhighcontrast">@T("DarkHighContrast")</option>
        </select>
    </div>
    <div class="theme-quick-switcher__control">
        <label for="appearance-direction">@T("Direction")</label>
        <select id="appearance-direction" value="@Appearance.Current.Direction" @onchange="DirectionChanged">
            <option value="auto">@T("Automatic")</option>
            <option value="ltr">@T("LeftToRight")</option>
            <option value="rtl">@T("RightToLeft")</option>
        </select>
    </div>
    <div class="theme-quick-switcher__control">
        <label for="appearance-density">@T("Density")</label>
        <select id="appearance-density" value="@Appearance.Current.Density" @onchange="DensityChanged">
            <option value="spacious">@T("Spacious")</option>
            <option value="comfortable">@T("Comfortable")</option>
            <option value="compact">@T("Compact")</option>
            <option value="dense">@T("Dense")</option>
        </select>
    </div>
    <div class="theme-quick-switcher__control">
        <label for="appearance-naming">@T("NamingMode")</label>
        <select id="appearance-naming" value="@Appearance.Current.NamingMode" @onchange="NamingChanged">
            <option value="humanized">@T("Humanized")</option>
            <option value="technical">@T("Technical")</option>
        </select>
    </div>
</div>

@code {
    [CascadingParameter] public (string Locale, string Direction) Culture { get; set; } = ("en", "ltr");
    private string T(string key) => BrowserStrings.Get(key, Culture.Locale);
    protected override void OnInitialized() => Appearance.Changed += AppearanceChanged;

    private void AppearanceChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);

    private Task ModeChanged(ChangeEventArgs args) => Appearance.SetAsync(args.Value?.ToString() ?? "system", Appearance.Current.Direction).AsTask();
    private Task DirectionChanged(ChangeEventArgs args) => Appearance.SetAsync(Appearance.Current.ThemeMode, args.Value?.ToString() ?? "auto").AsTask();
    private Task DensityChanged(ChangeEventArgs args) => Appearance.SetDensityAsync(args.Value?.ToString() ?? "comfortable").AsTask();
    private Task NamingChanged(ChangeEventArgs args) => Appearance.SetNamingModeAsync(args.Value?.ToString() ?? "humanized").AsTask();

    public void Dispose() => Appearance.Changed -= AppearanceChanged;
}
