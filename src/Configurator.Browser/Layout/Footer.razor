<footer class="site-footer">
    <div class="site-footer__content">
        <div class="site-footer__about">
            <span class="site-footer__brand"><bdi dir="ltr">ISLAMU Configurator</bdi></span>
            <p>@T("FooterPurpose")</p>
        </div>
        <nav aria-label="@T("SupportLinks")">
            <a href="help">@T("HelpPrivacy")</a>
            <a href="https://github.com/islamu-ngo/Configurator" rel="noopener noreferrer" target="_blank">@T("SourceContributions") <span class="sr-only">@T("NewTab")</span><span aria-hidden="true">↗</span></a>
        </nav>
    </div>
</footer>

@code {
    [CascadingParameter] public (string Locale, string Direction) Culture { get; set; } = ("en", "ltr");
    private string T(string key) => BrowserStrings.Get(key, Culture.Locale);
}
