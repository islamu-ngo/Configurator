@inherits LayoutComponentBase
@implements IDisposable
@inject AppearanceThemeService Appearance
@inject BrowserNavigationState NavigationState

<CascadingValue Value="@NavigationState.Culture">
<MudRTLProvider RightToLeft="@IsRtl">
    <MudThemeProvider Theme="@_theme" IsDarkMode="@Appearance.IsDark" ObserveSystemDarkModeChange="false" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />
    <WorkspaceNavigationGuard />
    <div class="main-layout" lang="@NavigationState.Culture.Locale" dir="@(IsRtl ? "rtl" : "ltr")">
        <a class="main-layout__skip-link" href="#main-content" @onclick="SkipToContentAsync" @onclick:preventDefault>@BrowserStrings.Get("SkipToContent", NavigationState.Culture.Locale)</a>
        <NavMenu />
        <main @ref="_mainContent" id="main-content" class="main-layout__main" tabindex="-1">@Body</main>
        <div class="main-layout__footer">
            <Footer />
        </div>
    </div>
</MudRTLProvider>
</CascadingValue>

@code {
    private MudTheme _theme = new();
    private ElementReference _mainContent;
    private bool IsRtl => (Appearance.Current.Direction == "auto"
        ? NavigationState.Culture.Direction : Appearance.Current.Direction) == "rtl";

    private async Task SkipToContentAsync() => await _mainContent.FocusAsync();

    protected override void OnInitialized()
    {
        _theme = Appearance.CreateTheme();
        Appearance.Changed += AppearanceChanged;
        NavigationState.Changed += CultureChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Appearance.InitializeAsync();
    }

    private void AppearanceChanged(object? sender, EventArgs args)
    {
        _theme = Appearance.CreateTheme();
        _ = InvokeAsync(StateHasChanged);
    }

    private void CultureChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Appearance.Changed -= AppearanceChanged;
        NavigationState.Changed -= CultureChanged;
    }
}
