@implements IDisposable
@using Microsoft.JSInterop
@inject Configurator.Browser.Services.BrowserNavigationState State
@inject Microsoft.JSInterop.IJSRuntime Javascript
@inject NavigationManager Navigation

<NavigationLock ConfirmExternalNavigation="@State.IsActive" OnBeforeInternalNavigation="BeforeNavigationAsync" />

@code {
    protected override void OnInitialized() => State.Changed += Changed;

    private async Task BeforeNavigationAsync(LocationChangingContext context)
    {
        if (context.TargetLocation == Navigation.Uri) return;
        try
        {
            bool leave = await State.TryLeaveAsync(async () =>
                await Javascript.InvokeAsync<bool>("confirm", "Discard this workspace's answers and output and continue? Choose Cancel to keep editing.")
                && !context.CancellationToken.IsCancellationRequested);
            if (!leave) context.PreventNavigation();
        }
        catch (JSException) { context.PreventNavigation(); }
    }

    private void Changed(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= Changed;
}
