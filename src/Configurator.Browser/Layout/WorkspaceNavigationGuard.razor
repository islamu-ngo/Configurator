@implements IDisposable
@inject Configurator.Browser.Services.BrowserNavigationState State
@inject IDialogService Dialogs
@inject NavigationManager Navigation

<NavigationLock ConfirmExternalNavigation="@State.HasWork" OnBeforeInternalNavigation="BeforeNavigationAsync" />

@code {
    protected override void OnInitialized()
    {
        State.Changed += Changed;
        State.WorkChanged += Changed;
    }

    private async Task BeforeNavigationAsync(LocationChangingContext context)
    {
        if (context.TargetLocation == Navigation.Uri) return;
        bool leave = await State.TryLeaveAsync(() =>
            AppDiscardDialog.ConfirmAsync(Dialogs, State.Culture.Locale, context.CancellationToken));
        if (!leave) context.PreventNavigation();
    }

    private void Changed(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        State.Changed -= Changed;
        State.WorkChanged -= Changed;
    }
}
