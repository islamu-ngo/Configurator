@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject WorkspaceSearchState SearchState
@inject IJSRuntime Javascript

@if (SearchState.IsActive)
{
    long generation = SearchState.Generation;
    <div class="workspace-search @(_open ? "workspace-search--open" : "")" @ref="_root" @onkeydown="args => HandleKey(generation, args)">
        <div class="workspace-search__entry" @onclick="() => OpenAsync(generation)">
            <MudTextField T="string" @ref="_input" InputId="configuration-search" Label="Find a setting"
                          Value="@SearchState.Query" ValueChanged="value => Search(generation, value)"
                          Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                          MaxLength="256" UserAttributes="@InputAttributes" />
        </div>
        <button type="button" class="button button--secondary workspace-search__trigger"
                aria-label="Open setting search" aria-expanded="@(_open ? "true" : "false")"
                aria-controls="workspace-search-results" @onclick="() => OpenAsync(generation)">Search settings</button>
        @if (_open)
        {
            <section id="workspace-search-results" class="workspace-search__results" aria-label="Setting search results">
                <div class="workspace-search__heading">
                    <strong>Settings in this workspace</strong>
                    <button type="button" class="button button--secondary" aria-label="Close setting search"
                            @onclick="() => CloseAsync(generation)">Close</button>
                </div>
                <p class="form-help">Search definition metadata, never answers. Up to 256 characters and 16 words.</p>
                @if (_queryRejected) { <p role="status">Use no more than 256 characters and 16 words.</p> }
                @SearchState.Content
            </section>
        }
    </div>
}

@code {
    private static readonly Dictionary<string, object> InputAttributes = new()
    {
        ["autocomplete"] = "off", ["spellcheck"] = "false"
    };
    private MudTextField<string>? _input;
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<WorkspaceSearch>? _reference;
    private long _generation;
    private long _watchedGeneration = -1;
    private long? _focusQueryGeneration;
    private long? _focusEntryGeneration;
    private bool _open;
    private bool _queryRejected;
    private bool _disposed;
    protected override void OnInitialized()
    {
        _generation = SearchState.Generation;
        SearchState.Changed += Changed;
        SearchState.Navigated += Navigated;
    }
    private void Changed(object? sender, EventArgs args)
    {
        if (_generation == SearchState.Generation && !_open && _input?.Value == SearchState.Query)
            return;
        if (_generation != SearchState.Generation)
        {
            _generation = SearchState.Generation;
            _open = false;
            _queryRejected = false;
            _focusQueryGeneration = null;
            _focusEntryGeneration = null;
        }
        _ = InvokeAsync(StateHasChanged);
    }
    private void Navigated(object? sender, EventArgs args)
    {
        _open = false;
        _ = InvokeAsync(StateHasChanged);
    }
    private void Search(long generation, string value)
    {
        if (generation != SearchState.Generation) return;
        try { SearchState.Search(generation, value); _queryRejected = false; }
        catch (ArgumentException) { _queryRejected = true; }
        _open = true;
    }
    [JSInvokable]
    public async Task OpenAsync(long generation)
    {
        if (_disposed || !SearchState.IsActive || generation != SearchState.Generation) return;
        _open = true;
        _focusQueryGeneration = generation;
        await InvokeAsync(StateHasChanged);
    }
    [JSInvokable]
    public async Task DismissAsync(long generation)
    {
        if (_disposed || generation != SearchState.Generation || !_open) return;
        _open = false;
        await InvokeAsync(StateHasChanged);
    }
    private async Task CloseAsync(long generation)
    {
        if (_disposed || generation != SearchState.Generation) return;
        _open = false;
        _focusEntryGeneration = generation;
        await InvokeAsync(StateHasChanged);
    }
    private async Task HandleKey(long generation, KeyboardEventArgs args)
    {
        if (args.Key == "Escape") await CloseAsync(generation);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (_module is null)
        {
            var module = await Javascript.InvokeAsync<IJSObjectReference>("import", "./workspace-interactions.js");
            if (_disposed) { await module.DisposeAsync(); return; }
            _module = module;
            _reference = DotNetObjectReference.Create(this);
        }
        if (_watchedGeneration != SearchState.Generation)
        {
            await _module.InvokeVoidAsync("unwatch", _watchedGeneration);
            _watchedGeneration = SearchState.Generation;
            if (SearchState.IsActive)
                await _module.InvokeVoidAsync("watch", _reference, _root, _watchedGeneration);
        }
        if (_disposed) return;
        if (_focusEntryGeneration == SearchState.Generation)
        {
            _focusEntryGeneration = null;
            await _module.InvokeVoidAsync("returnFocus", _root, _watchedGeneration);
        }
        if (_focusQueryGeneration == SearchState.Generation && _open && _input is not null)
        {
            _focusQueryGeneration = null;
            await _module.InvokeVoidAsync("focusEntry", _root);
        }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        SearchState.Changed -= Changed;
        SearchState.Navigated -= Navigated;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("unwatch", _watchedGeneration);
            await _module.DisposeAsync();
        }
        _reference?.Dispose();
    }
}
