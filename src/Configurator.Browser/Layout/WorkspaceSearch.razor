@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject WorkspaceSearchState SearchState
@inject IJSRuntime Javascript

@if (SearchState.IsActive)
{
    long generation = SearchState.Generation;
    string? activeOptionId = _open ? SearchState.ActiveOptionId : null;
    <div class="workspace-search @(_open ? "workspace-search--open" : "")" @ref="_root" @onkeydown="args => HandleKey(generation, args)">
        <div class="workspace-search__entry" @onclick="() => OpenAsync(generation)">
            <label class="sr-only" for="configuration-search">@T("FindSetting")</label>
            <input @ref="_inputElement"
                   id="configuration-search"
                   type="search"
                   class="workspace-search__input"
                   role="combobox"
                   aria-autocomplete="list"
                   aria-expanded="@(_open ? "true" : "false")"
                   aria-controls="workspace-search-results"
                   aria-activedescendant="@activeOptionId"
                   autocomplete="off"
                   spellcheck="false"
                   maxlength="256"
                   placeholder="@T("FindSetting")"
                   value="@SearchState.Query"
                   @oninput="args => Search(generation, args.Value?.ToString() ?? string.Empty)" />
        </div>
        <button type="button" class="button button--secondary workspace-search__trigger"
                aria-label="@T("OpenSettingSearch")" aria-expanded="@(_open ? "true" : "false")"
                aria-controls="workspace-search-results" @onclick="() => OpenAsync(generation)">@T("SearchSettings")</button>
        @if (_open)
        {
            <section id="workspace-search-results" class="workspace-search__results" aria-label="@T("SettingSearchResults")">
                <div class="workspace-search__heading">
                    <strong>@T("WorkspaceSettings")</strong>
                    <button type="button" class="button button--secondary" aria-label="@T("CloseSettingSearch")"
                            @onclick="() => CloseAsync(generation)">@T("Close")</button>
                </div>
                <p class="form-help">@T("SearchHelp")</p>
                @if (_queryRejected) { <p role="status">@T("SearchLimits")</p> }
                @SearchState.Content
            </section>
        }
    </div>
}

@code {
    [CascadingParameter] public (string Locale, string Direction) Culture { get; set; } = ("en", "ltr");
    private string T(string key) => BrowserStrings.Get(key, Culture.Locale);
    private ElementReference _inputElement;
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<WorkspaceSearch>? _reference;
    private long _generation;
    private long _watchedGeneration = -1;
    private long? _focusQueryGeneration;
    private long? _focusEntryGeneration;
    private bool _open;
    private bool _queryRejected;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _generation = SearchState.Generation;
        SearchState.Changed += Changed;
        SearchState.Navigated += Navigated;
        SearchState.OpenRequested += OpenRequested;
    }

    private void OpenRequested(object? sender, EventArgs args)
    {
        if (_disposed) return;
        _open = true;
        _focusQueryGeneration = _generation;
        _ = InvokeAsync(StateHasChanged);
    }

    private void Changed(object? sender, EventArgs args)
    {
        if (_generation != SearchState.Generation)
        {
            _generation = SearchState.Generation;
            _open = false;
            _queryRejected = false;
            _focusQueryGeneration = null;
            _focusEntryGeneration = null;
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private void Navigated(object? sender, EventArgs args)
    {
        _open = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void Search(long generation, string value)
    {
        if (generation != SearchState.Generation) return;
        try { SearchState.Search(generation, value); _queryRejected = false; }
        catch (ArgumentException) { _queryRejected = true; }
        _open = true;
    }

    [JSInvokable]
    public async Task OpenAsync(long generation)
    {
        if (_disposed || !SearchState.IsActive || generation != SearchState.Generation) return;
        _open = true;
        _focusQueryGeneration = generation;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task DismissAsync(long generation)
    {
        if (_disposed || generation != SearchState.Generation || !_open) return;
        _open = false;
        SearchState.ResetActiveOption(generation);
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseAsync(long generation)
    {
        if (_disposed || generation != SearchState.Generation) return;
        _open = false;
        SearchState.ResetActiveOption(generation);
        _focusEntryGeneration = generation;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleKey(long generation, KeyboardEventArgs args)
    {
        if (generation != SearchState.Generation) return;
        switch (args.Key)
        {
            case "Escape":
                await CloseAsync(generation);
                break;
            case "ArrowDown":
                if (!_open) _open = true;
                SearchState.MoveActiveOption(generation, +1);
                break;
            case "ArrowUp":
                if (!_open) _open = true;
                SearchState.MoveActiveOption(generation, -1);
                break;
            case "Enter":
                if (_open)
                    SearchState.TryActivateOption(generation);
                break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (_module is null)
        {
            var module = await Javascript.InvokeAsync<IJSObjectReference>("import", "./js/workspace-interactions.js");
            if (_disposed) { await module.DisposeAsync(); return; }
            _module = module;
            _reference = DotNetObjectReference.Create(this);
        }
        if (_watchedGeneration != SearchState.Generation)
        {
            await _module.InvokeVoidAsync("unwatch", _watchedGeneration);
            _watchedGeneration = SearchState.Generation;
            if (SearchState.IsActive)
                await _module.InvokeVoidAsync("watch", _reference, _root, _watchedGeneration);
        }
        if (_disposed) return;
        if (_focusEntryGeneration == SearchState.Generation)
        {
            _focusEntryGeneration = null;
            await _module.InvokeVoidAsync("returnFocus", _root, _watchedGeneration);
        }
        if (_focusQueryGeneration == SearchState.Generation && _open)
        {
            _focusQueryGeneration = null;
            await _module.InvokeVoidAsync("focusEntry", _root);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        SearchState.Changed -= Changed;
        SearchState.Navigated -= Navigated;
        SearchState.OpenRequested -= OpenRequested;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("unwatch", _watchedGeneration);
            await _module.DisposeAsync();
        }
        _reference?.Dispose();
    }
}
