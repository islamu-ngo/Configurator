@page "/store/{ProjectId}"
@implements IDisposable
@using Configurator.Browser.Services
@using Configurator.Core.Definitions
@inject DefinitionStoreCatalog Catalog
@inject NavigationManager Navigation

<PageTitle>@(_project?.Name ?? T("Project")) · Configurator</PageTitle>
<section class="store-project" lang="@Culture.Locale" aria-labelledby="store-project-heading">
    <a href="">@T("BackToCatalogue")</a>
    <h1 id="store-project-heading"><bdi>@(_project?.Name ?? T("Project"))</bdi></h1>
    @if (_loading)
    {
        <p role="status">@T("DirectoryLoading")</p>
    }
    else if (_project is null)
    {
        <p role="status" data-code="@_error">@T("ProjectUnavailable") <a href="open">@T("OpenFileOrLink")</a></p>
    }
    else
    {
        <p><bdi>@_project.Description</bdi></p>
        <p class="eyebrow">@T("DirectorySource")</p>
        <details>
        <summary>@T("SourceDetails")</summary>
        <dl class="store-project__metadata">
            <dt>@T("SourceRepository")</dt><dd><a href="@_project.SourceRepository" target="_blank" rel="noopener noreferrer"><bdi dir="ltr">@_project.SourceRepository</bdi><span class="sr-only">@T("NewTab")</span></a></dd>
            <dt>@T("License")</dt><dd><bdi dir="ltr">@_project.License</bdi></dd>
            <dt>@T("ApplicationId")</dt><dd><bdi dir="ltr">@_project.ApplicationId</bdi></dd>
            <dt>@T("Family")</dt><dd><bdi dir="ltr">@_project.FamilyId.ToString("D")</bdi></dd>
        </dl>
        <p>@T("TrustBoundary")</p>
        </details>
        <h2>@T("AvailableRevisions")</h2>
        <ul>
            @foreach (DefinitionStoreRevision revision in _project.Revisions)
            {
                <li>@T("Revision") <bdi dir="ltr">@revision.Revision</bdi> · @T("ApplicationVersions"): <bdi dir="ltr">@string.Join(", ", revision.ApplicationVersions)</bdi></li>
            }
        </ul>
        <label for="store-revision">@T("ChooseRevision")</label>
        <select id="store-revision" value="@_revision" @onchange="SelectRevision" disabled="@_busy">
            <option value="">@T("SelectRevision")</option>
            @foreach (DefinitionStoreRevision revision in _project.Revisions)
            {
                <option value="@revision.Revision">@T("Revision") @revision.Revision</option>
            }
        </select>
        @if (Selected is { } selected)
        {
            <dl class="store-project__metadata">
                <dt>@T("Publisher")</dt><dd><bdi>@selected.Publisher</bdi></dd>
                <dt>@T("ApplicationVersions")</dt><dd><bdi dir="ltr">@string.Join(", ", selected.ApplicationVersions)</bdi></dd>
                <dt>@T("EntryPoints")</dt><dd><bdi dir="ltr">@string.Join(", ", selected.EntryPoints)</bdi></dd>
                <dt>@T("Locales")</dt><dd><bdi dir="ltr">@string.Join(", ", selected.Locales)</bdi></dd>
                <dt>@T("OutputNames")</dt><dd><bdi dir="ltr">@string.Join(", ", selected.OutputNames)</bdi></dd>
                <dt>@T("Digest")</dt><dd><code dir="ltr">@selected.Digest</code></dd>
            </dl>
            <p>@T("VersionClaims")</p>
            @if (_admitted is null)
            {
                <AppButton OnClick="ReviewAsync" Disabled="@_busy">@T(_busy ? "CheckingSnapshot" : "ReviewRevision")</AppButton>
            }
        }
        @if (_error is not null)
        {
            <p role="alert" data-code="@_error">@T("RevisionRejected") @T("Code"): <bdi dir="ltr">@_error</bdi></p>
        }
        @if (_admitted is { } definition)
        {
            <AppCard>
                <h2>@T("ReadyToOpen") <bdi>@definition.Title</bdi></h2>
                <p>@T("Revision") <bdi dir="ltr">@definition.Revision</bdi> · @T("Digest") <code dir="ltr">@definition.Digest.Value</code></p>
                <p>@T("FreshWorkspace")</p>
                <AppButton OnClick="OpenWorkspace">@T("ConfigureRevision")</AppButton>
            </AppCard>
        }
    }
</section>

@code {
    [Parameter] public string ProjectId { get; set; } = string.Empty;
    [Parameter, SupplyParameterFromQuery(Name = "revision")] public string? RequestedRevision { get; set; }
    [CascadingParameter] public (string Locale, string Direction) Culture { get; set; } = ("en", "ltr");
    private string T(string key) => BrowserStrings.Get(key, Culture.Locale);
    private CancellationTokenSource? _lifetime;
    private DefinitionStoreProject? _project;
    private SetupDefinition? _admitted;
    private string _revision = string.Empty;
    private string? _error;
    private bool _loading;
    private bool _busy;
    private bool _disposed;
    private (string Project, string? Revision)? _request;
    private DefinitionStoreRevision? Selected => _project?.Revisions.SingleOrDefault(item => item.Revision.ToString(System.Globalization.CultureInfo.InvariantCulture) == _revision);

    protected override async Task OnParametersSetAsync()
    {
        if (_request == (ProjectId, RequestedRevision)) return;
        _request = (ProjectId, RequestedRevision);
        _lifetime?.Cancel();
        _lifetime?.Dispose();
        var lifetime = new CancellationTokenSource();
        _lifetime = lifetime;
        _loading = true;
        _busy = false;
        _project = null;
        _admitted = null;
        _revision = string.Empty;
        _error = null;
        try
        {
            IReadOnlyList<DefinitionStoreProject> projects = await Catalog.LoadAsync(lifetime.Token);
            if (_disposed || !ReferenceEquals(_lifetime, lifetime)) return;
            _project = projects.SingleOrDefault(project => project.ProjectId == ProjectId);
            if (_project is null) _error = "store-project-unavailable";
            else if (_project.Revisions.Any(revision => revision.Revision.ToString(System.Globalization.CultureInfo.InvariantCulture) == RequestedRevision))
                _revision = RequestedRevision!;
        }
        catch (BrowserLaunchException exception) { if (!_disposed && ReferenceEquals(_lifetime, lifetime)) _error = exception.Code; }
        finally { if (!_disposed && ReferenceEquals(_lifetime, lifetime)) _loading = false; }
    }

    private void SelectRevision(ChangeEventArgs args)
    {
        _revision = args.Value?.ToString() ?? string.Empty;
        _admitted = null;
        _error = null;
    }

    private async Task ReviewAsync()
    {
        if (Selected is not { } selected || _lifetime is null) return;
        CancellationTokenSource lifetime = _lifetime;
        _busy = true;
        _error = null;
        try
        {
            SetupDefinition definition = await Catalog.OpenAsync(ProjectId, selected.Revision, lifetime.Token);
            if (!_disposed && ReferenceEquals(_lifetime, lifetime) && Selected == selected) _admitted = definition;
        }
        catch (BrowserLaunchException exception) { if (!_disposed && ReferenceEquals(_lifetime, lifetime)) _error = exception.Code; }
        finally { if (!_disposed && ReferenceEquals(_lifetime, lifetime)) _busy = false; }
    }

    private void OpenWorkspace()
    {
        if (_admitted is not { } definition) return;
        Navigation.NavigateTo($"launch/{definition.FamilyId:D}?digest={definition.Digest.Value}");
    }

    public void Dispose()
    {
        _disposed = true;
        _lifetime?.Cancel();
        _lifetime?.Dispose();
        _admitted = null;
    }
}
