@page "/help"

<PageTitle>@T("HelpTitle") · Configurator</PageTitle>
<h1>@T("HelpTitle")</h1>
<AppCard>
    <h2>@T("HelpChooseTitle")</h2>
    <p>@T("HelpChooseBody")</p>
    <AppButton Href="./" Variant="Variant.Outlined">@T("HelpProjects")</AppButton>
    <AppButton Href="open" Variant="Variant.Outlined">@T("HelpCustomDefinition")</AppButton>
</AppCard>
<section>
    <h2>@T("HelpWorkTitle")</h2>
    <p>@T("HelpWorkBody")</p>
    <p>@T("HelpReuseBody")</p>
</section>
<section>
    <h2>@T("HelpCustodyTitle")</h2>
    <p>@T("HelpCustodyBody")</p>
    <p>@T("HelpSecretsBody")</p>
    <p>@T("HelpTargetBody")</p>
</section>
<section>
    <h2>@T("HelpOfflineTitle")</h2>
    <p>@T("HelpOfflineBody")</p>
</section>
<section>
    <h2>@T("HelpAppearanceTitle")</h2>
    <p>@T("HelpAppearanceBody")</p>
</section>

@code {
    [CascadingParameter] public (string Locale, string Direction) Culture { get; set; } = ("en", "ltr");
    private string T(string key) => BrowserStrings.Get(key, Culture.Locale);
}
