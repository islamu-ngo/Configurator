@page "/launch/{FamilyId}"
@implements IDisposable
@inject BrowserDefinitionRegistry Registry
@inject NavigationManager Navigation

<PageTitle>@T("WorkspaceTitle") · Configurator</PageTitle>
@if (_selection is { } selected)
{
    <section class="launch-header" lang="@Culture.Locale" aria-labelledby="launch-heading">
        <h1 id="launch-heading"><bdi>@selected.Definition.Title</bdi></h1>
        <details>
            <summary>@T("SourceDetails")</summary>
            <p>@T("Revision") <strong data-revision="@selected.Definition.Revision"><bdi dir="ltr">@selected.Definition.Revision</bdi></strong></p>
            <p>@T("Family"): <bdi dir="ltr">@selected.Definition.FamilyId.ToString("D")</bdi></p>
            <p>@T("Digest") <code dir="ltr" data-digest="@selected.Definition.Digest.Value">@selected.Definition.Digest.Value</code></p>
            <p>@T("Entry"): <bdi dir="ltr">@selected.Entry</bdi> · @T("Language"): <bdi dir="ltr">@selected.Locale</bdi></p>
            <p>@T("Publisher"): <bdi>@selected.Definition.Publisher</bdi></p>
            <p>@T("TrustBoundary")</p>
        </details>
    </section>
    <ConfigurationEditor @key="selected" @ref="_editor" Definition="@selected.Definition" InitialLocale="@selected.Locale"
                         InitialEntry="@(selected.EntryExplicit ? selected.Entry : null)" />
}
else
{
    <h1>@T("LaunchRejected")</h1>
    <p role="alert" data-code="@_error">@T("LaunchRejectedHelp") @T("Code"): <bdi dir="ltr">@_error</bdi></p>
    <NavLink href="">@T("BackToCatalogue")</NavLink>
}

@code {
    [CascadingParameter] public (string Locale, string Direction) Culture { get; set; } = ("en", "ltr");
    private string T(string key) => BrowserStrings.Get(key, Culture.Locale);
    [Parameter] public string FamilyId { get; set; } = string.Empty;
    private BrowserLaunchSelection? _selection;
    private ConfigurationEditor? _editor;
    private string? _request;
    private string _error = "launch-invalid";
    private bool _disposed;

    protected override void OnInitialized() => Navigation.LocationChanged += LocationChanged;

    protected override void OnParametersSet() => Select();

    private void Select()
    {
        if (_request == Navigation.Uri) return;
        _editor?.Invalidate();
        _request = Navigation.Uri;
        _selection = null;
        Uri uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        try
        {
            string path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
            if (path != $"launch/{FamilyId}") throw new BrowserLaunchException("family-invalid");
            if (uri.Fragment.Length > 0) throw new BrowserLaunchException("query-invalid");
            _selection = BrowserLaunchSelection.Resolve(Registry.Current, FamilyId, uri.Query);
        }
        catch (BrowserLaunchException exception)
        {
            _error = exception.Code;
        }
    }

    private void LocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (_disposed || args.Location == _request) return;
        // Invalidate immediately, before a pending upload can commit into the old route.
        _editor?.Invalidate();
        _selection = null;
        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            string path = Navigation.ToBaseRelativePath(args.Location).Split('?', '#')[0];
            if (path == $"launch/{FamilyId}") Select();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        Navigation.LocationChanged -= LocationChanged;
        _editor?.Invalidate();
        _selection = null;
    }
}
