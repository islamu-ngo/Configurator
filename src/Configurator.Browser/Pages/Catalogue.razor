@page "/"
@inject BrowserDefinitionRegistry Registry

<PageTitle>Configurator public definitions</PageTitle>
<section class="hero" aria-labelledby="catalogue-heading">
    <p class="eyebrow">Local public workspace</p>
    <h1 id="catalogue-heading">Prepare your configuration</h1>
    <p class="lede">
        Choose a bundled definition, supply local settings and export configuration files.
        Secret entry is optional and stays in this tab. Target validation and application remain with your target.
        Prepare the app for offline use while online before a disconnected relaunch.
    </p>
</section>
<p><NavLink href="open">Open a local file, a pinned publisher source, or a retained offline definition</NavLink></p>
<section aria-labelledby="definitions-heading">
    <h2 id="definitions-heading">Bundled definitions</h2>
    <ul class="definition-list">
        @foreach (var definition in Registry.Current.Definitions)
        {
            <li>
                <NavLink href="@($"launch/{definition.FamilyId:D}?digest={definition.Digest.Value}")">
                    @definition.Title - revision @definition.Revision
                </NavLink>
                <p>Publisher claim: @definition.Publisher. Family identity does not establish trust.</p>
            </li>
        }
    </ul>
</section>
