@page "/"
@inject BrowserDefinitionRegistry Registry

<PageTitle>Home · Configurator</PageTitle>
<header class="hero page-header catalogue__hero" aria-labelledby="catalogue-heading">
    <p class="eyebrow">Local configuration workspace</p>
    <h1 id="catalogue-heading">Prepare your configuration</h1>
    <p class="lede">
        Open a definition, answer the questions and prepare your files.
        Your answers stay in this tab. Secret entry is optional.
    </p>
    <div class="actions">
        <AppButton Href="open">Open configuration</AppButton>
        <AppButton Href="store" Variant="Variant.Outlined">Browse Definition Store</AppButton>
    </div>
</header>
<ol class="catalogue__steps" aria-label="Configuration workflow">
    <li><span class="catalogue__step-number" aria-hidden="true">1</span><div><strong>Choose a definition</strong><p>Use a bundled project, a local file or a public link.</p></div></li>
    <li><span class="catalogue__step-number" aria-hidden="true">2</span><div><strong>Configure locally</strong><p>Follow the guided sections and choose how to handle secrets.</p></div></li>
    <li><span class="catalogue__step-number" aria-hidden="true">3</span><div><strong>Prepare your files</strong><p>Export a draft or complete configuration for target validation.</p></div></li>
</ol>
<section aria-labelledby="definitions-heading">
    <h2 id="definitions-heading">Bundled definitions</h2>
    <div class="catalogue__definitions">
        @foreach (var definition in Registry.Current.Definitions)
        {
            <AppCard>
                <h3>@definition.Title</h3>
                <p>Definition revision @definition.Revision · Publisher claim: @definition.Publisher</p>
                <p>Family identity does not authenticate a publisher.</p>
                <AppButton Href="@($"launch/{definition.FamilyId:D}?digest={definition.Digest.Value}")" Variant="Variant.Outlined">Configure @definition.Title</AppButton>
            </AppCard>
        }
    </div>
</section>
<p>Prepare the app for offline use while online. <a href="help">Learn about offline use, privacy and target validation.</a></p>
