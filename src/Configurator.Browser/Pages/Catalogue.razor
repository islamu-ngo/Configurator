@page "/"
@implements IDisposable
@using System.Globalization
@using Configurator.Browser.Components.Store
@using Configurator.Core.Definitions
@using Configurator.Presentation.Store
@inject BrowserDefinitionRegistry Registry
@inject DefinitionStoreCatalog Catalog
@inject NavigationManager Navigation
@inject IDialogService Dialogs

<PageTitle>@T("CatalogueTitle") · Configurator</PageTitle>
<div class="catalogue" lang="@Culture.Locale">
    <header class="page-header catalogue__hero" aria-labelledby="catalogue-heading">
        <p class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>@T("LocalWorkspace")</p>
        <h1 id="catalogue-heading">@T("CatalogueTitle")</h1>
        <p class="lede">@T("CatalogueIntro")</p>
    </header>
    <div class="catalogue__controls">
        @if (_groups.Count >= 4)
        {
            <div class="catalogue__search">
                <label for="catalogue-search">@T("ProjectSearch")</label>
                <input class="form-control" id="catalogue-search" type="search" maxlength="256"
                       placeholder="@T("ProjectSearch")"
                       @bind="_query" @bind:event="oninput" />
            </div>
        }
        <p class="catalogue__count" role="status"><span class="catalogue__count-num">@Visible.Count()</span> @T("ProjectCount")</p>
    </div>
    <div class="catalogue__definitions">
        @foreach (CatalogueProject project in Visible)
        {
            CatalogueDefinition? primary = project.Primary;
            CatalogueDefinition lead = primary ?? project.Choices[0];
            DefinitionStoreProject? resolvedSource = lead.Sources.FirstOrDefault()
                ?? project.Choices.SelectMany(choice => choice.Sources).FirstOrDefault();
            StoreProjectCardViewModel? storeCard = resolvedSource is not null
                ? new StoreProjectCardViewModel(resolvedSource)
                : null;
            string monogram = storeCard?.Monogram ?? ComputeLocalMonogram(project.Title, project.ApplicationId);
            string summary = !string.IsNullOrWhiteSpace(project.Description) ? project.Description! : project.ApplicationId;
            int fileCount = project.OutputNames.Count;
            string fileLabel = fileCount == 1
                ? T("FileCountSingle")
                : string.Format(CultureInfo.GetCultureInfo(Culture.Locale), T("FileCountPlural"), fileCount);
            string[] extraSourceNames = project.Choices
                .SelectMany(choice => choice.Sources)
                .Select(source => source.Name)
                .Where(name => !string.IsNullOrWhiteSpace(name) && !string.Equals(name, project.Title, StringComparison.OrdinalIgnoreCase))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray();

            <article class="catalogue__card" @key="project.ApplicationId"
                     data-project="@ProjectIdentifier(project)"
                     data-project-origin="@(primary?.Local is not null ? "built-in" : "directory")">
                <div class="catalogue__card-media">
                    @if (storeCard is { HasIcon: true, IconDataUri: { } iconUri })
                    {
                        <img src="@iconUri" alt="" class="catalogue__card-logo" data-project-logo />
                    }
                    else
                    {
                        <span class="catalogue__card-monogram" data-project-monogram aria-hidden="true">@monogram</span>
                    }
                </div>

                <div class="catalogue__card-body">
                    <div class="catalogue__card-top">
                        <div class="catalogue__card-heading">
                            <h2 class="catalogue__card-title"><bdi>@project.Title</bdi></h2>
                            <div class="catalogue__card-badges">
                                @if (primary is { Local: not null })
                                {
                                    <span class="catalogue__badge catalogue__badge--local"><span class="catalogue__badge-dot" aria-hidden="true"></span>@T("AvailableInApp")</span>
                                }
                                else if (primary is not null)
                                {
                                    <span class="catalogue__badge"><span class="catalogue__badge-dot" aria-hidden="true"></span>@T("DirectorySource")</span>
                                }
                                @foreach (string sourceName in extraSourceNames)
                                {
                                    <span class="catalogue__pill catalogue__pill--source"><bdi>@sourceName</bdi></span>
                                }
                                <span class="catalogue__pill" dir="ltr">r@(lead.Revision.ToString(CultureInfo.InvariantCulture))</span>
                                @if (fileCount > 0)
                                {
                                    <span class="catalogue__pill">@fileLabel</span>
                                }
                            </div>
                        </div>
                        <button type="button"
                                class="catalogue__info-button"
                                data-action="open-project-details"
                                aria-label="@($"{T("ProjectDetailsLabel")}: {project.Title}")"
                                title="@T("ProjectDetailsLabel")"
                                @onclick="() => OpenDetailsAsync(project)">
                            <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" aria-hidden="true" />
                        </button>
                    </div>

                    <p class="catalogue__card-summary" data-catalogue-description><bdi>@summary</bdi></p>

                    <div class="catalogue__card-actions">
                        @if ((primary ?? project.Choices.FirstOrDefault()) is { } exploreChoice)
                        {
                            <a class="button button--secondary catalogue__action-btn"
                               data-action="explore-definition"
                               href="@($"explore/{exploreChoice.Family:D}?revision={exploreChoice.Revision.ToString(CultureInfo.InvariantCulture)}&digest={exploreChoice.Digest}")">@T("ExploreDefinitionAction")</a>
                        }

                        @if (primary is not null || project.Choices.Any(choice => choice.Sources.Count > 0))
                        {
                            <MudMenu AnchorOrigin="Origin.BottomRight"
                                     TransformOrigin="Origin.TopRight"
                                     Dense="true"
                                     Class="catalogue__more-menu">
                                <ActivatorContent>
                                    <button type="button"
                                            class="button button--secondary catalogue__more-button"
                                            data-action="open-card-menu"
                                            aria-label="@($"{T("MoreActions")}: {project.Title}")">
                                        <span aria-hidden="true">⋯</span>
                                    </button>
                                </ActivatorContent>
                                <ChildContent>
                                    @if (primary is { Local: { } localEntry })
                                    {
                                        <MudMenuItem data-catalogue-entry="import" OnClick='() => OpenLocal(localEntry, "import")'>@T("UseExistingConfigurationEntry")</MudMenuItem>
                                        <MudMenuItem data-catalogue-entry="profile" OnClick='() => OpenLocal(localEntry, "profile")'>@T("OpenSavedProfileEntry")</MudMenuItem>
                                    }
                                    else if (primary is { } dirEntry)
                                    {
                                        <MudMenuItem data-catalogue-entry="import" Disabled="@_opening" OnClick='() => OpenDirectoryAsync(dirEntry, "import")'>@T("UseExistingConfigurationEntry")</MudMenuItem>
                                        <MudMenuItem data-catalogue-entry="profile" Disabled="@_opening" OnClick='() => OpenDirectoryAsync(dirEntry, "profile")'>@T("OpenSavedProfileEntry")</MudMenuItem>
                                    }
                                    @foreach (CatalogueDefinition choice in project.Choices)
                                    {
                                        @foreach (DefinitionStoreProject source in choice.Sources)
                                        {
                                            string href = $"store/{source.ProjectId}?revision={choice.Revision.ToString(CultureInfo.InvariantCulture)}";
                                            <MudMenuItem Href="@href">@T("DirectorySource"): @source.Name (r@(choice.Revision.ToString(CultureInfo.InvariantCulture)))</MudMenuItem>
                                        }
                                    }
                                </ChildContent>
                            </MudMenu>
                        }

                        @if (primary is { Local: { } localAction })
                        {
                            <div class="catalogue__task-pill" data-task-card="fresh">
                                <AppButton Href="@($"launch/{localAction.FamilyId:D}?digest={localAction.Digest.Value}")"
                                           aria-label="@string.Format(CultureInfo.GetCultureInfo(Culture.Locale), T("ConfigureProject"), localAction.Title)">@T("Configure")</AppButton>
                            </div>
                        }
                        else if (primary is { } directory)
                        {
                            <div class="catalogue__task-pill" data-task-card="fresh">
                                <AppButton data-action="open-directory" OnClick='() => OpenDirectoryAsync(directory, "fresh")' Disabled="@_opening">@T(_opening ? "CheckingSnapshot" : "Configure")</AppButton>
                            </div>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
    @if (_openError is not null)
    {
        <p role="alert" data-code="@_openError">@T("RevisionRejected") <a href="open" @ref="_recoveryLink">@T("OpenFileOrLink")</a></p>
    }
    @if (!Visible.Any())
    {
        <h2>@T("NoProjects")</h2>
        <p>@T("SearchRecovery")</p>
        @if (!string.IsNullOrWhiteSpace(_query))
        {
            <AppButton Variant="Variant.Outlined" data-action="clear-catalogue-search" OnClick="ClearSearch">@T("ClearSearch")</AppButton>
        }
    }
    <p class="catalogue__directory-status" role="status" data-directory-state="@DirectoryState" data-code="@_error">
        @if (_loading) { @T("DirectoryLoading") }
        else if (_error is not null) { @T("DirectoryUnavailable") }
        else if (_projects.Count == 0) { @T("DirectoryEmpty") }
    </p>
    @if (_error is not null && !_loading)
    {
        <div class="catalogue__directory-recovery">
            <AppButton Variant="Variant.Outlined" data-action="retry-directory" OnClick="RetryDirectoryAsync">@T("RetryDirectory")</AppButton>
        </div>
    }
    <aside class="catalogue__recovery" aria-labelledby="catalogue-recovery-heading">
        <h2 id="catalogue-recovery-heading">@T("OtherSources")</h2>
        <div class="catalogue__recovery-links">
            <a href="open">@T("OpenFileOrLink")</a>
            <a href="help">@T("HelpPrivacy")</a>
        </div>
    </aside>
</div>

@code {
    [CascadingParameter] public (string Locale, string Direction) Culture { get; set; } = ("en", "ltr");
    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyList<DefinitionStoreProject> _projects = [];
    private IReadOnlyList<CatalogueDefinition> _choices = [];
    private IReadOnlyList<CatalogueProject> _groups = [];
    private string _query = string.Empty;
    private string? _error;
    private bool _loading = true;
    private bool _disposed;
    private bool _opening;
    private string? _openError;
    private bool _focusRecovery;
    private ElementReference _recoveryLink;
    private string DirectoryState => _loading ? "loading" : _error is not null ? "unavailable" : "ready";
    private string T(string key) => BrowserStrings.Get(key, Culture.Locale);
    private IEnumerable<CatalogueProject> Visible => _groups
        .Where(project => project.Choices.Any(choice => Matches(choice, _query.Trim())))
        .OrderByDescending(choice => choice.Title.Equals(_query.Trim(), StringComparison.OrdinalIgnoreCase))
        .ThenByDescending(choice => choice.Title.StartsWith(_query.Trim(), StringComparison.OrdinalIgnoreCase))
        .ThenBy(choice => choice.Title, StringComparer.OrdinalIgnoreCase)
        .ThenBy(choice => choice.ApplicationId, StringComparer.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        BuildChoices();
        await LoadDirectoryAsync();
    }

    private Task RetryDirectoryAsync() => _loading || _disposed ? Task.CompletedTask : LoadDirectoryAsync();

    private void ClearSearch() => _query = string.Empty;

    private async Task OpenDetailsAsync(CatalogueProject project)
    {
        if (_disposed) return;

        CatalogueDefinition lead = project.Primary ?? project.Choices[0];
        DefinitionStoreProject? resolvedSource = lead.Sources.FirstOrDefault()
            ?? project.Choices.SelectMany(choice => choice.Sources).FirstOrDefault();
        StoreProjectCardViewModel? card = resolvedSource is not null
            ? new StoreProjectCardViewModel(resolvedSource)
            : null;
        string monogram = card?.Monogram ?? ComputeLocalMonogram(project.Title, project.ApplicationId);

        StoreProjectDetailsDialog.RevisionDetail[] revisions = project.Choices
            .Select(choice =>
            {
                string publisher = choice.Local?.Publisher ?? choice.Directory?.Publisher ?? string.Empty;
                IReadOnlyList<string> outputs = choice.Local?.Artifacts.Select(artifact => artifact.FileName).ToArray()
                    ?? choice.Directory?.OutputNames ?? [];
                StoreProjectDetailsDialog.SourceLink[] links = choice.Sources
                    .Select(s => new StoreProjectDetailsDialog.SourceLink(
                        s.ProjectId,
                        s.Name,
                        s.Description,
                        $"store/{s.ProjectId}?revision={choice.Revision.ToString(CultureInfo.InvariantCulture)}"))
                    .ToArray();
                string? configureHref = choice != project.Primary && choice.Local is { } alt
                    ? $"launch/{alt.FamilyId:D}?digest={alt.Digest.Value}"
                    : null;
                return new StoreProjectDetailsDialog.RevisionDetail(
                    choice.Family,
                    choice.Revision,
                    choice.Digest,
                    choice.Title,
                    publisher,
                    choice.Local is not null,
                    outputs,
                    links,
                    configureHref);
            })
            .ToArray();

        DialogParameters<StoreProjectDetailsDialog> parameters = new()
        {
            { item => item.Title, project.Title },
            { item => item.ApplicationId, project.ApplicationId },
            { item => item.Description, project.Description },
            { item => item.Locale, Culture.Locale },
            { item => item.IconDataUri, card?.IconDataUri },
            { item => item.IconLicense, card?.IconLicense },
            { item => item.IconAttribution, card?.IconAttribution },
            { item => item.Monogram, monogram },
            { item => item.Conformance, card?.Conformance },
            { item => item.OutputNames, project.OutputNames },
            { item => item.Revisions, revisions }
        };

        await Dialogs.ShowAsync<StoreProjectDetailsDialog>(
            T("ProjectDetailsLabel"),
            parameters,
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
    }

    private async Task LoadDirectoryAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            IReadOnlyList<DefinitionStoreProject> projects = await Catalog.LoadAsync(_lifetime.Token);
            if (_disposed) return;
            _projects = projects;
            BuildChoices();
        }
        catch (BrowserLaunchException exception) { if (!_disposed) _error = exception.Code; }
        finally { if (!_disposed) _loading = false; }
    }

    private static string ProjectIdentifier(CatalogueProject project) =>
        project.Primary?.Sources.FirstOrDefault()?.ProjectId
        ?? project.Choices.SelectMany(choice => choice.Sources).FirstOrDefault()?.ProjectId
        ?? project.ApplicationId;

    private static string ComputeLocalMonogram(string title, string appId)
    {
        string source = string.IsNullOrWhiteSpace(title) ? appId : title.Trim();
        string[] parts = source.Split([' ', '-', '_', '.'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length >= 2)
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";
        return parts.Length == 1 && parts[0].Length >= 2
            ? $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[0][1])}"
            : parts.Length == 1 ? char.ToUpperInvariant(parts[0][0]).ToString() : "CF";
    }

    private void BuildChoices()
    {
        List<CatalogueDefinition> choices = Registry.Current.Definitions.Select(definition => new CatalogueDefinition(
            definition.FamilyId, definition.Revision, definition.Digest.Value, definition.Title, definition, null, [])).ToList();
        foreach (DefinitionStoreProject project in _projects)
        {
            foreach (DefinitionStoreRevision revision in project.Revisions)
            {
                int index = choices.FindIndex(choice => choice.Family == project.FamilyId
                    && choice.Revision == revision.Revision && choice.Digest == revision.Digest
                    && choice.ApplicationId == project.ApplicationId
                    && (choice.Local is { } local ? DefinitionStoreIndexParser.MatchesDefinition(project, revision, local)
                        : SameMetadata(choice.Directory!, revision)));
                if (index < 0)
                    choices.Add(new CatalogueDefinition(project.FamilyId, revision.Revision, revision.Digest, revision.Title, null, revision, [project]));
                else
                    choices[index] = choices[index] with { Sources = [.. choices[index].Sources, project] };
            }
        }
        _choices = choices;
        _groups = choices.GroupBy(choice => choice.ApplicationId, StringComparer.Ordinal)
            .Select(group =>
            {
                CatalogueDefinition[] candidates = group.OrderByDescending(choice => choice.Local is not null)
                    .ThenBy(choice => choice.Family).ThenByDescending(choice => choice.Revision)
                    .ThenBy(choice => choice.Digest, StringComparer.Ordinal).ToArray();
                CatalogueDefinition[] local = candidates.Where(choice => choice.Local is not null).ToArray();
                CatalogueDefinition? primary = local.Length == 1 ? local[0] : candidates.Length == 1 ? candidates[0] : null;
                CatalogueDefinition lead = primary ?? candidates[0];
                string? description = lead.Sources.FirstOrDefault()?.Description;
                IReadOnlyList<string> outputNames = lead.Local?.Artifacts.Select(artifact => artifact.FileName).ToArray()
                    ?? lead.Directory?.OutputNames ?? [];
                return new CatalogueProject(group.Key, lead.Title, description, outputNames, primary, candidates);
            }).ToArray();
    }

    private static bool SameMetadata(DefinitionStoreRevision left, DefinitionStoreRevision right) =>
        left.Title == right.Title && left.Publisher == right.Publisher
        && left.ApplicationVersions.SequenceEqual(right.ApplicationVersions, StringComparer.Ordinal)
        && left.EntryPoints.SequenceEqual(right.EntryPoints, StringComparer.Ordinal)
        && left.Locales.SequenceEqual(right.Locales, StringComparer.Ordinal)
        && left.OutputNames.SequenceEqual(right.OutputNames, StringComparer.Ordinal);

    private void OpenLocal(Definition localAction, string mode)
    {
        if (_disposed) return;
        string modeSuffix = mode is "import" or "profile" ? $"&mode={mode}" : string.Empty;
        Navigation.NavigateTo($"launch/{localAction.FamilyId:D}?digest={localAction.Digest.Value}{modeSuffix}");
    }

    private async Task OpenDirectoryAsync(CatalogueDefinition choice, string mode = "fresh")
    {
        if (_disposed || _opening || choice.Local is not null || !_choices.Contains(choice)) return;
        _opening = true;
        _openError = null;
        try
        {
            Definition definition = await Catalog.OpenAsync(choice.Sources[0].ProjectId, choice.Revision, _lifetime.Token);
            string modeSuffix = mode is "import" or "profile" ? $"&mode={mode}" : string.Empty;
            if (!_disposed) Navigation.NavigateTo($"launch/{definition.FamilyId:D}?digest={definition.Digest.Value}{modeSuffix}");
        }
        catch (BrowserLaunchException exception)
        {
            if (!_disposed)
            {
                _openError = exception.Code;
                _focusRecovery = true;
            }
        }
        finally { if (!_disposed) _opening = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusRecovery || _disposed) return;
        _focusRecovery = false;
        await _recoveryLink.FocusAsync();
    }

    private static bool Matches(CatalogueDefinition choice, string query) =>
        choice.Title.Contains(query, StringComparison.OrdinalIgnoreCase)
        || choice.Local?.ApplicationId.Contains(query, StringComparison.OrdinalIgnoreCase) == true
        || choice.Sources.Any(source => source.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
            || source.ApplicationId.Contains(query, StringComparison.OrdinalIgnoreCase)
            || source.Description.Contains(query, StringComparison.OrdinalIgnoreCase)
            || source.Tags.Any(tag => tag.Contains(query, StringComparison.OrdinalIgnoreCase)));

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private sealed record CatalogueDefinition(Guid Family, long Revision, string Digest, string Title,
        Definition? Local, DefinitionStoreRevision? Directory, IReadOnlyList<DefinitionStoreProject> Sources)
    {
        public string ApplicationId => Local?.ApplicationId ?? Sources[0].ApplicationId;
    }

    private sealed record CatalogueProject(string ApplicationId, string Title, string? Description,
        IReadOnlyList<string> OutputNames, CatalogueDefinition? Primary,
        IReadOnlyList<CatalogueDefinition> Choices);
}
