@page "/open"
@implements IAsyncDisposable
@inject BrowserDefinitionRegistry Registry
@inject BrowserOfflinePolicy Offline
@inject Microsoft.JSInterop.IJSRuntime Javascript
@inject NavigationManager Navigation
@using Configurator.Core.Definitions
@using Microsoft.JSInterop

<PageTitle>@T(_workspaceOpen ? "WorkspaceTitle" : "OpenTitle") · Configurator</PageTitle>
<div class="open-page" lang="@Culture.Locale">
<header class="page-header">
    @if (_workspaceOpen && _selection is { } current)
    {
        <h1><bdi>@current.Definition.Title</bdi></h1>
    }
    else
    {
        <h1>@T("OpenTitle")</h1>
        <p class="lede">@T("OpenIntro")</p>
        <a href="">@T("BackToCatalogue")</a>
    }
</header>
@if (_selection is { } selection)
{
    <details class="open-page__identity">
        <summary>@T("SourceDetails")@if (!_workspaceOpen) { <text>: </text><bdi>@selection.Definition.Title</bdi> }</summary>
        <p>@T("Publisher"): <bdi>@selection.Definition.Publisher</bdi></p>
        <p>@T("Family"): <bdi dir="ltr">@selection.Definition.FamilyId.ToString("D")</bdi></p>
        <p>@T("Revision") <bdi dir="ltr">@selection.Definition.Revision</bdi> · @T("Digest") <code dir="ltr">@selection.Definition.Digest.Value</code></p>
        <p>@T("Entry"): <bdi dir="ltr">@selection.Entry</bdi> · @T("Language"): <bdi dir="ltr">@selection.Locale</bdi></p>
        <p>@T("TrustBoundary")</p>
    </details>
    @if (_workspaceOpen)
    {
        <ConfigurationEditor @key="selection" @ref="_editor" Definition="selection.Definition" InitialLocale="@selection.Locale"
                             InitialEntry="@(selection.EntryExplicit ? selection.Entry : null)" />
        <AppButton Variant="Variant.Outlined" data-action="discard-workspace" OnClick="ConfirmDiscardAsync">@T("DiscardToChoose")</AppButton>
    }
    else
    {
        <p>@T("RetentionHelp")</p>
        <label><input type="checkbox" @bind="_publicSafeConfirmed" /> @T("ConfirmPublicMetadata")</label>
        <div class="actions">
            <AppButton Variant="Variant.Outlined" Disabled="@(!_publicSafeConfirmed)" OnClick="RetainAsync">@T("RetainDefinition")</AppButton>
            <AppButton data-action="open-workspace" OnClick="OpenWorkspace">@T("OpenWorkspace")</AppButton>
        </div>
        @if (_shareLink is { } shareLink)
        {
            <label for="definition-share-link">@T("DefinitionOnlyLink")</label>
            <input class="form-control" id="definition-share-link" value="@shareLink" readonly dir="ltr" />
            <AppButton Variant="Variant.Outlined" OnClick="CopyDefinitionLinkAsync">@T("CopyDefinitionLink")</AppButton>
        }
    }
}
@if (!_workspaceOpen)
{
    <div class="open-page__sources">
    <section class="open-page__source" aria-labelledby="local-source-heading">
    <AppCard>
        <p class="eyebrow">@T("FromDevice")</p>
        <h2 id="local-source-heading">@T("LocalFile")</h2>
        <p>@T("LocalFileIntro")</p>
        <div class="form-group">
            <label for="definition-file">@T("ChooseFile")</label>
            <InputFile @key="_fileKey" id="definition-file" @ref="_fileInput" OnChange="LoadLocalAsync" disabled="@_loading" accept=".json,.yaml,.yml,application/json,application/yaml,text/yaml" aria-describedby="definition-file-help" />
            <p id="definition-file-help" class="form-help">@T("FileLimits")</p>
        </div>
    </AppCard>
    </section>
    <section class="open-page__source" aria-labelledby="public-source-heading">
    <AppCard>
        <p class="eyebrow">@T("PublicSource")</p>
        <h2 id="public-source-heading">@T("PublicUrl")</h2>
        <p>@T("PublicUrlIntro")</p>
        <div class="form-group">
            <label for="source-url">@T("SourceUrl")</label>
            <input class="form-control" id="source-url" type="url" maxlength="2048" dir="ltr" placeholder="https://example.org/definition.json" aria-describedby="source-url-help" @bind="_sourceUrl" @bind:event="oninput" disabled="@_loading" />
            <p id="source-url-help" class="form-help">@T("SourceUrlHelp")</p>
        </div>
        <details>
            <summary>@T("OptionalSelectors")</summary>
            <div class="open-page__selectors">
            <div class="form-group">
            <label for="source-digest">@T("Digest")</label>
            <input class="form-control" id="source-digest" maxlength="64" dir="ltr" @bind="_digest" disabled="@_loading" />
            </div>
            <div class="form-group">
            <label for="source-version">@T("ApplicationVersion")</label>
            <input class="form-control" id="source-version" maxlength="64" dir="ltr" @bind="_appVersion" disabled="@_loading" />
            </div>
            <div class="form-group">
            <label for="source-entry">@T("Entry")</label>
            <input class="form-control" id="source-entry" maxlength="128" dir="ltr" @bind="_entry" disabled="@_loading" />
            </div>
            <div class="form-group">
            <label for="source-locale">@T("Language")</label>
            <input class="form-control" id="source-locale" maxlength="35" dir="ltr" @bind="_locale" disabled="@_loading" />
            </div>
            </div>
        </details>
        <div class="actions">
            <AppButton id="load-public-source" Disabled="@_loading" OnClick="LoadPublicAsync">@T(_loading ? "ReviewingDefinition" : "ReviewPublicDefinition")</AppButton>
        </div>
    </AppCard>
    </section>
    </div>
    @if (_retained.Count > 0)
    {
        <h2>@T("RetainedDefinitions")</h2>
        <ul>@foreach (SetupDefinition definition in _retained)
        {
            <li><button type="button" @onclick="() => SelectRetained(definition)"><bdi>@definition.Title</bdi> · @T("Revision") <bdi dir="ltr">@definition.Revision</bdi></button></li>
        }</ul>
    }
}
@if (!_workspaceOpen)
{
    <p class="notice" role="status" data-code="@_statusCode">@T(_statusKey)
        @if (_statusKey is "SourceRejected" or "DefinitionRejected") { <span>@T("Code"): <bdi dir="ltr">@_statusCode</bdi></span> }
    </p>
}
</div>

@code {
    [CascadingParameter] public (string Locale, string Direction) Culture { get; set; } = ("en", "ltr");
    private string T(string key) => BrowserStrings.Get(key, Culture.Locale);
    private BrowserDefinitionSource? _source;
    private BrowserLaunchSelection? _selection;
    private ConfigurationEditor? _editor;
    private IReadOnlyList<SetupDefinition> _retained = [];
    private string? _request;
    private long _generation;
    private long _fileKey;
    private bool _loading;
    private bool _workspaceOpen;
    private bool _publicSafeConfirmed;
    private bool _disposed;
    private bool _restoreFileFocus;
    private InputFile? _fileInput;
    private string _sourceUrl = string.Empty;
    private string _digest = string.Empty;
    private string _appVersion = string.Empty;
    private string _entry = string.Empty;
    private string _locale = string.Empty;
    private string? _shareLink;
    private IJSObjectReference? _linkModule;
    private string _statusCode = "source-ready";
    private string _statusKey = "SourceReady";

    protected override async Task OnInitializedAsync()
    {
        _source = new BrowserDefinitionSource(Registry, Javascript, Offline);
        Navigation.LocationChanged += LocationChanged;
        await Offline.InitializeAsync();
        _retained = await Offline.ReadRetainedDefinitionsAsync();
        await SelectSourceAsync();
    }

    private async Task SelectSourceAsync()
    {
        if (_disposed || _request == Navigation.Uri) return;
        long generation = ++_generation;
        string request = Navigation.Uri;
        _request = request;
        _source!.Invalidate();
        if (_editor is not null) await _editor.DiscardAsync();
        if (_disposed || generation != _generation) return;
        _editor = null;
        _selection = null;
        _shareLink = null;
        _workspaceOpen = false;
        _loading = false;
        _publicSafeConfirmed = false;
        Uri uri = Navigation.ToAbsoluteUri(request);
        if (uri.Query.Length == 0 && uri.Fragment.Length == 0) return;
        _loading = true;
        _statusKey = "SourceLoading";
        _statusCode = "source-loading";
        try
        {
            BrowserDefinitionPointer pointer = BrowserDefinitionPointer.Parse(uri.Fragment, uri.Query);
            BrowserLaunchSelection selection = await _source.FetchAsync(pointer);
            if (_disposed || generation != _generation) return;
            _selection = selection;
            _shareLink = ShareLink(pointer, selection);
            _statusKey = "SourceAdmitted";
            _statusCode = "source-admitted";
        }
        catch (BrowserLaunchException exception)
        {
            if (_disposed || generation != _generation) return;
            _statusCode = exception.Code;
            _statusKey = "SourceRejected";
        }
        finally { if (generation == _generation) _loading = false; }
    }

    private async Task LoadLocalAsync(InputFileChangeEventArgs args)
    {
        long generation = ++_generation;
        _source!.Invalidate();
        _selection = null;
        _shareLink = null;
        _publicSafeConfirmed = false;
        _loading = true;
        try
        {
            string extension = Path.GetExtension(args.File.Name).ToLowerInvariant();
            if (extension is not (".json" or ".yaml" or ".yml")) throw new BrowserLaunchException("source-format-invalid");
            using Stream stream = args.File.OpenReadStream(BrowserDefinitionSource.MaximumDocumentBytes);
            SetupDefinition definition = await _source.ReadLocalAsync(stream, yaml: extension is ".yaml" or ".yml");
            if (_disposed || generation != _generation) return;
            _selection = BrowserLaunchSelection.Resolve(new SetupDefinitionRegistry([definition]),
                definition.FamilyId.ToString("D"), "");
            _statusCode = "source-admitted";
            _statusKey = "LocalAdmitted";
        }
        catch (BrowserLaunchException exception) { if (generation == _generation) Reject(exception.Code); }
        catch (IOException) { if (generation == _generation) Reject("source-unavailable"); }
        finally
        {
            if (!_disposed && generation == _generation) { _loading = false; _fileKey++; _restoreFileFocus = true; }
        }
    }

    private void Reject(string code)
    {
        _selection = null;
        _shareLink = null;
        _statusCode = code;
        _statusKey = "DefinitionRejected";
    }

    private void SelectRetained(SetupDefinition definition)
    {
        _generation++;
        _source!.Invalidate();
        _shareLink = null;
        _loading = false;
        _fileKey++;
        try
        {
            Registry.Admit(definition);
            _selection = BrowserLaunchSelection.Resolve(new SetupDefinitionRegistry([definition]),
                definition.FamilyId.ToString("D"), "");
        }
        catch (SetupDefinitionException exception) { Reject(exception.Code); }
        catch (BrowserLaunchException exception) { Reject(exception.Code); }
        _publicSafeConfirmed = false;
    }

    private void OpenWorkspace() { _workspaceOpen = true; _publicSafeConfirmed = false; }

    private async Task LoadPublicAsync()
    {
        if (_loading || _workspaceOpen || _disposed) return;
        long generation = ++_generation;
        _source!.Invalidate();
        _selection = null;
        _shareLink = null;
        _publicSafeConfirmed = false;
        _loading = true;
        _statusCode = "source-loading";
        _statusKey = "SourceLoading";
        try
        {
            string fragment = "#src=" + Uri.EscapeDataString(_sourceUrl.Trim());
            var selectors = new[] { ("digest", _digest), ("appVersion", _appVersion), ("entry", _entry), ("locale", _locale) };
            foreach ((string name, string value) in selectors)
                if (!string.IsNullOrWhiteSpace(value)) fragment += "&" + name + "=" + Uri.EscapeDataString(value.Trim());
            BrowserDefinitionPointer pointer = BrowserDefinitionPointer.Parse(fragment);
            BrowserLaunchSelection selection = await _source.FetchAsync(pointer);
            if (_disposed || generation != _generation) return;
            _selection = selection;
            _shareLink = ShareLink(pointer, selection);
            _statusCode = "source-admitted";
            _statusKey = "SourceAdmitted";
        }
        catch (BrowserLaunchException exception) { if (!_disposed && generation == _generation) Reject(exception.Code); }
        finally { if (!_disposed && generation == _generation) _loading = false; }
    }

    private string ShareLink(BrowserDefinitionPointer pointer, BrowserLaunchSelection selection)
    {
        string fragment = "#src=" + Uri.EscapeDataString(pointer.Source.AbsoluteUri)
            + "&digest=" + selection.Definition.Digest.Value
            + "&locale=" + Uri.EscapeDataString(selection.Locale);
        if (selection.EntryExplicit) fragment += "&entry=" + Uri.EscapeDataString(selection.Entry);
        if (pointer.AppVersion is { } version) fragment += "&appVersion=" + Uri.EscapeDataString(version);
        _ = BrowserDefinitionPointer.Parse(fragment);
        return new Uri(new Uri(Navigation.BaseUri), "open").AbsoluteUri + fragment;
    }

    private async Task CopyDefinitionLinkAsync()
    {
        if (_shareLink is not { } link || _workspaceOpen || _disposed) return;
        long generation = _generation;
        try
        {
            if (_linkModule is null)
            {
                IJSObjectReference module = await Javascript.InvokeAsync<IJSObjectReference>("import", "./browser-definition-source.js");
                if (_disposed || generation != _generation) { await module.DisposeAsync(); return; }
                _linkModule = module;
            }
            if (_disposed || generation != _generation) return;
            bool copied = await _linkModule.InvokeAsync<bool>("copyDefinitionLink", link);
            if (_disposed || generation != _generation) return;
            _statusCode = copied ? "definition-link-copied" : "definition-link-copy-unavailable";
            _statusKey = copied ? "LinkCopied" : "LinkCopyUnavailable";
        }
        catch (JSException)
        {
            if (_disposed || generation != _generation) return;
            _statusCode = "definition-link-copy-unavailable";
            _statusKey = "LinkCopyUnavailable";
        }
    }

    private async Task ConfirmDiscardAsync()
    {
        long generation = _generation;
        try
        {
            bool confirmed = await Javascript.InvokeAsync<bool>("confirm", T("DiscardConfirm"));
            if (confirmed && !_disposed && generation == _generation) await DiscardAsync();
        }
        catch (JSException) { }
    }

    private async Task RetainAsync()
    {
        if (_selection is null || !_publicSafeConfirmed) return;
        bool retained = await Offline.PrepareOfflineAsync(_selection.Definition, _publicSafeConfirmed);
        _statusCode = retained ? "definition-retained" : "offline-preparation-unavailable";
        _statusKey = retained ? "DefinitionRetained" : "RetentionUnavailable";
        if (retained) _retained = await Offline.ReadRetainedDefinitionsAsync();
    }

    private async Task DiscardAsync()
    {
        long generation = ++_generation;
        _source!.Invalidate();
        if (_editor is not null) await _editor.DiscardAsync();
        if (_disposed || generation != _generation) return;
        _editor = null;
        _workspaceOpen = false;
        _selection = null;
        _shareLink = null;
        _loading = false;
        _fileKey++;
        _restoreFileFocus = true;
        _statusCode = "workspace-discarded";
        _statusKey = "WorkspaceDiscarded";
    }

    private void LocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (_disposed || args.Location == _request) return;
        _generation++;
        _source?.Invalidate();
        _editor?.Invalidate();
        _ = InvokeAsync(async () => { await SelectSourceAsync(); if (!_disposed) StateHasChanged(); });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_restoreFileFocus || _fileInput is null) return;
        _restoreFileFocus = false;
        await _fileInput.Element!.Value.FocusAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        _generation++;
        Navigation.LocationChanged -= LocationChanged;
        _editor?.Invalidate();
        if (_source is not null) await _source.DisposeAsync();
        if (_linkModule is not null) await _linkModule.DisposeAsync();
        _selection = null;
    }
}
