@page "/open"
@implements IAsyncDisposable
@inject BrowserDefinitionRegistry Registry
@inject BrowserOfflinePolicy Offline
@inject AccessibilityFocusService Focus
@inject Microsoft.JSInterop.IJSRuntime Javascript
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@using System.Globalization
@using Configurator.Browser.Models
@using Configurator.Browser.Services.Accessibility
@using Configurator.Core.Definitions
@using Microsoft.JSInterop

<PageTitle>@T(_workspaceOpen ? "WorkspaceTitle" : "OpenTitle") · Configurator</PageTitle>
<div class="open-page" lang="@Culture.Locale"
     data-workspace-phase="@(_workspaceOpen ? null : "definition-admission")"
     data-admission-state="@(_workspaceOpen ? null : AdmissionState)">
<header class="page-header">
    @if (_workspaceOpen && _selection is { } current)
    {
        <h1><bdi>@current.Definition.Title</bdi></h1>
    }
    else
    {
        <h1>@T("OpenTitle")</h1>
        <p class="lede">@T("OpenIntro")</p>
        <a href="">@T("BackToCatalogue")</a>
    }
</header>
@if (_selection is { } selection)
{
    <details class="open-page__identity" data-digest-disclosure>
        <summary>@T("SourceDetails")@if (!_workspaceOpen) { <text>: </text><bdi>@selection.Definition.Title</bdi> }</summary>
        <p>@T("Publisher"): <bdi>@selection.Definition.Publisher</bdi></p>
        <p>@T("Family"): <bdi dir="ltr">@selection.Definition.FamilyId.ToString("D")</bdi></p>
        <p>@T("Revision") <bdi dir="ltr">@selection.Definition.Revision</bdi> · @T("Digest") <code dir="ltr">@selection.Definition.Digest.Value</code></p>
        <p>@T("Entry"): <bdi dir="ltr">@selection.Entry</bdi> · @T("Language"): <bdi dir="ltr">@selection.Locale</bdi></p>
        <p>@T("TrustBoundary")</p>
    </details>
    @if (_workspaceOpen)
    {
        <ConfigurationEditor @key="selection" @ref="_editor" Definition="selection.Definition" InitialLocale="@selection.Locale"
                             InitialEntry="@(selection.EntryExplicit ? selection.Entry : null)" InitialMode="@_initialMode" />
        <AppButton Variant="Variant.Outlined" data-action="discard-workspace" OnClick="ConfirmDiscardAsync">@T("DiscardToChoose")</AppButton>
    }
    else
    {
        <div class="open-page__tasks">
            <section class="open-page__task-card" data-task-card="fresh">
                <h2>@T("StartFreshEntry")</h2>
                <p>@T("FreshEntryDescription")</p>
                <AppButton data-action="open-workspace" OnClick='() => OpenWorkspace("fresh")'>@T("OpenWorkspace")</AppButton>
            </section>
            <section class="open-page__task-card" data-task-card="import">
                <h2>@T("UseExistingConfigurationEntry")</h2>
                <p>@T("ImportEntryDescription")</p>
                <AppButton Variant="Variant.Outlined" data-action="open-workspace-import" OnClick='() => OpenWorkspace("import")'>@T("UseExistingConfigurationEntry")</AppButton>
            </section>
            <section class="open-page__task-card" data-task-card="profile">
                <h2>@T("OpenSavedProfileEntry")</h2>
                <p>@T("ProfileEntryDescription")</p>
                <AppButton Variant="Variant.Outlined" data-action="open-workspace-profile" OnClick='() => OpenWorkspace("profile")'>@T("OpenSavedProfileEntry")</AppButton>
            </section>
        </div>
        <div class="open-page__retention">
            <p>@T("RetentionHelp")</p>
            <label><input type="checkbox" @bind="_publicSafeConfirmed" /> @T("ConfirmPublicMetadata")</label>
            <div class="actions">
                <AppButton Variant="Variant.Outlined" data-action="retain-definition" Disabled="@(!_publicSafeConfirmed || _offlineMutationPending)" OnClick="RetainAsync">@T("RetainDefinition")</AppButton>
                <a class="button button--secondary" data-action="explore-definition" href="@($"explore/{selection.Definition.FamilyId:D}?digest={selection.Definition.Digest.Value}")">@T("ExploreDefinitionAction")</a>
            </div>
        </div>
        @if (_shareLink is { } shareLink)
        {
            <label for="definition-share-link">@T("DefinitionOnlyLink")</label>
            <input class="form-control" id="definition-share-link" value="@shareLink" readonly dir="ltr" />
            <AppButton Variant="Variant.Outlined" OnClick="CopyDefinitionLinkAsync">@T("CopyDefinitionLink")</AppButton>
        }
    }
}
@if (!_workspaceOpen)
{
    @if (!Offline.OfflineReady && !Offline.IsWorkspaceActive)
    {
        <section class="open-page__offline-banner" data-offline-recovery aria-label="@T("OfflineRecoveryLabel")">
            <p class="open-page__offline-text">@T("OfflineNotReadyNotice")</p>
            <AppButton Variant="Variant.Outlined"
                       Size="Size.Small"
                       data-action="retry-offline"
                       Disabled="@_offlineMutationPending"
                       OnClick="RetryOfflineAsync">@T("RetryOffline")</AppButton>
        </section>
    }
    <div class="open-page__sources">
    <section class="open-page__source" aria-labelledby="local-source-heading">
    <AppCard>
        <p class="eyebrow">@T("FromDevice")</p>
        <h2 id="local-source-heading">@T("LocalFile")</h2>
        <p>@T("LocalFileIntro")</p>
        <div class="form-group">
            <label for="definition-file">@T("ChooseFile")</label>
            <InputFile @key="_fileKey" id="definition-file" @ref="_fileInput" OnChange="LoadLocalAsync" disabled="@_loading" accept=".json,.yaml,.yml,application/json,application/yaml,text/yaml" aria-describedby="definition-file-help" />
            <p id="definition-file-help" class="form-help">@T("FileLimits")</p>
        </div>
    </AppCard>
    </section>
    <section class="open-page__source" aria-labelledby="public-source-heading">
    <AppCard>
        <p class="eyebrow">@T("PublicSource")</p>
        <h2 id="public-source-heading">@T("PublicUrl")</h2>
        <p>@T("PublicUrlIntro")</p>
        <div class="form-group">
            <label for="source-url">@T("SourceUrl")</label>
            <input class="form-control" id="source-url" @ref="_sourceInput" type="url" maxlength="2048" dir="ltr" placeholder="https://example.org/definition.json" aria-describedby="source-url-help" @bind="_sourceUrl" @bind:event="oninput" disabled="@_loading" />
            <p id="source-url-help" class="form-help">@T("SourceUrlHelp")</p>
        </div>
        <details>
            <summary>@T("OptionalSelectors")</summary>
            <div class="open-page__selectors">
            <div class="form-group">
            <label for="source-digest">@T("Digest")</label>
            <input class="form-control" id="source-digest" maxlength="64" dir="ltr" @bind="_digest" disabled="@_loading" />
            </div>
            <div class="form-group">
            <label for="source-version">@T("ApplicationVersion")</label>
            <input class="form-control" id="source-version" maxlength="64" dir="ltr" @bind="_appVersion" disabled="@_loading" />
            </div>
            <div class="form-group">
            <label for="source-entry">@T("Entry")</label>
            <input class="form-control" id="source-entry" maxlength="128" dir="ltr" @bind="_entry" disabled="@_loading" />
            </div>
            <div class="form-group">
            <label for="source-locale">@T("Language")</label>
            <input class="form-control" id="source-locale" maxlength="35" dir="ltr" @bind="_locale" disabled="@_loading" />
            </div>
            </div>
        </details>
        <div class="actions">
            <AppButton id="load-public-source" Disabled="@_loading" OnClick="LoadPublicAsync">@T(_loading ? "ReviewingDefinition" : "ReviewPublicDefinition")</AppButton>
            @if (_loading)
            {
                <AppButton Variant="Variant.Outlined" data-action="cancel-source-load" OnClick="CancelSourceLoad">@T("Cancel")</AppButton>
            }
        </div>
    </AppCard>
    </section>
    </div>
    @if (_retained.Count > 0)
    {
        <section class="open-page__retained" aria-labelledby="retained-definitions-heading" data-retained-definitions>
            <div class="open-page__retained-header">
                <h2 id="retained-definitions-heading">@T("RetainedDefinitions")</h2>
                <span class="open-page__retained-capacity" data-retained-capacity>@Format("RetainedCapacityCount", _retained.Count, BrowserOfflinePolicy.MaximumRetainedDefinitions)</span>
            </div>
            <ul class="open-page__retained-list">
                @foreach (Definition definition in _retained)
                {
                    string removeId = RemoveButtonId(definition);
                    <li class="open-page__retained-item" @key="definition.Digest.Value" data-retained-digest="@definition.Digest.Value">
                        <div class="open-page__retained-meta">
                            <AppButton Variant="Variant.Text"
                                       data-action="select-retained"
                                       Disabled="@(_loading || _offlineMutationPending)"
                                       OnClick="() => SelectRetained(definition)">
                                <bdi>@definition.Title</bdi> · @T("Revision") <bdi dir="ltr">@definition.Revision</bdi>
                            </AppButton>
                        </div>
                        <div class="open-page__retained-actions">
                            <AppButton id="@removeId"
                                       Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       data-action="remove-retained"
                                       aria-label="@Format("RemoveRetainedNamed", definition.Title)"
                                       Disabled="@(_loading || _offlineMutationPending)"
                                       OnClick="() => RemoveRetainedAsync(definition)">@T("RemoveRetained")</AppButton>
                        </div>
                    </li>
                }
            </ul>
        </section>
    }
}
@if (!_workspaceOpen)
{
    <p class="notice" role="status" data-code="@_statusCode">@(_statusMessage ?? T(_statusKey))
        @if (_statusKey is "SourceRejected" or "DefinitionRejected") { <span>@T("Code"): <bdi dir="ltr">@_statusCode</bdi></span> }
    </p>
    @if (_statusKey is "SourceRejected" or "DefinitionRejected" or "SourceCancelled")
    {
        <p>@T("EntrySourceRecovery")</p>
        <div class="actions">
            <AppButton Variant="Variant.Outlined" data-action="retry-source" OnClick="RetrySourceAsync">@T("RetrySource")</AppButton>
            <AppButton Variant="Variant.Outlined" data-action="choose-local-source" OnClick="FocusLocalFile">@T("ChooseLocalDefinition")</AppButton>
        </div>
    }
}
</div>

@code {
    [CascadingParameter] public (string Locale, string Direction) Culture { get; set; } = ("en", "ltr");
    private string T(string key) => BrowserStrings.Get(key, Culture.Locale);
    private string Format(string key, params object[] args) => string.Format(CultureInfo.InvariantCulture, T(key), args);
    private static string RemoveButtonId(Definition definition) => $"remove-retained-{definition.Digest.Value}";
    private BrowserDefinitionSource? _source;
    private BrowserLaunchSelection? _selection;
    private ConfigurationEditor? _editor;
    private IReadOnlyList<Definition> _retained = [];
    private string? _request;
    private long _generation;
    private long _fileKey;
    private bool _loading;
    private bool _offlineMutationPending;
    private bool _workspaceOpen;
    private string _initialMode = "fresh";
    private bool _publicSafeConfirmed;
    private bool _disposed;
    private bool _restoreFileFocus;
    private bool _restoreSourceFocus;
    private string? _pendingFocusId;
    private ElementReference _sourceInput;
    private InputFile? _fileInput;
    private string _sourceUrl = string.Empty;
    private string _digest = string.Empty;
    private string _appVersion = string.Empty;
    private string _entry = string.Empty;
    private string _locale = string.Empty;
    private string? _shareLink;
    private IJSObjectReference? _linkModule;
    private CancellationTokenSource? _discardConfirmation;
    private string _statusCode = "source-ready";
    private string _statusKey = "SourceReady";
    private string? _statusMessage;

    private string AdmissionState => _loading
        ? "loading"
        : _statusCode == "source-cancelled"
            ? "cancelled"
            : _statusKey is "SourceRejected" or "DefinitionRejected"
                ? "rejected"
                : _selection is not null
                    ? "admitted"
                    : "idle";

    protected override async Task OnInitializedAsync()
    {
        _source = new BrowserDefinitionSource(Registry, Javascript, Offline);
        Navigation.LocationChanged += LocationChanged;
        await Offline.InitializeAsync();
        _retained = await Offline.ReadRetainedDefinitionsAsync();
        await SelectSourceAsync();
    }

    private async Task SelectSourceAsync()
    {
        if (_disposed || _request == Navigation.Uri) return;
        CancelDiscardConfirmation();
        long generation = ++_generation;
        string request = Navigation.Uri;
        _request = request;
        _source!.Invalidate();
        if (_editor is not null) await _editor.DiscardAsync();
        if (_disposed || generation != _generation) return;
        _editor = null;
        _selection = null;
        _shareLink = null;
        _workspaceOpen = false;
        _loading = false;
        _publicSafeConfirmed = false;
        Uri uri = Navigation.ToAbsoluteUri(request);
        if (uri.Query.Length == 0 && uri.Fragment.Length == 0) return;
        _loading = true;
        SetStatus("source-loading", "SourceLoading");
        try
        {
            BrowserDefinitionPointer pointer = BrowserDefinitionPointer.Parse(uri.Fragment, uri.Query);
            _sourceUrl = pointer.Source.AbsoluteUri;
            _digest = pointer.Digest ?? string.Empty;
            _appVersion = pointer.AppVersion ?? string.Empty;
            _entry = pointer.Entry ?? string.Empty;
            _locale = pointer.Locale ?? string.Empty;
            BrowserLaunchSelection selection = await _source.FetchAsync(pointer);
            if (_disposed || generation != _generation) return;
            _selection = selection;
            _shareLink = ShareLink(pointer, selection);
            _workspaceOpen = selection.EntryExplicit;
            SetStatus("source-admitted", "SourceAdmitted");
        }
        catch (BrowserLaunchException exception)
        {
            if (_disposed || generation != _generation) return;
            SetStatus(exception.Code, "SourceRejected");
            _restoreSourceFocus = true;
        }
        finally { if (generation == _generation) _loading = false; }
    }

    private async Task LoadLocalAsync(InputFileChangeEventArgs args)
    {
        CancelDiscardConfirmation();
        long generation = ++_generation;
        _source!.Invalidate();
        _selection = null;
        _shareLink = null;
        _publicSafeConfirmed = false;
        _loading = true;
        try
        {
            string extension = Path.GetExtension(args.File.Name).ToLowerInvariant();
            if (extension is not (".json" or ".yaml" or ".yml")) throw new BrowserLaunchException("source-format-invalid");
            using Stream stream = args.File.OpenReadStream(BrowserDefinitionSource.MaximumDocumentBytes);
            Definition definition = await _source.ReadLocalAsync(stream, yaml: extension is ".yaml" or ".yml");
            if (_disposed || generation != _generation) return;
            _selection = BrowserLaunchSelection.Resolve(new DefinitionRegistry([definition]),
                definition.FamilyId.ToString("D"), "");
            SetStatus("source-admitted", "LocalAdmitted");
        }
        catch (BrowserLaunchException exception) { if (generation == _generation) Reject(exception.Code); }
        catch (IOException) { if (generation == _generation) Reject("source-unavailable"); }
        finally
        {
            if (!_disposed && generation == _generation) { _loading = false; _fileKey++; _restoreFileFocus = true; }
        }
    }

    private void Reject(string code)
    {
        _selection = null;
        _shareLink = null;
        SetStatus(code, "DefinitionRejected");
    }

    private void SelectRetained(Definition definition)
    {
        CancelDiscardConfirmation();
        _generation++;
        _source!.Invalidate();
        _shareLink = null;
        _loading = false;
        _fileKey++;
        try
        {
            Registry.Admit(definition);
            _selection = BrowserLaunchSelection.Resolve(new DefinitionRegistry([definition]),
                definition.FamilyId.ToString("D"), "");
        }
        catch (DefinitionException exception) { Reject(exception.Code); }
        catch (BrowserLaunchException exception) { Reject(exception.Code); }
        _publicSafeConfirmed = false;
    }

    private void CancelSourceLoad()
    {
        if (_disposed || !_loading) return;
        _generation++;
        _source?.Invalidate();
        _loading = false;
        SetStatus("source-cancelled", "SourceCancelled");
        _restoreSourceFocus = true;
    }

    private Task RetrySourceAsync()
    {
        if (_disposed || _loading || _workspaceOpen) return Task.CompletedTask;
        if (!string.IsNullOrWhiteSpace(_sourceUrl)) return LoadPublicAsync();
        _restoreSourceFocus = true;
        return Task.CompletedTask;
    }

    private void FocusLocalFile()
    {
        if (_disposed || _workspaceOpen) return;
        _restoreFileFocus = true;
    }

    private void OpenWorkspace(string mode = "fresh") { _initialMode = mode; _workspaceOpen = true; _publicSafeConfirmed = false; }

    private async Task LoadPublicAsync()
    {
        if (_loading || _workspaceOpen || _disposed) return;
        CancelDiscardConfirmation();
        long generation = ++_generation;
        _source!.Invalidate();
        _selection = null;
        _shareLink = null;
        _publicSafeConfirmed = false;
        _loading = true;
        SetStatus("source-loading", "SourceLoading");
        try
        {
            string fragment = "#src=" + Uri.EscapeDataString(_sourceUrl.Trim());
            var selectors = new[] { ("digest", _digest), ("appVersion", _appVersion), ("entry", _entry), ("locale", _locale) };
            foreach ((string name, string value) in selectors)
                if (!string.IsNullOrWhiteSpace(value)) fragment += "&" + name + "=" + Uri.EscapeDataString(value.Trim());
            BrowserDefinitionPointer pointer = BrowserDefinitionPointer.Parse(fragment);
            BrowserLaunchSelection selection = await _source.FetchAsync(pointer);
            if (_disposed || generation != _generation) return;
            _selection = selection;
            _shareLink = ShareLink(pointer, selection);
            SetStatus("source-admitted", "SourceAdmitted");
        }
        catch (BrowserLaunchException exception)
        {
            if (!_disposed && generation == _generation)
            {
                Reject(exception.Code);
                _restoreSourceFocus = true;
            }
        }
        finally { if (!_disposed && generation == _generation) _loading = false; }
    }

    private string ShareLink(BrowserDefinitionPointer pointer, BrowserLaunchSelection selection)
    {
        string fragment = "#src=" + Uri.EscapeDataString(pointer.Source.AbsoluteUri)
            + "&digest=" + selection.Definition.Digest.Value
            + "&locale=" + Uri.EscapeDataString(selection.Locale);
        if (selection.EntryExplicit) fragment += "&entry=" + Uri.EscapeDataString(selection.Entry);
        if (pointer.AppVersion is { } version) fragment += "&appVersion=" + Uri.EscapeDataString(version);
        _ = BrowserDefinitionPointer.Parse(fragment);
        return new Uri(new Uri(Navigation.BaseUri), "open").AbsoluteUri + fragment;
    }

    private async Task CopyDefinitionLinkAsync()
    {
        if (_shareLink is not { } link || _workspaceOpen || _disposed) return;
        long generation = _generation;
        try
        {
            if (_linkModule is null)
            {
                IJSObjectReference module = await Javascript.InvokeAsync<IJSObjectReference>("import", "./js/browser-definition-source.js");
                if (_disposed || generation != _generation) { await module.DisposeAsync(); return; }
                _linkModule = module;
            }
            if (_disposed || generation != _generation) return;
            bool copied = await _linkModule.InvokeAsync<bool>("copyDefinitionLink", link);
            if (_disposed || generation != _generation) return;
            SetStatus(
                copied ? "definition-link-copied" : "definition-link-copy-unavailable",
                copied ? "LinkCopied" : "LinkCopyUnavailable");
        }
        catch (JSException)
        {
            if (_disposed || generation != _generation) return;
            SetStatus("definition-link-copy-unavailable", "LinkCopyUnavailable");
        }
    }

    private async Task ConfirmDiscardAsync()
    {
        if (_disposed) return;
        CancelDiscardConfirmation();
        using var confirmation = new CancellationTokenSource();
        _discardConfirmation = confirmation;
        long generation = _generation;
        try
        {
            bool confirmed = await AppDiscardDialog.ConfirmAsync(Dialogs, Culture.Locale, confirmation.Token);
            if (confirmed && !_disposed && generation == _generation) await DiscardAsync();
        }
        finally
        {
            if (ReferenceEquals(_discardConfirmation, confirmation)) _discardConfirmation = null;
        }
    }

    private void CancelDiscardConfirmation()
    {
        CancellationTokenSource? confirmation = _discardConfirmation;
        _discardConfirmation = null;
        confirmation?.Cancel();
    }

    private void SetStatus(string code, string key, string? message = null)
    {
        _statusCode = code;
        _statusKey = key;
        _statusMessage = message;
    }

    private async Task RetryOfflineAsync()
    {
        if (_disposed || _workspaceOpen || Offline.IsWorkspaceActive || _offlineMutationPending) return;
        long generation = _generation;
        _offlineMutationPending = true;
        try
        {
            bool ready = await Offline.RetryInitializeAsync();
            if (_disposed || generation != _generation || _workspaceOpen || Offline.IsWorkspaceActive) return;
            if (ready)
            {
                IReadOnlyList<Definition> refreshed = await Offline.ReadRetainedDefinitionsAsync();
                if (_disposed || generation != _generation || _workspaceOpen || Offline.IsWorkspaceActive) return;
                _retained = refreshed;
                SetStatus("offline-ready", "OfflineRetrySucceeded");
            }
            else
            {
                SetStatus("offline-preparation-unavailable", "OfflineRetryFailed");
            }
        }
        finally
        {
            if (!_disposed && generation == _generation) _offlineMutationPending = false;
        }
    }

    private async Task RetainAsync()
    {
        if (_disposed || _workspaceOpen || Offline.IsWorkspaceActive || _offlineMutationPending || _selection is null || !_publicSafeConfirmed) return;
        long generation = _generation;
        Definition candidate = _selection.Definition;
        bool confirmed = _publicSafeConfirmed;
        _offlineMutationPending = true;
        try
        {
            BrowserOfflineRetentionStatus outcome = await Offline.PrepareOfflineAsync(candidate, confirmed);
            if (_disposed || generation != _generation || _workspaceOpen) return;
            switch (outcome)
            {
                case BrowserOfflineRetentionStatus.Retained:
                    SetStatus("definition-retained", "DefinitionRetained");
                    IReadOnlyList<Definition> refreshed = await Offline.ReadRetainedDefinitionsAsync();
                    if (!_disposed && generation == _generation && !_workspaceOpen) _retained = refreshed;
                    break;
                case BrowserOfflineRetentionStatus.CapacityReached:
                    SetStatus("offline-retention-capacity", "RetentionCapacityReached");
                    break;
                case BrowserOfflineRetentionStatus.BusyInWorkspace:
                    SetStatus("offline-retention-busy", "RetentionBusyInWorkspace");
                    break;
                default:
                    SetStatus("offline-preparation-unavailable", "RetentionUnavailable");
                    break;
            }
        }
        finally
        {
            if (!_disposed && generation == _generation) _offlineMutationPending = false;
        }
    }

    private async Task RemoveRetainedAsync(Definition definition)
    {
        if (_disposed || _workspaceOpen || Offline.IsWorkspaceActive || _offlineMutationPending) return;
        long generation = _generation;

        int removedIndex = -1;
        for (int i = 0; i < _retained.Count; i++)
        {
            if (_retained[i].Digest == definition.Digest)
            {
                removedIndex = i;
                break;
            }
        }

        string nextFocusId = removedIndex >= 0 && removedIndex + 1 < _retained.Count
            ? RemoveButtonId(_retained[removedIndex + 1])
            : removedIndex > 0
                ? RemoveButtonId(_retained[removedIndex - 1])
                : "definition-file";

        _offlineMutationPending = true;
        try
        {
            bool removed = await Offline.RemoveRetainedDefinitionAsync(definition.Digest.Value);
            if (_disposed || generation != _generation || _workspaceOpen || Offline.IsWorkspaceActive) return;
            if (!removed)
            {
                SetStatus("retained-definition-remove-unavailable", "RetainedRemoveUnavailable");
                return;
            }

            IReadOnlyList<Definition> refreshed = await Offline.ReadRetainedDefinitionsAsync();
            if (_disposed || generation != _generation || _workspaceOpen || Offline.IsWorkspaceActive) return;
            _retained = refreshed;

            if (nextFocusId != "definition-file"
                && !_retained.Any(item => RemoveButtonId(item) == nextFocusId))
            {
                nextFocusId = _retained.Count > 0 ? RemoveButtonId(_retained[0]) : "definition-file";
            }

            _pendingFocusId = nextFocusId;
            SetStatus(
                "retained-definition-removed",
                "RetainedRemovedStatus",
                Format("RetainedRemovedStatus", definition.Title));
        }
        finally
        {
            if (!_disposed && generation == _generation) _offlineMutationPending = false;
        }
    }

    private async Task DiscardAsync()
    {
        CancelDiscardConfirmation();
        long generation = ++_generation;
        _source!.Invalidate();
        if (_editor is not null) await _editor.DiscardAsync();
        if (_disposed || generation != _generation) return;
        _editor = null;
        _workspaceOpen = false;
        _selection = null;
        _shareLink = null;
        _loading = false;
        _fileKey++;
        _restoreFileFocus = true;
        SetStatus("workspace-discarded", "WorkspaceDiscarded");
    }

    private void LocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (_disposed || args.Location == _request) return;
        CancelDiscardConfirmation();
        _generation++;
        _source?.Invalidate();
        _editor?.Invalidate();
        _ = InvokeAsync(async () => { await SelectSourceAsync(); if (!_disposed) StateHasChanged(); });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingFocusId is { } focusId && !_workspaceOpen && !_disposed)
        {
            _pendingFocusId = null;
            await Focus.FocusByIdAsync(focusId);
        }
        if (_restoreSourceFocus && !_workspaceOpen && !_disposed)
        {
            _restoreSourceFocus = false;
            await _sourceInput.FocusAsync();
        }
        if (!_restoreFileFocus || _fileInput is null) return;
        _restoreFileFocus = false;
        await _fileInput.Element!.Value.FocusAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        CancelDiscardConfirmation();
        _generation++;
        Navigation.LocationChanged -= LocationChanged;
        _editor?.Invalidate();
        if (_source is not null) await _source.DisposeAsync();
        if (_linkModule is not null) await _linkModule.DisposeAsync();
        _selection = null;
    }
}
