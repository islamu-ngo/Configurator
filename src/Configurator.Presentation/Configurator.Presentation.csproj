<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SetupTargetEnabled>false</SetupTargetEnabled>
    <SetupTargetRole>SharedPresentationModel</SetupTargetRole>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Configurator.Core\Configurator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SetupLive/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources/PresentationStrings.resx" WithCulture="false"
                      LogicalName="Configurator.Presentation.Resources.PresentationStrings.resources" />
    <EmbeddedResource Update="Resources/PresentationStrings.ar.resx" WithCulture="false"
                      LogicalName="Configurator.Presentation.Resources.PresentationStrings.ar.resources" />
  </ItemGroup>
</Project>
