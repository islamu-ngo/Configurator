<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fields="using:Configurator.Desktop.ViewModels.Fields"
    xmlns:local="using:Configurator.Desktop.Views"
    xmlns:converters="using:Avalonia.Data.Converters"
    x:CompileBindings="True">
  <DataTemplate x:Key="RootFieldTemplate" DataType="fields:RootFieldViewModel" x:DataType="fields:RootFieldViewModel">
    <ContentControl Content="{Binding Editor}" IsVisible="{Binding IsVisible}" />
  </DataTemplate>
  <DataTemplate x:Key="FieldHeader" x:DataType="fields:FieldViewModel">
    <StackPanel Spacing="4">
      <WrapPanel Orientation="Horizontal" ItemSpacing="8" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Name="CopyWireKey"
                Content="{Binding WireToken}"
                Command="{Binding CopyWireKeyCommand}"
                IsVisible="{Binding HasCopyableWireToken}"
                AutomationProperties.Name="{Binding CopyWireKeyName}"
                Padding="8,2" Margin="0" FontSize="12" />
        <TextBlock Text="{Binding WireKeyStatus}"
                   Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}"
                   IsVisible="{Binding WireKeyStatus, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                   VerticalAlignment="Center" FontSize="12" />
      </WrapPanel>
      <TextBlock Text="{Binding DeprecationDisplay}" Classes="warning" TextWrapping="Wrap"
                 IsVisible="{Binding HasDeprecationBanner}" />
      <TextBlock Text="{Binding Strings[Required]}" IsVisible="{Binding IsRequired}" />
      <TextBlock Text="{Binding Help}" TextWrapping="Wrap"
                 IsVisible="{Binding Help, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{Binding Instructions}" TextWrapping="Wrap"
                 IsVisible="{Binding Instructions, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{Binding UnitsDisplay}"
                 Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}"
                 IsVisible="{Binding UnitsDisplay, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{Binding IfOmittedDisplay}"
                 Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding IfOmittedDisplay, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{Binding ControllerImpactSummary}"
                 Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding IsController}" />
      <TextBlock Text="{Binding Format}" TextWrapping="Wrap"
                 IsVisible="{Binding Format, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{Binding ConstraintsSummary}" TextWrapping="Wrap"
                 IsVisible="{Binding ConstraintsSummary, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{Binding Strings[ProtectedInput]}" IsVisible="{Binding RequiresMasking}" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="FieldActions" x:DataType="fields:FieldViewModel">
    <StackPanel Spacing="4">
      <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Classes="error" IsVisible="{Binding ShowError}" />
      <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
        <Button Content="{Binding SupplyLabel}" Command="{Binding SupplyCommand}" IsVisible="{Binding IsContainer}"
                AutomationProperties.Name="{Binding SupplyName}" AutomationProperties.HelpText="{Binding SupplyHelp}"
                local:FocusBehavior.Request="{Binding SupplyFocusRequestVersion}" />
        <Menu IsVisible="{Binding HasFieldActions}">
          <MenuItem Header="{Binding Strings[FieldActions]}">
            <MenuItem Header="{Binding ClearLabel}" Command="{Binding ClearCommand}" IsVisible="{Binding CanClear}"
                      AutomationProperties.Name="{Binding ClearName}" AutomationProperties.HelpText="{Binding ClearHelp}" />
            <MenuItem Header="{Binding SuggestionLabel}" Command="{Binding ApplySuggestionCommand}" IsVisible="{Binding HasSuggestion}"
                      AutomationProperties.Name="{Binding SuggestionName}" />
            <MenuItem Header="{Binding ResetLabel}" Command="{Binding ResetCommand}" IsVisible="{Binding CanReset}"
                      AutomationProperties.Name="{Binding ResetName}" AutomationProperties.HelpText="{Binding ResetHelp}" />
            <MenuItem Header="{Binding NullLabel}" Command="{Binding SetNullCommand}" IsVisible="{Binding CanSetNull}"
                      AutomationProperties.Name="{Binding NullName}" />
            <MenuItem Header="{Binding RemoveLabel}" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}"
                      AutomationProperties.Name="{Binding RemoveName}" />
          </MenuItem>
        </Menu>
      </WrapPanel>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="StringFieldTemplate" DataType="fields:StringFieldViewModel" x:DataType="fields:StringFieldViewModel">
    <StackPanel Spacing="5" IsVisible="{Binding IsVisible}" local:FieldFeedbackBehavior.Enabled="True">
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldHeader}" />
      <TextBox Text="{Binding Text, Mode=TwoWay}" PasswordChar="{Binding PasswordChar}" MaxLength="{Binding MaxLength}"
               AcceptsReturn="{Binding AcceptsReturn}"
               PlaceholderText="{Binding PlaceholderText}"
               Classes.multiline-editor="{Binding AcceptsReturn}"
               Classes.code-editor="{Binding IsCodeOrMarkdown}"
               AutomationProperties.AutomationId="{Binding AutomationId}"
               AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding InputHelpText}"
               local:FocusBehavior.Request="{Binding FocusRequestVersion}" />
      <local:SecretActionsView IsVisible="{Binding HasSecretPolicy}" />
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldActions}" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="EnumFieldTemplate" DataType="fields:EnumFieldViewModel" x:DataType="fields:EnumFieldViewModel">
    <StackPanel Spacing="5" IsVisible="{Binding IsVisible}" local:FieldFeedbackBehavior.Enabled="True">
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldHeader}" />
      <ComboBox ItemsSource="{Binding Choices}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" IsVisible="{Binding IsSelectWidget}"
                HorizontalAlignment="Stretch" AutomationProperties.AutomationId="{Binding AutomationId}"
                AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding HelpText}"
                local:FocusBehavior.Request="{Binding FocusRequestVersion}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="fields:EnumChoice">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Explanation}"
                         IsVisible="{Binding Explanation, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                         Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="{Binding SelectedChoiceExplanation}"
                 IsVisible="{Binding SelectedChoiceExplanation, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                 Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding SelectedChoiceDeprecation}"
                 Classes="warning"
                 IsVisible="{Binding SelectedChoiceDeprecation, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                 TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Choices}" IsVisible="{Binding IsRadioWidget}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="fields:EnumChoice">
            <StackPanel Spacing="2" Margin="0,2">
              <RadioButton Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
              <TextBlock Text="{Binding Explanation}"
                         IsVisible="{Binding Explanation, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                         Margin="28,0,0,2"
                         Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DeprecationGuidance}"
                         Classes="warning"
                         IsVisible="{Binding DeprecationGuidance, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                         Margin="28,0,0,2" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBox Text="{Binding Text, Mode=TwoWay}" PasswordChar="{Binding PasswordChar}" IsVisible="{Binding RequiresMasking}" MaxLength="65536"
               AutomationProperties.AutomationId="{Binding AutomationId}"
               AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding HelpText}"
               local:FocusBehavior.Request="{Binding FocusRequestVersion}" />
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldActions}" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="NumericFieldTemplate" DataType="fields:NumericFieldViewModel" x:DataType="fields:NumericFieldViewModel">
    <StackPanel Spacing="5" IsVisible="{Binding IsVisible}" local:FieldFeedbackBehavior.Enabled="True">
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldHeader}" />
      <Slider IsVisible="{Binding IsSliderWidget}"
              Minimum="{Binding SliderMinimum}"
              Maximum="{Binding SliderMaximum}"
              TickFrequency="{Binding SliderFrequency}"
              IsSnapToTickEnabled="{Binding IsInteger}"
              Value="{Binding SliderValue, Mode=TwoWay}"
              AutomationProperties.Name="{Binding Name}" />
      <TextBox Text="{Binding Text, Mode=TwoWay}" PasswordChar="{Binding PasswordChar}" MaxLength="65536"
               PlaceholderText="{Binding PlaceholderText}"
               AutomationProperties.AutomationId="{Binding AutomationId}"
               AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding HelpText}"
               local:FocusBehavior.Request="{Binding FocusRequestVersion}" />
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldActions}" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="BooleanFieldTemplate" DataType="fields:BooleanFieldViewModel" x:DataType="fields:BooleanFieldViewModel">
    <StackPanel Spacing="5" IsVisible="{Binding IsVisible}" local:FieldFeedbackBehavior.Enabled="True">
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldHeader}" />
      <ComboBox ItemsSource="{Binding Choices}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" IsVisible="{Binding IsSelectWidget}"
                HorizontalAlignment="Stretch" AutomationProperties.AutomationId="{Binding AutomationId}"
                AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding HelpText}"
                local:FocusBehavior.Request="{Binding FocusRequestVersion}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="fields:BooleanChoice">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <WrapPanel IsVisible="{Binding IsSwitchWidget}" ItemSpacing="8" VerticalAlignment="Center">
        <ToggleSwitch IsChecked="{Binding SwitchValue, Mode=TwoWay}"
                      OnContent="{Binding TrueLabel}" OffContent="{Binding FalseLabel}"
                      AutomationProperties.AutomationId="{Binding AutomationId}"
                      AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding HelpText}"
                      local:FocusBehavior.Request="{Binding FocusRequestVersion}" />
        <TextBlock Text="{Binding Strings[SwitchOmittedStatus]}"
                   IsVisible="{Binding IsOmitted}"
                   Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}"
                   VerticalAlignment="Center" />
        <Button Content="{Binding Strings[OmitSwitchLabel]}"
                Command="{Binding OmitSwitchCommand}"
                IsVisible="{Binding !IsOmitted}"
                Margin="0" />
      </WrapPanel>
      <TextBox Text="{Binding Text, Mode=TwoWay}" PasswordChar="{Binding PasswordChar}" IsVisible="{Binding RequiresMasking}" MaxLength="65536"
               AutomationProperties.AutomationId="{Binding AutomationId}"
               AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding HelpText}"
               local:FocusBehavior.Request="{Binding FocusRequestVersion}" />
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldActions}" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="ObjectFieldTemplate" DataType="fields:ObjectFieldViewModel" x:DataType="fields:ObjectFieldViewModel">
    <StackPanel Spacing="5" IsVisible="{Binding IsVisible}">
      <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
        <Expander.Header>
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldHeader}" />
        </Expander.Header>
        <ItemsControl ItemsSource="{Binding VisibleChildren}" Margin="16,0,0,0" />
      </Expander>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldActions}" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="ListFieldTemplate" DataType="fields:ListFieldViewModel" x:DataType="fields:ListFieldViewModel">
    <StackPanel Spacing="5" IsVisible="{Binding IsVisible}">
      <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
        <Expander.Header>
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldHeader}" />
        </Expander.Header>
        <StackPanel Spacing="5">
          <TextBlock Text="{Binding DuplicateKeysWarning}" Classes="error" IsVisible="{Binding HasDuplicateKeys}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding PageText}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding VisibleItems}" Margin="16,0,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="fields:FieldViewModel">
                <ContentControl Content="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel IsVisible="{Binding HasPages}" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
            <Button Content="{Binding Strings[PreviousPage]}" Command="{Binding PreviousPageCommand}"
                    AutomationProperties.Name="{Binding Strings[PreviousPage]}" />
            <Button Content="{Binding Strings[NextPage]}" Command="{Binding NextPageCommand}"
                    AutomationProperties.Name="{Binding Strings[NextPage]}" />
          </WrapPanel>
          <Button Content="{Binding Strings[AddItem]}" Command="{Binding AddItemCommand}"
                  AutomationProperties.Name="{Binding AddItemName}" AutomationProperties.HelpText="{Binding AddItemName}"
                  local:FocusBehavior.Request="{Binding FocusRequestVersion}" />
        </StackPanel>
      </Expander>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldActions}" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="MapFieldTemplate" DataType="fields:MapFieldViewModel" x:DataType="fields:MapFieldViewModel">
    <StackPanel Spacing="5" IsVisible="{Binding IsVisible}">
      <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
        <Expander.Header>
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldHeader}" />
        </Expander.Header>
        <StackPanel Spacing="5">
          <ItemsControl ItemsSource="{Binding VisibleChildren}" Margin="16,0,0,0" />
          <TextBlock Text="{Binding PageText}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding VisibleEntries}" Margin="16,0,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="fields:FieldViewModel">
                <ContentControl Content="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel IsVisible="{Binding HasPages}" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
            <Button Content="{Binding Strings[PreviousPage]}" Command="{Binding PreviousPageCommand}"
                    AutomationProperties.Name="{Binding Strings[PreviousPage]}" />
            <Button Content="{Binding Strings[NextPage]}" Command="{Binding NextPageCommand}"
                    AutomationProperties.Name="{Binding Strings[NextPage]}" />
          </WrapPanel>
          <TextBlock Text="{Binding NewKeyLabel}" />
          <TextBox Text="{Binding NewKey, Mode=TwoWay}" MaxLength="65536"
                   AutomationProperties.Name="{Binding NewKeyLabel}"
                   local:FocusBehavior.Request="{Binding FocusRequestVersion}" />
          <Button Content="{Binding AddEntryLabel}" Command="{Binding AddEntryCommand}"
                  AutomationProperties.Name="{Binding AddEntryName}" />
        </StackPanel>
      </Expander>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldActions}" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="VariantFieldTemplate" DataType="fields:VariantFieldViewModel" x:DataType="fields:VariantFieldViewModel">
    <StackPanel Spacing="5" IsVisible="{Binding IsVisible}">
      <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
      <Expander.Header>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldHeader}" />
      </Expander.Header>
      <StackPanel Spacing="8">
      <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Title}"
                AutomationProperties.HelpText="{Binding HelpText}" local:FocusBehavior.Request="{Binding FocusRequestVersion}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="fields:VariantChoice">
            <TextBlock Text="{Binding Title}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ItemsControl ItemsSource="{Binding VisibleChildren}" Margin="16,0,0,0" />
      </StackPanel>
      </Expander>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldActions}" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
