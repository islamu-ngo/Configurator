<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Configurator.Desktop.ViewModels"
    x:Class="Configurator.Desktop.Views.SecretGeneratorDialog"
    x:DataType="vm:SecretGeneratorDialogViewModel" x:CompileBindings="True"
    Title="{Binding Title}"
    FlowDirection="{Binding FlowDirection}"
    Width="520" SizeToContent="Height" MinWidth="420" CanResize="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource ConfiguratorSurfaceBrush}"
    AutomationProperties.Name="{Binding Title}">
  <ScrollViewer MaxHeight="680">
    <StackPanel Margin="20" Spacing="12">
      <TextBlock Text="{Binding Title}" Classes="m3-title" TextWrapping="Wrap" />
      <TextBlock Text="{Binding PrivacyNote}" Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}" TextWrapping="Wrap" />

      <StackPanel Spacing="4" IsVisible="{Binding IsPasswordBased}">
        <TextBlock Text="{Binding LengthFieldLabel}" FontWeight="SemiBold" />
        <TextBox Name="PasswordLengthInput"
                 Text="{Binding LengthText, Mode=TwoWay}"
                 FlowDirection="LeftToRight"
                 AutomationProperties.Name="{Binding LengthFieldLabel}" />
      </StackPanel>

      <StackPanel Spacing="6" IsVisible="{Binding IsPasswordBased}">
        <CheckBox IsVisible="{Binding ShowLowercaseOption}"
                  IsEnabled="{Binding Bounds.AllowsLowercaseToggle}"
                  IsChecked="{Binding IncludeLowercase, Mode=TwoWay}"
                  Content="{Binding Strings[SecretIncludeLowercase]}" />
        <CheckBox IsVisible="{Binding ShowUppercaseOption}"
                  IsEnabled="{Binding Bounds.AllowsUppercaseToggle}"
                  IsChecked="{Binding IncludeUppercase, Mode=TwoWay}"
                  Content="{Binding Strings[SecretIncludeUppercase]}" />
        <CheckBox IsVisible="{Binding ShowDigitsOption}"
                  IsEnabled="{Binding Bounds.AllowsDigitsToggle}"
                  IsChecked="{Binding IncludeDigits, Mode=TwoWay}"
                  Content="{Binding Strings[SecretIncludeDigits]}" />
        <CheckBox IsVisible="{Binding ShowSymbolsOption}"
                  IsEnabled="{Binding Bounds.AllowsSymbolsToggle}"
                  IsChecked="{Binding IncludeSymbols, Mode=TwoWay}"
                  Content="{Binding Strings[SecretIncludeSymbols]}" />

        <StackPanel Spacing="4" Margin="0,4,0,0">
          <TextBlock Text="{Binding Strings[SecretForbiddenCharsLabel]}" FontWeight="SemiBold" />
          <TextBox Name="ForbiddenCharactersInput"
                   Text="{Binding AdditionalForbiddenCharacters, Mode=TwoWay}"
                   FlowDirection="LeftToRight"
                   AutomationProperties.Name="{Binding Strings[SecretForbiddenCharsLabel]}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="4" IsVisible="{Binding ShowsByteLengthInput}">
        <TextBlock Text="{Binding LengthFieldLabel}" FontWeight="SemiBold" />
        <TextBox Name="ByteLengthInput"
                 Text="{Binding LengthText, Mode=TwoWay}"
                 FlowDirection="LeftToRight"
                 AutomationProperties.Name="{Binding LengthFieldLabel}" />
      </StackPanel>

      <TextBlock Text="{Binding EntropyText}" FontWeight="SemiBold" TextWrapping="Wrap" />

      <Border IsVisible="{Binding HasError}"
              Padding="10,8" CornerRadius="8" BorderThickness="1"
              BorderBrush="{DynamicResource ConfiguratorErrorBrush}">
        <TextBlock Name="SecretGeneratorError" Text="{Binding ErrorText}"
                   Foreground="{DynamicResource ConfiguratorErrorBrush}" TextWrapping="Wrap" />
      </Border>

      <Button Name="GeneratePreviewButton"
              Classes="secondary"
              Content="{Binding Strings[SecretGeneratePreview]}"
              Command="{Binding GeneratePreviewCommand}"
              HorizontalAlignment="Left"
              AutomationProperties.Name="{Binding Strings[SecretGeneratePreview]}" />

      <Border IsVisible="{Binding HasPreview}"
              Padding="12" CornerRadius="10" BorderThickness="1"
              BorderBrush="{DynamicResource ConfiguratorBorderBrush}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Strings[SecretPreviewLabel]}" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Name="GeneratedPreviewBox" Grid.Column="0"
                     Text="{Binding PreviewText, Mode=OneWay}"
                     PasswordChar="{Binding PreviewPasswordChar}"
                     IsReadOnly="True"
                     FlowDirection="LeftToRight"
                     AutomationProperties.Name="{Binding Strings[SecretPreviewLabel]}" />
            <Button Name="ToggleRevealPreviewButton" Grid.Column="1"
                    Classes="secondary"
                    Content="{Binding RevealButtonLabel}"
                    Command="{Binding ToggleRevealPreviewCommand}" />
            <Button Name="CopyPreviewButton" Grid.Column="2"
                    Classes="secondary"
                    Content="{Binding Strings[CopySecretLabel]}"
                    Command="{Binding CopyPreviewCommand}" />
          </Grid>
          <TextBlock IsVisible="{Binding HasClipboardNotice}"
                     Text="{Binding ClipboardNotice}"
                     Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
        <Button Name="CancelSecretGeneratorButton"
                Classes="secondary"
                Content="{Binding Strings[SecretDialogCancelLabel]}"
                Command="{Binding CancelCommand}" />
        <Button Name="ApplySecretGeneratorButton"
                Classes="primary"
                Content="{Binding Strings[SecretApplyGenerated]}"
                Command="{Binding ApplyCommand}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
