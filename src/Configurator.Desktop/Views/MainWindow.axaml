<Window
    x:Class="Configurator.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Configurator.Desktop.ViewModels"
    xmlns:local="using:Configurator.Desktop.Views"
    x:DataType="vm:DesktopShellViewModel"
    x:CompileBindings="True"
    local:FocusBehavior.Target="{Binding FocusTarget}"
    local:FocusBehavior.Request="{Binding FocusRequestGeneration}"
    local:FocusBehavior.OnOpened="True"
    FlowDirection="{Binding Workspace.FlowDirection}"
    Title="{Binding Workspace.Strings[WindowTitle]}"
    Width="960" Height="800" MinWidth="600" MinHeight="540"
    AutomationProperties.Name="{Binding Workspace.Strings[WindowTitle]}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding FocusDefinitionPathCommand}" />
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding Publisher.PrepareCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </Window.KeyBindings>
  <ScrollViewer Name="WorkspaceScroll" Margin="20" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Spacing="14">
    <Expander Name="WorkspaceSettings" Header="{Binding Workspace.Strings[Settings]}" HorizontalAlignment="Stretch">
      <StackPanel Spacing="8" MaxWidth="800">
        <TextBlock Text="{Binding Workspace.Strings[AppearanceLabel]}" />
        <ComboBox Name="Appearance" SelectedIndex="{Binding AppearanceIndex, Mode=TwoWay}"
                  AutomationProperties.Name="{Binding Workspace.Strings[AppearanceLabel]}">
          <ComboBoxItem Content="{Binding Workspace.Strings[AppearanceSystem]}" />
          <ComboBoxItem Content="{Binding Workspace.Strings[AppearanceLight]}" />
          <ComboBoxItem Content="{Binding Workspace.Strings[AppearanceDark]}" />
        </ComboBox>
      </StackPanel>
    </Expander>
    <local:DefinitionLoaderView />
    <StackPanel IsVisible="{Binding Workspace.HasConfigurationContext}" Spacing="6">
      <TextBlock Text="{Binding Workspace.Strings[ConfigurationContext]}" />
      <ComboBox Name="ConfigurationContext" ItemsSource="{Binding Workspace.ConfigurationChoices}"
                SelectedItem="{Binding Workspace.SelectedConfigurationContext, Mode=TwoWay}"
                AutomationProperties.Name="{Binding Workspace.Strings[ConfigurationContext]}"
                AutomationProperties.HelpText="{Binding Workspace.Strings[ConfigurationContextHelp]}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ConfigurationContextChoice">
            <TextBlock Text="{Binding Title}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="{Binding Workspace.Strings[ConfigurationContextHelp]}" TextWrapping="Wrap" />
    </StackPanel>
      <ItemsControl Name="Fields" ItemsSource="{Binding Workspace.Fields}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    <local:ArtifactPublicationView />
  </StackPanel>
  </ScrollViewer>
</Window>
