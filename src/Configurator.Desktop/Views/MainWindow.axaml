<Window
    x:Class="Configurator.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Configurator.Desktop.ViewModels"
    xmlns:local="using:Configurator.Desktop.Views"
    x:DataType="vm:DesktopShellViewModel"
    x:CompileBindings="True"
    local:FocusBehavior.Target="{Binding FocusTarget}"
    local:FocusBehavior.Request="{Binding FocusRequestGeneration}"
    local:FocusBehavior.OnOpened="True"
    FlowDirection="{Binding Workspace.FlowDirection}"
    Title="{Binding Workspace.Strings[WindowTitle]}"
    Width="960" Height="800" MinWidth="600" MinHeight="540"
    AutomationProperties.Name="{Binding Workspace.Strings[WindowTitle]}">
  <ScrollViewer Name="WorkspaceScroll" Margin="20" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Spacing="14">
    <WrapPanel>
      <Button Name="OpenStage" AutomationProperties.AutomationId="OpenStage" Content="{Binding Workspace.Strings[Open]}" Command="{Binding Navigation.OpenCommand}" />
      <Button Name="ConfigureStage" AutomationProperties.AutomationId="ConfigureStage" Content="{Binding Workspace.Strings[Configure]}"
              Command="{Binding Navigation.ConfigureCommand}" IsEnabled="{Binding Navigation.HasWorkspace}" />
      <Button Name="ReviewStage" AutomationProperties.AutomationId="ReviewStage" Content="{Binding Workspace.Strings[ReviewOutputs]}"
              Command="{Binding Navigation.ReviewCommand}" IsEnabled="{Binding Navigation.HasWorkspace}" />
    </WrapPanel>
    <Expander Name="WorkspaceSettings" Header="{Binding Workspace.Strings[Settings]}" HorizontalAlignment="Stretch">
      <StackPanel Spacing="8" MaxWidth="800">
        <TextBlock Text="{Binding Workspace.Strings[AppearanceLabel]}" />
        <ComboBox Name="Appearance" SelectedIndex="{Binding AppearanceIndex, Mode=TwoWay}"
                  AutomationProperties.Name="{Binding Workspace.Strings[AppearanceLabel]}">
          <ComboBoxItem Content="{Binding Workspace.Strings[AppearanceSystem]}" />
          <ComboBoxItem Content="{Binding Workspace.Strings[AppearanceLight]}" />
          <ComboBoxItem Content="{Binding Workspace.Strings[AppearanceDark]}" />
        </ComboBox>
        <StackPanel IsVisible="{Binding Navigation.HasWorkspace}" Spacing="8">
          <TextBlock Text="{Binding Workspace.LocaleLabel}" />
          <ComboBox Name="DefinitionLocale" ItemsSource="{Binding Workspace.Locales}"
                    SelectedItem="{Binding Workspace.SelectedLocale, Mode=TwoWay}"
                    AutomationProperties.Name="{Binding Workspace.LocaleLabel}" />
          <CheckBox AutomationProperties.Name="{Binding Workspace.FollowLocaleDirectionLabel}"
                    IsChecked="{Binding Workspace.FollowLocaleDirection, Mode=TwoWay}">
            <TextBlock Text="{Binding Workspace.FollowLocaleDirectionLabel}" />
          </CheckBox>
          <CheckBox AutomationProperties.Name="{Binding Workspace.Strings[RightToLeft]}"
                    IsChecked="{Binding Workspace.IsRightToLeft, Mode=TwoWay}">
            <TextBlock Text="{Binding Workspace.Strings[RightToLeft]}" />
          </CheckBox>
        </StackPanel>
      </StackPanel>
    </Expander>
    <local:DefinitionLoaderView IsVisible="{Binding Navigation.IsOpen}" MaxWidth="800" HorizontalAlignment="Stretch" />
    <local:ConfigurationWorkspaceView IsVisible="{Binding Navigation.IsConfigure}" />
    <local:ArtifactPublicationView IsVisible="{Binding Navigation.IsReview}" MaxWidth="800" HorizontalAlignment="Stretch" />
    <local:WorkspaceActionBar />
  </StackPanel>
  </ScrollViewer>
</Window>
