<UserControl x:Class="Configurator.Desktop.Views.SettingsWorkspaceView"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Configurator.Desktop.ViewModels"
    xmlns:res="using:Configurator.Desktop.Resources"
    xmlns:local="using:Configurator.Desktop.Views"
    x:DataType="vm:DesktopShellViewModel" x:CompileBindings="True">
  <StackPanel Spacing="16" MaxWidth="860">
    <Button Name="ReturnToConfigurationButton"
            AutomationProperties.AutomationId="ReturnToConfigurationButton"
            Content="{Binding Workspace.Strings[ReturnToConfigurationLabel]}"
            Command="{Binding Navigation.ReturnToConfigurationCommand}"
            IsVisible="{Binding Navigation.CanReturnToConfiguration}"
            HorizontalAlignment="Left" />
    <TextBlock Text="{Binding Workspace.Strings[Settings]}"
               FontSize="{DynamicResource ConfiguratorHeadingFontSize}"
               FontWeight="SemiBold" />
    <StackPanel Classes="compact-navigation" Spacing="8">
      <TextBlock Text="{Binding Workspace.Strings[Section]}" />
      <ComboBox Name="SettingsSectionSelector"
                ItemsSource="{Binding Navigation.SettingsSections}"
                SelectedItem="{Binding Navigation.SelectedSettingsSection, Mode=TwoWay}"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="{Binding Workspace.Strings[Settings]}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DesktopSettingsSection">
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Text="{Binding Navigation.SelectedSettingsSection.Title}"
                 FontSize="{DynamicResource ConfiguratorTitleFontSize}"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding Navigation.SelectedSettingsSection.Description}"
                 Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}"
                 TextWrapping="Wrap" />
    </StackPanel>

    <Border BorderBrush="{DynamicResource ConfiguratorBorderBrush}"
            Background="{DynamicResource ConfiguratorSurfaceBrush}"
            BorderThickness="1" Padding="16" CornerRadius="8"
            IsVisible="{Binding Navigation.IsAppearanceSettings}">
      <StackPanel Spacing="16">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Workspace.Strings[AppearanceLabel]}" FontWeight="SemiBold" />
          <ComboBox Name="SettingsAppearanceModeSelector"
                    SelectedIndex="{Binding AppearanceModeIndex, Mode=TwoWay}"
                    AutomationProperties.Name="{Binding Workspace.Strings[AppearanceLabel]}"
                    HorizontalAlignment="Left" MinWidth="220">
            <ComboBoxItem Content="{Binding Workspace.Strings[AppearanceSystem]}" />
            <ComboBoxItem Content="{Binding Workspace.Strings[AppearanceLight]}" />
            <ComboBoxItem Content="{Binding Workspace.Strings[AppearanceDark]}" />
            <ComboBoxItem Content="{Binding Workspace.Strings[AppearanceLightHighContrast]}" />
            <ComboBoxItem Content="{Binding Workspace.Strings[AppearanceDarkHighContrast]}" />
          </ComboBox>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Workspace.Strings[ThemePresetLabel]}" FontWeight="SemiBold" />
          <ItemsControl Name="SettingsPresetGallery" ItemsSource="{Binding ThemePresets}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="8" LineSpacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DesktopThemePresetItem">
                <Button Classes="preset-chip"
                        Classes.active-preset="{Binding IsSelected}"
                        Command="{Binding $parent[local:SettingsWorkspaceView].((vm:DesktopShellViewModel)DataContext).SelectThemePresetCommand}"
                        CommandParameter="{Binding ThemeKey}"
                        Margin="0">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="14" Height="14" CornerRadius="7"
                            BorderBrush="{DynamicResource ConfiguratorBorderBrush}" BorderThickness="1"
                            Background="{Binding NaturalHex, Converter={x:Static res:HexToBrushConverter.Instance}}" />
                    <Border Width="14" Height="14" CornerRadius="7"
                            BorderBrush="{DynamicResource ConfiguratorBorderBrush}" BorderThickness="1"
                            Background="{Binding BrandHex, Converter={x:Static res:HexToBrushConverter.Instance}}" />
                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel ItemSpacing="8" VerticalAlignment="Center">
            <Button Name="SelectCustomThemeButton"
                    Classes="preset-chip"
                    Classes.active-preset="{Binding IsCustomPreset}"
                    Content="{Binding Workspace.Strings[ThemePresetCustomName]}"
                    Command="{Binding SelectCustomThemeCommand}"
                    Margin="0" />
            <Button Name="ResetCustomThemeButton"
                    Content="{Binding Workspace.Strings[ThemeResetCustomLabel]}"
                    Command="{Binding ResetCustomThemeCommand}"
                    Margin="0" />
          </WrapPanel>
        </StackPanel>

        <Border Classes="m3-card" Name="CustomThemeBuilderPanel"
                Background="{DynamicResource ConfiguratorSurfaceContainerBrush}">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <StackPanel Grid.Column="0" Spacing="6">
              <TextBlock Text="{Binding Workspace.Strings[ThemeCustomNaturalLabel]}" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="4"
                        BorderBrush="{DynamicResource ConfiguratorBorderBrush}" BorderThickness="1"
                        Background="{Binding CustomNaturalHex, Converter={x:Static res:HexToBrushConverter.Instance}}" />
                <TextBox Name="SettingsCustomNaturalHex"
                         Text="{Binding CustomNaturalHex, Mode=TwoWay}"
                         FlowDirection="LeftToRight" Width="120"
                         AutomationProperties.Name="{Binding Workspace.Strings[ThemeCustomNaturalLabel]}" />
              </StackPanel>
              <TextBlock Text="{Binding Workspace.Strings[ThemeHueLabel]}" />
              <Slider Name="CustomNaturalHueSlider" Minimum="0" Maximum="360"
                      Value="{Binding CustomNaturalHue, Mode=TwoWay}" />
              <TextBlock Text="{Binding Workspace.Strings[ThemeSaturationLabel]}" />
              <Slider Name="CustomNaturalSaturationSlider" Minimum="0" Maximum="100"
                      Value="{Binding CustomNaturalSaturation, Mode=TwoWay}" />
              <TextBlock Text="{Binding Workspace.Strings[ThemeLightnessLabel]}" />
              <Slider Name="CustomNaturalLightnessSlider" Minimum="0" Maximum="100"
                      Value="{Binding CustomNaturalLightness, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="{Binding Workspace.Strings[ThemeCustomBrandLabel]}" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="4"
                        BorderBrush="{DynamicResource ConfiguratorBorderBrush}" BorderThickness="1"
                        Background="{Binding CustomBrandHex, Converter={x:Static res:HexToBrushConverter.Instance}}" />
                <TextBox Name="SettingsCustomBrandHex"
                         Text="{Binding CustomBrandHex, Mode=TwoWay}"
                         FlowDirection="LeftToRight" Width="120"
                         AutomationProperties.Name="{Binding Workspace.Strings[ThemeCustomBrandLabel]}" />
              </StackPanel>
              <TextBlock Text="{Binding Workspace.Strings[ThemeHueLabel]}" />
              <Slider Name="CustomBrandHueSlider" Minimum="0" Maximum="360"
                      Value="{Binding CustomBrandHue, Mode=TwoWay}" />
              <TextBlock Text="{Binding Workspace.Strings[ThemeSaturationLabel]}" />
              <Slider Name="CustomBrandSaturationSlider" Minimum="0" Maximum="100"
                      Value="{Binding CustomBrandSaturation, Mode=TwoWay}" />
              <TextBlock Text="{Binding Workspace.Strings[ThemeLightnessLabel]}" />
              <Slider Name="CustomBrandLightnessSlider" Minimum="0" Maximum="100"
                      Value="{Binding CustomBrandLightness, Mode=TwoWay}" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="m3-card" Background="{DynamicResource ConfiguratorSurfaceBrush}" Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Workspace.Strings[ThemePreviewLabel]}" FontWeight="SemiBold" />
            <WrapPanel ItemSpacing="8" LineSpacing="8" VerticalAlignment="Center">
              <Border Classes="tonal-pill">
                <TextBlock Text="{Binding Workspace.Strings[ThemePreviewSurfaceSample]}" />
              </Border>
              <Border Background="{DynamicResource ConfiguratorPrimaryContainerBrush}" CornerRadius="6" Padding="10,4">
                <TextBlock Text="{Binding Workspace.Strings[ThemePreviewAccentSample]}"
                           Foreground="{DynamicResource ConfiguratorOnPrimaryContainerBrush}" FontWeight="SemiBold" />
              </Border>
              <Border Background="{DynamicResource ConfiguratorSelectedBrush}" CornerRadius="6" Padding="10,4">
                <TextBlock Text="{Binding ActiveThemeKey}"
                           Foreground="{DynamicResource ConfiguratorSelectedTextBrush}" FontWeight="SemiBold" />
              </Border>
            </WrapPanel>
          </StackPanel>
        </Border>

        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Workspace.Strings[SettingsDensityLabel]}" FontWeight="SemiBold" />
          <ComboBox Name="SettingsDensitySelector"
                    SelectedIndex="{Binding DensityIndex, Mode=TwoWay}"
                    AutomationProperties.Name="{Binding Workspace.Strings[SettingsDensityLabel]}"
                    HorizontalAlignment="Left" MinWidth="180">
            <ComboBoxItem Content="{Binding Workspace.Strings[DensitySpacious]}" />
            <ComboBoxItem Content="{Binding Workspace.Strings[DensityComfortable]}" />
            <ComboBoxItem Content="{Binding Workspace.Strings[DensityCompact]}" />
            <ComboBoxItem Content="{Binding Workspace.Strings[DensityDense]}" />
          </ComboBox>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Workspace.Strings[SettingsDefaultNamingLabel]}" FontWeight="SemiBold" />
          <ComboBox Name="SettingsDefaultNamingSelector"
                    SelectedIndex="{Binding DefaultNamingModeIndex, Mode=TwoWay}"
                    AutomationProperties.Name="{Binding Workspace.Strings[SettingsDefaultNamingLabel]}"
                    HorizontalAlignment="Left" MinWidth="220">
            <ComboBoxItem Content="{Binding Workspace.Strings[NamingHumanized]}" />
            <ComboBoxItem Content="{Binding Workspace.Strings[NamingTechnical]}" />
          </ComboBox>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Workspace.Strings[SettingsContrastLabel]}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding HighContrastStatus}"
                     Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Text="{Binding Workspace.Strings[SettingsAppearanceSessionNote]}"
                   Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border BorderBrush="{DynamicResource ConfiguratorBorderBrush}"
            Background="{DynamicResource ConfiguratorSurfaceBrush}"
            BorderThickness="1" Padding="16"
            IsVisible="{Binding Navigation.IsLanguageSettings}">
      <StackPanel Spacing="12">
        <StackPanel Spacing="4" IsVisible="{Binding Navigation.HasWorkspace}">
          <TextBlock Text="{Binding Workspace.LocaleLabel}" FontWeight="SemiBold" />
          <ComboBox Name="SettingsDefinitionLocale"
                    ItemsSource="{Binding Workspace.Locales}"
                    SelectedItem="{Binding Workspace.SelectedLocale, Mode=TwoWay}"
                    AutomationProperties.Name="{Binding Workspace.LocaleLabel}"
                    HorizontalAlignment="Left" MinWidth="180" />
        </StackPanel>
        <TextBlock Text="{Binding Workspace.Strings[SettingsNoWorkspaceLocales]}"
                   IsVisible="{Binding !Navigation.HasWorkspace}"
                   Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}"
                   TextWrapping="Wrap" />
        <CheckBox Name="SettingsFollowLocaleDirection"
                  Content="{Binding Workspace.FollowLocaleDirectionLabel}"
                  AutomationProperties.Name="{Binding Workspace.FollowLocaleDirectionLabel}"
                  IsChecked="{Binding Workspace.FollowLocaleDirection, Mode=TwoWay}" />
        <CheckBox Name="SettingsRightToLeft"
                  Content="{Binding Workspace.Strings[RightToLeft]}"
                  AutomationProperties.Name="{Binding Workspace.Strings[RightToLeft]}"
                  IsChecked="{Binding Workspace.IsRightToLeft, Mode=TwoWay}" />
      </StackPanel>
    </Border>

    <Border BorderBrush="{DynamicResource ConfiguratorBorderBrush}"
            Background="{DynamicResource ConfiguratorSurfaceBrush}"
            BorderThickness="1" Padding="16"
            IsVisible="{Binding Navigation.IsKeyboardSettings}">
      <StackPanel Spacing="12">
        <Button Name="SettingsShortcutsButton"
                AutomationProperties.AutomationId="SettingsShortcutsButton"
                Content="{Binding Workspace.Strings[OpenShortcutsHelpLabel]}"
                Command="{Binding OpenShortcutsHelpCommand}"
                HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Workspace.Strings[SettingsShortcutsHelp]}" TextWrapping="Wrap" />
        <Border Name="ShortcutsSheetPanel"
                IsVisible="{Binding ShortcutsDialogOpen}"
                Classes="m3-card"
                BorderBrush="{DynamicResource ConfiguratorFocusBrush}"
                BorderThickness="2">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Workspace.Strings[ShortcutsDialogTitle]}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Workspace.Strings[SettingsShortcutsHelp]}" TextWrapping="Wrap" />
            <Button Content="{Binding Workspace.Strings[CloseShortcutsLabel]}"
                    Command="{Binding CloseShortcutsHelpCommand}"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <Border BorderBrush="{DynamicResource ConfiguratorBorderBrush}"
            Background="{DynamicResource ConfiguratorSurfaceBrush}"
            BorderThickness="1" Padding="16"
            IsVisible="{Binding Navigation.IsPrivacySettings}">
      <StackPanel Spacing="12">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Workspace.Strings[SettingsWorkstationHostLabel]}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Publisher.ProtectedCapability}" TextWrapping="Wrap" />
        </StackPanel>
        <local:ProfileWorkspaceView />
        <TextBlock Text="{Binding Workspace.Strings[SettingsPrivacyHelp]}"
                   Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
