<UserControl x:Class="Configurator.Desktop.Views.DefinitionLoaderView"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Configurator.Desktop.ViewModels"
    xmlns:res="using:Configurator.Desktop.Resources"
    xmlns:local="using:Configurator.Desktop.Views"
    xmlns:store="using:Configurator.Presentation.Store"
    x:DataType="vm:DesktopShellViewModel" x:CompileBindings="True">
    <UserControl.Styles>
      <Style Selector="UniformGrid.store-cards-grid">
        <Setter Property="Columns" Value="1" />
      </Style>
      <ContainerQuery Name="StoreGridHost" Query="min-width: 700">
        <Style Selector="UniformGrid.store-cards-grid">
          <Setter Property="Columns" Value="2" />
        </Style>
      </ContainerQuery>
    </UserControl.Styles>
    <StackPanel Spacing="14">
      <WrapPanel ItemSpacing="8">
        <Button Name="StartFreshTask" Content="{Binding Workspace.Strings[StartFreshTask]}"
                Command="{Binding StartFreshTaskCommand}" />
        <Button Name="UseExistingTask" Content="{Binding Workspace.Strings[UseExistingTask]}"
                Command="{Binding UseExistingTaskCommand}" />
        <Button Name="OpenSavedProfileTask" Content="{Binding Workspace.Strings[OpenSavedProfileTask]}"
                Command="{Binding OpenSavedProfileTaskCommand}" />
      </WrapPanel>
      <local:ProfileWorkspaceView />
      <TextBlock Text="{Binding Workspace.Strings[PreparationTitle]}" FontSize="{DynamicResource ConfiguratorTitleFontSize}" FontWeight="SemiBold" />

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Workspace.Strings[PublicSchemaUrl]}" />
          <TextBox Name="DefinitionUrl" Text="{Binding Loader.DefinitionUrl, Mode=TwoWay}" FlowDirection="LeftToRight"
                   PlaceholderText="https://example.org/definition.json"
                   AutomationProperties.Name="{Binding Workspace.Strings[PublicSchemaUrl]}" />
        </StackPanel>
        <Button Grid.Column="1" Name="FetchDefinition" Content="{Binding Workspace.Strings[FetchSchema]}"
                Command="{Binding Loader.FetchDefinitionCommand}"
                AutomationProperties.Name="{Binding Workspace.Strings[FetchSchema]}"
                VerticalAlignment="Bottom" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Workspace.Strings[DefinitionPath]}" />
          <TextBox Name="DefinitionPath" Text="{Binding Loader.DefinitionPath, Mode=TwoWay}" FlowDirection="LeftToRight"
                   AutomationProperties.Name="{Binding Workspace.Strings[DefinitionPath]}" />
        </StackPanel>
        <Button Grid.Column="1" Name="SelectDefinition" Content="{Binding Workspace.Strings[ChooseDefinition]}"
                Command="{Binding Loader.SelectDefinitionCommand}"
                AutomationProperties.Name="{Binding Workspace.Strings[ChooseDefinition]}"
                VerticalAlignment="Bottom" />
        <Button Grid.Column="2" Name="LoadDefinition" Content="{Binding Workspace.Strings[LoadDefinition]}"
                Command="{Binding Loader.LoadDefinitionCommand}"
                AutomationProperties.Name="{Binding Workspace.Strings[LoadDefinition]}"
                VerticalAlignment="Bottom" />
      </Grid>

      <TextBlock Text="{Binding Loader.DefinitionPin}" TextWrapping="Wrap" />

      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Workspace.Strings[RepositoryStore]}" FontSize="{DynamicResource ConfiguratorHeadingFontSize}" FontWeight="SemiBold" />
        <TextBox Name="StoreSearchQuery" Text="{Binding Loader.StoreSearchQuery, Mode=TwoWay}"
                 PlaceholderText="{Binding Workspace.Strings[SearchSchemas]}"
                 AutomationProperties.Name="{Binding Workspace.Strings[SearchSchemas]}" />
        <TextBlock Name="StoreUnavailableText" Text="{Binding Workspace.Strings[StoreUnavailable]}"
                   IsVisible="{Binding Loader.StoreCatalog.LoadFailed}" Classes="error" TextWrapping="Wrap" />
        <TextBlock Name="StoreNoProjectsText" Text="{Binding Workspace.Strings[StoreNoProjects]}"
                   IsVisible="{Binding Loader.StoreCatalog.HasNoMatches}"
                   Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}" TextWrapping="Wrap" />
        <Border Container.Name="StoreGridHost" Container.Sizing="Width">
          <ItemsControl Name="StoreProjects" ItemsSource="{Binding Loader.StoreCatalog.Projects}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Classes="store-cards-grid" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="store:StoreProjectCardViewModel">
                <Border Classes="store-project-card" Margin="0,0,10,10" MinHeight="128" MaxHeight="164">
                  <Grid ColumnDefinitions="76,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Classes="store-logo-tile" VerticalAlignment="Top">
                      <Panel>
                        <Image Name="StoreProjectLogo"
                               Width="74" Height="74" Stretch="Uniform"
                               IsVisible="{Binding HasIcon}"
                               Source="{Binding IconBytes, Converter={x:Static res:StoreIconBitmapConverter.Instance}}"
                               AutomationProperties.Name="{Binding Name}" />
                        <TextBlock Name="StoreProjectMonogram"
                                   Text="{Binding Monogram}"
                                   IsVisible="{Binding !HasIcon}"
                                   FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Panel>
                    </Border>
                    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="4">
                      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Classes="tonal-pill" VerticalAlignment="Center">
                          <TextBlock Text="{Binding LatestRevision, StringFormat='r{0}'}" FontSize="12" />
                        </Border>
                        <Button Grid.Column="2" Name="StoreProjectDetailsButton"
                                Content="ⓘ"
                                Padding="8,2" MinHeight="28" MinWidth="32" Margin="0"
                                Command="{Binding $parent[local:DefinitionLoaderView].((vm:DesktopShellViewModel)DataContext).Loader.OpenStoreDetailsCommand}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding $parent[local:DefinitionLoaderView].((vm:DesktopShellViewModel)DataContext).Workspace.Strings[StoreProjectDetailsButtonLabel]}"
                                ToolTip.Tip="{Binding $parent[local:DefinitionLoaderView].((vm:DesktopShellViewModel)DataContext).Workspace.Strings[StoreProjectDetailsButtonLabel]}" />
                      </Grid>
                      <TextBlock Grid.Row="1" Text="{Binding Description}"
                                 Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}"
                                 MaxLines="2" TextTrimming="CharacterEllipsis" />
                      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="{Binding ApplicationId}" Classes="code-font"
                                   Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                          <Button Content="{Binding $parent[local:DefinitionLoaderView].((vm:DesktopShellViewModel)DataContext).Workspace.Strings[InspectProjectLabel]}"
                                  Command="{Binding $parent[local:DefinitionLoaderView].((vm:DesktopShellViewModel)DataContext).Loader.InspectStoreProjectCommand}"
                                  CommandParameter="{Binding}"
                                  Padding="10,4" MinHeight="32" Margin="0" />
                          <Button Name="ConfigureStoreProject"
                                  Classes="active-stage"
                                  Content="{Binding $parent[local:DefinitionLoaderView].((vm:DesktopShellViewModel)DataContext).Workspace.Strings[Configure]}"
                                  Command="{Binding $parent[local:DefinitionLoaderView].((vm:DesktopShellViewModel)DataContext).Loader.ConfigureStoreProjectCommand}"
                                  CommandParameter="{Binding}"
                                  Padding="12,4" MinHeight="32" Margin="0"
                                  AutomationProperties.Name="{Binding Name}" />
                        </StackPanel>
                      </Grid>
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <local:DefinitionExplorerView Name="DefinitionExplorer"
                                      IsVisible="{Binding Loader.Explorer.IsOpen}" />
      </StackPanel>
    </StackPanel>
</UserControl>
