<UserControl
    x:Class="Configurator.Desktop.Views.CompactSettingsTableView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:Configurator.Presentation"
    xmlns:vm="using:Configurator.Desktop.ViewModels"
    x:DataType="vm:CompactSettingsTableViewModel"
    x:CompileBindings="True">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
    <!-- Filter and sort bar -->
    <StackPanel Grid.Row="0" Spacing="6">
      <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
        <TextBox Name="CompactSearchBox" MinWidth="220"
                 Text="{Binding SearchQuery, Mode=TwoWay}"
                 PlaceholderText="{Binding Strings[CompactSearchLabel]}"
                 AutomationProperties.Name="{Binding Strings[CompactSearchLabel]}" />
        <ComboBox Name="CompactSortColumn" ItemsSource="{Binding SortColumnOptions}"
                  SelectedIndex="{Binding SortIndex, Mode=TwoWay}"
                  AutomationProperties.Name="{Binding Strings[CompactSortLabel]}" />
        <Button Name="CompactSortDirection" Content="{Binding SortDirectionLabel}"
                Command="{Binding ToggleSortDirectionCommand}" />
        <CheckBox Content="{Binding Strings[DiscoveryIncludeInactive]}"
                  IsChecked="{Binding IncludeInactive, Mode=TwoWay}" />
        <CheckBox Content="{Binding Strings[CompactCurrentSectionOnly]}"
                  IsChecked="{Binding CurrentSectionOnly, Mode=TwoWay}" />
      </WrapPanel>

      <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
        <Button Content="{Binding Strings[DiscoveryFilterAll]}"
                Classes.active-stage="{Binding IsFilterAll}"
                Command="{Binding SetFilterCommand}"
                CommandParameter="{x:Static p:DefinitionDiscoveryFilter.All}" />
        <Button Content="{Binding Strings[DiscoveryFilterInvalid]}"
                Classes.active-stage="{Binding IsFilterInvalid}"
                Command="{Binding SetFilterCommand}"
                CommandParameter="{x:Static p:DefinitionDiscoveryFilter.Invalid}" />
        <Button Content="{Binding Strings[DiscoveryFilterMissing]}"
                Classes.active-stage="{Binding IsFilterMissing}"
                Command="{Binding SetFilterCommand}"
                CommandParameter="{x:Static p:DefinitionDiscoveryFilter.MissingRequired}" />
        <Button Content="{Binding Strings[DiscoveryFilterModified]}"
                Classes.active-stage="{Binding IsFilterModified}"
                Command="{Binding SetFilterCommand}"
                CommandParameter="{x:Static p:DefinitionDiscoveryFilter.Modified}" />
        <Button Content="{Binding Strings[DiscoveryFilterDeferred]}"
                Classes.active-stage="{Binding IsFilterDeferred}"
                Command="{Binding SetFilterCommand}"
                CommandParameter="{x:Static p:DefinitionDiscoveryFilter.DeferredSecret}" />
      </WrapPanel>
    </StackPanel>

    <!-- Virtualized dense table rows inside bounded height -->
    <ListBox Grid.Row="1" Name="CompactRowsList"
             ItemsSource="{Binding Rows}"
             SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
             AutomationProperties.Name="{Binding Strings[ConfigureModeCompact]}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:CompactPropertyRowViewModel">
          <Border Classes="m3-surface-subtle" Padding="8,6" Margin="0,2">
            <Grid ColumnDefinitions="2*,2*,Auto" ColumnSpacing="10">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SecondaryLabel}" IsVisible="{Binding HasSecondaryLabel}"
                           Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal" ItemSpacing="8">
                  <TextBlock Text="{Binding SectionTitle}" Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}" FontSize="12" />
                  <TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource ConfiguratorAccentBrush}" FontSize="12" />
                  <TextBlock Text="{Binding OriginLabel}" Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}" FontSize="12" />
                </WrapPanel>
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{Binding DisplayValue}" Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}"
                           FontSize="12" TextWrapping="Wrap" />
                <TextBox Text="{Binding EditText, Mode=TwoWay}"
                         IsVisible="{Binding IsScalarTextEditable}"
                         AutomationProperties.Name="{Binding Label}" />
                <TextBox Text="{Binding EditText, Mode=TwoWay}"
                         PasswordChar="●"
                         IsVisible="{Binding IsMaskedEditable}"
                         PlaceholderText="{Binding Strings[CompactSecretInputHelp]}"
                         AutomationProperties.Name="{Binding Label}" />
                <ComboBox ItemsSource="{Binding Choices}"
                          SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                          IsVisible="{Binding HasChoices}"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{Binding Label}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="p:DefinitionChoicePresentation">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <WrapPanel Grid.Column="2" Orientation="Horizontal" ItemSpacing="4" LineSpacing="4" VerticalAlignment="Center">
                <Button Content="{Binding Strings[CompactCommitLabel]}"
                        Command="{Binding CommitEditCommand}"
                        IsVisible="{Binding CanEdit}" />
                <Button Content="{Binding Strings.ResetLabel}"
                        Command="{Binding ResetCommand}" />
                <Button Content="{Binding Strings.ClearLabel}"
                        Command="{Binding OmitCommand}"
                        IsVisible="{Binding CanEdit}" />
                <Button Content="{Binding Strings[CompactOpenGuidedLabel]}"
                        Command="{Binding OpenInGuidedCommand}" />
                <Button Content="{Binding Strings[CompactInspectLabel]}"
                        Command="{Binding InspectCommand}" />
              </WrapPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Grid.Row="2" Text="{Binding RowsCountSummary}"
               Foreground="{DynamicResource ConfiguratorSecondaryTextBrush}" FontSize="12" />
  </Grid>
</UserControl>
