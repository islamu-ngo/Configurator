<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:Configurator.Desktop.Resources">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="ConfiguratorCanvasBrush" Color="#FAF9FD" />
      <SolidColorBrush x:Key="ConfiguratorInputBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ConfiguratorSurfaceBrush" Color="#F3F2F8" />
      <SolidColorBrush x:Key="ConfiguratorSurfaceContainerBrush" Color="#EDECF4" />
      <SolidColorBrush x:Key="ConfiguratorSurfaceContainerHighBrush" Color="#E6E5EF" />
      <SolidColorBrush x:Key="ConfiguratorSecondaryTextBrush" Color="#44474F" />
      <SolidColorBrush x:Key="ConfiguratorAccentBrush" Color="#1B5EBE" />
      <SolidColorBrush x:Key="ConfiguratorFocusBrush" Color="#1B5EBE" />
      <SolidColorBrush x:Key="ConfiguratorPrimaryContainerBrush" Color="#D6E3FF" />
      <SolidColorBrush x:Key="ConfiguratorOnPrimaryContainerBrush" Color="#001B3E" />
      <SolidColorBrush x:Key="ConfiguratorSuccessBrush" Color="#1D682B" />
      <SolidColorBrush x:Key="ConfiguratorWarningBrush" Color="#785200" />
      <SolidColorBrush x:Key="ConfiguratorSelectedBrush" Color="#1B5EBE" />
      <SolidColorBrush x:Key="ConfiguratorSelectedTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ConfiguratorDisabledBrush" Color="#E3E2EA" />
      <SolidColorBrush x:Key="ConfiguratorDisabledTextBrush" Color="#4F525C" />
      <SolidColorBrush x:Key="ConfiguratorErrorBrush" Color="#BA1A1A" />
      <SolidColorBrush x:Key="ConfiguratorTextBrush" Color="#1A1B20" />
      <SolidColorBrush x:Key="ConfiguratorBorderBrush" Color="#5C5F6A" />
      <SolidColorBrush x:Key="ConfiguratorOutlineVariantBrush" Color="#C4C6D0" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="ConfiguratorCanvasBrush" Color="#111318" />
      <SolidColorBrush x:Key="ConfiguratorInputBrush" Color="#15171D" />
      <SolidColorBrush x:Key="ConfiguratorSurfaceBrush" Color="#1E2027" />
      <SolidColorBrush x:Key="ConfiguratorSurfaceContainerBrush" Color="#252730" />
      <SolidColorBrush x:Key="ConfiguratorSurfaceContainerHighBrush" Color="#2C2F3A" />
      <SolidColorBrush x:Key="ConfiguratorSecondaryTextBrush" Color="#C4C6D0" />
      <SolidColorBrush x:Key="ConfiguratorAccentBrush" Color="#A8C7FA" />
      <SolidColorBrush x:Key="ConfiguratorFocusBrush" Color="#A8C7FA" />
      <SolidColorBrush x:Key="ConfiguratorPrimaryContainerBrush" Color="#284777" />
      <SolidColorBrush x:Key="ConfiguratorOnPrimaryContainerBrush" Color="#D6E3FF" />
      <SolidColorBrush x:Key="ConfiguratorSuccessBrush" Color="#8AD88F" />
      <SolidColorBrush x:Key="ConfiguratorWarningBrush" Color="#F1C478" />
      <SolidColorBrush x:Key="ConfiguratorSelectedBrush" Color="#A8C7FA" />
      <SolidColorBrush x:Key="ConfiguratorSelectedTextBrush" Color="#072B59" />
      <SolidColorBrush x:Key="ConfiguratorDisabledBrush" Color="#272A32" />
      <SolidColorBrush x:Key="ConfiguratorDisabledTextBrush" Color="#8E9099" />
      <SolidColorBrush x:Key="ConfiguratorErrorBrush" Color="#FFB4AB" />
      <SolidColorBrush x:Key="ConfiguratorTextBrush" Color="#E2E2E9" />
      <SolidColorBrush x:Key="ConfiguratorBorderBrush" Color="#8E9099" />
      <SolidColorBrush x:Key="ConfiguratorOutlineVariantBrush" Color="#44474F" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="{x:Static local:DesktopTheme.HighContrast}">
      <SolidColorBrush x:Key="ConfiguratorCanvasBrush" Color="#000000" />
      <SolidColorBrush x:Key="ConfiguratorInputBrush" Color="#000000" />
      <SolidColorBrush x:Key="ConfiguratorSurfaceBrush" Color="#000000" />
      <SolidColorBrush x:Key="ConfiguratorSurfaceContainerBrush" Color="#000000" />
      <SolidColorBrush x:Key="ConfiguratorSurfaceContainerHighBrush" Color="#000000" />
      <SolidColorBrush x:Key="ConfiguratorSecondaryTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ConfiguratorAccentBrush" Color="#00FFFF" />
      <SolidColorBrush x:Key="ConfiguratorFocusBrush" Color="#00FFFF" />
      <SolidColorBrush x:Key="ConfiguratorPrimaryContainerBrush" Color="#00FFFF" />
      <SolidColorBrush x:Key="ConfiguratorOnPrimaryContainerBrush" Color="#000000" />
      <SolidColorBrush x:Key="ConfiguratorSuccessBrush" Color="#00FF00" />
      <SolidColorBrush x:Key="ConfiguratorWarningBrush" Color="#FFFF00" />
      <SolidColorBrush x:Key="ConfiguratorSelectedBrush" Color="#00FFFF" />
      <SolidColorBrush x:Key="ConfiguratorSelectedTextBrush" Color="#000000" />
      <SolidColorBrush x:Key="ConfiguratorDisabledBrush" Color="#000000" />
      <SolidColorBrush x:Key="ConfiguratorDisabledTextBrush" Color="#BFBFBF" />
      <SolidColorBrush x:Key="ConfiguratorErrorBrush" Color="#FFFF00" />
      <SolidColorBrush x:Key="ConfiguratorTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ConfiguratorBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ConfiguratorOutlineVariantBrush" Color="#FFFFFF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="{x:Static local:DesktopTheme.LightHighContrast}">
      <SolidColorBrush x:Key="ConfiguratorCanvasBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ConfiguratorInputBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ConfiguratorSurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ConfiguratorSurfaceContainerBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ConfiguratorSurfaceContainerHighBrush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="ConfiguratorSecondaryTextBrush" Color="#000000" />
      <SolidColorBrush x:Key="ConfiguratorAccentBrush" Color="#003599" />
      <SolidColorBrush x:Key="ConfiguratorFocusBrush" Color="#003599" />
      <SolidColorBrush x:Key="ConfiguratorPrimaryContainerBrush" Color="#003599" />
      <SolidColorBrush x:Key="ConfiguratorOnPrimaryContainerBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ConfiguratorSuccessBrush" Color="#005500" />
      <SolidColorBrush x:Key="ConfiguratorWarningBrush" Color="#5A3900" />
      <SolidColorBrush x:Key="ConfiguratorSelectedBrush" Color="#003599" />
      <SolidColorBrush x:Key="ConfiguratorSelectedTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ConfiguratorDisabledBrush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="ConfiguratorDisabledTextBrush" Color="#3F3F3F" />
      <SolidColorBrush x:Key="ConfiguratorErrorBrush" Color="#8A0000" />
      <SolidColorBrush x:Key="ConfiguratorTextBrush" Color="#000000" />
      <SolidColorBrush x:Key="ConfiguratorBorderBrush" Color="#000000" />
      <SolidColorBrush x:Key="ConfiguratorOutlineVariantBrush" Color="#000000" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
