<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <x:Double x:Key="ConfiguratorBodyFontSize">14</x:Double>
    <x:Double x:Key="ConfiguratorHeadingFontSize">24</x:Double>
    <x:Double x:Key="ConfiguratorTitleFontSize">26</x:Double>
    <x:Double x:Key="ConfiguratorControlMinHeight">36</x:Double>
    <x:Double x:Key="ConfiguratorSpacing">14</x:Double>
    <x:Double x:Key="ConfiguratorTableRowHeight">40</x:Double>
    <Thickness x:Key="ConfiguratorCardPadding">12</Thickness>
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="FontSize" Value="{DynamicResource ConfiguratorBodyFontSize}" />
    <Setter Property="Background" Value="{DynamicResource ConfiguratorCanvasBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ConfiguratorTextBrush}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.code-font">
    <Setter Property="FontFamily" Value="Consolas, Liberation Mono, Menlo, monospace" />
  </Style>
  <Style Selector="TextBox.code-editor">
    <Setter Property="FontFamily" Value="Consolas, Liberation Mono, Menlo, monospace" />
  </Style>
  <Style Selector="TextBox.multiline-editor">
    <Setter Property="MinHeight" Value="88" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.m3-card">
    <Setter Property="Background" Value="{DynamicResource ConfiguratorSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConfiguratorBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="{DynamicResource ConfiguratorCardPadding}" />
  </Style>
  <Style Selector="Border.tonal-pill">
    <Setter Property="Background" Value="{DynamicResource ConfiguratorSurfaceContainerHighBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConfiguratorOutlineVariantBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="TextBox, ComboBox, Button">
    <Setter Property="MinHeight" Value="{DynamicResource ConfiguratorControlMinHeight}" />
    <Setter Property="MinWidth" Value="32" />
  </Style>
  <Style Selector="CheckBox, RadioButton, MenuItem">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="32" />
  </Style>
  <Style Selector="Button">
    <Setter Property="Margin" Value="0,0,8,8" />
  </Style>
  <Style Selector="TextBox, ComboBox, Button, ComboBoxItem">
    <Setter Property="Background" Value="{DynamicResource ConfiguratorInputBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ConfiguratorTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConfiguratorBorderBrush}" />
  </Style>
  <Style Selector="Button:pointerover, Button:pressed, ComboBox:pointerover, TextBox:pointerover">
    <Setter Property="Background" Value="{DynamicResource ConfiguratorSurfaceContainerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ConfiguratorTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConfiguratorFocusBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected, ComboBoxItem:selected:pointerover, ListBoxItem:selected, ListBoxItem:selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource ConfiguratorSelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ConfiguratorSelectedTextBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected TextBlock, ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ConfiguratorSelectedTextBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter, ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ConfiguratorSelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ConfiguratorSelectedTextBrush}" />
  </Style>
  <Style Selector="TextBox:focus, ComboBox:focus, Button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource ConfiguratorFocusBrush}" />
  </Style>
  <Style Selector="TextBox:disabled, ComboBox:disabled, Button:disabled">
    <Setter Property="Background" Value="{DynamicResource ConfiguratorDisabledBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ConfiguratorDisabledTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConfiguratorBorderBrush}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource ConfiguratorErrorBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource ConfiguratorWarningBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Grid.header-bar Button, Grid.header-bar ComboBox">
    <Setter Property="Margin" Value="0,0,8,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.active-stage, Button.active-stage:pointerover">
    <Setter Property="Background" Value="{DynamicResource ConfiguratorSelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ConfiguratorSelectedTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConfiguratorFocusBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.active-stage /template/ ContentPresenter, Button.active-stage:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ConfiguratorSelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ConfiguratorSelectedTextBrush}" />
  </Style>
  <Style Selector="Border.field-row">
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConfiguratorOutlineVariantBrush}" />
    <Setter Property="Padding" Value="10,2,0,2" />
  </Style>
  <Style Selector="Border.field-row.stripe-modified">
    <Setter Property="BorderBrush" Value="{DynamicResource ConfiguratorAccentBrush}" />
  </Style>
  <Style Selector="Border.field-row.stripe-required">
    <Setter Property="BorderBrush" Value="{DynamicResource ConfiguratorAccentBrush}" />
  </Style>
  <Style Selector="Border.field-row.stripe-error">
    <Setter Property="BorderBrush" Value="{DynamicResource ConfiguratorErrorBrush}" />
  </Style>
  <Style Selector="Border.required-pill">
    <Setter Property="Background" Value="{DynamicResource ConfiguratorPrimaryContainerBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,1" />
  </Style>
  <Style Selector="Border.error-summary">
    <Setter Property="Background" Value="{DynamicResource ConfiguratorSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConfiguratorErrorBrush}" />
    <Setter Property="BorderThickness" Value="3,1,1,1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="Border.overlay-drawer">
    <Setter Property="Background" Value="{DynamicResource ConfiguratorCanvasBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConfiguratorBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14" />
  </Style>
  <Style Selector="Border.end-dock">
    <Setter Property="Background" Value="{DynamicResource ConfiguratorSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConfiguratorBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="Thumb.dock-splitter, GridSplitter.dock-splitter">
    <Setter Property="Background" Value="{DynamicResource ConfiguratorOutlineVariantBrush}" />
    <Setter Property="Width" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="SizeWestEast" />
  </Style>
  <Style Selector="Thumb.dock-splitter">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Thumb.dock-splitter:pointerover, Thumb.dock-splitter:focus-visible, GridSplitter.dock-splitter:pointerover, GridSplitter.dock-splitter:focus-visible">
    <Setter Property="Background" Value="{DynamicResource ConfiguratorAccentBrush}" />
  </Style>
  <Style Selector="Border.store-project-card">
    <Setter Property="Background" Value="{DynamicResource ConfiguratorSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConfiguratorBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="Border.store-logo-tile">
    <Setter Property="Width" Value="76" />
    <Setter Property="Height" Value="76" />
    <Setter Property="Background" Value="{DynamicResource ConfiguratorSurfaceContainerHighBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConfiguratorOutlineVariantBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.preset-chip">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.preset-chip.active-preset, Button.preset-chip.active-preset:pointerover">
    <Setter Property="Background" Value="{DynamicResource ConfiguratorSelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ConfiguratorSelectedTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConfiguratorFocusBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
</Styles>
