<Application
    x:Class="Configurator.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Resources/ThemePalettes.axaml" />
        <ResourceInclude Source="/Views/FieldTemplates.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.DataTemplates>
    <StaticResource ResourceKey="RootFieldTemplate" />
    <StaticResource ResourceKey="StringFieldTemplate" />
    <StaticResource ResourceKey="EnumFieldTemplate" />
    <StaticResource ResourceKey="NumericFieldTemplate" />
    <StaticResource ResourceKey="BooleanFieldTemplate" />
    <StaticResource ResourceKey="ObjectFieldTemplate" />
    <StaticResource ResourceKey="MapFieldTemplate" />
    <StaticResource ResourceKey="VariantFieldTemplate" />
    <StaticResource ResourceKey="ListFieldTemplate" />
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#1B5EBE" RegionColor="#FAF9FD"
            BaseHigh="#1A1B20" BaseMediumHigh="#44474F" BaseMedium="#5C5F6A"
            BaseMediumLow="#757882" BaseLow="#A3A6B0"
            AltHigh="#FFFFFF" AltMediumHigh="#F3F2F8" AltMedium="#EDECF4"
            AltLow="#E6E5EF" AltMediumLow="#E3E2EA"
            ChromeHigh="#F3F2F8" ChromeMedium="#EDECF4" ChromeMediumLow="#E6E5EF"
            ChromeLow="#FAF9FD" ChromeAltLow="#FFFFFF" ChromeGray="#5C5F6A"
            ChromeDisabledHigh="#4F525C" ChromeDisabledLow="#E3E2EA"
            ChromeBlackHigh="#1A1B20" ChromeBlackMedium="#44474F"
            ChromeBlackMediumLow="#5C5F6A" ChromeBlackLow="#A3A6B0" ChromeWhite="#FFFFFF"
            ListLow="#EDECF4" ListMedium="#E3E2EA" ErrorText="#BA1A1A" />
        <ColorPaletteResources x:Key="Dark" Accent="#A8C7FA" RegionColor="#111318"
            BaseHigh="#E2E2E9" BaseMediumHigh="#C4C6D0" BaseMedium="#A7AAB4"
            BaseMediumLow="#8E9099" BaseLow="#5C5F6A"
            AltHigh="#111318" AltMediumHigh="#1E2027" AltMedium="#252730"
            AltMediumLow="#2C2F3A" AltLow="#111318"
            ChromeHigh="#1E2027" ChromeMedium="#252730" ChromeMediumLow="#1E2027"
            ChromeLow="#111318" ChromeAltLow="#15171D" ChromeGray="#A7AAB4"
            ChromeDisabledHigh="#8E9099" ChromeDisabledLow="#272A32"
            ChromeBlackHigh="#E2E2E9" ChromeBlackMedium="#C4C6D0"
            ChromeBlackMediumLow="#A7AAB4" ChromeBlackLow="#5C5F6A" ChromeWhite="#111318"
            ListLow="#1E2027" ListMedium="#252730" ErrorText="#FFB4AB" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="/Resources/DesignTokens.axaml" />
  </Application.Styles>
</Application>
