{
  "$schema": "urn:islamu:configurator:authoring:v2",
  "applicationVersions": [
    "1.0"
  ],
  "configuration": {
    "additionalProperties": false,
    "properties": {
      "metrics.enabled": {
        "description": "Expose metrics only on a network controlled by the operator.",
        "title": "Enable metrics",
        "type": "boolean",
        "x-configurator": {
          "applicableWhen": {
            "op": "equals",
            "reference": {
              "path": "/service.mode",
              "scope": "root"
            },
            "value": "extended"
          },
          "detail": "advanced",
          "guidance": {
            "instructions": "Leave disabled unless the target supports metrics and you have arranged an appropriate private network.",
            "searchTerms": [
              "monitoring",
              "observability",
              "metrics"
            ]
          },
          "initialValue": false,
          "sensitivity": "public"
        }
      },
      "service.credential": {
        "description": "Create a unique password for this service, not your hosting login. Enable secret entry first, or defer it and finish the incomplete draft locally.",
        "maxLength": 128,
        "minLength": 1,
        "title": "Local service password",
        "type": "string",
        "x-configurator": {
          "credential": {
            "acquisition": "create",
            "kind": "password"
          },
          "detail": "basic",
          "guidance": {
            "instructions": "Create and retain the password in your own password manager. Configurator does not generate it or install it on the target.",
            "searchTerms": [
              "password",
              "credential",
              "access"
            ]
          },
          "sensitivity": "secret"
        }
      },
      "service.extended": {
        "additionalProperties": false,
        "description": "Optional nested settings for an adapted service; omit the object to retain target-owned behavior.",
        "properties": {
          "logLevel": {
            "description": "Optional log level for a compatible target. Review target logs for private data before increasing detail.",
            "enum": [
              "warning",
              "information",
              "debug"
            ],
            "title": "Log detail",
            "type": "string",
            "x-configurator": {
              "detail": "advanced",
              "sensitivity": "public"
            }
          },
          "workers": {
            "description": "Optional worker count. Example public value, 2; confirm the target supports it.",
            "maximum": 64,
            "minimum": 1,
            "title": "Worker count",
            "type": "integer",
            "x-configurator": {
              "detail": "standard",
              "sensitivity": "public"
            }
          }
        },
        "title": "Extended operations settings",
        "type": "object",
        "x-configurator": {
          "applicableWhen": {
            "op": "equals",
            "reference": {
              "path": "/service.mode",
              "scope": "root"
            },
            "value": "extended"
          },
          "detail": "standard",
          "guidance": {
            "instructions": "These illustrative keys need an explicit mapping in a real target integration. Configurator only prepares them.",
            "searchTerms": [
              "operations",
              "workers",
              "logging"
            ]
          },
          "sensitivity": "public"
        }
      },
      "service.issuerToken": {
        "description": "Leave absent unless adapting this example to a service with an external token issuer. This example includes no issuer or token endpoint.",
        "maxLength": 4096,
        "minLength": 1,
        "title": "Optional issuer token",
        "type": "string",
        "x-configurator": {
          "credential": {
            "acquisition": "issuer",
            "kind": "opaque-token"
          },
          "detail": "advanced",
          "guidance": {
            "instructions": "Obtain a scoped service token through your issuer\u0027s documented administrator workflow. Ask that administrator about permissions and expiry; do not substitute the local service password. No provider documentation link is supplied because this neutral example names no provider.",
            "searchTerms": [
              "issuer",
              "token",
              "integration",
              "permissions"
            ]
          },
          "sensitivity": "secret"
        }
      },
      "service.mode": {
        "description": "Minimal keeps the base configuration; extended makes optional operations settings available. Selecting extended activates metrics and nested operations settings; it does not start services or expose a network port.",
        "enum": [
          "minimal",
          "extended"
        ],
        "title": "Deployment mode",
        "type": "string",
        "x-configurator": {
          "detail": "basic",
          "guidance": {
            "instructions": "Keep minimal unless you intend to review extended operations. Both modes still require the local service password.",
            "searchTerms": [
              "mode",
              "minimal",
              "extended",
              "deployment"
            ]
          },
          "initialValue": "minimal",
          "sensitivity": "public"
        }
      },
      "service.name": {
        "description": "Choose a recognizable name for this deployment. Example public name, local-service.",
        "maxLength": 128,
        "minLength": 1,
        "title": "Service name",
        "type": "string",
        "x-configurator": {
          "detail": "basic",
          "guidance": {
            "instructions": "Use a deployment label, not a password or a private customer identifier.",
            "searchTerms": [
              "name",
              "identity",
              "deployment"
            ]
          },
          "initialValue": "local-service",
          "sensitivity": "public"
        }
      }
    },
    "required": [
      "service.name",
      "service.credential"
    ],
    "type": "object",
    "x-configurator": {
      "sensitivity": "public"
    }
  },
  "identity": {
    "familyId": "289f3d1c-21ed-4888-9de3-3897d2d3fc1d",
    "revision": 1
  },
  "localization": {
    "defaultLocale": "en",
    "translations": {
      "ar": {
        "direction": "rtl",
        "overrides": {}
      }
    }
  },
  "outputs": {
    ".env": {
      "bindings": {
        "METRICS_ENABLED": {
          "path": "/metrics.enabled",
          "scope": "root"
        },
        "SERVICE_CREDENTIAL": {
          "path": "/service.credential",
          "scope": "root"
        },
        "SERVICE_ISSUER_TOKEN": {
          "path": "/service.issuerToken",
          "scope": "root"
        },
        "SERVICE_MODE": {
          "path": "/service.mode",
          "scope": "root"
        },
        "SERVICE_NAME": {
          "path": "/service.name",
          "scope": "root"
        }
      },
      "format": "dotenv",
      "id": "environment",
      "restartRequirement": "process",
      "targetUpdateMode": "create"
    },
    "service.json": {
      "bindings": {
        "/credential": {
          "path": "/service.credential",
          "scope": "root"
        },
        "/extended": {
          "path": "/service.extended",
          "scope": "root"
        },
        "/issuerToken": {
          "path": "/service.issuerToken",
          "scope": "root"
        },
        "/metrics": {
          "path": "/metrics.enabled",
          "scope": "root"
        },
        "/mode": {
          "path": "/service.mode",
          "scope": "root"
        },
        "/name": {
          "path": "/service.name",
          "scope": "root"
        }
      },
      "format": "json",
      "id": "configuration",
      "restartRequirement": "process",
      "targetUpdateMode": "create"
    },
    "service.yaml": {
      "bindings": {
        "/credential": {
          "path": "/service.credential",
          "scope": "root"
        },
        "/extended": {
          "path": "/service.extended",
          "scope": "root"
        },
        "/issuerToken": {
          "path": "/service.issuerToken",
          "scope": "root"
        },
        "/metrics": {
          "path": "/metrics.enabled",
          "scope": "root"
        },
        "/mode": {
          "path": "/service.mode",
          "scope": "root"
        },
        "/name": {
          "path": "/service.name",
          "scope": "root"
        }
      },
      "format": "yaml",
      "id": "configuration-yaml",
      "restartRequirement": "process",
      "targetUpdateMode": "create"
    }
  },
  "presentation": {
    "defaultJourney": "recommended",
    "journeys": [
      {
        "id": "recommended",
        "sections": [
          "service",
          "access",
          "operations",
          "integration"
        ],
        "title": "Recommended"
      },
      {
        "id": "custom",
        "sections": [
          "service",
          "operations",
          "access",
          "integration"
        ],
        "title": "Custom"
      }
    ],
    "navigation": "wizard",
    "sections": [
      {
        "id": "service",
        "pointers": [
          "/service.name",
          "/service.mode"
        ],
        "title": "Service identity and deployment"
      },
      {
        "id": "access",
        "pointers": [
          "/service.credential"
        ],
        "title": "Local service access"
      },
      {
        "id": "operations",
        "pointers": [
          "/service.extended",
          "/metrics.enabled"
        ],
        "title": "Extended operations"
      },
      {
        "id": "integration",
        "pointers": [
          "/service.issuerToken"
        ],
        "title": "Optional issuer integration"
      }
    ]
  },
  "project": {
    "id": "example.service",
    "name": "Minimal self-hosted service",
    "publisher": "example",
    "description": "A small neutral service example covering public settings, optional metrics and a deferred local credential.",
    "repository": "https://github.com/islamu-ngo/Configurator",
    "definitionLicense": "MIT"
  }
}