    {
      "id": "missing-server-domain-refusal",
      "description": "Omitting required server.domain refuses artifact composition.",
      "kind": "prepare",
      "answers": {
        "answerContractVersion": "0.0.1",
        "values": {
          "server": {
            "allowSignUp": false
          },
          "datasource": {
            "name": "Example metrics",
            "url": "http://metrics.example.invalid:8080"
          }
        },
        "omitted": [
          "/server/domain"
        ]
      },
      "expect": {
        "ready": false,
        "refusal": "value-required"
      }
    },
    {
