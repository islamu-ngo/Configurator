<Project>
  <!-- Probe code and friend access exist only in explicitly instrumented builds. -->
  <PropertyGroup Condition="'$(ConfiguratorImportComparisonOwnershipProbe)' == 'true'">
    <ConfiguratorImportComparisonMemoryProbe>true</ConfiguratorImportComparisonMemoryProbe>
    <DefineConstants>$(DefineConstants);CONFIGURATOR_IMPORT_OWNERSHIP_PROBE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Configurator.Browser' and '$(ConfiguratorImportComparisonMemoryProbe)' == 'true'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Configurator.Browser' and '$(ConfiguratorImportComparisonMemoryProbe)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)ImportComparisonMemoryProbe.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Configurator.Core' and '$(ConfiguratorImportComparisonOwnershipProbe)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)ImportComparisonOwnershipProbe.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(ConfiguratorImportComparisonOwnershipProbe)' == 'true' and ('$(MSBuildProjectName)' == 'Configurator.Core' or '$(MSBuildProjectName)' == 'Configurator.Presentation')">
    <InternalsVisibleTo Include="Configurator.Browser" />
    <InternalsVisibleTo Include="Configurator.Desktop" />
    <InternalsVisibleTo Include="Configurator.Terminal" />
  </ItemGroup>
</Project>
