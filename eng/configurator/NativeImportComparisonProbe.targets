<Project>
  <PropertyGroup Condition="'$(ConfiguratorNativeImportComparisonProbe)' == 'true'">
    <ConfiguratorImportComparisonOwnershipProbe>true</ConfiguratorImportComparisonOwnershipProbe>
    <DefineConstants>$(DefineConstants);CONFIGURATOR_NATIVE_IMPORT_PROBE</DefineConstants>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)ImportComparisonMemoryProbe.targets" />
  <PropertyGroup Condition="'$(ConfiguratorNativeImportComparisonProbe)' == 'true' and '$(MSBuildProjectName)' == 'Configurator.Desktop'">
    <DefineConstants>$(DefineConstants);CONFIGURATOR_DESKTOP_NATIVE_PROBE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(ConfiguratorNativeImportComparisonProbe)' == 'true' and ('$(MSBuildProjectName)' == 'Configurator.Desktop' or '$(MSBuildProjectName)' == 'Configurator.Terminal')">
    <Compile Include="$(MSBuildThisFileDirectory)MeasureNativeImportComparison.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)MeasureNativePreparation.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(ConfiguratorNativeImportComparisonProbe)' == 'true' and '$(MSBuildProjectName)' == 'Configurator.Core'">
    <Compile Include="$(MSBuildThisFileDirectory)NativeImportComparisonProbe.cs" />
    <InternalsVisibleTo Include="Configurator.Artifacts" />
  </ItemGroup>
  <ItemGroup Condition="'$(ConfiguratorNativeImportComparisonProbe)' == 'true' and '$(MSBuildProjectName)' == 'Configurator.Terminal'">
    <Compile Include="$(MSBuildThisFileDirectory)TerminalImportComparisonProbe.cs" />
  </ItemGroup>
</Project>
