<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Fixtures/Scripts/**/*.cs" />
    <ProjectReference Include="../../src/Configurator.ReleaseEngineering/Configurator.ReleaseEngineering.csproj" />
    <PackageReference Include="TUnit" />
  </ItemGroup>
  <Target Name="CopyReleaseEngineAppHost" AfterTargets="Build">
    <MSBuild Projects="../../src/Configurator.ReleaseEngineering/Configurator.ReleaseEngineering.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_ReleaseEngineTarget" />
    </MSBuild>
    <PropertyGroup>
      <_ReleaseEngineAppHostSuffix Condition="'$(OS)' == 'Windows_NT'">.exe</_ReleaseEngineAppHostSuffix>
    </PropertyGroup>
    <Copy SourceFiles="@(_ReleaseEngineTarget->'%(RootDir)%(Directory)%(Filename)$(_ReleaseEngineAppHostSuffix)')"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
